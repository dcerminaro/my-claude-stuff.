      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">AbilityConfig</string>
          <string name="Source"><![CDATA[-- AbilityConfig (ModuleScript)
-- Location: ReplicatedStorage > Shared > AbilityConfig
--
-- Numbers for the god abilities (Phase 4B). Each ability belongs to the
-- blessing with the same Id (see Shared > Gods), and its slot comes from
-- that blessing's `Ability` field (Q, Dash, E, R or Form).
-- Damage = BaseAttack (level + blessings) x (1 + Training Grounds bonus)
--          x (1 + active buffs) x (Damage + PerLevel x (blessing level - 1)).
-- All numbers are PLACEHOLDERS, balanced in Phase 8.

local AbilityConfig = {}

-- Keyboard and controller keys for each slot (touch screens get buttons).
AbilityConfig.Keys = {
	Q = { Enum.KeyCode.Q, Enum.KeyCode.ButtonL1 },
	E = { Enum.KeyCode.E, Enum.KeyCode.ButtonR1 },
	R = { Enum.KeyCode.R, Enum.KeyCode.ButtonY },
	Form = { Enum.KeyCode.T, Enum.KeyCode.DPadUp },
}
AbilityConfig.SlotOrder = { "Q", "E", "R", "Form" }
AbilityConfig.KeyLabels = { Q = "Q", E = "E", R = "R", Form = "T" }

AbilityConfig.Abilities = {
	------------------------------------------------------------------ Zeus
	LightningStrike = {
		Kind = "Strike", Move = "Cast", Cooldown = 6,
		Damage = 2.2, PerLevel = 0.4,
		Range = 28,  -- how far away it can target an enemy
		Radius = 6,  -- splash around the strike
	},
	ThunderDash = {
		Kind = "DashHit", Cooldown = 4,
		Damage = 1.2, PerLevel = 0.3,
		Width = 6, Distance = 11, Knockback = 8,
	},
	ChainLightning = {
		Kind = "Chain", Move = "Lunge", Cooldown = 9,
		Damage = 1.6, PerLevel = 0.3,
		Range = 22, JumpRange = 14, Jumps = 3, JumpsPerLevel = 1,
		Falloff = 0.85, -- each jump does 85% of the previous one
	},
	WrathOfOlympus = {
		Kind = "Storm", Move = "Cast", Cooldown = 30,
		Damage = 1.1, PerLevel = 0.25,
		Radius = 20, Pulses = 5, Interval = 0.5,
	},
	AscendedThunderForm = {
		Kind = "Buff", Move = "Cast", Cooldown = 60, Duration = 12,
		AttackPercent = 40, AttackPerLevel = 10, SpeedPercent = 25,
	},

	------------------------------------------------------------------ Ares
	WarSlash = {
		Kind = "Cleave", Move = "Cleave", Cooldown = 5,
		Damage = 2.4, PerLevel = 0.4,
		Range = 11, ArcDot = -0.2, -- about 200 degrees in front
		Knockback = 16,
	},
	BattleCharge = {
		Kind = "DashHit", Cooldown = 4,
		Damage = 1.4, PerLevel = 0.3,
		Width = 6, Distance = 11, Knockback = 22,
	},
	BerserkerRage = {
		Kind = "Buff", Move = "Cast", Cooldown = 18, Duration = 8,
		AttackPercent = 35, AttackPerLevel = 10, SpeedPercent = 15,
	},
	GodOfWar = {
		Kind = "Slam", Move = "Slam", Cooldown = 25,
		Damage = 3.5, PerLevel = 0.6,
		Radius = 14, Delay = 0.5, -- lands when the sword hits the ground
		Knockback = 28,
	},
	DivineWarlordForm = {
		Kind = "Buff", Move = "Cast", Cooldown = 60, Duration = 12,
		AttackPercent = 30, AttackPerLevel = 10, DamageTaken = 0.7, -- take 30% less damage
	},

	------------------------------------------------------------------ Poseidon (Phase 7A)
	WaterBlast = {
		Kind = "Line", Move = "Lunge", Cooldown = 6,
		Damage = 2.0, PerLevel = 0.35,
		Range = 26, Width = 4, Pierce = 3, Knockback = 14,
	},
	TidalDash = {
		Kind = "DashHit", Cooldown = 4,
		Damage = 1.2, PerLevel = 0.3,
		Width = 7, Distance = 11, Knockback = 24,
	},
	Whirlpool = {
		Kind = "Pull", Move = "Cast", Cooldown = 12,
		Damage = 0.6, PerLevel = 0.15, -- per tick
		Offset = 10, Radius = 11, Ticks = 5, Interval = 0.5,
		Slow = 0.5, SlowTime = 3, -- enemies walk at 50% for 3 s
	},
	DivineTsunami = {
		Kind = "Cone", Move = "Cleave", Cooldown = 28,
		Damage = 3.2, PerLevel = 0.5,
		Range = 22, ArcDot = 0.35, Knockback = 35,
	},
	OceanicAscension = {
		Kind = "Buff", Move = "Cast", Cooldown = 60, Duration = 12,
		AttackPercent = 15, AttackPerLevel = 5, DamageTaken = 0.7, RegenPercent = 2,
	},

	------------------------------------------------------------------ Hades (Phase 7A)
	ShadowStrike = {
		Kind = "Strike", Move = "Lunge", Cooldown = 6,
		Damage = 2.0, PerLevel = 0.35,
		Range = 20, Radius = 4, LifeSteal = 0.3, -- heals 30% of the damage dealt
	},
	SoulDrain = {
		Kind = "DashHit", Cooldown = 4,
		Damage = 1.1, PerLevel = 0.3,
		Width = 6, Distance = 11, Knockback = 8, LifeSteal = 0.5,
	},
	SummonUndead = {
		Kind = "Summon", Move = "Cast", Cooldown = 20,
		Damage = 0.6, PerLevel = 0.15, -- per spirit, per second
		Count = 2, CountPerLevel = 0.5, Duration = 15, Interval = 1, Range = 16,
	},
	ArmyOfTheDead = {
		Kind = "Storm", Move = "Slam", Cooldown = 30,
		Damage = 0.9, PerLevel = 0.2,
		Radius = 18, Pulses = 6, Interval = 0.5, LifeSteal = 0.25,
	},
	UnderworldAscension = {
		Kind = "Buff", Move = "Cast", Cooldown = 60, Duration = 12,
		AttackPercent = 30, AttackPerLevel = 10, LifeSteal = 0.2,
	},

	------------------------------------------------------------------ Athena (Phase 7A)
	SpearStrike = {
		Kind = "Line", Move = "Lunge", Cooldown = 5,
		Damage = 2.6, PerLevel = 0.45,
		Range = 16, Width = 3, Pierce = 2, Knockback = 10,
	},
	DivineShield = {
		Kind = "DashHit", Cooldown = 5,
		Damage = 0.8, PerLevel = 0.2,
		Width = 6, Distance = 11, Knockback = 14,
		ShieldTime = 3, ShieldDamageTaken = 0.5, -- take 50% damage for 3 s
	},
	Counterattack = {
		Kind = "Counter", Move = "Cast", Cooldown = 10,
		Duration = 2.5, Damage = 2.5, PerLevel = 0.5, -- each parried hit strikes back for this x attack
	},
	AegisOfOlympus = {
		Kind = "Aegis", Move = "Slam", Cooldown = 30,
		Damage = 2.0, PerLevel = 0.4,
		Radius = 14, Duration = 6, DamageTaken = 0.4, Knockback = 30,
	},
	DivineGuardianForm = {
		Kind = "Buff", Move = "Cast", Cooldown = 60, Duration = 12,
		AttackPercent = 25, AttackPerLevel = 5, DamageTaken = 0.6,
	},

	------------------------------------------------------------------ Apollo (Phase 7A)
	SolarArrow = {
		Kind = "Line", Move = "Lunge", Cooldown = 5,
		Damage = 2.0, PerLevel = 0.35,
		Range = 40, Width = 3, Pierce = 3, Knockback = 6,
	},
	RadiantDash = {
		Kind = "DashHit", Cooldown = 4,
		Damage = 1.0, PerLevel = 0.25,
		Width = 6, Distance = 11, Knockback = 8, HealPercent = 8, -- heals 8% of max health
	},
	HealingLight = {
		Kind = "Heal", Move = "Cast", Cooldown = 15,
		Radius = 20, HealPercent = 25, HealPerLevel = 5,
	},
	SolarJudgment = {
		Kind = "Storm", Move = "Cast", Cooldown = 30,
		Damage = 1.2, PerLevel = 0.25,
		Radius = 24, Pulses = 6, Interval = 0.4, Straight = true, -- straight sunbeams
	},
	SunGodForm = {
		Kind = "Buff", Move = "Cast", Cooldown = 60, Duration = 12,
		AttackPercent = 25, AttackPerLevel = 5, SpeedPercent = 20, RegenPercent = 2,
	},
}

for id, ability in AbilityConfig.Abilities do
	ability.Id = id
end

function AbilityConfig.DamageMultiplier(abilityId, level)
	local a = AbilityConfig.Abilities[abilityId]
	if not a or not a.Damage then
		return 0
	end
	return a.Damage + (a.PerLevel or 0) * (math.max(level, 1) - 1)
end

return AbilityConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">AimHelper</string>
          <string name="Source"><![CDATA[-- AimHelper (ModuleScript)
-- Location: ReplicatedStorage > Shared > AimHelper
--
-- Shared by AimDot, CombatController and AbilityController (client only).
-- In a fighting area your attacks go where the centre of the screen points
-- (the white dot), so the character turns to face the camera's direction
-- right before an attack.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local CombatConfig = require(script.Parent:WaitForChild("CombatConfig"))

local AimHelper = {}

local field = CombatConfig.PracticeField

-- In an arena / trial / challenge run, or on the Practice Field.
function AimHelper.InFightingArea(root)
	local player = Players.LocalPlayer
	local runId = player:GetAttribute("ArenaRunId")
	if runId ~= nil and runId ~= "" and runId ~= 0 then
		return true
	end
	if not root then
		return false
	end
	local offset = root.Position - field.Center
	return math.abs(offset.X) <= field.Size.X / 2 and math.abs(offset.Z) <= field.Size.Z / 2 and math.abs(offset.Y) < 25
end

-- The flat (no up/down) direction the camera looks, or nil.
function AimHelper.CameraDirection()
	local camera = Workspace.CurrentCamera
	if not camera then
		return nil
	end
	local look = camera.CFrame.LookVector
	look = Vector3.new(look.X, 0, look.Z)
	if look.Magnitude < 0.05 then
		return nil
	end
	return look.Unit
end

-- Turns the character to face the dot. Returns the aim direction to send to
-- the server, or nil when not in a fighting area (attacks go where you face).
function AimHelper.FaceAim(root)
	if not root or not AimHelper.InFightingArea(root) then
		return nil
	end
	local direction = AimHelper.CameraDirection()
	if not direction then
		return nil
	end
	local position = root.Position
	root.CFrame = CFrame.lookAt(position, position + direction)
	return direction
end

return AimHelper
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">ArenaConfig</string>
          <string name="Source"><![CDATA[-- ArenaConfig (ModuleScript)
-- Location: ReplicatedStorage > Shared > ArenaConfig
--
-- The PvE arenas (Phase 5). Each arena: 5 waves, the last with a boss.
-- Waves list enemy types (from CombatConfig.Enemies) and how many; "Boss"
-- names the boss. Add an arena by adding an entry and setting Available.
-- All numbers are PLACEHOLDERS, balanced in Phase 8.

local ArenaConfig = {}

ArenaConfig.Arenas = {
	{
		Id = "MortalTrainingPit",
		DisplayName = "Mortal Training Pit",
		Description = "Bandits and skeletons. Defeat the Training Champion!",
		MinLevel = 1,
		MaxLevel = 15,
		Available = true,
		Color = Color3.fromRGB(205, 120, 60),
		Waves = {
			{ Bandit = 2 },
			{ Bandit = 3, Skeleton = 1 },
			{ Bandit = 2, Skeleton = 3 },
			{ Bandit = 4, Skeleton = 3 },
			{ Boss = "TrainingChampion", Bandit = 2 },
		},
		-- Each wave is harder than the last (wave 1 is a warm-up).
		-- Multiplies normal enemies' health and damage; the boss is not scaled.
		WaveHealth = { 0.7, 0.9, 1.15, 1.4, 1.7 },
		WaveDamage = { 0.6, 0.8, 1.0, 1.2, 1.4 },
		WaveSpeed = { 0.9, 1.0, 1.1, 1.2, 1.3 }, -- walking speed
		-- Completion rewards (on top of what each enemy drops).
		Rewards = { XP = 250, Gold = 200, DivineFavor = 15, Ambrosia = 1 },
	},
	-- RequiredRank (Phase 6): the ascension rank needed to enter (2 = Warrior ...).
	-- Theme (Phase 7B): floor, wall and torch-fire colours. Radius: arena size.
	{
		Id = "SpartanBattleground", DisplayName = "Spartan Battleground", Description = "Spartan soldiers and war hounds. Defeat the Spartan Warlord!",
		MinLevel = 16, MaxLevel = 35, RequiredRank = 2, Available = true, Color = Color3.fromRGB(190, 60, 45),
		Theme = { Floor = Color3.fromRGB(170, 140, 100), Wall = Color3.fromRGB(150, 110, 75), Fire = Color3.fromRGB(255, 120, 40) },
		Waves = {
			{ SpartanSoldier = 3 },
			{ SpartanSoldier = 3, WarHound = 2 },
			{ SpartanSoldier = 4, WarHound = 3 },
			{ SpartanSoldier = 5, WarHound = 4 },
			{ Boss = "SpartanWarlord", SpartanSoldier = 2 },
		},
		WaveHealth = { 0.7, 0.9, 1.15, 1.4, 1.7 },
		WaveDamage = { 0.6, 0.8, 1.0, 1.2, 1.4 },
		WaveSpeed = { 0.9, 1.0, 1.1, 1.2, 1.3 },
		Rewards = { XP = 1500, Gold = 1200, DivineFavor = 60, Ambrosia = 2 },
	},
	{
		Id = "LabyrinthOfCrete", DisplayName = "Labyrinth of Crete", Description = "Stone guardians and minotaur brutes. Defeat the Minotaur!",
		MinLevel = 36, MaxLevel = 60, RequiredRank = 3, Available = true, Color = Color3.fromRGB(150, 120, 90),
		Theme = { Floor = Color3.fromRGB(120, 115, 105), Wall = Color3.fromRGB(95, 90, 82), Fire = Color3.fromRGB(255, 160, 60) },
		Radius = 50,
		Waves = {
			{ LabyrinthGuardian = 3 },
			{ LabyrinthGuardian = 2, MinotaurBrute = 2 },
			{ LabyrinthGuardian = 3, MinotaurBrute = 3 },
			{ LabyrinthGuardian = 4, MinotaurBrute = 4 },
			{ Boss = "Minotaur", MinotaurBrute = 2 },
		},
		WaveHealth = { 0.7, 0.9, 1.15, 1.4, 1.7 },
		WaveDamage = { 0.6, 0.8, 1.0, 1.2, 1.4 },
		WaveSpeed = { 0.9, 1.0, 1.1, 1.2, 1.3 },
		Rewards = { XP = 6000, Gold = 5000, DivineFavor = 150, Ambrosia = 3 },
	},
	{
		Id = "CursedTemple", DisplayName = "Cursed Temple", Description = "Cursed warriors and gorgons. Defeat Medusa!",
		MinLevel = 61, MaxLevel = 90, RequiredRank = 4, Available = true, Color = Color3.fromRGB(80, 170, 90),
		Theme = { Floor = Color3.fromRGB(80, 95, 80), Wall = Color3.fromRGB(55, 70, 58), Fire = Color3.fromRGB(110, 255, 120) },
		Radius = 50,
		Waves = {
			{ CursedWarrior = 3 },
			{ CursedWarrior = 2, Gorgon = 2 },
			{ CursedWarrior = 3, Gorgon = 3 },
			{ CursedWarrior = 4, Gorgon = 4 },
			{ Boss = "Medusa", Gorgon = 2 },
		},
		WaveHealth = { 0.7, 0.9, 1.15, 1.4, 1.7 },
		WaveDamage = { 0.6, 0.8, 1.0, 1.2, 1.4 },
		WaveSpeed = { 0.9, 1.0, 1.1, 1.2, 1.3 },
		Rewards = { XP = 20000, Gold = 15000, DivineFavor = 400, Ambrosia = 5 },
	},
	{
		Id = "GatesOfTheUnderworld", DisplayName = "Gates of the Underworld", Description = "Undead soldiers and hellhounds. Defeat Cerberus!",
		MinLevel = 91, MaxLevel = 135, RequiredRank = 5, Available = true, Color = Color3.fromRGB(150, 80, 230),
		Theme = { Floor = Color3.fromRGB(50, 40, 55), Wall = Color3.fromRGB(35, 28, 40), Fire = Color3.fromRGB(160, 80, 255) },
		Radius = 55,
		Waves = {
			{ UndeadSoldier = 3 },
			{ UndeadSoldier = 3, HellHound = 2 },
			{ UndeadSoldier = 3, HellHound = 3 },
			{ UndeadSoldier = 4, HellHound = 4 },
			{ Boss = "Cerberus", HellHound = 2 },
		},
		WaveHealth = { 0.7, 0.9, 1.15, 1.4, 1.7 },
		WaveDamage = { 0.6, 0.8, 1.0, 1.2, 1.4 },
		WaveSpeed = { 0.9, 1.0, 1.1, 1.2, 1.3 },
		Rewards = { XP = 60000, Gold = 40000, DivineFavor = 900, Ambrosia = 8 },
	},
	{
		Id = "TitansColosseum", DisplayName = "Titan's Colosseum", Description = "Titan warriors and cyclopes. Defeat the Titan King!",
		MinLevel = 136, MaxLevel = 200, RequiredRank = 6, Available = true, Color = Color3.fromRGB(230, 170, 60),
		Theme = { Floor = Color3.fromRGB(200, 185, 150), Wall = Color3.fromRGB(170, 150, 110), Fire = Color3.fromRGB(255, 200, 80) },
		Radius = 65,
		Waves = {
			{ TitanWarrior = 2 },
			{ TitanWarrior = 2, Cyclops = 1 },
			{ TitanWarrior = 3, Cyclops = 2 },
			{ TitanWarrior = 3, Cyclops = 3 },
			{ Boss = "TitanKing", TitanWarrior = 2 },
		},
		WaveHealth = { 0.7, 0.9, 1.15, 1.4, 1.7 },
		WaveDamage = { 0.6, 0.8, 1.0, 1.2, 1.4 },
		WaveSpeed = { 0.9, 1.0, 1.1, 1.2, 1.3 },
		Rewards = { XP = 150000, Gold = 100000, DivineFavor = 2000, Ambrosia = 15 },
	},
}

ArenaConfig.ById = {}
for _, arena in ArenaConfig.Arenas do
	ArenaConfig.ById[arena.Id] = arena
end

-- Bigger parties: tougher and more numerous enemies.
ArenaConfig.Party = {
	MaxPlayers = 4,
	HealthPerExtraPlayer = 0.5,     -- +50% enemy health per extra player
	CountPerExtraPlayer = 0.25,     -- +25% enemies per extra player (rounded)
	BossHealthPerExtraPlayer = 0.6, -- +60% boss health per extra player
}

ArenaConfig.CountdownTime = 3      -- seconds before wave 1
ArenaConfig.IntermissionTime = 4   -- seconds between waves
ArenaConfig.ReturnDelay = 12       -- seconds on the results screen before going home
ArenaConfig.FailRewardMultiplier = 0.3 -- a failed run pays 30% x (waves cleared / 5)
ArenaConfig.MaxRuns = 4            -- arenas that can run at the same time on one server

-- Where arena copies are built (far from the hub), one slot per running arena.
ArenaConfig.Origin = Vector3.new(0, 1, 1500)
ArenaConfig.SlotSpacing = 400
ArenaConfig.Radius = 45

local RANK_NAMES = { "Mortal", "Warrior", "Champion", "Hero", "Demigod", "Lesser God", "Olympian", "Elder God" }

-- Why an arena can't be entered, or nil if it can.
function ArenaConfig.LockReason(arena, level, rankIndex)
	if not arena.Available then
		return "Coming in Phase 7"
	end
	if level < arena.MinLevel then
		return ("Reach level %d"):format(arena.MinLevel)
	end
	if arena.RequiredRank and (rankIndex or 1) < arena.RequiredRank then
		return ("Ascend to %s"):format(RANK_NAMES[arena.RequiredRank])
	end
	return nil
end

return ArenaConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">AscensionConfig</string>
          <string name="Source"><![CDATA[-- AscensionConfig (ModuleScript)
-- Location: ReplicatedStorage > Shared > AscensionConfig
--
-- Phase 6: ascension trials, rank looks (outfit + physique + aura).
-- Ranks themselves (names, level ranges) are in GameConfig.Ranks.
-- To rank up: reach the top level of your rank, then win the trial for the
-- NEXT rank. Trials are short solo arena runs (see ArenaService.StartTrial).
-- All numbers are PLACEHOLDERS, balanced in Phase 8.
-- Phase 7E nerf: trial bosses have BossHealth 0.7 (on top of
-- CombatConfig.BossHealthScale), and trial wave enemies have less health.

local AscensionConfig = {}

-- Trial for reaching rank N (index = rank number, 2 = Warrior ... 8 = Elder God).
-- Ids match GameConfig.Ranks[N].Trial.
AscensionConfig.Trials = {
	[2] = {
		Id = "TrainingChampion",
		Name = "Defeat the Training Champion",
		Description = "Face the Training Champion alone.",
		Available = true,
		Color = Color3.fromRGB(205, 150, 60),
		Waves = { { Boss = "TrainingChampion" } },
		BossHealth = 0.7,
	},
	[3] = {
		Id = "SpartanArena",
		Name = "Complete the Spartan Arena trial",
		Description = "Survive the Spartan phalanx, then defeat the Spartan Warlord.",
		Available = true,
		Color = Color3.fromRGB(180, 55, 45),
		Theme = { Floor = Color3.fromRGB(170, 140, 100), Wall = Color3.fromRGB(150, 110, 75), Fire = Color3.fromRGB(255, 120, 40) },
		Waves = {
			{ SpartanSoldier = 4, WarHound = 2 },
			{ SpartanSoldier = 5, WarHound = 3 },
			{ Boss = "SpartanWarlord", SpartanSoldier = 2 },
		},
		WaveHealth = { 0.8, 0.9, 1.0 }, -- Phase 7E: lowered from 1.2 / 1.4 / 1.5
		WaveDamage = { 1.0, 1.1, 1.2 },
		BossHealth = 0.7,
	},
	[4] = {
		Id = "Minotaur",
		Name = "Defeat the Minotaur",
		Description = "Face the Minotaur alone in its labyrinth.",
		Available = true,
		Color = Color3.fromRGB(150, 120, 90),
		Theme = { Floor = Color3.fromRGB(120, 115, 105), Wall = Color3.fromRGB(95, 90, 82), Fire = Color3.fromRGB(255, 160, 60) },
		Radius = 50,
		Waves = { { Boss = "Minotaur" } },
		BossHealth = 0.7,
	},
	[5] = {
		Id = "DivineTrial",
		Name = "Complete your god's Divine Trial",
		Description = "Prove yourself to your god: two waves of cursed foes, then your god's own Avatar.",
		Available = true,
		Divine = true, -- the boss is named "Avatar of <your god>"
		Color = Color3.fromRGB(255, 220, 120),
		Theme = { Floor = Color3.fromRGB(235, 230, 215), Wall = Color3.fromRGB(212, 175, 55), Fire = Color3.fromRGB(255, 240, 180) },
		Radius = 50,
		Waves = {
			{ CursedWarrior = 3, Gorgon = 2 },
			{ UndeadSoldier = 3, HellHound = 2 },
			{ Boss = "DivineAvatar" },
		},
		WaveHealth = { 0.55, 0.55, 0.7 }, -- Phase 7E: lowered from 0.8 / 0.8 / 1
		WaveDamage = { 0.8, 0.8, 1 },
		BossHealth = 0.7,
	},
	[6] = {
		Id = "Cerberus",
		Name = "Defeat Cerberus",
		Description = "Slay the three-headed guardian of the Underworld.",
		Available = true,
		Color = Color3.fromRGB(150, 80, 230),
		Theme = { Floor = Color3.fromRGB(50, 40, 55), Wall = Color3.fromRGB(35, 28, 40), Fire = Color3.fromRGB(160, 80, 255) },
		Radius = 55,
		Waves = { { Boss = "Cerberus" } },
		BossHealth = 0.7,
	},
	[7] = {
		Id = "OlympianGauntlet",
		Name = "Complete the Olympian Gauntlet",
		Description = "Three legends in a row: the Minotaur, Medusa and Cerberus.",
		Available = true,
		Color = Color3.fromRGB(200, 150, 20),
		Theme = { Floor = Color3.fromRGB(235, 230, 215), Wall = Color3.fromRGB(200, 170, 90), Fire = Color3.fromRGB(255, 220, 120) },
		Radius = 55,
		Waves = { { Boss = "Minotaur" }, { Boss = "Medusa" }, { Boss = "Cerberus" } },
		BossHealth = 0.85, -- Phase 7E: lowered from 1.2
	},
	[8] = {
		Id = "TitanKing",
		Name = "Defeat the Titan King",
		Description = "The final trial: overthrow the Titan King.",
		Available = true,
		Color = Color3.fromRGB(230, 120, 20),
		Theme = { Floor = Color3.fromRGB(200, 185, 150), Wall = Color3.fromRGB(170, 150, 110), Fire = Color3.fromRGB(255, 200, 80) },
		Radius = 65,
		Waves = { { Boss = "TitanKing" } },
		BossHealth = 0.7,
	},
}

-- Body size per rank, multiplying the player's own avatar proportions.
-- Wider/deeper grows faster than height: a bigger, more powerful build.
AscensionConfig.Physique = {}
for rank = 1, 8 do
	AscensionConfig.Physique[rank] = {
		Height = 1 + 0.03 * (rank - 1),
		Width = 1 + 0.05 * (rank - 1),
		Depth = 1 + 0.04 * (rank - 1),
		Head = 1 + 0.01 * (rank - 1),
	}
end

-- Shown in the Ascension Chamber.
AscensionConfig.Perks = {
	[1] = "Your journey begins.",
	[2] = "Leather shoulder pads, bracers and belt · a stronger build",
	[3] = "Bronze chest plate and greaves",
	[4] = "A hero's red cape",
	[5] = "Steel armour, a glowing chest gem and a divine aura",
	[6] = "Golden armour, a laurel wreath and a cape in your god's colour",
	[7] = "Wings of light",
	[8] = "A halo and a blazing aura",
}

-- Aura particles per second from Demigod upwards.
AscensionConfig.AuraRate = { [5] = 4, [6] = 6, [7] = 9, [8] = 14 }

return AscensionConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">ChallengeConfig</string>
          <string name="Source"><![CDATA[-- ChallengeConfig (ModuleScript)
-- Location: ReplicatedStorage > Shared > ChallengeConfig
--
-- Phase 7E: Olympian Challenges at the Titan Gate. Harder rematches of every
-- arena boss, plus the Olympian Gauntlet (all six bosses in a row).
--   Heroic: open once you could enter that boss's arena (its RequiredRank).
--   Mythic and the Gauntlet: Elder God only (the true endgame).
-- Two waves per rematch: the arena's elite wave, then the boss with helpers.
-- Rewards = the arena's rewards x difficulty, plus a one-time first-clear
-- Ambrosia bonus. All numbers are PLACEHOLDERS, balanced in Phase 8.

local ArenaConfig = require(script.Parent:WaitForChild("ArenaConfig"))
local CombatConfig = require(script.Parent:WaitForChild("CombatConfig"))

local ChallengeConfig = {}

local RANK_NAMES = { "Mortal", "Warrior", "Champion", "Hero", "Demigod", "Lesser God", "Olympian", "Elder God" }

ChallengeConfig.ElderGodRank = 8

ChallengeConfig.DifficultyOrder = { "Heroic", "Mythic" }
ChallengeConfig.Difficulties = {
	Heroic = {
		Name = "Heroic", Color = Color3.fromRGB(200, 120, 40),
		BossHealth = 2.5, BossDamage = 1.6,   -- the boss
		AddHealth = 2.2, AddDamage = 1.6,     -- everything else
		Speed = 1.25, Reward = 3, FirstClearAmbrosia = 3,
	},
	Mythic = {
		Name = "Mythic", Color = Color3.fromRGB(170, 60, 210),
		BossHealth = 5, BossDamage = 2.4,
		AddHealth = 4, AddDamage = 2.2,
		Speed = 1.4, Reward = 7, FirstClearAmbrosia = 8,
		RequiredRank = 8,
	},
}

ChallengeConfig.Challenges = {}
ChallengeConfig.ById = {}

local function add(challenge)
	table.insert(ChallengeConfig.Challenges, challenge)
	ChallengeConfig.ById[challenge.Id] = challenge
end

for _, arena in ArenaConfig.Arenas do
	local bossWave = arena.Waves[#arena.Waves]
	local boss = bossWave.Boss
	local bossCfg = boss and CombatConfig.Enemies[boss]
	if arena.Available and bossCfg then
		add({
			Id = "Rematch_" .. boss,
			Name = bossCfg.DisplayName .. " Rematch",
			Description = "Elite " .. arena.DisplayName .. " forces, then a far stronger " .. bossCfg.DisplayName .. ".",
			Boss = boss,
			RequiredRank = arena.RequiredRank or 1,
			Arena = arena,
			Waves = { arena.Waves[#arena.Waves - 1], bossWave },
			Rewards = arena.Rewards,
			Theme = arena.Theme,
			Radius = arena.Radius,
			Color = arena.Color,
		})
	end
end

local colosseum = ArenaConfig.ById and ArenaConfig.ById.TitansColosseum
add({
	Id = "OlympianGauntlet",
	Name = "The Olympian Gauntlet",
	Description = "All six bosses, one after another, with no healing breaks beyond the short pauses. Only for Elder Gods.",
	Boss = "TitanKing",
	RequiredRank = 8,
	MythicOnlyRank = true,
	Waves = {
		{ Boss = "TrainingChampion" },
		{ Boss = "SpartanWarlord" },
		{ Boss = "Minotaur" },
		{ Boss = "Medusa" },
		{ Boss = "Cerberus" },
		{ Boss = "TitanKing" },
	},
	Rewards = { XP = 60000, Gold = 50000, DivineFavor = 300, Ambrosia = 4 },
	Theme = colosseum and colosseum.Theme,
	Radius = colosseum and colosseum.Radius,
	Color = Color3.fromRGB(230, 190, 60),
})

-- Why a player can't start this challenge at this difficulty (nil = they can).
function ChallengeConfig.LockReason(challenge, difficultyId, rankIndex)
	local difficulty = ChallengeConfig.Difficulties[difficultyId]
	if not challenge or not difficulty then
		return "Unknown challenge."
	end
	local needed = math.max(challenge.RequiredRank or 1, difficulty.RequiredRank or 1)
	if rankIndex < needed then
		return if needed >= ChallengeConfig.ElderGodRank then "Elder God only" else ("Ascend to %s"):format(RANK_NAMES[needed] or "?")
	end
	return nil
end

-- The clear record key, e.g. "Rematch_Medusa:Mythic".
function ChallengeConfig.Key(challengeId, difficultyId)
	return challengeId .. ":" .. difficultyId
end

return ChallengeConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">CombatConfig</string>
          <string name="Source"><![CDATA[-- CombatConfig (ModuleScript)
-- Location: ReplicatedStorage > Shared > CombatConfig
--
-- Tunable combat numbers for players and enemies. Server and client read it.
-- All numbers are PLACEHOLDERS, balanced in Phase 8.
-- To add an enemy: add an entry to Enemies. Arenas (Phase 5) spawn enemies by
-- these names through EnemyService.Spawn.

local CombatConfig = {}

--------------------------------------------------------------------------
-- PLAYER
--------------------------------------------------------------------------
CombatConfig.Player = {
	RespawnTime = 4, -- seconds after dying

	-- Damage = BaseAttack (level + blessings) x DamageMultiplier x (1 + Training Grounds bonus)
	BasicAttack = {
		DamageMultiplier = 1,
		Range = 7.5,        -- studs in front of you
		ArcDot = 0.2,       -- how wide the swing is (0 = 180 degrees, 0.7 = narrow)
		Cooldown = 0.45,    -- seconds between swings
		MaxTargets = 3,
		RandomSpread = 0.1, -- +/- 10% damage variation
	},

	Block = {
		DamageTaken = 0.3,          -- you take 30% damage while blocking
		WalkSpeedMultiplier = 0.5,  -- and move at half speed
	},

	Dash = {
		Cooldown = 2,
		Speed = 60,             -- studs per second during the dash
		Duration = 0.18,        -- seconds
		InvulnerableTime = 0.3, -- you can't be hit right after dashing
	},

	-- Replaces Roblox's default regeneration. The Divine Fountain bonus multiplies it.
	Regen = {
		DelayAfterDamage = 5, -- seconds without taking damage before regen starts
		PercentPerSecond = 1, -- % of max health per second
	},
}

--------------------------------------------------------------------------
-- ENEMIES
-- Windup = the warning time (the enemy glows red) before an attack lands.
-- AggroRange = how close you must be before it chases you.
-- LeashRange = how far from its spawn it will follow you before giving up.
--------------------------------------------------------------------------
CombatConfig.Enemies = {
	Bandit = {
		DisplayName = "Bandit",
