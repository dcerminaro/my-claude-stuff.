		Damage = 8,
		WalkSpeed = 12,
		AttackRange = 5,
		Windup = 0.45,
		AttackCooldown = 1.0,
		AggroRange = 22,
		LeashRange = 55,
		XP = 25,
		Gold = 10,
		RespawnTime = 6,
		Appearance = {
			Skin = Color3.fromRGB(204, 160, 120),
			Shirt = Color3.fromRGB(120, 60, 40),
			Pants = Color3.fromRGB(70, 55, 40),
			Width = 1,
			Weapon = Color3.fromRGB(150, 150, 155),
		},
	},
	Skeleton = {
