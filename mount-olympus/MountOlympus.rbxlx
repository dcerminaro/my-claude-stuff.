			{ Name = "Slam", Kind = "Slam", Windup = 0.9, Cooldown = 7, Range = 20, Radius = 24, Damage = 180 },
			{ Name = "Charge", Kind = "Charge", Windup = 0.9, Cooldown = 9, Range = 60, MinRange = 18, Length = 50, Width = 14, Damage = 160 },
		},
		Phase2 = { At = 0.5, CooldownMultiplier = 0.6, SpeedMultiplier = 1.2, Summon = { TitanWarrior = 2 }, Message = "The Titan King summons his titans!" },
	},

	-- Demigod trial boss: shown as "Avatar of <your god>".
	DivineAvatar = {
		DisplayName = "Divine Avatar", Boss = true, MaxHealth = 30000, Damage = 85, WalkSpeed = 16,
		AttackRange = 8, Windup = 0.45, AttackCooldown = 0.9, AggroRange = 120, LeashRange = 250,
		XP = 0, Gold = 0, RespawnTime = 0,
		Appearance = { Skin = Color3.fromRGB(255, 240, 200), Shirt = Color3.fromRGB(240, 230, 210), Pants = Color3.fromRGB(212, 175, 55),
			Width = 1.2, Scale = 1.7, Weapon = Color3.fromRGB(255, 240, 160), WeaponLength = 5, Extras = { "Crown" }, ExtraColor = Color3.fromRGB(255, 220, 90) },
		Attacks = {
			{ Name = "Judgment", Kind = "Meteors", Windup = 1.1, Cooldown = 8, Range = 60, Count = 4, Radius = 7, Damage = 100 },
			{ Name = "Slam", Kind = "Slam", Windup = 0.8, Cooldown = 6, Range = 12, Radius = 16, Damage = 95 },
		},
		Phase2 = { At = 0.5, CooldownMultiplier = 0.6, SpeedMultiplier = 1.2, Message = "The Avatar blazes with divine power!" },
	},
	TrainingDummy = {
		DisplayName = "Training Dummy",
		MaxHealth = 500,
		Damage = 0,
		WalkSpeed = 0,
		Passive = true,   -- never moves or attacks
		Immortal = true,  -- when "knocked out" it pops straight back up instead of dying
		Builder = "Dummy", -- a wooden training dummy instead of a character
		RegenDelay = 3,   -- heals fully after 3 seconds without being hit
		XP = 0,
		Gold = 0,
		RespawnTime = 0,
		Appearance = {
			Skin = Color3.fromRGB(214, 190, 140),
			Shirt = Color3.fromRGB(160, 120, 80),
			Pants = Color3.fromRGB(120, 85, 55),
			Width = 1.1,
		},
	},
}

--------------------------------------------------------------------------
-- PRACTICE FIELD (behind the plaza spawn) — a place to fight before arenas
-- exist. Offsets are relative to Center (Y = floor top).
--------------------------------------------------------------------------
-- Phase 7E balance: every boss's health and damage (arenas, trials,
-- challenges) is multiplied by these. 1 = the numbers above.
CombatConfig.BossHealthScale = 0.75 -- 25% less health
CombatConfig.BossDamageScale = 0.9  -- 10% less damage

CombatConfig.PracticeField = {
	Center = Vector3.new(0, 1, -125),
	Size = Vector3.new(90, 1, 70),
	Spawns = {
		{ Enemy = "TrainingDummy", Offset = Vector3.new(-20, 0, 18) },
		{ Enemy = "TrainingDummy", Offset = Vector3.new(0, 0, 18) },
		{ Enemy = "TrainingDummy", Offset = Vector3.new(20, 0, 18) },
		{ Enemy = "Bandit", Offset = Vector3.new(-22, 0, 2) },
		{ Enemy = "Bandit", Offset = Vector3.new(0, 0, -6) },
		{ Enemy = "Bandit", Offset = Vector3.new(22, 0, 2) },
		{ Enemy = "Skeleton", Offset = Vector3.new(-14, 0, -24) },
		{ Enemy = "Skeleton", Offset = Vector3.new(14, 0, -24) },
	},
}

return CombatConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">GameConfig</string>
          <string name="Source"><![CDATA[-- GameConfig (ModuleScript)
-- Location: ReplicatedStorage > Shared > GameConfig
--
-- Central settings for Mount Olympus: Rise of the Gods.
-- Both the server and the client read this file.
-- Players CAN read anything in ReplicatedStorage, so never put secrets here.
-- Changing a number here is how you balance the game; you should not need
-- to edit the other scripts to tweak values.

local GameConfig = {}

--------------------------------------------------------------------------
-- DATA SAVING
--------------------------------------------------------------------------
GameConfig.Data = {
	StoreName = "MountOlympus_PlayerData", -- changing this starts everyone fresh
	SchemaVersion = 1,         -- bump when the data layout changes (see DataService migrations)
	AutosaveInterval = 120,    -- seconds between automatic saves
	SessionLockTimeout = 600,  -- a lock older than this (seconds) is treated as left behind by a crashed server
	MaxLoadAttempts = 6,
	LoadRetryDelay = 5,        -- seconds between load attempts
	MaxSaveAttempts = 3,
}

--------------------------------------------------------------------------
-- LEVELS AND STATS
--------------------------------------------------------------------------
GameConfig.Progression = {
	MaxLevel = 200,

	-- XP needed to go from level L to L+1 = floor(BaseXP * L ^ XPExponent)
	-- Placeholder curve; tuned during Phase 8 balancing.
	BaseXP = 100,
	XPExponent = 1.5,

	-- If true, a player stops levelling at the top of their rank's range
	-- (e.g. Mortal stops at 10) until they complete the ascension trial.
	LevelCappedByRank = true,

	BaseHealth = 100,
	HealthPerLevel = 10,
	BaseAttack = 10,
	AttackPerLevel = 2,
}

--------------------------------------------------------------------------
-- ASCENSION RANKS
-- Trial = the trial that must be completed to REACH this rank.
--------------------------------------------------------------------------
GameConfig.Ranks = {
	{ Name = "Mortal",     MinLevel = 1,   MaxLevel = 10,  Trial = "",                 Color = Color3.fromRGB(120, 112, 100) },
	{ Name = "Warrior",    MinLevel = 11,  MaxLevel = 25,  Trial = "TrainingChampion", Color = Color3.fromRGB(165, 105, 55) },
	{ Name = "Champion",   MinLevel = 26,  MaxLevel = 45,  Trial = "SpartanArena",     Color = Color3.fromRGB(180, 55, 45) },
	{ Name = "Hero",       MinLevel = 46,  MaxLevel = 70,  Trial = "Minotaur",         Color = Color3.fromRGB(50, 110, 190) },
	{ Name = "Demigod",    MinLevel = 71,  MaxLevel = 100, Trial = "DivineTrial",      Color = Color3.fromRGB(125, 70, 195) },
	{ Name = "Lesser God", MinLevel = 101, MaxLevel = 140, Trial = "Cerberus",         Color = Color3.fromRGB(30, 150, 140) },
	{ Name = "Olympian",   MinLevel = 141, MaxLevel = 180, Trial = "OlympianGauntlet", Color = Color3.fromRGB(200, 150, 20) },
	{ Name = "Elder God",  MinLevel = 181, MaxLevel = 200, Trial = "TitanKing",        Color = Color3.fromRGB(230, 120, 20) },
}

--------------------------------------------------------------------------
-- CURRENCIES
--------------------------------------------------------------------------
GameConfig.Currencies = { "Gold", "DivineFavor", "Ambrosia" }

GameConfig.CurrencyInfo = {
	Gold        = { DisplayName = "Gold",   Color = Color3.fromRGB(212, 175, 55) },
	DivineFavor = { DisplayName = "Favor",  Color = Color3.fromRGB(110, 170, 255) },
	Ambrosia    = { DisplayName = "Ambrosia", Color = Color3.fromRGB(230, 110, 170) },
}

GameConfig.StartingCurrencies = {
	Gold = 100,
	DivineFavor = 0,
	Ambrosia = 0,
}

--------------------------------------------------------------------------
-- TEMPLE PLOTS
-- Count must be >= the server's Max Players (Game Settings > Places).
--------------------------------------------------------------------------
GameConfig.Plots = {
	Count = 8,
	Columns = 4,
	Size = Vector3.new(80, 1, 80),
	Spacing = 100,
	Origin = Vector3.new(-150, 0.5, 200), -- centre of Plot1
}

--------------------------------------------------------------------------
-- MISC
--------------------------------------------------------------------------
GameConfig.Teleport = {
	Cooldown = 3, -- seconds between teleport requests
}

-- Shown small in the corner so you can tell which update a server is running.
-- Bump this with every publish.
GameConfig.BuildLabel = "v51"

GameConfig.Debug = {
	-- Chat commands like "!xp 500". They ONLY work inside Roblox Studio,
	-- never in the live game, even if this is left true.
	ChatCommandsInStudio = true,

	-- Lets ONLY the game's owner use the same chat commands in the live
	-- game (e.g. testing on an iPad without Studio). Nobody else can.
	-- !!! Set this to false before releasing the game to the public. !!!
	ChatCommandsForOwnerInLiveGame = true,

	-- Devices send a small performance/error report to the server, saved in
	-- the "OlympusDiagnostics" DataStore so problems can be investigated.
	-- Set to false before release if no longer needed.
	Diagnostics = true,
}

return GameConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">GodConfig</string>
          <string name="Source"><![CDATA[-- GodConfig (ModuleScript)
-- Location: ReplicatedStorage > Shared > GodConfig
--
-- Loads every god module from ReplicatedStorage > Shared > Gods and holds the
-- rules shared by all gods: blessing tiers, Divine Favor costs, requirements,
-- worship and god-changing. Both server and client read this.
-- To add a god: create a module in the Gods folder, add its Id to Order.
-- All numbers are PLACEHOLDERS, balanced in Phase 8.

local GameConfig = require(script.Parent:WaitForChild("GameConfig"))
local GodsFolder = script.Parent:WaitForChild("Gods")

local GodConfig = {}

-- Display order in the menus.
GodConfig.Order = { "Zeus", "Poseidon", "Hades", "Ares", "Athena", "Apollo" }

GodConfig.Gods = {}
for _, id in GodConfig.Order do
	GodConfig.Gods[id] = require(GodsFolder:WaitForChild(id))
end

-- [BlessingId] = { God = godId, Blessing = blessing table }
GodConfig.BlessingsById = {}
for godId, god in GodConfig.Gods do
	for _, blessing in god.Blessings do
		GodConfig.BlessingsById[blessing.Id] = { God = godId, Blessing = blessing }
	end
end

--------------------------------------------------------------------------
-- Blessing tiers (same rules for every god)
-- AltarLevel = Main Altar level needed, Loyalty = loyalty with that god,
-- RankIndex  = ascension rank needed (1 Mortal, 2 Warrior, 3 Champion, 4 Hero),
-- Costs[n]   = Divine Favor to reach blessing level n.
-- Tier 1 level 1 is given free when you start worshipping a god.
--------------------------------------------------------------------------
GodConfig.MaxBlessingLevel = 3

GodConfig.Tiers = {
	{ AltarLevel = 0, Loyalty = 0,   RankIndex = 1, Costs = { 0, 40, 120 } },
	{ AltarLevel = 1, Loyalty = 25,  RankIndex = 1, Costs = { 60, 150, 400 } },
	{ AltarLevel = 2, Loyalty = 100, RankIndex = 2, Costs = { 200, 500, 1200 } },
	{ AltarLevel = 3, Loyalty = 300, RankIndex = 3, Costs = { 600, 1500, 3500 } },
	{ AltarLevel = 4, Loyalty = 800, RankIndex = 4, Costs = { 1500, 4000, 10000 } },
}

-- Worship at your god's statue in the Hall of the Gods.
-- Rewards are increased by the Statue Hall's worship bonus.
GodConfig.Worship = {
	Cooldown = 30, -- seconds
	Favor = 10,
	Loyalty = 10,
}

-- Changing god: start at the Shrine of Change, then pray there this many times.
-- Levels, currencies, temple and every god's blessings and loyalty are kept.
GodConfig.GodChange = {
	PrayersNeeded = 3,
	PrayerCooldown = 20, -- seconds between prayers
}

-- Temple colours before a god is chosen.
GodConfig.DefaultColors = {
	Primary = Color3.fromRGB(212, 175, 55),
	Accent = Color3.fromRGB(212, 175, 55),
	Glow = Color3.fromRGB(110, 170, 255),
}

--------------------------------------------------------------------------
-- Shared rules
--------------------------------------------------------------------------
function GodConfig.IsPlayable(godId)
	local god = GodConfig.Gods[godId]
	return god ~= nil and god.Available == true
end

function GodConfig.GetColors(godId)
	local god = GodConfig.Gods[godId]
	return if god then god.Colors else GodConfig.DefaultColors
end

-- What the next level of a blessing needs.
-- Returns { Maxed = bool, NextLevel = n, Cost = favor, Blocked = "reason" or nil }
function GodConfig.GetBlessingUpgradeInfo(blessingId, currentLevel, altarLevel, loyalty, rankIndex)
	local entry = GodConfig.BlessingsById[blessingId]
	if not entry then
		return nil
	end
	if currentLevel >= GodConfig.MaxBlessingLevel then
		return { Maxed = true }
	end
	local tier = GodConfig.Tiers[entry.Blessing.Tier]
	local nextLevel = currentLevel + 1

	local blocked = nil
	if altarLevel < tier.AltarLevel then
		blocked = ("Needs Main Altar level %d"):format(tier.AltarLevel)
	elseif loyalty < tier.Loyalty then
		blocked = ("Needs %d loyalty"):format(tier.Loyalty)
	elseif rankIndex < tier.RankIndex then
		blocked = ("Needs rank %s"):format(GameConfig.Ranks[tier.RankIndex].Name)
	end

	return {
		Maxed = false,
		NextLevel = nextLevel,
		Cost = tier.Costs[nextLevel],
		Blocked = blocked,
	}
end

return GodConfig
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="11">
