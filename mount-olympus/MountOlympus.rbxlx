        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Zeus</string>
            <string name="Source"><![CDATA[-- Zeus (ModuleScript)
-- Location: ReplicatedStorage > Shared > Gods > Zeus
--
-- One god = one config module. Blessing tiers 1-5 follow the shared rules
-- in GodConfig (costs, Altar level, Loyalty and rank requirements).
-- Ability = which control the blessing's ability will use (Phase 4).
-- Passive = a permanent stat bonus per blessing level, active NOW while
-- Zeus is your god: AttackPercent, HealthPercent or SpeedPercent.

return {
	Id = "Zeus",
	DisplayName = "Zeus",
	Title = "God of Thunder",
	Specialty = "Lightning and burst damage.",
	Available = true,

	Colors = {
		Primary = Color3.fromRGB(90, 170, 255),  -- menus and badges
		Accent = Color3.fromRGB(212, 175, 55),   -- metal trim on your temple
		Glow = Color3.fromRGB(90, 170, 255),     -- glowing parts on your temple
		Fire = Color3.fromRGB(120, 180, 255),    -- temple flames
	},

	Blessings = {
		{ Id = "LightningStrike", Name = "Lightning Strike", Tier = 1, Ability = "Q",
			Description = "Call down a bolt of lightning.", Passive = { Stat = "AttackPercent", PerLevel = 3 } },
		{ Id = "ThunderDash", Name = "Thunder Dash", Tier = 2, Ability = "Dash",
			Description = "Dash forward as a streak of thunder.", Passive = { Stat = "SpeedPercent", PerLevel = 4 } },
		{ Id = "ChainLightning", Name = "Chain Lightning", Tier = 3, Ability = "E",
			Description = "Lightning that leaps between enemies.", Passive = { Stat = "AttackPercent", PerLevel = 4 } },
		{ Id = "WrathOfOlympus", Name = "Wrath of Olympus", Tier = 4, Ability = "R",
			Description = "A storm of lightning around you (ultimate).", Passive = { Stat = "AttackPercent", PerLevel = 6 } },
		{ Id = "AscendedThunderForm", Name = "Ascended Thunder Form", Tier = 5, Ability = "Form",
			Description = "Become living lightning for a short time.", Passive = { Stat = "SpeedPercent", PerLevel = 5 } },
	},
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">MasteryConfig</string>
          <string name="Source"><![CDATA[-- MasteryConfig (ModuleScript)
-- Location: ReplicatedStorage > Shared > MasteryConfig
--
-- Phase 7E part 3: Divine Mastery and Divine Incarnations.
--
-- DIVINE MASTERY: every god has its own mastery level (1-50). Mastery XP is
-- earned for the god you currently worship by fighting and worshipping.
-- Each level gives a small, capped bonus and some levels unlock cosmetics.
--
-- DIVINE INCARNATION (Elder God only): fill Divine Energy by hitting and
-- defeating enemies, then transform into your god's divine form for a short
-- time: an opening blast, glowing form and strong temporary buffs.
-- All numbers are PLACEHOLDERS, balanced in Phase 8.

local MasteryConfig = {}

MasteryConfig.MaxLevel = 50

-- Mastery XP needed to go from `level` to `level + 1`.
function MasteryConfig.XPForLevel(level)
	return math.floor(100 * level ^ 1.8)
end

-- Where mastery XP comes from.
MasteryConfig.Sources = {
	KillXPShare = 0.1,      -- a tenth of the enemy's normal XP (dummies give 0)
	ArenaXPShare = 0.1,     -- a tenth of the arena's XP reward for a win
	ChallengeWin = 1500,
	Worship = 20,
	UseAbility = 2,
}

-- Small, capped bonuses (per level; level 50 = +10% attack, +10% health).
MasteryConfig.AttackPercentPerLevel = 0.2
MasteryConfig.HealthPercentPerLevel = 0.2

-- Cosmetics unlocked at mastery levels (for the god you worship).
MasteryConfig.Unlocks = {
	{ Level = 5, Id = "Sparks", Name = "Divine Sparks", Description = "Sparks of your god's colour drift around you." },
	{ Level = 10, Id = "Title1", Name = "Title: Adept", Description = "\"<God> Adept\" above your head." },
	{ Level = 15, Id = "Trail", Name = "Divine Trail", Description = "A glowing trail follows your steps." },
	{ Level = 25, Id = "Title2", Name = "Title: Master", Description = "\"Master of <God>\" above your head." },
	{ Level = 30, Id = "Glow", Name = "Inner Light", Description = "You shine with your god's light." },
	{ Level = 40, Id = "Title3", Name = "Title: Grandmaster", Description = "\"Grandmaster of <God>\" above your head." },
	{ Level = 50, Id = "Crown", Name = "Crown of Light", Description = "A floating crown of light and the title \"Chosen of <God>\"." },
}

function MasteryConfig.Title(godName, level)
	if level >= 50 then
		return "Chosen of " .. godName
	elseif level >= 40 then
		return "Grandmaster of " .. godName
	elseif level >= 25 then
		return "Master of " .. godName
	elseif level >= 10 then
		return godName .. " Adept"
	end
	return nil
end

--------------------------------------------------------------------------
-- DIVINE INCARNATION
--------------------------------------------------------------------------
MasteryConfig.Incarnation = {
	RequiredRank = 8,        -- Elder God
	EnergyMax = 100,
	EnergyPerHit = 1,        -- each time you damage an enemy
	EnergyPerKill = 3,
	EnergyPerBossKill = 25,
	BaseDuration = 18,       -- seconds
	DurationPerMastery = 0.2, -- + seconds per mastery level (level 50: 28 s)
	BlastRadius = 24,        -- opening blast
	BlastDamage = 8,         -- x your ability damage
	HealPercent = 30,        -- heals you when you transform
	Key = Enum.KeyCode.T,    -- keyboard key (phones/tablets get a button)
}

-- Each god's form. Buff numbers work like ability buffs:
-- AttackPercent, SpeedPercent, DamageTaken (0.6 = take 40% less),
-- RegenPercent (% of max health per second), LifeSteal (share of damage).
MasteryConfig.Forms = {
	Zeus = { Name = "Avatar of the Storm", AttackPercent = 60, SpeedPercent = 25, DamageTaken = 0.7 },
	Poseidon = { Name = "Lord of the Deep", AttackPercent = 40, SpeedPercent = 20, DamageTaken = 0.6, RegenPercent = 3 },
	Hades = { Name = "King of the Dead", AttackPercent = 45, SpeedPercent = 20, DamageTaken = 0.65, LifeSteal = 0.15 },
	Ares = { Name = "Avatar of War", AttackPercent = 75, SpeedPercent = 25, DamageTaken = 0.75 },
	Athena = { Name = "Aegis Incarnate", AttackPercent = 35, SpeedPercent = 20, DamageTaken = 0.45 },
	Apollo = { Name = "The Radiant Sun", AttackPercent = 45, SpeedPercent = 40, DamageTaken = 0.7, RegenPercent = 2 },
}
MasteryConfig.DefaultForm = { Name = "Divine Form", AttackPercent = 40, SpeedPercent = 20, DamageTaken = 0.7 }

return MasteryConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Progression</string>
          <string name="Source"><![CDATA[-- Progression (ModuleScript)
-- Location: ReplicatedStorage > Shared > Progression
--
-- Pure formulas shared by server and client (no data is changed here).
-- The server uses these to apply progression; the client uses them for display.

local GameConfig = require(script.Parent:WaitForChild("GameConfig"))

local P = GameConfig.Progression
local Progression = {}

-- XP required to go from `level` to `level + 1`. Returns 0 at max level.
function Progression.XPToNextLevel(level)
	if level >= P.MaxLevel then
		return 0
	end
	return math.floor(P.BaseXP * level ^ P.XPExponent)
end

function Progression.GetRank(rankIndex)
	local index = math.clamp(math.floor(tonumber(rankIndex) or 1), 1, #GameConfig.Ranks)
	return GameConfig.Ranks[index]
end

-- Highest level a player can reach at their current rank.
function Progression.GetLevelCap(rankIndex)
	if not P.LevelCappedByRank then
		return P.MaxLevel
	end
	return math.min(Progression.GetRank(rankIndex).MaxLevel, P.MaxLevel)
end

function Progression.GetMaxHealth(level)
	return P.BaseHealth + P.HealthPerLevel * (level - 1)
end

function Progression.GetBaseAttack(level)
	return P.BaseAttack + P.AttackPerLevel * (level - 1)
end

-- 950 -> "950", 1500 -> "1.5K", 2000000 -> "2M"
local SUFFIXES = { "", "K", "M", "B", "T", "Qa" }
function Progression.FormatNumber(n)
	n = math.floor(tonumber(n) or 0)
	if math.abs(n) < 1000 then
		return tostring(n)
	end
	local value = n
	local i = 1
	while math.abs(value) >= 1000 and i < #SUFFIXES do
		value /= 1000
		i += 1
	end
	local text = string.format("%.1f%s", value, SUFFIXES[i])
	return (string.gsub(text, "%.0(%a)", "%1"))
end

return Progression
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">QuestConfig</string>
          <string name="Source"><![CDATA[-- QuestConfig (ModuleScript)
-- Location: ReplicatedStorage > Shared > QuestConfig
--
-- Phase 7D: quests. Quests are grouped in CHAINS: only the first unfinished
-- quest of each chain is active, and claiming it unlocks the next one.
-- Daily quests: 3 picked from the Daily pool each day (UTC), reset at midnight.
--
-- Objective types (counted by the server as things happen):
--   KillEnemy / KillBoss (Target = enemy type or "Any"), WinArena (Target =
--   arena id or "Any"), UpgradeBuilding (building id or "Any"), Worship
--   (god or "Any"), UpgradeBlessing, UseAbility (god or "Any"), CraftWeapon,
--   UpgradeWeapon, EarnGold (amount).
-- State objectives (checked from your save): ChooseGod, ReachLevel,
--   ReachRank, TempleTier.
-- Rewards: XP, Gold, DivineFavor, Ambrosia. Daily rewards grow with level.
-- All numbers are PLACEHOLDERS, balanced in Phase 8.

local QuestConfig = {}

local function q(id, name, description, objective, rewards, requires)
	return { Id = id, Name = name, Description = description, Objective = objective, Rewards = rewards, Requires = requires }
end

QuestConfig.Chains = {
	-- The main journey (story + ascension)
	{
		Id = "Main", Name = "The Path to Godhood", Category = "Story",
		Quests = {
			q("M01", "Arrival at Olympus", "Choose a god to worship in the Hall of the Gods.", { Type = "ChooseGod", Count = 1 }, { Gold = 100 }),
			q("M02", "A Humble Shrine", "Build the Gold Treasury at your temple.", { Type = "BuildingLevel", Target = "GoldTreasury", Count = 1 }, { Gold = 150, XP = 50 }),
			q("M03", "First Blood", "Defeat 5 enemies (the Practice Field is behind the plaza).", { Type = "KillEnemy", Target = "Any", Count = 5 }, { XP = 100, Gold = 100 }),
			q("M04", "Into the Pit", "Win the Mortal Training Pit at the Arena Gate.", { Type = "WinArena", Target = "MortalTrainingPit", Count = 1 }, { XP = 300, Gold = 250, DivineFavor = 20 }),
			q("M05", "Mortal No More", "Ascend to Warrior at the Ascension Chamber.", { Type = "ReachRank", Count = 2 }, { Gold = 500, Ambrosia = 1 }),
			q("M06", "Spartan Glory", "Win the Spartan Battleground.", { Type = "WinArena", Target = "SpartanBattleground", Count = 1 }, { XP = 1500, Gold = 1500, Ambrosia = 1 }),
			q("M07", "Champion of Olympus", "Ascend to Champion.", { Type = "ReachRank", Count = 3 }, { Gold = 3000, Ambrosia = 2 }),
			q("M08", "Into the Labyrinth", "Win the Labyrinth of Crete.", { Type = "WinArena", Target = "LabyrinthOfCrete", Count = 1 }, { XP = 6000, Gold = 6000, Ambrosia = 2 }),
			q("M09", "A Hero's Name", "Ascend to Hero.", { Type = "ReachRank", Count = 4 }, { Gold = 10000, Ambrosia = 3 }),
			q("M10", "Lifting the Curse", "Win the Cursed Temple.", { Type = "WinArena", Target = "CursedTemple", Count = 1 }, { XP = 20000, Gold = 20000, Ambrosia = 3 }),
			q("M11", "Divine Blood", "Ascend to Demigod.", { Type = "ReachRank", Count = 5 }, { Gold = 30000, Ambrosia = 5 }),
			q("M12", "Gates of the Dead", "Win the Gates of the Underworld.", { Type = "WinArena", Target = "GatesOfTheUnderworld", Count = 1 }, { XP = 60000, Gold = 50000, Ambrosia = 5 }),
			q("M13", "Among the Gods", "Ascend to Lesser God.", { Type = "ReachRank", Count = 6 }, { Gold = 80000, Ambrosia = 8 }),
			q("M14", "The Fall of Titans", "Win Titan's Colosseum.", { Type = "WinArena", Target = "TitansColosseum", Count = 1 }, { XP = 150000, Gold = 120000, Ambrosia = 10 }),
			q("M15", "Seat on Olympus", "Ascend to Olympian.", { Type = "ReachRank", Count = 7 }, { Gold = 200000, Ambrosia = 15 }),
			q("M16", "Elder God", "Ascend to Elder God.", { Type = "ReachRank", Count = 8 }, { Gold = 500000, Ambrosia = 30 }),
		},
	},
	{
		Id = "Combat", Name = "Warpath", Category = "Combat",
		Quests = {
			q("C1", "Blooded", "Defeat 25 enemies.", { Type = "KillEnemy", Target = "Any", Count = 25 }, { XP = 200, Gold = 200 }),
			q("C2", "Veteran", "Defeat 100 enemies.", { Type = "KillEnemy", Target = "Any", Count = 100 }, { XP = 2000, Gold = 1500 }),
			q("C3", "Slayer", "Defeat 500 enemies.", { Type = "KillEnemy", Target = "Any", Count = 500 }, { XP = 20000, Gold = 10000, Ambrosia = 2 }),
			q("C4", "Legend of War", "Defeat 2,000 enemies.", { Type = "KillEnemy", Target = "Any", Count = 2000 }, { XP = 100000, Gold = 60000, Ambrosia = 6 }),
		},
	},
	{
		Id = "Bosses", Name = "Monster Hunter", Category = "Boss",
		Quests = {
			q("B1", "The Champion Falls", "Defeat the Training Champion.", { Type = "KillBoss", Target = "TrainingChampion", Count = 1 }, { Gold = 400, Ambrosia = 1 }),
			q("B2", "Warlord of Sparta", "Defeat the Spartan Warlord.", { Type = "KillBoss", Target = "SpartanWarlord", Count = 1 }, { Gold = 2500, Ambrosia = 1 }),
			q("B3", "The Bull of Crete", "Defeat the Minotaur.", { Type = "KillBoss", Target = "Minotaur", Count = 1 }, { Gold = 8000, Ambrosia = 2 }),
			q("B4", "Stone Gaze", "Defeat Medusa.", { Type = "KillBoss", Target = "Medusa", Count = 1 }, { Gold = 20000, Ambrosia = 3 }),
			q("B5", "Hound of Hades", "Defeat Cerberus.", { Type = "KillBoss", Target = "Cerberus", Count = 1 }, { Gold = 50000, Ambrosia = 5 }),
			q("B6", "Kingslayer", "Defeat the Titan King.", { Type = "KillBoss", Target = "TitanKing", Count = 1 }, { Gold = 120000, Ambrosia = 10 }),
		},
	},
	{
		Id = "Temple", Name = "House of the Gods", Category = "Temple",
		Quests = {
			q("T1", "Builder", "Reach 5 total building levels at your temple.", { Type = "TotalBuildingLevels", Count = 5 }, { Gold = 500, DivineFavor = 10 }),
			q("T2", "Sacred Sanctuary", "Raise your temple to tier 2 with the Temple Core.", { Type = "TempleTier", Count = 2 }, { Gold = 1500, DivineFavor = 20 }),
			q("T3", "Temple of Devotion", "Raise your temple to tier 3.", { Type = "TempleTier", Count = 3 }, { Gold = 8000, DivineFavor = 50, Ambrosia = 1 }),
			q("T4", "Master Builder", "Reach 15 total building levels at your temple.", { Type = "TotalBuildingLevels", Count = 15 }, { Gold = 20000, DivineFavor = 80 }),
			q("T5", "Blessed Temple", "Raise your temple to tier 4.", { Type = "TempleTier", Count = 4 }, { Gold = 40000, DivineFavor = 150, Ambrosia = 2 }),
			q("T6", "Grand Pantheon", "Raise your temple to tier 5.", { Type = "TempleTier", Count = 5 }, { Gold = 150000, DivineFavor = 300, Ambrosia = 4 }),
			q("T7", "Celestial Palace", "Raise your temple to tier 6.", { Type = "TempleTier", Count = 6 }, { Gold = 500000, DivineFavor = 600, Ambrosia = 8 }),
			q("T8", "Divine Citadel", "Raise your temple to tier 7, the Divine Citadel (Elder God).", { Type = "TempleTier", Count = 7 }, { Gold = 1500000, DivineFavor = 1000, Ambrosia = 12 }),
			q("T9", "Prestigious", "Reach Temple Prestige 1.", { Type = "TemplePrestige", Count = 1 }, { DivineFavor = 1500, Ambrosia = 10 }),
			q("T10", "Wonder of Olympus", "Reach Temple Prestige 5.", { Type = "TemplePrestige", Count = 5 }, { DivineFavor = 4000, Ambrosia = 25 }),
			q("T11", "Radiant Citadel", "Reach Temple Prestige 10.", { Type = "TemplePrestige", Count = 10 }, { DivineFavor = 10000, Ambrosia = 60 }),
		},
	},
	{
		Id = "Worship", Name = "Devotion", Category = "Worship",
		Quests = {
			q("W1", "First Prayer", "Worship your god 5 times in the Hall of the Gods.", { Type = "Worship", Target = "Any", Count = 5 }, { DivineFavor = 30, Gold = 100 }),
			q("W2", "Blessed", "Upgrade a blessing in the Hall of the Gods.", { Type = "BlessingLevels", Count = 1 }, { DivineFavor = 40 }),
			q("W3", "Faithful", "Worship 25 times.", { Type = "Worship", Target = "Any", Count = 25 }, { DivineFavor = 150, Gold = 1000 }),
			q("W4", "Chosen", "Reach 5 total blessing levels.", { Type = "BlessingLevels", Count = 5 }, { DivineFavor = 300, Ambrosia = 1 }),
			q("W5", "Devoted for Life", "Worship 100 times.", { Type = "Worship", Target = "Any", Count = 100 }, { DivineFavor = 800, Ambrosia = 3 }),
		},
	},
	{
		Id = "Forge", Name = "Smith of the Gods", Category = "Forge",
		Quests = {
			q("F1", "Fresh Steel", "Own 2 weapons (craft one at the Divine Forge).", { Type = "OwnWeapons", Count = 2 }, { Gold = 300 }),
			q("F2", "Sharpened", "Upgrade weapons 5 times.", { Type = "UpgradeWeapon", Target = "Any", Count = 5 }, { Gold = 3000 }),
			q("F3", "Armory", "Own 5 weapons (craft them or win them from bosses).", { Type = "OwnWeapons", Count = 5 }, { Gold = 15000, Ambrosia = 2 }),
			q("F4", "Master Smith", "Upgrade weapons 25 times.", { Type = "UpgradeWeapon", Target = "Any", Count = 25 }, { Gold = 80000, Ambrosia = 5 }),
		},
	},
}

-- Phase 7E: Olympian Challenges at the Titan Gate.
table.insert(QuestConfig.Chains, {
	Id = "Challenges", Name = "Olympian Trials", Category = "Challenge",
	Quests = {
		q("X1", "Through the Titan Gate", "Win any Olympian Challenge at the Titan Gate.", { Type = "WinChallenge", Target = "Any", Count = 1 }, { Gold = 5000, Ambrosia = 2 }),
		q("X2", "Relentless", "Win 10 Olympian Challenges.", { Type = "WinChallenge", Target = "Any", Count = 10 }, { Gold = 40000, Ambrosia = 5 }),
		q("X3", "Run the Gauntlet", "Win the Olympian Gauntlet.", { Type = "WinChallenge", Target = "OlympianGauntlet", Count = 1 }, { Gold = 150000, Ambrosia = 15 }),
	},
})

-- Phase 7E part 3: Divine Mastery and Incarnation.
table.insert(QuestConfig.Chains, {
	Id = "Mastery", Name = "Divine Mastery", Category = "Mastery",
	Quests = {
		q("DM1", "Student of the Gods", "Reach mastery level 5 with your god.", { Type = "MasteryLevel", Count = 5 }, { DivineFavor = 100, Gold = 2000 }),
		q("DM2", "Adept", "Reach mastery level 10 with your god.", { Type = "MasteryLevel", Count = 10 }, { DivineFavor = 300, Ambrosia = 2 }),
		q("DM3", "Become the God", "Incarnate for the first time (Elder God).", { Type = "Incarnate", Target = "Any", Count = 1 }, { DivineFavor = 500, Ambrosia = 5 }),
		q("DM4", "Master", "Reach mastery level 25 with your god.", { Type = "MasteryLevel", Count = 25 }, { DivineFavor = 1500, Ambrosia = 8 }),
		q("DM5", "Chosen", "Reach mastery level 50 with your god.", { Type = "MasteryLevel", Count = 50 }, { DivineFavor = 6000, Ambrosia = 30 }),
	},
})

-- God quests: one small chain per god, only while you worship that god.
local GOD_IDS = { "Zeus", "Poseidon", "Hades", "Ares", "Athena", "Apollo" }
for _, god in GOD_IDS do
	table.insert(QuestConfig.Chains, {
		Id = "God_" .. god, Name = "Divine Tasks of " .. god, Category = "God", God = god,
		Quests = {
			q("G_" .. god .. "_1", "Devotion to " .. god, "Worship " .. god .. " 10 times.", { Type = "Worship", Target = god, Count = 10 }, { DivineFavor = 100, Gold = 500 }),
			q("G_" .. god .. "_2", "Power of " .. god, "Use " .. god .. "'s abilities 30 times.", { Type = "UseAbility", Target = god, Count = 30 }, { DivineFavor = 250, Gold = 2000, Ambrosia = 1 }),
			q("G_" .. god .. "_3", "Champion of " .. god, "Use " .. god .. "'s abilities 200 times.", { Type = "UseAbility", Target = god, Count = 200 }, { DivineFavor = 1000, Gold = 20000, Ambrosia = 4 }),
		},
	})
end

-- Daily pool: 3 are picked each day. Rewards are multiplied by (1 + level / 20).
QuestConfig.DailyCount = 3
QuestConfig.Daily = {
	q("D_Kill", "Daily: Cull the Monsters", "Defeat 30 enemies.", { Type = "KillEnemy", Target = "Any", Count = 30 }, { XP = 300, Gold = 300 }),
	q("D_Arena", "Daily: Arena Victory", "Win any arena.", { Type = "WinArena", Target = "Any", Count = 1 }, { XP = 500, Gold = 400, Ambrosia = 1 }),
	q("D_Worship", "Daily: Prayers", "Worship 5 times.", { Type = "Worship", Target = "Any", Count = 5 }, { DivineFavor = 60, Gold = 150 }),
	q("D_Build", "Daily: Builder", "Make a temple upgrade.", { Type = "UpgradeBuilding", Target = "Any", Count = 1 }, { Gold = 400, DivineFavor = 20 }),
	q("D_Ability", "Daily: Divine Power", "Use god abilities 20 times.", { Type = "UseAbility", Target = "Any", Count = 20 }, { XP = 300, DivineFavor = 40 }),
	q("D_Gold", "Daily: Treasury", "Earn 5,000 Gold.", { Type = "EarnGold", Count = 5000 }, { XP = 250, DivineFavor = 30 }),
	q("D_Boss", "Daily: Giant Slayer", "Defeat any boss.", { Type = "KillBoss", Target = "Any", Count = 1 }, { XP = 600, Gold = 500, Ambrosia = 1 }),
	q("D_Forge", "Daily: At the Anvil", "Upgrade a weapon.", { Type = "UpgradeWeapon", Target = "Any", Count = 1 }, { Gold = 500 }),
}

-- Lookups
QuestConfig.ById = {}
for _, chain in QuestConfig.Chains do
	for index, quest in chain.Quests do
		quest.Chain = chain
		quest.Index = index
		quest.Category = chain.Category
		QuestConfig.ById[quest.Id] = quest
	end
end
for _, quest in QuestConfig.Daily do
	quest.Category = "Daily"
	quest.IsDaily = true
	QuestConfig.ById[quest.Id] = quest
end

-- Objectives that are checked from the save instead of counted.
QuestConfig.StateObjectives = {
	ChooseGod = true, ReachLevel = true, ReachRank = true, TempleTier = true,
	BuildingLevel = true, TotalBuildingLevels = true, BlessingLevels = true, OwnWeapons = true, TemplePrestige = true, MasteryLevel = true,
}

return QuestConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">RankOutfits</string>
          <string name="Source"><![CDATA[-- RankOutfits (ModuleScript)
-- Location: ReplicatedStorage > Shared > RankOutfits
--
-- Builds the rank outfit out of parts and welds it OVER the player's own
-- avatar (their look is kept). Each rank adds pieces; materials improve:
-- leather (Warrior) -> bronze (Champion, Hero) -> steel (Demigod) -> gold.
-- Pieces are sized from the body part they sit on, so they fit any avatar.
-- RankOutfits.Apply(character, rankIndex, godColor) replaces any old outfit.

local AscensionConfig = require(script.Parent:WaitForChild("AscensionConfig"))

local RankOutfits = {}

RankOutfits.Name = "RankOutfit"

local LEATHER = { Color3.fromRGB(110, 72, 40), Enum.Material.Leather }
local BRONZE = { Color3.fromRGB(176, 112, 56), Enum.Material.Metal }
local STEEL = { Color3.fromRGB(200, 205, 215), Enum.Material.Metal }
local GOLD = { Color3.fromRGB(226, 186, 72), Enum.Material.Metal }
local HERO_RED = Color3.fromRGB(165, 30, 35)

local function armour(rank)
	if rank >= 6 then
		return GOLD
	elseif rank >= 5 then
		return STEEL
	elseif rank >= 3 then
		return BRONZE
	end
	return LEATHER
end

local function piece(model, bodyPart, name, size, offset, look, props)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = look[1]
	p.Material = look[2]
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props or {} do
		p[key] = value
	end
	p.CFrame = bodyPart.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = bodyPart
	weld.Part1 = p
	weld.Parent = p
	p.Parent = model
	return p
end

function RankOutfits.Apply(character, rank, godColor)
	local old = character:FindFirstChild(RankOutfits.Name)
	if old then
		old:Destroy()
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	local oldAura = root and root:FindFirstChild("RankAura")
	if oldAura then
		oldAura:Destroy()
	end
	if rank < 2 then
		return nil
	end

	local model = Instance.new("Model")
	model.Name = RankOutfits.Name
	local metal = armour(rank)
	local trim = if rank >= 5 then GOLD else metal
	local glow = { godColor, Enum.Material.Neon }
	local function part(name)
		return character:FindFirstChild(name)
	end

	-- Warrior: shoulder pads, bracers, belt
	for _, side in { "Left", "Right" } do
		local upper = part(side .. "UpperArm")
		if upper then
			local s = upper.Size
			piece(model, upper, side .. "ShoulderPad", Vector3.new(s.X * 1.45, 0.32, s.Z * 1.4), CFrame.new(0, s.Y / 2 - 0.08, 0), metal)
			if rank >= 5 then
				piece(model, upper, side .. "ShoulderTrim", Vector3.new(s.X * 1.5, 0.1, s.Z * 1.45), CFrame.new(0, s.Y / 2 - 0.26, 0), trim)
			end
		end
		local lower = part(side .. "LowerArm")
		if lower then
			local s = lower.Size
			piece(model, lower, side .. "Bracer", Vector3.new(s.X * 1.2, s.Y * 0.55, s.Z * 1.2), CFrame.new(0, -s.Y * 0.12, 0), metal)
		end
	end
	local lowerTorso = part("LowerTorso")
	if lowerTorso then
		local s = lowerTorso.Size
		piece(model, lowerTorso, "Belt", Vector3.new(s.X * 1.08, s.Y * 0.38, s.Z * 1.12), CFrame.new(0, s.Y * 0.12, 0), if rank >= 5 then GOLD else LEATHER)
		piece(model, lowerTorso, "Buckle", Vector3.new(s.X * 0.22, s.Y * 0.3, 0.1), CFrame.new(0, s.Y * 0.12, -s.Z * 0.56 - 0.03), trim)
	end

	-- Champion: chest plate, greaves
	local upperTorso = part("UpperTorso")
	if rank >= 3 then
		if upperTorso then
			local s = upperTorso.Size
			piece(model, upperTorso, "ChestPlate", Vector3.new(s.X * 1.06, s.Y * 0.82, s.Z * 1.16), CFrame.new(0, s.Y * 0.04, 0), metal)
			piece(model, upperTorso, "ChestRidge", Vector3.new(s.X * 0.12, s.Y * 0.7, 0.08), CFrame.new(0, s.Y * 0.04, -s.Z * 0.58 - 0.02), trim)
		end
		for _, side in { "Left", "Right" } do
			local leg = part(side .. "LowerLeg")
			if leg then
				local s = leg.Size
				piece(model, leg, side .. "Greave", Vector3.new(s.X * 1.18, s.Y * 0.72, s.Z * 1.18), CFrame.new(0, s.Y * 0.06, 0), metal)
			end
		end
	end

	-- Hero: cape (red, then the god's colour from Lesser God)
	if rank >= 4 and upperTorso then
		local s = upperTorso.Size
		local length = s.Y * 2.3
		piece(model, upperTorso, "Cape", Vector3.new(s.X * 0.95, length, 0.1),
			CFrame.new(0, s.Y / 2 - length / 2 + 0.05, s.Z / 2 + 0.12) * CFrame.Angles(math.rad(-6), 0, 0),
			{ if rank >= 6 then godColor else HERO_RED, Enum.Material.Fabric })
	end

	-- Demigod: glowing chest gem
	if rank >= 5 and upperTorso then
		local s = upperTorso.Size
		piece(model, upperTorso, "ChestGem", Vector3.new(0.38, 0.38, 0.38), CFrame.new(0, s.Y * 0.18, -s.Z * 0.58 - 0.08), glow, { Shape = Enum.PartType.Ball })
	end

	-- Lesser God: laurel wreath
	local head = part("Head")
	if rank >= 6 and head then
		local s = head.Size
		local radius = math.max(s.X, s.Z) * 0.55
		for i = 0, 11 do
			local angle = (i / 12) * math.pi * 2
			if i ~= 0 and i ~= 11 then -- gap at the front
				piece(model, head, "Leaf" .. i, Vector3.new(0.12, 0.16, 0.42),
					CFrame.new(math.sin(angle) * radius, s.Y * 0.22, -math.cos(angle) * radius) * CFrame.Angles(0, -angle, math.rad(25)),
					{ Color3.fromRGB(200, 170, 60), Enum.Material.Metal })
			end
		end
	end

	-- Olympian: wings of light, three fanned feathers per side
	if rank >= 7 and upperTorso then
		local s = upperTorso.Size
		for _, side in { -1, 1 } do
			for i = 0, 2 do
				local length = s.Y * (1.25 - i * 0.25)
				local angle = 25 + i * 22 -- tilt outwards from straight up
				local base = CFrame.new(side * s.X * 0.18, s.Y * 0.28, s.Z / 2 + 0.18)
				piece(model, upperTorso, ("Wing%s%d"):format(if side < 0 then "L" else "R", i),
					Vector3.new(s.X * 0.32, length, 0.06),
					base * CFrame.Angles(math.rad(-18), 0, math.rad(-side * angle)) * CFrame.new(0, length / 2, 0),
					glow, { Transparency = 0.3 })
			end
		end
	end

	-- Elder God: halo
	if rank >= 8 and head then
		local s = head.Size
		local radius = math.max(s.X, s.Z) * 0.5
		for i = 0, 15 do
			local angle = (i / 16) * math.pi * 2
			piece(model, head, "Halo" .. i, Vector3.new(0.12, 0.08, radius * 0.42),
				CFrame.new(math.sin(angle) * radius, s.Y / 2 + 0.55, -math.cos(angle) * radius) * CFrame.Angles(0, -angle + math.pi / 2, 0),
				{ Color3.fromRGB(255, 236, 160), Enum.Material.Neon })
		end
	end

	model.Parent = character

	-- Aura from Demigod upwards
	local rate = AscensionConfig.AuraRate[rank]
	if rate and root then
		local attachment = Instance.new("Attachment")
		attachment.Name = "RankAura"
		attachment.Parent = root
		local emitter = Instance.new("ParticleEmitter")
		emitter.Color = ColorSequence.new(godColor)
		emitter.LightEmission = 1
		emitter.Rate = rate
		emitter.Lifetime = NumberRange.new(0.8, 1.4)
		emitter.Speed = NumberRange.new(1, 2.5)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Acceleration = Vector3.new(0, 3, 0)
		emitter.Size = NumberSequence.new(0.35, 0)
		emitter.Parent = attachment
	end
	return model
end

return RankOutfits
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Sfx</string>
          <string name="Source"><![CDATA[-- Sfx (ModuleScript)
-- Location: ReplicatedStorage > Shared > Sfx
--
-- Phase 8: plays sound effects on the client (names from SoundConfig.Effects).
--   Sfx.Play(name)                 -> a 2D sound (UI, your own actions)
--   Sfx.Play(name, position)       -> a 3D sound in the world at `position`
--   Sfx.Play(name, nil, volumeScale)
-- Respects the player's "SfxVolume" attribute and limits how many sounds
-- play at once so big fights stay pleasant.

local Players = game:GetService("Players")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")

local SoundConfig = require(script.Parent:WaitForChild("SoundConfig"))

local Sfx = {}

local MAX_PER_WINDOW = 10
local WINDOW = 0.25
local recent = {}
local random = Random.new()
local templates = {}

local function template(name)
	local cfg = SoundConfig.Effects[name]
	if not cfg then
		return nil
	end
	local sound = templates[name]
	if not sound then
		sound = Instance.new("Sound")
		sound.Name = "Sfx_" .. name
		sound.SoundId = cfg.Id
		sound.Volume = cfg.Volume
		sound.RollOffMinDistance = 12
		sound.RollOffMaxDistance = 180
		templates[name] = sound
	end
	return sound, cfg
end

local function allowed()
	local now = os.clock()
	local i = 1
	while i <= #recent do
		if now - recent[i] > WINDOW then
			table.remove(recent, i)
		else
			i += 1
		end
	end
	if #recent >= MAX_PER_WINDOW then
		return false
	end
	table.insert(recent, now)
	return true
end

function Sfx.Play(name, position, volumeScale)
	local player = Players.LocalPlayer
	local setting = player and player:GetAttribute("SfxVolume")
	local master = if type(setting) == "number" then setting else 0.8
	if master <= 0 or not allowed() then
		return
	end
	local base, cfg = template(name)
	if not base then
		return
	end
	local sound = base:Clone()
	sound.Volume = cfg.Volume * master * (volumeScale or 1) * 1.25
	local pitch = cfg.Pitch
	if type(pitch) == "table" then
		sound.PlaybackSpeed = random:NextNumber(pitch[1], pitch[2])
	elseif type(pitch) == "number" then
		sound.PlaybackSpeed = pitch
	end
	if typeof(position) == "Vector3" then
		local attachment = Instance.new("Attachment")
		attachment.Name = "SfxPoint"
		attachment.WorldPosition = position
		attachment.Parent = Workspace.Terrain
		sound.Parent = attachment
		sound:Play()
		Debris:AddItem(attachment, 8)
	else
		sound.Parent = SoundService
		sound:Play()
		Debris:AddItem(sound, 8)
	end
end

-- Makes sure the sounds are downloaded early (call once on the client).
function Sfx.Preload()
	local ContentProvider = game:GetService("ContentProvider")
	local list = {}
	for name in SoundConfig.Effects do
		local sound = template(name)
		if sound then
			table.insert(list, sound)
		end
	end
	task.spawn(function()
		pcall(function()
			ContentProvider:PreloadAsync(list)
		end)
	end)
end

return Sfx
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">SoundConfig</string>
          <string name="Source"><![CDATA[-- SoundConfig (ModuleScript)
-- Location: ReplicatedStorage > Shared > SoundConfig
--
-- Phase 8: music and sound effects. All tracks are from Roblox's licensed
-- libraries (APM Music, DistroKid, ProSoundEffects, Roblox UI sounds), which
-- any experience may use. To change a sound, replace its id.

local SoundConfig = {}

local function id(n)
	return "rbxassetid://" .. n
end

-- Music playlists (shuffled, crossfaded). Volume is multiplied by the
-- player's Music setting.
SoundConfig.Music = {
	-- Ethereal, floating: the plaza, temples and practice field.
	Olympus = {
		Volume = 0.35,
		Tracks = {
			id(9043657051),      -- Star Chasing (Underscore): soaring ethereal strings and bells
			id(1837463526),      -- Ethereal Drone: celestial ambient synth textures
			id(9043678446),      -- Arcturus (Underscore): swirling, graceful
			id(111151323492777), -- Floating Through Silence
			id(106135664783553), -- Clouds Unfurl
		},
	},
	-- Arena waves.
	Battle = {
		Volume = 0.4,
		Tracks = {
			id(122783941148304), -- Heroic Orchestral Battle Music
			id(1842337366),      -- Might of Arms
			id(1842960322),      -- Shoulders Of Giants
		},
	},
	-- When a boss is on the field.
	Boss = {
		Volume = 0.45,
		Tracks = {
			id(128007000574959), -- Epic Boss Battle
			id(80766740746561),  -- Rise of Vaurinox (epic boss battle film score)
			id(76918130388475),  -- Last Stand
		},
	},
}

-- Soft wind on the mountain top (looped under the Olympus music).
SoundConfig.Ambience = { Id = id(9114057128), Volume = 0.12 } -- Desert Wind, light gusts

-- Sound effects. Volume is multiplied by the player's Effects setting.
-- Pitch can be a number or { min, max } for variety.
SoundConfig.Effects = {
	Swing = { Id = id(9126229255), Volume = 0.45, Pitch = { 0.95, 1.15 } },  -- fast airy whoosh
	HeavySwing = { Id = id(9120972321), Volume = 0.5, Pitch = { 0.8, 0.9 } }, -- slicing air
	Hit = { Id = id(9113530386), Volume = 0.45, Pitch = { 0.9, 1.1 } },       -- body impact
	Crit = { Id = id(9125672726), Volume = 0.5, Pitch = { 1.0, 1.1 } },       -- metal impact
	Block = { Id = id(9119072660), Volume = 0.55, Pitch = { 0.95, 1.05 } },   -- shield clang
	Hurt = { Id = id(9119072674), Volume = 0.35, Pitch = { 0.7, 0.8 } },
	Dash = { Id = id(9125807267), Volume = 0.4, Pitch = { 1.0, 1.1 } },       -- rising whoosh
	Arrow = { Id = id(9113166206), Volume = 0.45 },
	Death = { Id = id(9113470802), Volume = 0.45 },                           -- heavy body fall
	Thunder = { Id = id(9120016256), Volume = 0.5 },
	Fire = { Id = id(9117985933), Volume = 0.5 },
	Slam = { Id = id(9118588626), Volume = 0.55, Pitch = { 0.8, 0.9 } },
	Magic = { Id = id(9116394545), Volume = 0.5 },                            -- soft chiming magic
	Heal = { Id = id(9116395089), Volume = 0.5 },
	Water = { Id = id(9125703162), Volume = 0.5 },
	Whoosh = { Id = id(9126228631), Volume = 0.45 },
	Chimes = { Id = id(9119447936), Volume = 0.5 },                           -- level up / quest
	Coins = { Id = id(9113849492), Volume = 0.45 },
	Gong = { Id = id(9114630316), Volume = 0.5 },                             -- arena waves, boss
	Roar = { Id = id(9113980319), Volume = 0.6, Pitch = { 0.8, 0.9 } },       -- boss appears
	Click = { Id = id(15675059323), Volume = 0.4 },                           -- UI buttons
	UIWhoosh = { Id = id(15674975792), Volume = 0.3 },                        -- menus opening
}

return SoundConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">SwordAnimator</string>
          <string name="Source"><![CDATA[-- SwordAnimator (ModuleScript, used by the client only)
-- Location: ReplicatedStorage > Shared > SwordAnimator
--
-- Plays our own sword animations (SwordPoses) on R15 joints every frame.
-- Roblox's Animator owns each joint's Transform (walk, idle...), so writing
-- there loses the race. Instead we move the joint's own offset, which the
-- Animator never touches, and cancel the Animator's current Transform on the
-- joints we drive. That keeps the sword arm steady and the swings visible.
-- Two joint types are supported:
--   * Motor6D (classic joints): we change C0.
--   * AnimationConstraint (Roblox's newer avatar joints): we change the CFrame
--     of its Attachment0, which plays the same role as C0.
-- (The game sets StarterPlayer.AvatarJointUpgrade = Disabled so characters
-- normally use Motor6D; the second path is a safety net.)
-- It runs on every player's device for every nearby sword-holder: you,
-- other players (when the server tells us they swung) and enemies.
--   * Holding a weapon: the ready stance (right arm only, legs still walk).
--   * Blocking (player attribute "Blocking"): the guard pose.
--   * Attacks: SwordAnimator.Play(model, "Slash1" | "Slash2" | "Lunge")
--   * Enemy attacks: SwordAnimator.PlayKeys(model, SwordPoses.EnemyAttack(windup))

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Poses = require(script.Parent:WaitForChild("SwordPoses"))

local SwordAnimator = {}

local JOINT_PARTS = {
	RightShoulder = "RightUpperArm",
	RightElbow = "RightLowerArm",
	RightWrist = "RightHand",
	LeftShoulder = "LeftUpperArm",
	LeftElbow = "LeftLowerArm",
	Waist = "UpperTorso",
}
local MAX_DISTANCE = 150 -- don't bother animating far-away characters
local BLEND_SPEED = 18   -- how fast the stance changes (hold <-> block)

local active = setmetatable({}, { __mode = "k" })  -- [Model] = { Keys, Start, Duration, Joints }
local current = setmetatable({}, { __mode = "k" }) -- [Model] = { [joint] = CFrame currently applied }
local motorCache = setmetatable({}, { __mode = "k" })
local baseC0 = setmetatable({}, { __mode = "k" }) -- [joint] = its original C0 / Attachment0 CFrame
local RETRY_MISSING = 2 -- seconds before looking again for a joint that wasn't found

-- Numbers for the diagnostics report.
local debugInfo = { Frames = 0, Updates = 0, JointsSet = 0, Errors = 0, LastError = "", MissingJoints = {}, JointKinds = {} }

-- Pose a joint: offset * pose * Transform^-1 * Transform = offset * pose,
-- whatever the Animator writes into Transform.
local function setJoint(joint, pose)
	if joint:IsA("Motor6D") then
		local base = baseC0[joint]
		if not base then
			base = joint.C0
			baseC0[joint] = base
		end
		joint.C0 = base * pose * joint.Transform:Inverse()
	else -- AnimationConstraint
		local attachment = joint.Attachment0
		if not attachment then
			return
		end
		local base = baseC0[joint]
		if not base then
			base = attachment.CFrame
			baseC0[joint] = base
		end
		attachment.CFrame = base * pose * joint.Transform:Inverse()
	end
end

local function releaseJoint(joint)
	local base = baseC0[joint]
	if not base then
		return
	end
	if joint:IsA("Motor6D") then
		joint.C0 = base
	elseif joint.Attachment0 then
		joint.Attachment0.CFrame = base
	end
	baseC0[joint] = nil
end

local function toCFrame(e)
	return CFrame.Angles(math.rad(e[1]), math.rad(e[2]), math.rad(e[3]))
end

local function getMotor(model, joint)
	local cache = motorCache[model]
	if not cache then
		cache = {}
		motorCache[model] = cache
	end
	local found = cache[joint]
	if typeof(found) == "Instance" and found.Parent then
		return found
	end
	if typeof(found) == "number" and os.clock() < found then
		return nil -- looked recently and it wasn't there
	end
	-- Usual place first, then anywhere in the model.
	local part = model:FindFirstChild(JOINT_PARTS[joint])
	local candidate = part and part:FindFirstChild(joint)
	if not (candidate and (candidate:IsA("Motor6D") or candidate:IsA("AnimationConstraint"))) then
		candidate = nil
		for _, d in model:GetDescendants() do
			if d.Name == joint and (d:IsA("Motor6D") or d:IsA("AnimationConstraint")) then
				candidate = d
				break
			end
		end
	end
	if candidate then
		cache[joint] = candidate
		debugInfo.JointKinds[candidate.ClassName] = true
		return candidate
	end
	cache[joint] = os.clock() + RETRY_MISSING
	debugInfo.MissingJoints[model.Name .. "." .. joint] = true
	return nil
end

local function jointsIn(keys)
	local set = {}
	for _, key in keys do
		for joint in key[2] do
			set[joint] = true
		end
	end
	return set
end

local function smooth(alpha)
	return alpha * alpha * (3 - 2 * alpha)
end

-- Pose at time t within a list of keyframes: { [joint] = CFrame }
local function sample(move, t)
	local keys = move.Keys
	local i = 1
	while i < #keys and keys[i + 1][1] < t do
		i += 1
	end
	local a, b = keys[i], keys[math.min(i + 1, #keys)]
	local span = b[1] - a[1]
	local alpha = if span > 0 then smooth(math.clamp((t - a[1]) / span, 0, 1)) else 1
	local pose = {}
	for joint in move.Joints do
		local from = a[2][joint] or { 0, 0, 0 }
		local to = b[2][joint] or { 0, 0, 0 }
		pose[joint] = toCFrame(from):Lerp(toCFrame(to), alpha)
	end
	return pose
end

local function stance(pose)
	local result = {}
	for joint, e in pose do
		result[joint] = toCFrame(e)
	end
	return result
end
local HOLD = stance(Poses.Hold)
local BLOCK = stance(Poses.Block)

local function apply(model, target, dt, instant)
	local cur = current[model]
	if not cur then
		cur = {}
		current[model] = cur
	end
	local alpha = if instant then 1 else math.min(1, dt * BLEND_SPEED)
	-- Joints we drove last frame but not now: blend back to neutral, then let go.
	for joint in cur do
		if not target[joint] then
			-- No longer ours: hand the joint back to Roblox's animations.
			local motor = getMotor(model, joint)
			if motor then
				releaseJoint(motor)
			end
			cur[joint] = nil
		end
	end
	for joint, cf in target do
		local motor = getMotor(model, joint)
		if motor then
			local blended = if cur[joint] then cur[joint]:Lerp(cf, alpha) else cf
			setJoint(motor, blended)
			debugInfo.JointsSet += 1
			cur[joint] = blended
		end
	end
end

local function holdsWeapon(model)
	return model:FindFirstChild("DivineSword") ~= nil or model:FindFirstChild("Weapon") ~= nil
end

local function step(dt)
	local camera = Workspace.CurrentCamera
	local camPos = if camera then camera.CFrame.Position else Vector3.zero
	local now = os.clock()
	debugInfo.Frames += 1

	local function update(model, blocking)
		debugInfo.Updates += 1
		local root = model:FindFirstChild("HumanoidRootPart")
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if not root or not humanoid or humanoid.Health <= 0 or not holdsWeapon(model) then
			return
		end
		if (root.Position - camPos).Magnitude > MAX_DISTANCE then
			return
		end
		local move = active[model]
		if move then
			local t = now - move.Start
			if t < move.Duration then
				apply(model, sample(move, t), dt, true)
				return
			end
			active[model] = nil
		end
		apply(model, if blocking then BLOCK else HOLD, dt, false)
	end

	local function safeUpdate(model, blocking)
		local ok, err = pcall(update, model, blocking)
		if not ok then
			debugInfo.Errors += 1
			debugInfo.LastError = tostring(err)
		end
	end

	for _, player in Players:GetPlayers() do
		local character = player.Character
		if character then
			safeUpdate(character, player:GetAttribute("Blocking") == true)
		end
	end
	local enemies = Workspace:FindFirstChild("Enemies")
	if enemies then
		for _, model in enemies:GetChildren() do
			safeUpdate(model, false)
		end
	end
end

-- For the diagnostics report: counters, plus a look at the local character's arm joint.
function SwordAnimator.GetDebugInfo()
	local info = table.clone(debugInfo)
	local missing = {}
	for name in debugInfo.MissingJoints do
		table.insert(missing, name)
	end
	info.MissingJoints = table.concat(missing, ",")
	local kinds = {}
	for name in debugInfo.JointKinds do
		table.insert(kinds, name)
	end
	info.JointKinds = table.concat(kinds, ",")
	local character = Players.LocalPlayer and Players.LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	info.RigType = humanoid and humanoid.RigType.Name or "?"
	local joint = character and getMotor(character, "RightShoulder")
	if joint then
		info.ShoulderJointType = joint.ClassName
		info.ShoulderPosed = baseC0[joint] ~= nil
		local x, y, z = joint.Transform:ToEulerAnglesXYZ()
		info.ShoulderTransformDeg = ("%d,%d,%d"):format(math.deg(x), math.deg(y), math.deg(z))
	end
	local joints = {}
	if character then
		for _, d in character:GetDescendants() do
			if d:IsA("Motor6D") or d:IsA("AnimationConstraint") then
				table.insert(joints, d.ClassName .. ":" .. d.Name)
			end
		end
	end
	info.CharacterJoints = table.concat(joints, ",")
	return info
end

-- Plays a keyframe list on a character or enemy.
function SwordAnimator.PlayKeys(model, keys)
	if not model or #keys < 2 then
		return
	end
	active[model] = {
		Keys = keys,
		Start = os.clock(),
		Duration = keys[#keys][1],
		Joints = jointsIn(keys),
	}
end

-- Plays one of the named moves in SwordPoses.Moves.
function SwordAnimator.Play(model, moveName)
	local keys = Poses.Moves[moveName]
	if keys then
		SwordAnimator.PlayKeys(model, keys)
	end
end

-- Right before each frame is drawn, using that frame's animation values.
RunService.PreRender:Connect(step)

return SwordAnimator
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">SwordBuilder</string>
          <string name="Source"><![CDATA[-- SwordBuilder (ModuleScript)
-- Location: ReplicatedStorage > Shared > SwordBuilder
--
-- Builds the placeholder "Divine Sword" out of parts and welds it into a
-- character's right hand. The blade's glowing core, the guard gems and the
-- swing trail use the player's god colour. Real weapons come in Phase 7.
--
-- Sword space: the grip is at the origin and the blade points along +Y.
-- In the hand, the blade points the way the knuckles face, so with the arm
-- hanging down it points forward, and with the forearm forward it points up.

local SwordBuilder = {}

SwordBuilder.Name = "DivineSword"

local GOLD = Color3.fromRGB(212, 175, 55)
local STEEL = Color3.fromRGB(214, 220, 230)
local LEATHER = Color3.fromRGB(100, 62, 38)

local function part(model, name, size, cframe, color, material, shape)
	local p = Instance.new("Part")
	p.Name = name
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

-- Phase 7C: `weapon` (a WeaponConfig entry) picks the type and colours.
-- Without it you get the original sword. The model's name stays
-- "DivineSword" so the animation and trail code work for every weapon.
function SwordBuilder.Build(glowColor, weapon)
	local model = Instance.new("Model")
	model.Name = SwordBuilder.Name
	model:SetAttribute("WeaponId", if weapon then weapon.Id else "")
	local M = Enum.Material
	local look = if weapon then weapon.Look or {} else {}
	local kind = if weapon then weapon.Type else "Sword"
	local metal = look.Blade or STEEL
	local handleColor = look.Handle or Color3.fromRGB(110, 75, 45)
	local glow = look.Glow or glowColor
	local L = look.Length or 3.0

	local grip = part(model, "Grip", Vector3.new(0.24, 1.0, 0.24), CFrame.new(), if kind == "Sword" then LEATHER else handleColor, if kind == "Sword" then M.Fabric else M.Wood)
	local blade

	if kind == "Sword" then
		part(model, "Pommel", Vector3.new(0.42, 0.42, 0.42), CFrame.new(0, -0.62, 0), GOLD, M.Metal, Enum.PartType.Ball)
		part(model, "Guard", Vector3.new(1.5, 0.2, 0.32), CFrame.new(0, 0.6, 0), GOLD, M.Metal)
		part(model, "GuardEndL", Vector3.new(0.3, 0.3, 0.3), CFrame.new(-0.75, 0.6, 0), GOLD, M.Metal, Enum.PartType.Ball)
		part(model, "GuardEndR", Vector3.new(0.3, 0.3, 0.3), CFrame.new(0.75, 0.6, 0), GOLD, M.Metal, Enum.PartType.Ball)
		part(model, "Gem", Vector3.new(0.26, 0.26, 0.4), CFrame.new(0, 0.6, 0), glow, M.Neon, Enum.PartType.Ball)
		blade = part(model, "Blade", Vector3.new(0.4, L, 0.09), CFrame.new(0, 0.7 + L / 2, 0), metal, M.Metal)
		part(model, "Fuller", Vector3.new(0.1, L - 0.5, 0.12), CFrame.new(0, 0.55 + L / 2, 0), glow, M.Neon)
		-- A small diamond turned 45 degrees makes the point of the blade.
		part(model, "Tip", Vector3.new(0.283, 0.283, 0.09), CFrame.new(0, 0.7 + L, 0) * CFrame.Angles(0, 0, math.rad(45)), metal, M.Metal)
	elseif kind == "Axe" then
		part(model, "Haft", Vector3.new(0.22, L, 0.22), CFrame.new(0, L / 2 - 0.4, 0), handleColor, M.Wood)
		blade = part(model, "Blade", Vector3.new(0.3, 0.3, 0.3), CFrame.new(0, L - 0.9, 0), metal, M.Metal)
		for _, side in { -1, 1 } do
			part(model, "AxeHead", Vector3.new(1.1, 1.4, 0.12), CFrame.new(side * 0.6, L - 0.9, 0), metal, M.Metal)
			part(model, "AxeEdge", Vector3.new(0.14, 1.6, 0.16), CFrame.new(side * 1.15, L - 0.9, 0), glow, M.Neon)
		end
	elseif kind == "Spear" or kind == "Trident" then
		part(model, "Shaft", Vector3.new(0.2, L + 1.6, 0.2), CFrame.new(0, (L + 1.6) / 2 - 1.4, 0), handleColor, M.Wood)
		if kind == "Spear" then
			blade = part(model, "Blade", Vector3.new(0.55, 0.55, 0.1), CFrame.new(0, L, 0) * CFrame.Angles(0, 0, math.rad(45)), metal, M.Metal)
			part(model, "Point", Vector3.new(0.12, 0.9, 0.14), CFrame.new(0, L + 0.5, 0), glow, M.Neon)
		else
			part(model, "Crossbar", Vector3.new(1.3, 0.16, 0.16), CFrame.new(0, L - 0.6, 0), metal, M.Metal)
			for i, x in { -0.6, 0, 0.6 } do
				local prong = part(model, "Prong" .. i, Vector3.new(0.14, 1.3, 0.14), CFrame.new(x, L + 0.05, 0), metal, M.Metal)
				if i == 2 then
					blade = prong
				end
				part(model, "ProngTip" .. i, Vector3.new(0.16, 0.3, 0.16), CFrame.new(x, L + 0.8, 0), glow, M.Neon)
			end
		end
		part(model, "Band", Vector3.new(0.3, 0.25, 0.3), CFrame.new(0, L - 0.9, 0), glow, M.Neon)
	else -- Bow: a curved stave and a glowing string
		local half = L / 2
		local points = {}
		for i = 0, 6 do
			local y = -half + (i / 6) * L
			table.insert(points, Vector3.new(0, y, 0.55 * (y / half) ^ 2))
		end
		for i = 1, #points - 1 do
			local a, b = points[i], points[i + 1]
			local seg = part(model, "Limb" .. i, Vector3.new(0.22, (b - a).Magnitude + 0.05, 0.18),
				CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(math.rad(90), 0, 0), metal, M.Wood)
			if i == 6 then
				blade = seg
			end
		end
		local top, bottom = points[#points], points[1]
		part(model, "String", Vector3.new(0.05, (top - bottom).Magnitude, 0.05), CFrame.new((top + bottom) / 2 + Vector3.new(0, 0, 0.05)), glow, M.Neon)
	end

	for _, item in model:GetChildren() do
		if item ~= grip then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = grip
			weld.Part1 = item
			weld.Parent = item
		end
	end

	-- Light trail along the striking end, shown while swinging.
	local reach = if kind == "Sword" then L / 2 + 0.1 else 0.6
	local a0 = Instance.new("Attachment")
	a0.Name = "TrailBase"
	a0.Position = Vector3.new(0, -reach + 0.2, 0)
	a0.Parent = blade
	local a1 = Instance.new("Attachment")
	a1.Name = "TrailTip"
	a1.Position = Vector3.new(0, reach, 0)
	a1.Parent = blade
	local trail = Instance.new("Trail")
	trail.Name = "SwingTrail"
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.18
	trail.LightEmission = 1
	trail.FaceCamera = true
	trail.Color = ColorSequence.new(glow)
	trail.Transparency = NumberSequence.new(0.15, 1)
	trail.Enabled = false
	trail.Parent = blade

	model.PrimaryPart = grip
	return model
end

-- Welds a new weapon into the character's right hand. Returns it.
-- A different weapon than the one held is swapped out.
function SwordBuilder.Attach(character, glowColor, weapon)
	local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	local existing = character:FindFirstChild(SwordBuilder.Name)
	if existing and existing:GetAttribute("WeaponId") ~= (if weapon then weapon.Id else "") then
		existing:Destroy()
		existing = nil
	end
	if existing then
		-- Still properly held? (Avatar loading can replace the hand and break the weld.)
		local grip = existing.PrimaryPart
		local weld = grip and grip:FindFirstChild("SwordGrip")
		if weld and weld.Part0 == hand and hand ~= nil and hand.Parent == character then
			return existing
		end
		existing:Destroy()
	end
	if not hand then
		return nil
	end
	local sword = SwordBuilder.Build(glowColor, weapon)
	local gripPoint = hand:FindFirstChild("RightGripAttachment")
	local offset = if gripPoint then CFrame.new(gripPoint.Position) else CFrame.new(0, -hand.Size.Y / 2, 0)
	local c0 = offset * CFrame.Angles(math.rad(-90), 0, 0) -- blade (+Y) -> knuckle direction (-Z)
	sword:PivotTo(hand.CFrame * c0)

	local weld = Instance.new("Weld")
	weld.Name = "SwordGrip"
	weld.Part0 = hand
	weld.Part1 = sword.PrimaryPart
	weld.C0 = c0
	weld.Parent = sword.PrimaryPart
	sword.Parent = character
	return sword
end

function SwordBuilder.SetColor(sword, glowColor)
	local weaponId = sword:GetAttribute("WeaponId")
	if weaponId and weaponId ~= "" and weaponId ~= "BronzeSword" then
		return -- weapons with their own glow keep it
	end
	for _, name in { "Gem", "Fuller" } do
		local p = sword:FindFirstChild(name)
		if p then
			p.Color = glowColor
		end
	end
	local blade = sword:FindFirstChild("Blade")
	local trail = blade and blade:FindFirstChild("SwingTrail")
	if trail then
		trail.Color = ColorSequence.new(glowColor)
	end
end

function SwordBuilder.GetTrail(character)
	local sword = character and character:FindFirstChild(SwordBuilder.Name)
	local blade = sword and sword:FindFirstChild("Blade")
	return blade and blade:FindFirstChild("SwingTrail")
end

return SwordBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">SwordPoses</string>
          <string name="Source"><![CDATA[-- SwordPoses (ModuleScript)
-- Location: ReplicatedStorage > Shared > SwordPoses
--
-- Our own sword animations, written as joint angles (degrees) for R15
-- characters. SwordAnimator plays them on every player's screen.
-- Each pose: { JointName = { X, Y, Z } }
--   Shoulder/Elbow/Wrist X+ = swing the limb forward/up, Z+ = out to the
--   right (for the right arm), Waist Y+ = turn the upper body to the left.
-- Each move: a list of { time in seconds, pose }. Missing joints = neutral.
-- Tweak the numbers here to change how attacks look.

local Poses = {}

-- Standing ready: sword held up in front.
Poses.Hold = {
	RightShoulder = { 30, 0, 10 },
	RightElbow = { 60, 0, 0 },
	RightWrist = { -20, 0, 0 },
}

-- Blocking: sword across the body, other arm braced.
Poses.Block = {
	RightShoulder = { 70, 0, -20 },
	RightElbow = { 60, 0, 0 },
	RightWrist = { -10, 70, 0 },
	LeftShoulder = { 60, 0, 20 },
	LeftElbow = { 70, 0, 0 },
	Waist = { 0, 10, 0 },
}

-- Slash 1: high on the right, cutting down to the lower left.
local slash1Up = {
	RightShoulder = { 160, 0, 35 },
	RightElbow = { 30, 0, 0 },
	RightWrist = { -10, 0, 0 },
	LeftShoulder = { 20, 0, -10 },
	Waist = { 0, -15, 0 },
}
local slash1Down = {
	RightShoulder = { 55, 0, -45 },
	RightElbow = { 10, 0, 0 },
	RightWrist = { -70, 0, 0 },
	LeftShoulder = { -15, 0, -10 },
	Waist = { 0, 18, 0 },
}

-- Slash 2: backhand, from the left across to the right.
local slash2Start = {
	RightShoulder = { 110, 0, -55 },
	RightElbow = { 80, 0, 0 },
	RightWrist = { -30, 0, 0 },
	LeftShoulder = { 10, 0, -10 },
	Waist = { 0, 18, 0 },
}
local slash2End = {
	RightShoulder = { 85, 0, 60 },
	RightElbow = { 5, 0, 0 },
	RightWrist = { -80, 0, 0 },
	LeftShoulder = { -10, 0, -15 },
	Waist = { 0, -18, 0 },
}

-- Lunge: pull back, then thrust straight forward.
local lungeBack = {
	RightShoulder = { 20, 0, 15 },
	RightElbow = { 110, 0, 0 },
	RightWrist = { -120, 0, 0 },
	LeftShoulder = { 40, 0, -20 },
	Waist = { 0, -12, 0 },
}
local lungeThrust = {
	RightShoulder = { 90, 0, 0 },
	RightElbow = { 0, 0, 0 },
	RightWrist = { -90, 0, 0 },
	LeftShoulder = { -30, 0, -20 },
	Waist = { 0, 8, 0 },
}

-- Abilities (Phase 4B)
-- Cast: sword raised straight up to the sky.
local castUp = {
	RightShoulder = { 170, 0, 5 },
	RightElbow = { 0, 0, 0 },
	RightWrist = { -90, 0, 0 },
	LeftShoulder = { 25, 0, -15 },
	Waist = { 0, 0, 0 },
}
-- Slam: sword driven down into the ground in front.
local slamDown = {
	RightShoulder = { 45, 0, -5 },
	RightElbow = { 10, 0, 0 },
	RightWrist = { -150, 0, 0 },
	LeftShoulder = { 30, 0, -20 },
	Waist = { 0, 0, 0 },
}
-- Cleave: a wide sweep from far right to far left.
local cleaveStart = {
	RightShoulder = { 90, 0, 75 },
	RightElbow = { 15, 0, 0 },
	RightWrist = { -85, 0, 0 },
	LeftShoulder = { 20, 0, -10 },
	Waist = { 0, -25, 0 },
}
local cleaveEnd = {
	RightShoulder = { 85, 0, -70 },
	RightElbow = { 10, 0, 0 },
	RightWrist = { -85, 0, 0 },
	LeftShoulder = { -10, 0, -15 },
	Waist = { 0, 25, 0 },
}

Poses.Moves = {
	Slash1 = { { 0, Poses.Hold }, { 0.09, slash1Up }, { 0.2, slash1Down }, { 0.42, Poses.Hold } },
	Slash2 = { { 0, Poses.Hold }, { 0.08, slash2Start }, { 0.19, slash2End }, { 0.42, Poses.Hold } },
	Lunge = { { 0, Poses.Hold }, { 0.1, lungeBack }, { 0.21, lungeThrust }, { 0.5, Poses.Hold } },
	Cast = { { 0, Poses.Hold }, { 0.15, castUp }, { 0.45, castUp }, { 0.7, Poses.Hold } },
	Slam = { { 0, Poses.Hold }, { 0.2, castUp }, { 0.4, castUp }, { 0.5, slamDown }, { 0.8, slamDown }, { 1.05, Poses.Hold } },
	Cleave = { { 0, Poses.Hold }, { 0.1, cleaveStart }, { 0.24, cleaveEnd }, { 0.55, Poses.Hold } },
}
Poses.ComboOrder = { "Slash1", "Slash2", "Lunge" }

-- Enemies raise their weapon during the red warning, then strike.
function Poses.EnemyAttack(windup)
	return {
		{ 0, Poses.Hold },
		{ windup * 0.6, slash1Up },
		{ windup, slash1Up },
		{ windup + 0.12, slash1Down },
		{ windup + 0.45, Poses.Hold },
	}
end

-- For the preview renderer / tests.
Poses.Named = {
	Hold = Poses.Hold,
	Block = Poses.Block,
	Slash1Up = slash1Up,
	Slash1Down = slash1Down,
	Slash2Start = slash2Start,
	Slash2End = slash2End,
	LungeBack = lungeBack,
	LungeThrust = lungeThrust,
	CastUp = castUp,
	SlamDown = slamDown,
	CleaveStart = cleaveStart,
	CleaveEnd = cleaveEnd,
}

return Poses
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">TempleConfig</string>
          <string name="Source"><![CDATA[-- TempleConfig (ModuleScript)
-- Location: ReplicatedStorage > Shared > TempleConfig
--
-- Everything about the Temple Tycoon that you might want to tweak:
-- building names, costs, effects, requirements and where they sit on the plot.
-- Both the server (to decide purchases) and the client (to show the upgrade
-- menu) read this file. All numbers are PLACEHOLDERS, balanced in Phase 8.
--
-- To add a new building later: add an entry to Buildings, add its id to
-- BuildingOrder, and add a model function in TempleModels.

local TempleConfig = {}

TempleConfig.MaxBuildingLevel = 6     -- level 6 ("Divine") needs the Divine Citadel (Phase 7E)
TempleConfig.IncomeInterval = 5      -- seconds between passive income payments
TempleConfig.UpgradeCooldown = 0.5   -- seconds between purchase requests per player

--------------------------------------------------------------------------
-- TEMPLE TIERS
-- Tier = 1 + Temple Core level. Core has 6 levels -> tiers 1-7.
-- Tier 7 (Divine Citadel, Phase 7E) needs character level 100 and Elder God.
--------------------------------------------------------------------------
TempleConfig.Tiers = {
	{ Name = "Ruined Shrine" },
	{ Name = "Sacred Sanctuary" },
	{ Name = "Temple of Devotion" },
	{ Name = "Blessed Temple" },
	{ Name = "Grand Pantheon" },
	{ Name = "Celestial Palace" },
	{ Name = "Divine Citadel" },
}

-- Order shown in the upgrade menu.
TempleConfig.BuildingOrder = {
	"GoldTreasury",
	"MainAltar",
	"DivineFountain",
	"TrainingGrounds",
	"StatueHall",
	"TempleCore",
}

--------------------------------------------------------------------------
-- BUILDINGS
-- Slot = centre of the building, relative to the plot centre (X, Z).
-- Pad  = centre of its glowing purchase pad, relative to the plot centre.
-- Costs[n] = Gold to reach level n.
-- Effect / EffectValues[n] = what the building gives at level n.
-- Players arrive at the front of the plot (negative Z).
--------------------------------------------------------------------------
TempleConfig.Buildings = {
	GoldTreasury = {
		DisplayName = "Gold Treasury",
		Description = "Earns Gold automatically while you play.",
		Slot = Vector3.new(-28, 0, -16),
		Pad = Vector3.new(-28, 0, -30),
		Costs = { 100, 600, 3000, 15000, 75000, 400000 },
		Effect = "GoldPerMinute",
		EffectLabel = "Gold per minute",
		EffectValues = { 30, 75, 180, 420, 900, 2000 },
	},
	MainAltar = {
		DisplayName = "Main Altar",
		Description = "Earns Divine Favor. Unlocks higher blessing tiers (Phase 3).",
		Slot = Vector3.new(0, 0, -20),
		Pad = Vector3.new(-9, 0, -30),
		Costs = { 250, 1500, 7500, 35000, 150000, 750000 },
		Effect = "FavorPerMinute",
		EffectLabel = "Favor per minute",
		EffectValues = { 5, 12, 25, 50, 100, 200 },
	},
	DivineFountain = {
		DisplayName = "Divine Fountain",
		Description = "Improves health and energy regeneration (used from Phase 4).",
		Slot = Vector3.new(28, 0, -16),
		Pad = Vector3.new(28, 0, -30),
		Costs = { 300, 2000, 10000, 45000, 180000, 900000 },
		Effect = "RegenBonusPercent",
		EffectLabel = "Regeneration bonus %",
		EffectValues = { 10, 20, 35, 50, 75, 100 },
	},
	TrainingGrounds = {
		DisplayName = "Training Grounds",
		Description = "Boosts combat and equipment progression (used from Phase 4).",
		Slot = Vector3.new(-28, 0, 20),
		Pad = Vector3.new(-28, 0, 5),
		Costs = { 400, 2500, 12000, 50000, 200000, 1000000 },
		Effect = "CombatBonusPercent",
		EffectLabel = "Combat bonus %",
		EffectValues = { 2, 4, 7, 10, 15, 20 },
	},
	StatueHall = {
		DisplayName = "Statue Hall",
		Description = "Displays statues and improves worship rewards (used from Phase 3).",
		Slot = Vector3.new(28, 0, 20),
		Pad = Vector3.new(28, 0, 5),
		Costs = { 500, 3000, 15000, 60000, 250000, 1250000 },
		Effect = "WorshipBonusPercent",
		EffectLabel = "Worship bonus %",
		EffectValues = { 5, 10, 20, 30, 50, 75 },
	},
	TempleCore = {
		DisplayName = "Temple Core",
		Description = "Raises your temple tier, changes its look, and unlocks stronger buildings.",
		Slot = Vector3.new(0, 0, 12), -- the main temple itself
		Pad = Vector3.new(9, 0, -30),
		Costs = { 1000, 8000, 40000, 160000, 600000, 3000000 },
		RequiredLevel = { 5, 10, 25, 45, 70, 100 }, -- character level needed for each Core level
		RequiredRank = { [6] = 8 }, -- Core level 6 (Divine Citadel) also needs Elder God
		IsCore = true,
	},
}

--------------------------------------------------------------------------
-- Shared rules (used by both the server and the menu)
--------------------------------------------------------------------------
function TempleConfig.TierFromCoreLevel(coreLevel)
	return math.clamp(1 + (tonumber(coreLevel) or 0), 1, #TempleConfig.Tiers)
end

function TempleConfig.GetTierName(tier)
	local info = TempleConfig.Tiers[tier]
	return if info then info.Name else "?"
end

-- Value of a building's effect at a level (0 if not built).
function TempleConfig.GetEffectValue(buildingId, level)
	local building = TempleConfig.Buildings[buildingId]
	if not building or not building.EffectValues or level <= 0 then
		return 0
	end
	return building.EffectValues[math.min(level, #building.EffectValues)] or 0
end

-- What the next upgrade of a building needs.
-- Returns a table: { Maxed = bool, NextLevel = n, Cost = gold, Blocked = "reason" or nil }
-- Temple tier needed for each building level (level 6 needs the Divine Citadel).
TempleConfig.BuildingTierNeeded = { 1, 2, 3, 4, 5, 7 }

local RANK_NAMES = { "Mortal", "Warrior", "Champion", "Hero", "Demigod", "Lesser God", "Olympian", "Elder God" }

function TempleConfig.GetUpgradeInfo(buildingId, currentLevel, templeTier, playerLevel, rankIndex)
	local building = TempleConfig.Buildings[buildingId]
	if not building then
		return nil
	end
	if currentLevel >= TempleConfig.MaxBuildingLevel then
		return { Maxed = true }
	end

	local nextLevel = currentLevel + 1
	local blocked = nil
	if building.IsCore then
		local required = building.RequiredLevel[nextLevel]
		local rankNeeded = building.RequiredRank and building.RequiredRank[nextLevel]
		if playerLevel < required then
			blocked = ("Reach character level %d"):format(required)
		elseif rankNeeded and (rankIndex or 1) < rankNeeded then
			blocked = ("Ascend to %s"):format(RANK_NAMES[rankNeeded])
		end
	else
		local tierNeeded = TempleConfig.BuildingTierNeeded[nextLevel] or nextLevel
		if templeTier < tierNeeded then
			blocked = ("Needs temple tier %d (%s)"):format(tierNeeded, TempleConfig.GetTierName(tierNeeded))
		end
	end

	return {
		Maxed = false,
		NextLevel = nextLevel,
		Cost = building.Costs[nextLevel],
		Blocked = blocked,
	}
end

--------------------------------------------------------------------------
-- TEMPLE PRESTIGE (Phase 7E)
-- After the Divine Citadel with every building at level 6, keep improving
-- the temple: 10 Prestige levels. Nothing resets. Each level adds
-- IncomeBonusPercent to temple Gold and Favor income and new decorations.
--------------------------------------------------------------------------
TempleConfig.Prestige = {
	MaxLevel = 10,
	IncomeBonusPercent = 5, -- per Prestige level
	BaseGold = 2000000,   -- Prestige 1 costs 2M Gold; each level x1.4 (Prestige 10: ~41M)
	GoldGrowth = 1.4,
	BaseAmbrosia = 5,     -- Prestige 1 costs 5 Ambrosia; +3 per level
	AmbrosiaPerLevel = 3,
	-- New look at each level (shown in the menu).
	Looks = {
		[1] = "Golden banners on the citadel",
		[2] = "A ring of glowing pillars around the citadel",
		[3] = "A divine halo above the dome",
		[4] = "Prestige stars on the citadel",
		[5] = "A beam of light into the sky",
		[6] = "Two more floating sky islands",
		[7] = "Flames of the gods on every tower",
		[8] = "A second, larger halo",
		[9] = "Golden statues of you at the gates",
		[10] = "Radiant Citadel: everything glows",
	},
}

-- What the next Prestige level needs.
-- Returns { Maxed, NextLevel, Gold, Ambrosia, Blocked }.
function TempleConfig.GetPrestigeInfo(prestige, templeTier, buildings)
	local p = TempleConfig.Prestige
	prestige = tonumber(prestige) or 0
	if prestige >= p.MaxLevel then
		return { Maxed = true }
	end
	local nextLevel = prestige + 1
	local blocked = nil
	if templeTier < #TempleConfig.Tiers then
		blocked = "Build the Divine Citadel first"
	else
		for _, id in TempleConfig.BuildingOrder do
			if (tonumber(buildings[id]) or 0) < TempleConfig.MaxBuildingLevel then
				blocked = ("Raise every building to level %d first"):format(TempleConfig.MaxBuildingLevel)
				break
			end
		end
	end
	return {
		Maxed = false,
		NextLevel = nextLevel,
		Gold = math.floor(p.BaseGold * p.GoldGrowth ^ prestige / 1000) * 1000,
		Ambrosia = p.BaseAmbrosia + p.AmbrosiaPerLevel * prestige,
		Blocked = blocked,
	}
end

function TempleConfig.PrestigeMultiplier(prestige)
	return 1 + (tonumber(prestige) or 0) * TempleConfig.Prestige.IncomeBonusPercent / 100
end

return TempleConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">WeaponConfig</string>
          <string name="Source"><![CDATA[-- WeaponConfig (ModuleScript)
-- Location: ReplicatedStorage > Shared > WeaponConfig
--
-- Phase 7C: weapons, rarities, the Divine Forge and boss drops.
-- Damage = a multiplier on your attack power (Bronze Sword = 1.0), raised by
-- +6% per upgrade level. It applies to basic attacks AND god abilities.
-- Speed = attack cooldown multiplier (lower = faster).
-- Special: CritChance (0-1, double damage), LifeSteal (0-1), Pierce (extra
-- enemies hit), ExtraTargets.
-- Look: Blade / Handle / Glow colours and Length for the model in your hand.
-- All numbers are PLACEHOLDERS, balanced in Phase 8.

local WeaponConfig = {}

WeaponConfig.Rarities = {
	{ Name = "Common", Color = Color3.fromRGB(175, 175, 175), MaxLevel = 5, UpgradeGold = 200, UpgradeAmbrosia = 0, Salvage = 100 },
	{ Name = "Uncommon", Color = Color3.fromRGB(90, 200, 90), MaxLevel = 6, UpgradeGold = 600, UpgradeAmbrosia = 0, Salvage = 400 },
	{ Name = "Rare", Color = Color3.fromRGB(70, 140, 255), MaxLevel = 8, UpgradeGold = 2000, UpgradeAmbrosia = 0, Salvage = 1500 },
	{ Name = "Epic", Color = Color3.fromRGB(175, 80, 240), MaxLevel = 10, UpgradeGold = 8000, UpgradeAmbrosia = 1, Salvage = 6000 },
	{ Name = "Legendary", Color = Color3.fromRGB(255, 160, 40), MaxLevel = 12, UpgradeGold = 30000, UpgradeAmbrosia = 2, Salvage = 25000 },
	{ Name = "Divine", Color = Color3.fromRGB(255, 225, 110), MaxLevel = 15, UpgradeGold = 100000, UpgradeAmbrosia = 3, Salvage = 80000 },
}

-- How each weapon type attacks. Combo = the three swing animations (SwordPoses).
WeaponConfig.Types = {
	Sword = { Range = 7.5, ArcDot = 0.2, MaxTargets = 3, Cooldown = 0.45, Combo = { "Slash1", "Slash2", "Lunge" } },
	Axe = { Range = 7.5, ArcDot = 0.0, MaxTargets = 4, Cooldown = 0.6, Combo = { "Slash1", "Cleave", "Slash2" } },
	Spear = { Range = 10.5, ArcDot = 0.6, MaxTargets = 2, Cooldown = 0.55, Combo = { "Lunge", "Slash1", "Lunge" } },
	Trident = { Range = 9, ArcDot = 0.35, MaxTargets = 4, Cooldown = 0.55, Combo = { "Lunge", "Slash2", "Lunge" } },
	Bow = { Range = 32, Width = 3, MaxTargets = 1, Cooldown = 0.6, Ranged = true, Combo = { "Lunge", "Lunge", "Lunge" } },
}

WeaponConfig.StarterWeapon = "BronzeSword"

-- Cost = Gold (+ Ambrosia) to craft at the Divine Forge; nil = not craftable.
-- Drop = { Boss = enemy type, Chance = 0-1 } when you win that boss's arena or trial.
WeaponConfig.Weapons = {
	BronzeSword = { Name = "Bronze Sword", Type = "Sword", Rarity = 1, Damage = 1.0, Speed = 1.0,
		Look = { Blade = Color3.fromRGB(205, 140, 75), Glow = nil, Length = 3.0 } },
	WoodenSpear = { Name = "Wooden Spear", Type = "Spear", Rarity = 1, Damage = 1.05, Speed = 1.0, Cost = { Gold = 300 },
		Look = { Blade = Color3.fromRGB(170, 170, 175), Handle = Color3.fromRGB(120, 85, 55), Length = 5.5 } },
	HuntingBow = { Name = "Hunting Bow", Type = "Bow", Rarity = 1, Damage = 0.95, Speed = 1.0, Cost = { Gold = 400 },
		Look = { Blade = Color3.fromRGB(120, 85, 55), Length = 4 } },

	IronSword = { Name = "Iron Sword", Type = "Sword", Rarity = 2, Damage = 1.2, Speed = 1.0, Cost = { Gold = 2000 },
		Look = { Blade = Color3.fromRGB(190, 195, 205), Length = 3.2 } },
	HopliteSpear = { Name = "Hoplite Spear", Type = "Spear", Rarity = 2, Damage = 1.25, Speed = 1.0, Cost = { Gold = 2500 },
		Look = { Blade = Color3.fromRGB(205, 140, 75), Handle = Color3.fromRGB(110, 75, 45), Length = 6 } },
	FishermansTrident = { Name = "Fisherman's Trident", Type = "Trident", Rarity = 2, Damage = 1.2, Speed = 1.0, Cost = { Gold = 2500 },
		Look = { Blade = Color3.fromRGB(180, 190, 200), Handle = Color3.fromRGB(110, 80, 50), Length = 5.5 } },

	ChampionsBlade = { Name = "Champion's Blade", Type = "Sword", Rarity = 3, Damage = 1.45, Speed = 0.95, Special = { CritChance = 0.1 },
		Cost = { Gold = 8000, Ambrosia = 1 }, Drop = { Boss = "TrainingChampion", Chance = 0.3 },
		Look = { Blade = Color3.fromRGB(230, 205, 120), Glow = Color3.fromRGB(255, 220, 120), Length = 3.4 } },
	SilverLongbow = { Name = "Silver Longbow", Type = "Bow", Rarity = 3, Damage = 1.4, Speed = 0.95, Special = { Pierce = 1 },
		Cost = { Gold = 12000, Ambrosia = 2 },
		Look = { Blade = Color3.fromRGB(210, 215, 225), Glow = Color3.fromRGB(180, 220, 255), Length = 4.6 } },
	SpartanBlade = { Name = "Spartan Blade", Type = "Sword", Rarity = 3, Damage = 1.55, Speed = 0.9, Special = { CritChance = 0.15 },
		Drop = { Boss = "SpartanWarlord", Chance = 0.3 },
		Look = { Blade = Color3.fromRGB(200, 60, 45), Glow = Color3.fromRGB(255, 90, 60), Length = 3.2 } },

	MinotaursLabrys = { Name = "Minotaur's Labrys", Type = "Axe", Rarity = 4, Damage = 1.9, Speed = 1.1, Special = { ExtraTargets = 2 },
		Drop = { Boss = "Minotaur", Chance = 0.25 },
		Look = { Blade = Color3.fromRGB(150, 140, 130), Handle = Color3.fromRGB(95, 60, 38), Glow = Color3.fromRGB(255, 160, 80), Length = 4.2 } },
	GorgonSpear = { Name = "Gorgon Spear", Type = "Spear", Rarity = 4, Damage = 1.8, Speed = 0.95, Special = { LifeSteal = 0.05 },
		Drop = { Boss = "Medusa", Chance = 0.25 },
		Look = { Blade = Color3.fromRGB(110, 200, 100), Handle = Color3.fromRGB(60, 90, 60), Glow = Color3.fromRGB(120, 255, 130), Length = 6.5 } },
	TridentOfTheDeep = { Name = "Trident of the Deep", Type = "Trident", Rarity = 4, Damage = 1.75, Speed = 0.95, Special = { ExtraTargets = 1 },
		Cost = { Gold = 60000, Ambrosia = 6 },
		Look = { Blade = Color3.fromRGB(60, 200, 220), Handle = Color3.fromRGB(40, 90, 120), Glow = Color3.fromRGB(80, 230, 255), Length = 6 } },

	HellfireBlade = { Name = "Hellfire Blade", Type = "Sword", Rarity = 5, Damage = 2.2, Speed = 0.9, Special = { CritChance = 0.2 },
		Drop = { Boss = "Cerberus", Chance = 0.2 },
		Look = { Blade = Color3.fromRGB(60, 30, 30), Glow = Color3.fromRGB(255, 100, 30), Length = 3.6 } },
	SunlightBow = { Name = "Sunlight Bow", Type = "Bow", Rarity = 5, Damage = 2.1, Speed = 0.9, Special = { Pierce = 3 },
		Cost = { Gold = 250000, Ambrosia = 15 },
		Look = { Blade = Color3.fromRGB(245, 200, 80), Glow = Color3.fromRGB(255, 220, 90), Length = 5 } },
	AegisSpear = { Name = "Aegis Spear", Type = "Spear", Rarity = 5, Damage = 2.15, Speed = 0.9, Special = { LifeSteal = 0.08 },
		Cost = { Gold = 250000, Ambrosia = 15 },
		Look = { Blade = Color3.fromRGB(230, 230, 240), Handle = Color3.fromRGB(212, 175, 55), Glow = Color3.fromRGB(255, 240, 200), Length = 7 } },

	ThunderboltBlade = { Name = "Thunderbolt Blade", Type = "Sword", Rarity = 6, Damage = 2.8, Speed = 0.85, Special = { CritChance = 0.25, LifeSteal = 0.05 },
		Drop = { Boss = "TitanKing", Chance = 0.15 },
		Look = { Blade = Color3.fromRGB(240, 240, 255), Glow = Color3.fromRGB(110, 190, 255), Length = 3.8 } },
	TridentOfPoseidon = { Name = "Trident of Poseidon", Type = "Trident", Rarity = 6, Damage = 2.7, Speed = 0.85, Special = { ExtraTargets = 2, LifeSteal = 0.04 },
		Cost = { Gold = 1000000, Ambrosia = 50 },
		Look = { Blade = Color3.fromRGB(255, 225, 110), Handle = Color3.fromRGB(40, 150, 200), Glow = Color3.fromRGB(80, 230, 255), Length = 7 } },
	BowOfApollo = { Name = "Bow of Apollo", Type = "Bow", Rarity = 6, Damage = 2.6, Speed = 0.85, Special = { Pierce = 5, CritChance = 0.15 },
		Cost = { Gold = 1000000, Ambrosia = 50 },
		Look = { Blade = Color3.fromRGB(255, 225, 110), Glow = Color3.fromRGB(255, 240, 160), Length = 5.4 } },
}

for id, weapon in WeaponConfig.Weapons do
	weapon.Id = id
end

-- Display order (forge list): by rarity, then name.
WeaponConfig.Order = {}
for id in WeaponConfig.Weapons do
	table.insert(WeaponConfig.Order, id)
end
table.sort(WeaponConfig.Order, function(a, b)
	local wa, wb = WeaponConfig.Weapons[a], WeaponConfig.Weapons[b]
	if wa.Rarity ~= wb.Rarity then
		return wa.Rarity < wb.Rarity
	end
	return wa.Name < wb.Name
end)

WeaponConfig.DamagePerLevel = 0.06      -- +6% per upgrade level
WeaponConfig.UpgradeDiscountPerTrainingLevel = 0.04 -- Training Grounds: -4% upgrade cost per level
WeaponConfig.ForgeRange = 22            -- crafting/upgrading needs you at the Divine Forge

-- Attack power multiplier of a weapon at a level.
function WeaponConfig.Power(weaponId, level)
	local w = WeaponConfig.Weapons[weaponId]
	return (if w then w.Damage else 1) * (1 + WeaponConfig.DamagePerLevel * (level or 0))
end

-- Cost of the next upgrade: gold, ambrosia (nil if maxed).
function WeaponConfig.UpgradeCost(weaponId, level, trainingLevel)
	local w = WeaponConfig.Weapons[weaponId]
	local rarity = w and WeaponConfig.Rarities[w.Rarity]
	if not rarity or level >= rarity.MaxLevel then
		return nil
	end
	local discount = 1 - WeaponConfig.UpgradeDiscountPerTrainingLevel * (trainingLevel or 0)
	local gold = math.floor(rarity.UpgradeGold * (level + 1) ^ 1.5 * discount)
	local ambrosia = rarity.UpgradeAmbrosia * (if level >= 3 then 2 else 1)
	return gold, ambrosia
end

return WeaponConfig
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="29">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="30">
      <Properties>
        <string name="Name">Main</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Main (Script)
-- Location: ServerScriptService > Main
--
-- Starts every server system in the right order and handles players
-- joining and leaving. This is the only server Script; everything else
-- is a ModuleScript in ServerScriptService > Services.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local MessagingService = game:GetService("MessagingService")
local ServerScriptService = game:GetService("ServerScriptService")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))

local Services = ServerScriptService:WaitForChild("Services")
local WorldBuilder = require(Services:WaitForChild("WorldBuilder"))
local DataService = require(Services:WaitForChild("DataService"))
local ProgressionService = require(Services:WaitForChild("ProgressionService"))
local PlotService = require(Services:WaitForChild("PlotService"))
local TempleService = require(Services:WaitForChild("TempleService"))
local GodService = require(Services:WaitForChild("GodService"))
local EnemyService = require(Services:WaitForChild("EnemyService"))
local CombatService = require(Services:WaitForChild("CombatService"))
local DiagnosticsService = require(Services:WaitForChild("DiagnosticsService"))
local AbilityService = require(Services:WaitForChild("AbilityService"))
local ArenaService = require(Services:WaitForChild("ArenaService"))
local AscensionService = require(Services:WaitForChild("AscensionService"))
local InventoryService = require(Services:WaitForChild("InventoryService"))
local GameEvents = require(Services:WaitForChild("GameEvents"))
local QuestService = require(Services:WaitForChild("QuestService"))
local ChallengeService = require(Services:WaitForChild("ChallengeService"))
local MasteryService = require(Services:WaitForChild("MasteryService"))
local EnvironmentService = require(Services:WaitForChild("EnvironmentService"))

--------------------------------------------------------------------------
-- 1. Remotes (created by the server so they always exist)
--------------------------------------------------------------------------
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"

local notifyRemote = Instance.new("RemoteEvent") -- server -> client pop-up messages
notifyRemote.Name = "Notify"
notifyRemote.Parent = remotes

local teleportRemote = Instance.new("RemoteEvent") -- client -> server "take me to my temple / plaza"
teleportRemote.Name = "RequestTeleport"
teleportRemote.Parent = remotes

local upgradeRemote = Instance.new("RemoteEvent") -- client -> server "upgrade this temple building"
upgradeRemote.Name = "RequestUpgrade"
upgradeRemote.Parent = remotes

local godRemote = Instance.new("RemoteEvent") -- client -> server god menu requests (choose, blessings, change)
godRemote.Name = "GodAction"
godRemote.Parent = remotes

local function newRemote(name)
	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = remotes
	return remote
end
local combatRemotes = {
	Attack = newRemote("CombatAttack"), -- client -> server "I swung"
	Block = newRemote("CombatBlock"),   -- client -> server block on/off
	Dash = newRemote("CombatDash"),     -- client -> server "I dashed"
}
local fxRemote = newRemote("CombatFX") -- server -> clients damage numbers and effects
local reportRemote = newRemote("ClientReport") -- client -> server diagnostics report
local abilityRemote = newRemote("UseAbility") -- client -> server "use my Q / E / R / Form ability"
local arenaActionRemote = newRemote("ArenaAction") -- client -> server arena menu requests
local arenaEventRemote = newRemote("ArenaEvent") -- server -> client party queue and results
local ascensionRemote = newRemote("AscensionAction") -- client -> server "start my ascension trial"
local weaponRemote = newRemote("WeaponAction") -- client -> server equip / craft / upgrade a weapon
local questRemote = newRemote("QuestAction") -- client -> server "claim this quest"
local challengeRemote = newRemote("ChallengeAction") -- client -> server "start this Titan Gate challenge"
local incarnationRemote = newRemote("IncarnationAction") -- client -> server "transform now"
local settingsRemote = newRemote("SettingsAction") -- client -> server music / effects volume

remotes.Parent = ReplicatedStorage

--------------------------------------------------------------------------
-- 2. Start systems
--------------------------------------------------------------------------
EnvironmentService.Build() -- Phase 8: sky, mountain, cloud sea
WorldBuilder.Build()
DataService.Init()
ProgressionService.Init(DataService, notifyRemote)
PlotService.Init()
TempleService.Init(DataService, ProgressionService, PlotService, notifyRemote, upgradeRemote)
GodService.Init(DataService, ProgressionService, TempleService, notifyRemote, godRemote)
GodService.BuildHall()
CombatService.Init(TempleService, EnemyService, fxRemote, combatRemotes)
EnemyService.Init(DataService, ProgressionService, CombatService, fxRemote)
EnemyService.SpawnPracticeField()
AbilityService.Init(DataService, ProgressionService, TempleService, EnemyService, GodService, fxRemote, abilityRemote)
CombatService.SetModifierProvider(AbilityService.GetModifiers)
CombatService.SetDashHandler(AbilityService.OnDash)
CombatService.SetCounterHandler(AbilityService.TryCounter)
ArenaService.Init(DataService, ProgressionService, PlotService, EnemyService, notifyRemote, arenaActionRemote, arenaEventRemote)
ArenaService.BuildGate()
ChallengeService.Init(DataService, ArenaService, notifyRemote, challengeRemote)
ChallengeService.BuildGate()
MasteryService.Init(DataService, ProgressionService, AbilityService, GameEvents, notifyRemote, fxRemote, incarnationRemote)

-- Phase 8: music / effects volume (saved in data.Settings, shown as attributes)
local function pushSettings(player)
	local data = DataService.GetData(player)
	if data and type(data.Settings) == "table" then
		player:SetAttribute("MusicVolume", tonumber(data.Settings.MusicVolume) or 0.5)
		player:SetAttribute("SfxVolume", tonumber(data.Settings.SfxVolume) or 0.8)
	end
end
settingsRemote.OnServerEvent:Connect(function(player, key, value)
	local data = DataService.GetData(player)
	if not data or (key ~= "MusicVolume" and key ~= "SfxVolume") or type(value) ~= "number" or value ~= value then
		return
	end
	if type(data.Settings) ~= "table" then
		data.Settings = {}
	end
	data.Settings[key] = math.clamp(value, 0, 1)
	pushSettings(player)
end)
AscensionService.Init(DataService, ProgressionService, ArenaService, notifyRemote, fxRemote, ascensionRemote, if GameConfig.Debug.Diagnostics then DiagnosticsService else nil)
AscensionService.BuildChamber()
InventoryService.Init(DataService, ProgressionService, notifyRemote, weaponRemote)
InventoryService.BuildForge()
QuestService.Init(DataService, ProgressionService, GameEvents, notifyRemote, questRemote)
CombatService.SetWeaponProvider(InventoryService.GetEquipped)
AbilityService.SetPowerProvider(function(player)
	return InventoryService.GetEquipped(player).Power
end)
InventoryService.SetWeaponChangedHandler(CombatService.RefreshWeapon)
ArenaService.SetDropHandler(InventoryService.RollBossDrops)
if GameConfig.Debug.Diagnostics then
	DiagnosticsService.Init(reportRemote)
end

--------------------------------------------------------------------------
-- 3. Debug chat commands
-- Allowed in Studio, and in the live game for the game's owner only
-- (see GameConfig.Debug).
--------------------------------------------------------------------------
local function isGameOwner(player)
	if game.CreatorType == Enum.CreatorType.User then
		return player.UserId == game.CreatorId
	end
	-- Group-owned game: only the group owner (rank 255).
	local ok, rank = pcall(function()
		return player:GetRankInGroup(game.CreatorId)
	end)
	return ok and rank == 255
end

local function canUseDebugCommands(player)
	if RunService:IsStudio() then
		return GameConfig.Debug.ChatCommandsInStudio
	end
	return GameConfig.Debug.ChatCommandsForOwnerInLiveGame and isGameOwner(player)
end

local function runDebugCommand(player, message)
	local args = string.split(message, " ")
	local command = string.lower(args[1] or "")
	local number = tonumber(args[2])

	local function reply(text)
		notifyRemote:FireClient(player, "Message", text)
		print("[Debug] " .. player.Name .. ": " .. text)
	end

	if command == "!xp" and number then
		ProgressionService.AddXP(player, number, "Debug")
		reply("Added " .. number .. " XP")
	elseif command == "!gold" and number then
		ProgressionService.AddCurrency(player, "Gold", number, "Debug")
		reply("Added " .. number .. " Gold")
	elseif command == "!favor" and number then
		ProgressionService.AddCurrency(player, "DivineFavor", number, "Debug")
		reply("Added " .. number .. " Divine Favor")
	elseif command == "!ambrosia" and number then
		ProgressionService.AddCurrency(player, "Ambrosia", number, "Debug")
		reply("Added " .. number .. " Ambrosia")
	elseif command == "!spend" and number then
		local ok = ProgressionService.SpendCurrency(player, "Gold", number)
		reply(if ok then "Spent " .. number .. " Gold" else "Not enough Gold (purchase refused)")
	elseif command == "!blessall" then
		reply(if GodService.DebugMaxBlessings(player) then "All blessings of your god are now max level" else "Choose a god first")
	elseif command == "!loyalty" and number then
		reply(if GodService.AddLoyalty(player, number) then "Added " .. number .. " loyalty" else "Choose a god first")
	elseif command == "!rank" then
		local ok, text = ProgressionService.AdvanceRank(player, "Debug")
		if ok then
			AscensionService.OnRankUp(player)
		end
		reply(text)
	elseif command == "!save" then
		reply(if DataService.SaveNow(player) then "Saved" else "Save failed (see Output)")
	elseif command == "!data" then
		local data = DataService.GetData(player)
		print("[Debug] Data for " .. player.Name .. ":\n" .. (if data then HttpService:JSONEncode(data) else "not loaded"))
		reply("Printed your data to the Output window")
	elseif command == "!reset" then
		if DataService.ResetData(player) then
			ProgressionService.RefreshAll(player)
			GodService.Refresh(player)
			TempleService.Rebuild(player)
			task.spawn(AscensionService.ApplyLooks, player)
			reply("Progress reset to defaults")
		end
	else
		reply("Commands: !xp N, !gold N, !favor N, !ambrosia N, !loyalty N, !blessall, !spend N, !rank, !save, !data, !reset")
	end
end

--------------------------------------------------------------------------
-- 4. Player lifecycle
--------------------------------------------------------------------------
local function onPlayerAdded(player)
	if canUseDebugCommands(player) then
		player.Chatted:Connect(function(message)
			if string.sub(message, 1, 1) == "!" then
				runDebugCommand(player, message)
			end
		end)
	end

	local data = DataService.LoadPlayer(player) -- yields; nil = failed/kicked/left
	if not data then
		return
	end

	local plot = PlotService.AssignPlot(player)
	if not plot then
		player:Kick("This server has no free temple plots. Please join another server.")
		return
	end

	ProgressionService.SetupPlayer(player)
	GodService.SetupPlayer(player)
	TempleService.SetupPlayer(player, plot)
	InventoryService.SetupPlayer(player) -- before combat, so the right weapon is in hand
	CombatService.SetupPlayer(player)
	AbilityService.SetupPlayer(player)
	AscensionService.SetupPlayer(player)
	QuestService.SetupPlayer(player)
	ChallengeService.SetupPlayer(player)
	MasteryService.SetupPlayer(player)
	pushSettings(player)
	player:SetAttribute("DataLoaded", true)
	print(("[Main] %s ready: Level %d, %d Gold, %s"):format(player.Name, data.Level, data.Currencies.Gold, plot.Name))
end

local lastTeleport = {}

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player) -- players who joined before this script ran
end

Players.PlayerRemoving:Connect(function(player)
	lastTeleport[player] = nil
	TempleService.ReleasePlayer(player)
	GodService.ReleasePlayer(player)
	CombatService.ReleasePlayer(player)
	AbilityService.ReleasePlayer(player)
	ArenaService.ReleasePlayer(player)
	AscensionService.ReleasePlayer(player)
	QuestService.ReleasePlayer(player)
	MasteryService.ReleasePlayer(player)
	PlotService.ReleasePlot(player)
	DataService.ReleasePlayer(player) -- yields while saving
end)

--------------------------------------------------------------------------
-- 4b. Update restarts: when a new version is published, a message on the
-- "OlympusUpdate" topic (sent with Open Cloud) asks every OLD server to send
-- its players back in, so nobody stays on an outdated version.
--------------------------------------------------------------------------
if not RunService:IsStudio() then
	task.spawn(function()
		local ok, err = pcall(function()
			MessagingService:SubscribeAsync("OlympusUpdate", function(message)
				local newVersion = tonumber(message.Data)
				if newVersion and newVersion > game.PlaceVersion then
					for _, player in Players:GetPlayers() do
						player:Kick("Mount Olympus was just updated! Please rejoin to play the new version.")
					end
				end
			end)
		end)
		if not ok then
			warn("[Main] Could not listen for updates: " .. tostring(err))
		end
	end)
end

--------------------------------------------------------------------------
-- 5. Teleport requests (validated: never trust what the client sends)
--------------------------------------------------------------------------
teleportRemote.OnServerEvent:Connect(function(player, destination)
	if destination ~= "Temple" and destination ~= "Plaza" and destination ~= "Practice" then
		return
	end
	if player:GetAttribute("DataLoaded") ~= true then
		return
	end
	local now = os.clock()
	if lastTeleport[player] and now - lastTeleport[player] < GameConfig.Teleport.Cooldown then
		return
	end
	lastTeleport[player] = now
	if ArenaService.IsInRun(player) then
		ArenaService.Leave(player) -- travelling away from an arena counts as leaving it
	end
	PlotService.TeleportPlayer(player, destination)
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="31">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">AbilityService</string>
          <string name="Source"><![CDATA[-- AbilityService (ModuleScript)
-- Location: ServerScriptService > Services > AbilityService
--
-- God abilities (Phase 4B), all decided on the server:
--   * The client only says "use slot Q/E/R/Form" (or that it dashed).
--   * The server finds the active god's blessing for that slot, checks the
--     blessing is unlocked, the cooldown, and that the player is alive and
--     not blocking, then works out targets and damage itself.
--   * Abilities of gods you don't currently worship can't be used.
--   * Cooldowns are published as player attributes "Cooldown_<slot>"
--     (the server time when the slot is ready again) for the buttons.
--   * Buffs (Forms, Berserker Rage) add attack %, speed % and/or damage
--     reduction for a few seconds.
-- Visuals are drawn on every device from CombatFX events.

local GameEvents = require(script.Parent:WaitForChild("GameEvents"))
local CombatService = require(script.Parent:WaitForChild("CombatService"))
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local AbilityConfig = require(Shared:WaitForChild("AbilityConfig"))
local GodConfig = require(Shared:WaitForChild("GodConfig"))

local AbilityService = {}

local DataService = nil
local ProgressionService = nil
local TempleService = nil
local EnemyService = nil
local GodService = nil
local fxRemote = nil

local state = {} -- [Player] = { ReadyAt = { [slot] = os.clock() }, Buffs = { [abilityId] = { Until, ... } } }

--------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------
local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function getParts(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and root and humanoid.Health > 0 then
		return character, humanoid, root
	end
	return nil
end

local function godColor(player)
	local data = DataService.GetData(player)
	return GodConfig.GetColors(data and data.SelectedGod or "").Primary
end

-- The active god's blessing for a slot, and its level (0 = locked).
local function blessingForSlot(data, slot)
	local god = GodConfig.Gods[data.SelectedGod]
	if not god then
		return nil, 0
	end
	for _, blessing in god.Blessings do
		if blessing.Ability == slot then
			local tree = data.Blessings[god.Id]
			local level = if type(tree) == "table" then tonumber(tree[blessing.Id]) or 0 else 0
			return blessing, level
		end
	end
	return nil, 0
end

local function activeBuffs(player)
	local st = state[player]
	local mods = { AttackPercent = 0, SpeedPercent = 0, DamageTaken = 1, LifeSteal = 0, RegenPercent = 0 }
	if not st then
		return mods
	end
	local now = os.clock()
	for id, buff in st.Buffs do
		if now < buff.Until then
			mods.AttackPercent += buff.AttackPercent
			mods.SpeedPercent += buff.SpeedPercent
			mods.DamageTaken *= buff.DamageTaken
			mods.LifeSteal += buff.LifeSteal or 0
			mods.RegenPercent += buff.RegenPercent or 0
		else
			st.Buffs[id] = nil
		end
	end
	return mods
end

-- Damage one point of "ability damage" is worth for this player.
local powerProvider = nil -- Phase 7C: function(player) -> equipped weapon power multiplier

local function baseDamage(player)
	local baseAttack = player:GetAttribute("BaseAttack") or 10
	local combatBonus = TempleService.GetEffect(player, "CombatBonusPercent") / 100
	local buff = activeBuffs(player).AttackPercent / 100
	local power = if powerProvider then powerProvider(player) else 1
	return baseAttack * power * (1 + combatBonus) * (1 + buff)
end

-- Everyone in the server, always including the caster.
local function everyone(player)
	local list = Players:GetPlayers()
	if not table.find(list, player) then
		table.insert(list, player)
	end
	return list
end

local function healPlayer(player, amount)
	local _, humanoid, root = getParts(player)
	if humanoid and amount >= 1 and humanoid.Health < humanoid.MaxHealth then
		local before = humanoid.Health
		humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + amount)
		local healed = math.floor(humanoid.Health - before)
		if healed >= 1 then
			fxRemote:FireAllClients("Damage", root.Position + Vector3.new(0, 3, 0), healed, "Heal")
		end
	end
end

-- Damages an enemy; `cfg.LifeSteal` (and life-steal buffs) heal the player.
local function hit(player, record, amount, knockback, cfg)
	if EnemyService.DamageEnemy(record.Model, amount, player, { Knockback = knockback }) then
		fxRemote:FireAllClients("Hit", record.Root.Position, record.Model, nil)
		local lifeSteal = (cfg and cfg.LifeSteal or 0) + activeBuffs(player).LifeSteal
		if lifeSteal > 0 then
			healPlayer(player, amount * lifeSteal)
		end
		return true
	end
	return false
end

-- Enemies in range, those in front first, then by distance.
local function enemiesNear(root, range)
	local look = flat(root.CFrame.LookVector).Unit
	local list = {}
	for _, record in EnemyService.GetEnemiesInRange(root.Position, range) do
		local offset = flat(record.Root.Position - root.Position)
		local inFront = offset.Magnitude < 1 or look:Dot(offset.Unit) > 0.3
		table.insert(list, { Record = record, Distance = offset.Magnitude, InFront = inFront })
	end
	table.sort(list, function(a, b)
		if a.InFront ~= b.InFront then
			return a.InFront
		end
		return a.Distance < b.Distance
	end)
	return list
end

local function distanceToSegment(point, a, b)
	local ab = flat(b - a)
	local ap = flat(point - a)
	local length = ab.Magnitude
	if length < 0.01 then
		return ap.Magnitude
	end
	local t = math.clamp(ap:Dot(ab) / (length * length), 0, 1)
	return (ap - ab * t).Magnitude
end

-- Lets other players' screens play the same move.
local function broadcastMove(player, moveName)
	if not moveName then
		return
	end
	for _, other in Players:GetPlayers() do
		if other ~= player then
			fxRemote:FireClient(other, "Swing", player, moveName)
		end
	end
end

--------------------------------------------------------------------------
-- What each kind of ability does
--------------------------------------------------------------------------
local Kinds = {}

-- A bolt from the sky on the best target, damaging everything around it.
function Kinds.Strike(player, root, cfg, level, color)
	local best = enemiesNear(root, cfg.Range)[1]
	local point = if best then best.Record.Root.Position else root.Position + flat(root.CFrame.LookVector).Unit * 12
	local damage = baseDamage(player) * AbilityConfig.DamageMultiplier(cfg.Id, level)
	for _, record in EnemyService.GetEnemiesInRange(point, cfg.Radius) do
		hit(player, record, damage, nil, cfg)
	end
	fxRemote:FireAllClients("Lightning", point, color, cfg.Radius)
end

-- Jumps from enemy to enemy, weaker each time.
function Kinds.Chain(player, root, cfg, level, color)
	local first = enemiesNear(root, cfg.Range)[1]
	local points = { root.Position + Vector3.new(0, 2, 0) }
	if first then
		local damage = baseDamage(player) * AbilityConfig.DamageMultiplier(cfg.Id, level)
		local current = first.Record
		local done = {}
		local jumps = cfg.Jumps + (cfg.JumpsPerLevel or 0) * (level - 1)
		for _ = 0, jumps do
			done[current] = true
			hit(player, current, damage)
			table.insert(points, current.Root.Position)
			damage *= cfg.Falloff
			local nextRecord, nextDistance = nil, math.huge
			for _, record in EnemyService.GetEnemiesInRange(current.Root.Position, cfg.JumpRange) do
				local d = (record.Root.Position - current.Root.Position).Magnitude
				if not done[record] and d < nextDistance then
					nextRecord, nextDistance = record, d
				end
			end
			if not nextRecord then
				break
			end
			current = nextRecord
		end
	else
		table.insert(points, root.Position + flat(root.CFrame.LookVector).Unit * 14 + Vector3.new(0, 2, 0))
	end
	fxRemote:FireAllClients("Chain", root.Position, color, points)
end

-- Several lightning pulses around the player.
function Kinds.Storm(player, _root, cfg, level, color)
	for pulse = 1, cfg.Pulses do
		task.delay((pulse - 1) * cfg.Interval + 0.3, function()
			local _, _, root = getParts(player)
			if not root then
				return
			end
			local damage = baseDamage(player) * AbilityConfig.DamageMultiplier(cfg.Id, level)
			local struck = 0
			for _, record in EnemyService.GetEnemiesInRange(root.Position, cfg.Radius) do
				if hit(player, record, damage, nil, cfg) and struck < 6 then
					struck += 1
					fxRemote:FireAllClients("Lightning", record.Root.Position, color, 3, cfg.Straight == true)
				end
			end
			fxRemote:FireAllClients("Shockwave", root.Position, color, cfg.Radius)
		end)
	end
end

-- A wide swing in front with knockback.
function Kinds.Cleave(player, root, cfg, level, color)
	local damage = baseDamage(player) * AbilityConfig.DamageMultiplier(cfg.Id, level)
	local look = flat(root.CFrame.LookVector).Unit
	for _, record in EnemyService.GetEnemiesInRange(root.Position, cfg.Range + 3) do
		local offset = flat(record.Root.Position - root.Position)
		if offset.Magnitude <= cfg.Range + 1.5 and (offset.Magnitude < 1.5 or look:Dot(offset.Unit) >= cfg.ArcDot) then
			hit(player, record, damage, cfg.Knockback)
		end
	end
	fxRemote:FireAllClients("Cleave", root.Position, color, root.CFrame.LookVector, cfg.Range)
end

-- Jump-slam: damage around the player when the sword hits the ground.
function Kinds.Slam(player, _root, cfg, level, color)
	task.delay(cfg.Delay, function()
		local _, _, root = getParts(player)
		if not root then
			return
		end
		local damage = baseDamage(player) * AbilityConfig.DamageMultiplier(cfg.Id, level)
		for _, record in EnemyService.GetEnemiesInRange(root.Position, cfg.Radius) do
			hit(player, record, damage, cfg.Knockback)
		end
		fxRemote:FireAllClients("Shockwave", root.Position, color, cfg.Radius)
	end)
end

-- A timed power-up with an aura.
function Kinds.Buff(player, _root, cfg, level, color)
	local st = state[player]
	st.Buffs[cfg.Id] = {
		Until = os.clock() + cfg.Duration,
		AttackPercent = (cfg.AttackPercent or 0) + (cfg.AttackPerLevel or 0) * (level - 1),
		SpeedPercent = cfg.SpeedPercent or 0,
		DamageTaken = cfg.DamageTaken or 1,
		LifeSteal = cfg.LifeSteal or 0,
		RegenPercent = cfg.RegenPercent or 0,
	}
	ProgressionService.RefreshStats(player) -- applies the speed bonus now
	task.delay(cfg.Duration + 0.05, function()
		if state[player] then
			activeBuffs(player) -- clears it
			ProgressionService.RefreshStats(player)
		end
	end)
	fxRemote:FireAllClients("Aura", Vector3.zero, color, player, cfg.Duration)
end

-- Upgraded dash: damages enemies along the dash path.
function Kinds.DashHit(player, root, cfg, level, color, direction)
	local start = root.Position
	local finish = start + direction * cfg.Distance
	local damage = baseDamage(player) * AbilityConfig.DamageMultiplier(cfg.Id, level)
	for _, record in EnemyService.GetEnemiesInRange(start, cfg.Distance + cfg.Width) do
		if distanceToSegment(record.Root.Position, start, finish) <= cfg.Width / 2 + record.Root.Size.X / 2 then
			hit(player, record, damage, cfg.Knockback, cfg)
		end
	end
	fxRemote:FireAllClients("DashTrail", start, color, finish)
	if cfg.HealPercent then
		local _, humanoid = getParts(player)
		if humanoid then
			healPlayer(player, humanoid.MaxHealth * cfg.HealPercent / 100)
		end
	end
	if cfg.ShieldTime then
		state[player].Buffs[cfg.Id] = {
			Until = os.clock() + cfg.ShieldTime,
			AttackPercent = 0, SpeedPercent = 0, DamageTaken = cfg.ShieldDamageTaken or 0.5,
		}
		fxRemote:FireAllClients("Aura", Vector3.zero, color, player, cfg.ShieldTime)
	end
end

-- A piercing line (water blast, spear, arrow): hits the first few enemies in front.
function Kinds.Line(player, root, cfg, level, color)
	local look = flat(root.CFrame.LookVector).Unit
	local start = root.Position
	local finish = start + look * cfg.Range
	local damage = baseDamage(player) * AbilityConfig.DamageMultiplier(cfg.Id, level)
	local inLine = {}
	for _, record in EnemyService.GetEnemiesInRange(start, cfg.Range + 3) do
		local offset = flat(record.Root.Position - start)
		local along = offset:Dot(look)
		if along >= -1 and along <= cfg.Range + 1 and distanceToSegment(record.Root.Position, start, finish) <= cfg.Width / 2 + record.Root.Size.X / 2 then
			table.insert(inLine, { Record = record, Along = along })
		end
	end
	table.sort(inLine, function(a, b)
		return a.Along < b.Along
	end)
	for i = 1, math.min(#inLine, cfg.Pierce or 1) do
		hit(player, inLine[i].Record, damage, cfg.Knockback, cfg)
	end
	fxRemote:FireAllClients("Beam", start + Vector3.new(0, 1, 0), color, finish + Vector3.new(0, 1, 0), cfg.Width)
end

-- A whirlpool in front: pulls enemies in, slows them, and damages them over time.
function Kinds.Pull(player, root, cfg, level, color)
	local center = root.Position + flat(root.CFrame.LookVector).Unit * cfg.Offset
	for _, record in EnemyService.GetEnemiesInRange(center, cfg.Radius) do
		local toward = flat(center - record.Root.Position)
		if toward.Magnitude > 1 then
			EnemyService.Push(record.Model, toward.Unit * 14, 0.5)
		end
		EnemyService.Slow(record.Model, cfg.Slow, cfg.SlowTime)
	end
	for tick = 1, cfg.Ticks do
		task.delay((tick - 1) * cfg.Interval + 0.2, function()
			local damage = baseDamage(player) * AbilityConfig.DamageMultiplier(cfg.Id, level)
			for _, record in EnemyService.GetEnemiesInRange(center, cfg.Radius) do
				hit(player, record, damage, 0, cfg)
			end
		end)
	end
	fxRemote:FireAllClients("Vortex", center, color, cfg.Radius, cfg.Ticks * cfg.Interval + 0.3)
end

-- A wave crashing forward in a cone.
function Kinds.Cone(player, root, cfg, level, color)
	local damage = baseDamage(player) * AbilityConfig.DamageMultiplier(cfg.Id, level)
	local look = flat(root.CFrame.LookVector).Unit
	for _, record in EnemyService.GetEnemiesInRange(root.Position, cfg.Range + 3) do
		local offset = flat(record.Root.Position - root.Position)
		if offset.Magnitude <= cfg.Range + 1.5 and (offset.Magnitude < 1.5 or look:Dot(offset.Unit) >= cfg.ArcDot) then
			hit(player, record, damage, cfg.Knockback, cfg)
		end
	end
	fxRemote:FireAllClients("Wave", root.Position, color, root.CFrame.LookVector, cfg.Range)
end

-- Spectral spirits circle the player and attack nearby enemies.
function Kinds.Summon(player, root, cfg, level, color)
	local character = root.Parent
	local count = math.floor(cfg.Count + (cfg.CountPerLevel or 0) * (level - 1))
	local spirits = {}
	for i = 1, count do
		local angle = (i / count) * math.pi * 2
		local orb = Instance.new("Part")
		orb.Name = "Spirit"
		orb.Shape = Enum.PartType.Ball
		orb.Size = Vector3.new(1.3, 1.3, 1.3)
		orb.Material = Enum.Material.Neon
		orb.Color = color
		orb.Transparency = 0.2
		orb.CanCollide = false
		orb.CanQuery = false
		orb.CanTouch = false
		orb.Massless = true
		orb.CFrame = root.CFrame * CFrame.new(math.cos(angle) * 3, 2.5, math.sin(angle) * 3)
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = orb
		weld.Parent = orb
		local light = Instance.new("PointLight")
		light.Color = color
		light.Range = 8
		light.Parent = orb
		orb.Parent = character
		table.insert(spirits, orb)
	end
	local ticks = math.floor(cfg.Duration / cfg.Interval)
	for tick = 1, ticks do
		task.delay(tick * cfg.Interval, function()
			local damage = baseDamage(player) * AbilityConfig.DamageMultiplier(cfg.Id, level)
			for _, orb in spirits do
				if orb.Parent then
					local best, bestDistance = nil, math.huge
					for _, record in EnemyService.GetEnemiesInRange(orb.Position, cfg.Range) do
						local d = (record.Root.Position - orb.Position).Magnitude
						if d < bestDistance then
							best, bestDistance = record, d
						end
					end
					if best and hit(player, best, damage, 0, cfg) then
						fxRemote:FireAllClients("Chain", orb.Position, color, { orb.Position, best.Root.Position })
					end
				end
			end
		end)
	end
	task.delay(cfg.Duration + 0.1, function()
		for _, orb in spirits do
			orb:Destroy()
		end
	end)
end

-- Parry: for a moment, hits against you are blocked and struck back.
function Kinds.Counter(player, _root, cfg, level, color)
	state[player].Counter = {
		Until = os.clock() + cfg.Duration,
		Multiplier = AbilityConfig.DamageMultiplier(cfg.Id, level),
		Color = color,
	}
	fxRemote:FireAllClients("Aura", Vector3.zero, color, player, cfg.Duration)
end

-- A great shield: you and nearby allies take less damage; enemies are blasted away.
function Kinds.Aegis(player, root, cfg, level, color)
	task.delay(0.5, function()
		local _, _, liveRoot = getParts(player)
		local center = if liveRoot then liveRoot.Position else root.Position
		local damage = baseDamage(player) * AbilityConfig.DamageMultiplier(cfg.Id, level)
		for _, record in EnemyService.GetEnemiesInRange(center, cfg.Radius) do
			hit(player, record, damage, cfg.Knockback, cfg)
		end
		for _, ally in everyone(player) do
			local _, _, allyRoot = getParts(ally)
			if allyRoot and state[ally] and (allyRoot.Position - center).Magnitude <= cfg.Radius then
				state[ally].Buffs["Aegis"] = {
					Until = os.clock() + cfg.Duration,
					AttackPercent = 0, SpeedPercent = 0, DamageTaken = cfg.DamageTaken,
				}
				fxRemote:FireAllClients("Aura", Vector3.zero, color, ally, cfg.Duration)
			end
		end
		fxRemote:FireAllClients("Dome", center, color, cfg.Radius, cfg.Duration)
		fxRemote:FireAllClients("Shockwave", center, color, cfg.Radius)
	end)
end

-- Heals you and nearby allies.
function Kinds.Heal(player, root, cfg, level, color)
	local percent = cfg.HealPercent + (cfg.HealPerLevel or 0) * (level - 1)
	for _, ally in everyone(player) do
		local _, humanoid, allyRoot = getParts(ally)
		if humanoid and (allyRoot.Position - root.Position).Magnitude <= cfg.Radius then
			healPlayer(ally, humanoid.MaxHealth * percent / 100)
		end
	end
	fxRemote:FireAllClients("HealBurst", root.Position, color, cfg.Radius)
end

--------------------------------------------------------------------------
-- Using abilities
--------------------------------------------------------------------------
local function setCooldown(player, slot, seconds)
	local st = state[player]
	st.ReadyAt[slot] = os.clock() + seconds
	player:SetAttribute("Cooldown_" .. slot, Workspace:GetServerTimeNow() + seconds)
end

-- Returns true if the ability was used.
function AbilityService.UseAbility(player, slot, direction)
	local st = state[player]
	local data = DataService.GetData(player)
	local _, _, root = getParts(player)
	if not st or not data or not root or player:GetAttribute("Blocking") == true then
		return false
	end
	local blessing, level = blessingForSlot(data, slot)
	if not blessing or level < 1 then
		return false -- locked, or this god has no ability here
	end
	local cfg = AbilityConfig.Abilities[blessing.Id]
	if not cfg or not Kinds[cfg.Kind] then
		return false
	end
	if os.clock() < (st.ReadyAt[slot] or 0) - 0.1 then
		return false -- still cooling down (small allowance for network timing)
	end
	setCooldown(player, slot, cfg.Cooldown)

	broadcastMove(player, cfg.Move)
	Kinds[cfg.Kind](player, root, cfg, level, godColor(player), direction)
	GameEvents.Fire("UseAbility", player, data.SelectedGod)
	return true
end

-- Called by CombatService after a dash: runs the god's dash ability if unlocked and ready.
function AbilityService.OnDash(player, direction)
	if typeof(direction) ~= "Vector3" or direction ~= direction then
		return
	end
	direction = flat(direction)
	if direction.Magnitude < 0.1 then
		return
	end
	AbilityService.UseAbility(player, "Dash", direction.Unit)
end

-- Athena's Counterattack: called by CombatService when an enemy hits the
-- player. Returns true if the hit was parried (and strikes back).
function AbilityService.TryCounter(player, attackerModel)
	local st = state[player]
	local counter = st and st.Counter
	if not counter or os.clock() > counter.Until then
		return false
	end
	if typeof(attackerModel) == "Instance" then
		local root = attackerModel:FindFirstChild("HumanoidRootPart")
		local damage = baseDamage(player) * counter.Multiplier
		if EnemyService.DamageEnemy(attackerModel, damage, player, { Knockback = 20 }) and root then
			fxRemote:FireAllClients("Hit", root.Position, attackerModel, nil)
			fxRemote:FireAllClients("Lightning", root.Position, counter.Color, 3, true)
		end
	end
	return true
end

-- { AttackPercent, SpeedPercent, DamageTaken, LifeSteal, RegenPercent } from active buffs.
function AbilityService.GetModifiers(player)
	return activeBuffs(player)
end

-- Phase 7E (Divine Incarnation): a timed buff from outside the ability system.
-- buff = { AttackPercent, SpeedPercent, DamageTaken, LifeSteal, RegenPercent }
function AbilityService.AddBuff(player, id, buff, duration)
	local st = state[player]
	if not st then
		return false
	end
	st.Buffs[id] = {
		Until = os.clock() + duration,
		AttackPercent = buff.AttackPercent or 0,
		SpeedPercent = buff.SpeedPercent or 0,
		DamageTaken = buff.DamageTaken or 1,
		LifeSteal = buff.LifeSteal or 0,
		RegenPercent = buff.RegenPercent or 0,
	}
	ProgressionService.RefreshStats(player)
	task.delay(duration + 0.05, function()
		if state[player] then
			activeBuffs(player) -- clears it
			ProgressionService.RefreshStats(player)
		end
	end)
	return true
end

function AbilityService.BaseDamage(player)
	return baseDamage(player)
end

-- Damages every enemy within `radius` of `position`. Returns how many were hit.
function AbilityService.DamageArea(player, position, radius, amount, knockback)
	local count = 0
	for _, record in EnemyService.GetEnemiesInRange(position, radius) do
		if hit(player, record, amount, knockback) then
			count += 1
		end
	end
	return count
end

function AbilityService.Heal(player, amount)
	healPlayer(player, amount)
end

function AbilityService.Init(dataService, progressionService, templeService, enemyService, godService, fxRemoteEvent, abilityRemote)
	DataService = dataService
	ProgressionService = progressionService
	TempleService = templeService
	EnemyService = enemyService
	GodService = godService
	fxRemote = fxRemoteEvent

	-- Speed from buffs joins the blessing bonuses that ProgressionService applies.
	ProgressionService.SetBonusProvider(function(player)
		local bonuses = GodService.GetBonuses(player)
		bonuses.SpeedPercent += activeBuffs(player).SpeedPercent
		return bonuses
	end)

	-- Healing-over-time buffs (Oceanic Ascension, Sun God Form).
	task.spawn(function()
		while true do
			task.wait(1)
			for player in state do
				local regen = activeBuffs(player).RegenPercent
				if regen > 0 then
					local _, humanoid = getParts(player)
					if humanoid then
						healPlayer(player, humanoid.MaxHealth * regen / 100)
					end
				end
			end
		end
	end)

	if abilityRemote then
		abilityRemote.OnServerEvent:Connect(function(player, slot, aim)
			if slot == "Q" or slot == "E" or slot == "R" or slot == "Form" then
				CombatService.ApplyAim(player, aim) -- face the aim dot (fighting areas only)
				AbilityService.UseAbility(player, slot)
			end
		end)
	end
end

function AbilityService.SetPowerProvider(provider)
	powerProvider = provider
end

function AbilityService.SetupPlayer(player)
	state[player] = { ReadyAt = {}, Buffs = {} }
	for _, slot in { "Q", "E", "R", "Form", "Dash" } do
		player:SetAttribute("Cooldown_" .. slot, 0)
	end
end

function AbilityService.ReleasePlayer(player)
	state[player] = nil
end

return AbilityService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">ArenaService</string>
          <string name="Source"><![CDATA[-- ArenaService (ModuleScript)
-- Location: ServerScriptService > Services > ArenaService
--
-- PvE arenas (Phase 5), all run by the server:
--   * The Arena Gate in Olympus Plaza opens the arena menu.
--   * Solo runs, or a party queue (up to 4) for one arena.
--   * Each run gets its own copy of the arena, built far from the hub.
--   * 5 waves (the last with a boss); enemies scale with party size.
--   * Players who die or leave are out; the run fails if nobody is left.
--   * Victory pays the arena's completion rewards; a failed run pays a part.
--   * Rewards are paid once per run; everyone is sent back to the plaza.
-- Run progress is published as player attributes for the HUD:
--   ArenaRunId, ArenaName, ArenaState, ArenaWave, ArenaWaves,
--   ArenaEnemiesLeft, ArenaTimerEnd (server time).

local GameEvents = require(script.Parent:WaitForChild("GameEvents"))
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ArenaConfig = require(Shared:WaitForChild("ArenaConfig"))
local CombatConfig = require(Shared:WaitForChild("CombatConfig"))
local WorldBuilder = require(ServerScriptService:WaitForChild("Services"):WaitForChild("WorldBuilder"))

local ArenaService = {}

local DataService = nil
local ProgressionService = nil
local PlotService = nil
local EnemyService = nil
local notifyRemote = nil
local arenaEvent = nil

local runs = {}      -- [runId] = run
local playerRun = {} -- [Player] = run
local queues = {}    -- [arenaId] = { Player, ... }
local slotUsed = {}  -- [slot] = true
local nextRunId = 0
local dropHandler = nil -- Phase 7C: function(player, bossTypes) -> { weapon names won }
local arenasFolder = nil

local ATTRIBUTES = { "ArenaRunId", "ArenaName", "ArenaState", "ArenaWave", "ArenaWaves", "ArenaEnemiesLeft", "ArenaTimerEnd" }

--------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------
local function message(player, text)
	if notifyRemote and player.Parent then
		notifyRemote:FireClient(player, "Message", text)
	end
end

local function aliveRoot(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and root and humanoid.Health > 0 then
		return root, humanoid
	end
	return nil
end

local function playerLevel(player)
	local data = DataService.GetData(player)
	return if data then data.Level else 0
end

local function now()
	return Workspace:GetServerTimeNow()
end

local function publish(run)
	for player in run.Players do
		if player.Parent then
			player:SetAttribute("ArenaRunId", run.Id)
			player:SetAttribute("ArenaName", run.Arena.DisplayName)
			player:SetAttribute("ArenaState", run.State)
			player:SetAttribute("ArenaWave", run.Wave)
			player:SetAttribute("ArenaWaves", #run.Arena.Waves)
			player:SetAttribute("ArenaEnemiesLeft", run.Remaining)
			player:SetAttribute("ArenaTimerEnd", run.TimerEnd or 0)
		end
	end
end

local function clearAttributes(player)
	for _, name in ATTRIBUTES do
		player:SetAttribute(name, nil)
	end
end

local function sendQueue(arenaId)
	local queue = queues[arenaId] or {}
	local names = {}
	for _, player in queue do
		table.insert(names, player.DisplayName)
	end
	for _, player in queue do
		arenaEvent:FireClient(player, "Queue", arenaId, names)
	end
end

local function leaveQueue(player)
	for arenaId, queue in queues do
		local index = table.find(queue, player)
		if index then
			table.remove(queue, index)
			sendQueue(arenaId)
			if player.Parent then
				arenaEvent:FireClient(player, "Queue", nil, {})
			end
		end
	end
end

--------------------------------------------------------------------------
-- Building an arena copy (placeholder geometry)
--------------------------------------------------------------------------
local function buildArena(center, arena)
	local model = Instance.new("Model")
	model.Name = "Arena_" .. arena.Id
	local MP = WorldBuilder.MakePart
	local R = arena.Radius or ArenaConfig.Radius
	local theme = arena.Theme or {}
	local stone = theme.Wall or Color3.fromRGB(176, 160, 130)

	MP(model, {
		Name = "Floor",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2, R * 2 + 6, R * 2 + 6),
		CFrame = CFrame.new(center - Vector3.new(0, 1, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Sandstone,
		Color = theme.Floor or Color3.fromRGB(196, 170, 125),
	})
	MP(model, {
		Name = "Centre",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, 14, 14),
		CFrame = CFrame.new(center + Vector3.new(0, 0.05, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Slate,
		Color = arena.Color or stone,
	})
	-- Ring wall of blocks and columns (keeps everyone inside)
	local segments = 24
	for i = 0, segments - 1 do
		local angle = (i / segments) * math.pi * 2
		local pos = center + Vector3.new(math.cos(angle) * (R + 1.5), 0, math.sin(angle) * (R + 1.5))
		MP(model, {
			Name = "Wall",
			Size = Vector3.new(2 * math.pi * (R + 1.5) / segments + 0.5, 10, 3),
			CFrame = CFrame.lookAt(pos + Vector3.new(0, 5, 0), center + Vector3.new(0, 5, 0)),
			Material = Enum.Material.Slate,
			Color = stone,
		})
		if i % 3 == 0 then
			MP(model, {
				Name = "Column",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(16, 3.5, 3.5),
				CFrame = CFrame.new(pos + Vector3.new(0, 8, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			})
			local fire = Instance.new("Fire")
			fire.Size = 6
			if theme.Fire then
				fire.Color = theme.Fire
				fire.SecondaryColor = Color3.new(1, 1, 1)
			end
			fire.Heat = 10
			fire.Parent = MP(model, {
				Name = "Torch",
				Size = Vector3.new(1.6, 0.6, 1.6),
				Position = pos + Vector3.new(0, 16.3, 0),
				Material = Enum.Material.Metal,
				Color = Color3.fromRGB(212, 175, 55),
			})
		end
	end
	local sign = MP(model, { Name = "Sign", Size = Vector3.new(1, 1, 1), Position = center + Vector3.new(0, 20, 0), Transparency = 1, CanCollide = false })
	WorldBuilder.AddLabel(sign, arena.DisplayName, arena.Color or Color3.new(1, 1, 1), 0)
	model.Parent = arenasFolder
	return model
end

--------------------------------------------------------------------------
-- Running a run
--------------------------------------------------------------------------
local finish -- forward declaration

local function spawnPoint(run, index, count)
	local angle = math.rad(-150 + 300 * ((index - 0.5) / math.max(count, 1))) - math.pi / 2
	local r = (run.Arena.Radius or ArenaConfig.Radius) - 8
	return run.Center + Vector3.new(math.cos(angle) * r, 0, math.sin(angle) * r)
end

local function onEnemyGone(run, model)
	if not run.Enemies[model] then
		return
	end
	run.Enemies[model] = nil
	run.Remaining -= 1
	publish(run)
	if run.Remaining > 0 or run.Finished or run.State ~= "Fighting" then
		return
	end
	run.Cleared = run.Wave
	if run.Wave >= #run.Arena.Waves then
		finish(run, true)
		return
	end
	run.State = "Intermission"
	run.TimerEnd = now() + ArenaConfig.IntermissionTime
	publish(run)
	task.delay(ArenaConfig.IntermissionTime, function()
		if not run.Finished then
			ArenaService._StartWave(run, run.Wave + 1)
		end
	end)
end

local function spawnEnemy(run, enemyType, position, isBoss)
	local partyExtra = run.PartySize - 1
	local party = ArenaConfig.Party
	local healthMultiplier = 1 + partyExtra * (if isBoss then party.BossHealthPerExtraPlayer else party.HealthPerExtraPlayer)
	-- Waves get harder: normal enemies get more health and damage each wave.
	local damageMultiplier = 1
	local speedMultiplier = 1
	if isBoss then
		healthMultiplier *= run.Arena.BossHealth or 1 -- e.g. a tougher boss in a trial
		damageMultiplier = run.Arena.BossDamage or 1 -- e.g. Olympian Challenges (Phase 7E)
		speedMultiplier = run.Arena.BossSpeed or 1
	end
	if not isBoss then
		local wave = math.max(run.Wave, 1)
		healthMultiplier *= (run.Arena.WaveHealth and run.Arena.WaveHealth[wave]) or 1
		damageMultiplier = (run.Arena.WaveDamage and run.Arena.WaveDamage[wave]) or 1
		speedMultiplier = (run.Arena.WaveSpeed and run.Arena.WaveSpeed[wave]) or 1
	end
	local cframe = CFrame.lookAt(position, Vector3.new(run.Center.X, position.Y, run.Center.Z))
	local model
	model = EnemyService.Spawn(enemyType, cframe, {
		HealthMultiplier = healthMultiplier,
		DamageMultiplier = damageMultiplier,
		SpeedMultiplier = speedMultiplier,
		AggroRange = (run.Arena.Radius or ArenaConfig.Radius) * 3, -- arena enemies always find you
		LeashRange = (run.Arena.Radius or ArenaConfig.Radius) * 3,
		Attributes = { RunId = run.Id, DisplayName = if isBoss then run.Arena.BossDisplayName else nil },
		OnDeath = function(deadModel)
			onEnemyGone(run, deadModel)
		end,
		OnPhase2 = function(bossModel)
			local cfg = CombatConfig.Enemies[enemyType]
			local phase2 = cfg.Phase2
			for player in run.Alive do
				message(player, phase2.Message or "The boss is enraged!")
			end
			local root = bossModel:FindFirstChild("HumanoidRootPart")
			local i = 0
			for addType, count in phase2.Summon or {} do
				for _ = 1, count do
					i += 1
					local base = if root then root.Position - Vector3.new(0, 3, 0) else run.Center
					local offset = Vector3.new(math.cos(i * 2.1) * 8, 0, math.sin(i * 2.1) * 8)
					spawnEnemy(run, addType, base + offset, false)
				end
			end
			publish(run) -- show the summoned enemies in "Enemies left"
		end,
	})
	if model then
		run.Enemies[model] = true
		run.Remaining += 1
		if isBoss then
			run.BossTypes[enemyType] = true
		end
	end
	return model
end

function ArenaService._StartWave(run, index)
	run.Wave = index
	run.State = "Fighting"
	run.TimerEnd = 0
	local wave = run.Arena.Waves[index]
	local extra = (run.PartySize - 1) * ArenaConfig.Party.CountPerExtraPlayer

	-- Work out the list first, so the remaining count is right from the start.
	local list = {}
	if wave.Boss then
		table.insert(list, { wave.Boss, true })
	end
	for enemyType, count in wave do
		if enemyType ~= "Boss" then
			for _ = 1, math.floor(count * (1 + extra) + 0.5) do
				table.insert(list, { enemyType, false })
			end
		end
	end
	for i, entry in list do
		local position = if entry[2] then run.Center + Vector3.new(0, 0, -(run.Arena.Radius or ArenaConfig.Radius) + 16) else spawnPoint(run, i, #list)
		spawnEnemy(run, entry[1], position, entry[2])
	end
	publish(run)
	for player in run.Alive do
		message(player, if wave.Boss then "Final wave: the boss appears!" else ("Wave %d of %d"):format(index, #run.Arena.Waves))
	end
end

local function returnHome(player)
	if player.Parent then
		PlotService.TeleportPlayer(player, "Plaza")
		clearAttributes(player)
	end
	playerRun[player] = nil
end

local function cleanup(run)
	for model in run.Enemies do
		EnemyService.Remove(model)
	end
	run.Enemies = {}
	if run.Model then
		run.Model:Destroy()
	end
	for _, connection in run.Connections do
		connection:Disconnect()
	end
	slotUsed[run.Slot] = nil
	runs[run.Id] = nil
end

finish = function(run, victory)
	if run.Finished then
		return
	end
	run.Finished = true
	run.State = if victory then "Victory" else "Failed"
	run.TimerEnd = now() + ArenaConfig.ReturnDelay

	-- Remaining enemies vanish (no rewards for them).
	for model in run.Enemies do
		EnemyService.Remove(model)
	end
	run.Enemies = {}
	run.Remaining = 0
	publish(run)
	if victory then
		for player in run.Players do
			GameEvents.Fire("WinArena", player, run.Arena.Id)
		end
	end
	if victory and run.OnVictory then
		task.spawn(run.OnVictory, run) -- e.g. an ascension trial ranks the player up
	end

	local rewards = run.Arena.Rewards or {}
	local multiplier = if victory then 1 else ArenaConfig.FailRewardMultiplier * (run.Cleared / #run.Arena.Waves)
	local elapsed = math.floor(os.clock() - run.StartedAt)
	for player in run.Players do
		if player.Parent and DataService.GetData(player) then
			local paid = {}
			for currency, amount in rewards do
				local value = math.floor(amount * multiplier)
				if currency == "Ambrosia" and not victory then
					value = 0 -- Ambrosia only for winning
				end
				if value > 0 then
					if currency == "XP" then
						ProgressionService.AddXP(player, value, "Arena")
					else
						ProgressionService.AddCurrency(player, currency, value, "Arena")
					end
					paid[currency] = value
				end
			end
			local weapons = if victory and dropHandler then dropHandler(player, run.BossTypes) else {}
			arenaEvent:FireClient(player, "Result", {
				Weapons = weapons,
				Victory = victory,
				Arena = run.Arena.DisplayName,
				WavesCleared = run.Cleared,
				Waves = #run.Arena.Waves,
				Seconds = elapsed,
				Rewards = paid,
			})
		end
	end

	task.delay(ArenaConfig.ReturnDelay, function()
		for player in run.Players do
			if playerRun[player] == run then
				returnHome(player)
			end
		end
		cleanup(run)
	end)
end

-- A player stops taking part (died, left the arena or the game).
local function playerOut(run, player)
	if not run.Alive[player] then
		return
	end
	run.Alive[player] = nil
	if not run.Finished and next(run.Alive) == nil then
		finish(run, false)
	end
end

-- `arena` is an ArenaConfig entry, or a trial built by StartTrial.
local function startRun(arena, members, onVictory)
	if not arena or not arena.Available then
		return false, "That arena isn't open yet."
	end
	local slot = nil
	for i = 1, ArenaConfig.MaxRuns do
		if not slotUsed[i] then
			slot = i
			break
		end
	end
	if not slot then
		return false, "All arenas are busy. Try again in a minute."
	end
	local ready = {}
	for _, player in members do
		if player.Parent and not playerRun[player] and aliveRoot(player) and playerLevel(player) >= arena.MinLevel then
			table.insert(ready, player)
		end
	end
	if #ready == 0 then
		return false, ("You need level %d and to be alive to enter."):format(arena.MinLevel)
	end

	slotUsed[slot] = true
	nextRunId += 1
	local center = ArenaConfig.Origin + Vector3.new((slot - 1) * ArenaConfig.SlotSpacing, 0, 0)
	local run = {
		Id = nextRunId,
		Arena = arena,
		Slot = slot,
		Center = center,
		Players = {},
		Alive = {},
		PartySize = #ready,
		Wave = 0,
		Cleared = 0,
		Remaining = 0,
		Enemies = {},
		State = "Countdown",
		TimerEnd = now() + ArenaConfig.CountdownTime,
		Finished = false,
		StartedAt = os.clock(),
		Connections = {},
		OnVictory = onVictory,
		BossTypes = {},
	}
	runs[run.Id] = run
	run.Model = buildArena(center, arena)

	for i, player in ready do
		leaveQueue(player)
		run.Players[player] = true
		run.Alive[player] = true
		playerRun[player] = run
		local pos = center + Vector3.new((i - (#ready + 1) / 2) * 5, 3, (arena.Radius or ArenaConfig.Radius) - 10)
		player.Character:PivotTo(CFrame.lookAt(pos, Vector3.new(center.X, pos.Y, center.Z)))
		local _, humanoid = aliveRoot(player)
		if humanoid then
			table.insert(run.Connections, humanoid.Died:Connect(function()
				playerOut(run, player)
			end))
		end
	end
	publish(run)
	task.delay(ArenaConfig.CountdownTime, function()
		if not run.Finished then
			ArenaService._StartWave(run, 1)
		end
	end)
	return true, run
end

--------------------------------------------------------------------------
-- Requests
--------------------------------------------------------------------------
function ArenaService.StartSolo(player, arenaId)
	if playerRun[player] then
		return false
	end
	local ok, result = startRun(ArenaConfig.ById[arenaId], { player })
	if not ok then
		message(player, result)
	end
	return ok, result
end

-- Phase 6: a solo ascension trial. `trial` is an AscensionConfig.Trials entry;
-- onVictory(run) is called once if the player wins.
function ArenaService.StartTrial(player, trial, onVictory)
	if playerRun[player] then
		return false
	end
	local arena = {
		Id = trial.ArenaId or ("Trial_" .. trial.Id),
		DisplayName = trial.DisplayName or ("Trial: " .. trial.Name),
		Available = true,
		MinLevel = 0,
		Color = trial.Color,
		Waves = trial.Waves,
		WaveHealth = trial.WaveHealth,
		WaveDamage = trial.WaveDamage,
		WaveSpeed = trial.WaveSpeed,
		BossHealth = trial.BossHealth,
		BossDamage = trial.BossDamage,
		BossSpeed = trial.BossSpeed,
		BossDisplayName = trial.BossDisplayName,
		Theme = trial.Theme,
		Radius = trial.Radius,
		Rewards = trial.Rewards or {}, -- trials pay nothing extra; challenges do
	}
	leaveQueue(player)
	local ok, result = startRun(arena, { player }, onVictory)
	if not ok then
		message(player, result)
	end
	return ok, result
end

function ArenaService.JoinQueue(player, arenaId)
	local arena = ArenaConfig.ById[arenaId]
	if not arena or playerRun[player] then
		return false
	end
	local data = DataService.GetData(player)
	local reason = ArenaConfig.LockReason(arena, playerLevel(player), data and data.RankIndex or 1)
	if reason then
		message(player, reason .. " to enter " .. arena.DisplayName .. ".")
		return false
	end
	leaveQueue(player)
	queues[arenaId] = queues[arenaId] or {}
	if #queues[arenaId] >= ArenaConfig.Party.MaxPlayers then
		message(player, "That party is full.")
		return false
	end
	table.insert(queues[arenaId], player)
	sendQueue(arenaId)
	return true
end

function ArenaService.StartParty(player)
	for arenaId, queue in queues do
		if table.find(queue, player) then
			local members = table.clone(queue)
			local ok, result = startRun(ArenaConfig.ById[arenaId], members)
			if not ok then
				message(player, result)
			end
			return ok, result
		end
	end
	return false
end

-- Leaving: during a run you're out; after it you just go home early.
function ArenaService.Leave(player)
	local run = playerRun[player]
	if not run then
		return false
	end
	playerOut(run, player)
	returnHome(player)
	return true
end

function ArenaService.SetDropHandler(handler)
	dropHandler = handler
end

function ArenaService.IsInRun(player)
	return playerRun[player] ~= nil
end

--------------------------------------------------------------------------
-- Arena Gate in Olympus Plaza
--------------------------------------------------------------------------
function ArenaService.BuildGate()
	local hub = Workspace:WaitForChild("Hub")
	local marker = hub:FindFirstChild("Arena Gate")
	if marker then
		marker:Destroy() -- the old "coming in Phase 5" marker
	end
	if hub:FindFirstChild("ArenaGate") then
		return
	end
	local gate = Instance.new("Model")
	gate.Name = "ArenaGate"
	local MP = WorldBuilder.MakePart
	local base = Vector3.new(-44, 1, 0)
	local bronze = Color3.fromRGB(150, 95, 45)
	for _, z in { -5, 5 } do
		MP(gate, {
			Name = "Pillar",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(14, 2.4, 2.4),
			CFrame = CFrame.new(base + Vector3.new(0, 7, z)) * CFrame.Angles(0, 0, math.rad(90)),
		})
	end
	MP(gate, { Name = "Lintel", Size = Vector3.new(3, 2, 13), Position = base + Vector3.new(0, 15, 0), Material = Enum.Material.Metal, Color = bronze })
	local portal = MP(gate, {
		Name = "Portal",
		Size = Vector3.new(0.4, 13, 8),
		Position = base + Vector3.new(0, 7.5, 0),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(230, 90, 50),
		Transparency = 0.35,
		CanCollide = false,
	})
	WorldBuilder.AddLabel(portal, "Arena Gate", Color3.fromRGB(255, 140, 90), 9)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Open"
	prompt.ObjectText = "Arena Gate"
	prompt.HoldDuration = 0.2
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = portal
	prompt.Triggered:Connect(function(player)
		notifyRemote:FireClient(player, "OpenArenaMenu")
	end)
	gate.Parent = hub
end

--------------------------------------------------------------------------
-- Setup
--------------------------------------------------------------------------
function ArenaService.Init(dataService, progressionService, plotService, enemyService, notifyRemoteEvent, arenaActionRemote, arenaEventRemote)
	DataService = dataService
	ProgressionService = progressionService
	PlotService = plotService
	EnemyService = enemyService
	notifyRemote = notifyRemoteEvent
	arenaEvent = arenaEventRemote

	arenasFolder = Workspace:FindFirstChild("Arenas") or Instance.new("Folder")
	arenasFolder.Name = "Arenas"
	arenasFolder.Parent = Workspace

	if arenaActionRemote then
		local last = {}
		arenaActionRemote.OnServerEvent:Connect(function(player, action, arg)
			local t = os.clock()
			if last[player] and t - last[player] < 0.5 then
				return
			end
			last[player] = t
			if action == "StartSolo" and type(arg) == "string" then
				ArenaService.StartSolo(player, arg)
			elseif action == "JoinQueue" and type(arg) == "string" then
				ArenaService.JoinQueue(player, arg)
			elseif action == "LeaveQueue" then
				leaveQueue(player)
			elseif action == "StartParty" then
				ArenaService.StartParty(player)
			elseif action == "Leave" then
				ArenaService.Leave(player)
			end
		end)
	end
end

function ArenaService.ReleasePlayer(player)
	leaveQueue(player)
	local run = playerRun[player]
	if run then
		playerOut(run, player)
		run.Players[player] = nil
		playerRun[player] = nil
	end
end

-- Test helpers
function ArenaService._GetRun(player)
	return playerRun[player]
end
function ArenaService._PlayerOut(player)
	local run = playerRun[player]
	if run then
		playerOut(run, player)
	end
end

return ArenaService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">AscensionService</string>
          <string name="Source"><![CDATA[-- AscensionService (ModuleScript)
-- Location: ServerScriptService > Services > AscensionService
--
-- Phase 6, ascension:
--   * Builds the Ascension Chamber in Olympus Plaza (8 rank pillars + altar).
--   * Trials: at the top level of your rank you can start the trial for the
--     next rank (a solo arena run). Winning it calls
--     ProgressionService.AdvanceRank, which raises the rank and the level cap.
--   * Rank looks: each rank makes the character bigger and broader (applied
--     to the player's OWN avatar proportions) and adds outfit pieces and,
--     from Demigod up, an aura (see RankOutfits / AscensionConfig).
--   * Ranking up plays a pillar-of-light effect for everyone nearby.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local GodConfig = require(Shared:WaitForChild("GodConfig"))
local Progression = require(Shared:WaitForChild("Progression"))
local AscensionConfig = require(Shared:WaitForChild("AscensionConfig"))
local RankOutfits = require(Shared:WaitForChild("RankOutfits"))
local WorldBuilder = require(ServerScriptService:WaitForChild("Services"):WaitForChild("WorldBuilder"))

local AscensionService = {}

local DataService = nil
local DiagnosticsService = nil
local ProgressionService = nil
local ArenaService = nil
local notifyRemote = nil
local fxRemote = nil

local originalScales = {} -- [Player] = the avatar's own body scales
local applyToken = {}     -- [Player] = number, so only the newest ApplyLooks finishes

local CHAMBER_CENTER = Vector3.new(44, 1, 0)

local function message(player, text)
	if notifyRemote and player.Parent then
		notifyRemote:FireClient(player, "Message", text)
	end
end

local function note(player, text)
	if DiagnosticsService then
		DiagnosticsService.Note(player, text)
	end
end

local function godColor(data)
	return GodConfig.GetColors(data and data.SelectedGod or "").Primary
end

--------------------------------------------------------------------------
-- Rank looks
--------------------------------------------------------------------------
local function applyPhysique(player, character, rank)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local ok, description = pcall(function()
		return humanoid:GetAppliedDescription()
	end)
	if not ok or not description then
		note(player, "GetAppliedDescription failed: " .. tostring(description))
		return
	end
	local base = originalScales[player]
	if not base then
		base = {
			Height = description.HeightScale,
			Width = description.WidthScale,
			Depth = description.DepthScale,
			Head = description.HeadScale,
		}
		originalScales[player] = base
	end
	local scale = AscensionConfig.Physique[rank] or AscensionConfig.Physique[1]
	local target = {
		HeightScale = base.Height * scale.Height,
		WidthScale = base.Width * scale.Width,
		DepthScale = base.Depth * scale.Depth,
		HeadScale = base.Head * scale.Head,
	}
	local changed = false
	for property, value in target do
		if math.abs(description[property] - value) > 0.001 then
			description[property] = value
			changed = true
		end
	end
	if changed then
		local applied, err = pcall(function()
			humanoid:ApplyDescription(description)
		end)
		if not applied then
			note(player, "ApplyDescription failed: " .. tostring(err))
		end
	end
end

-- Size + outfit + aura for the player's current rank.
function AscensionService.ApplyLooks(player)
	local data = DataService.GetData(player)
	local character = player.Character
	if not data or not character or not character.Parent then
		return
	end
	applyToken[player] = (applyToken[player] or 0) + 1
	local token = applyToken[player]
	applyPhysique(player, character, data.RankIndex)
	if applyToken[player] ~= token or player.Character ~= character then
		return -- a newer call (or a new character) took over
	end
	RankOutfits.Apply(character, data.RankIndex, godColor(data))
	character:SetAttribute("LooksRank", data.RankIndex)
end


-- Just the outfit colours (e.g. after changing god).
local function refreshOutfit(player)
	local data = DataService.GetData(player)
	if data and player.Character then
		RankOutfits.Apply(player.Character, data.RankIndex, godColor(data))
	end
end

function AscensionService.OnRankUp(player)
	local data = DataService.GetData(player)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if root then
		fxRemote:FireAllClients("Ascend", root.Position, godColor(data), player)
	end
	task.spawn(AscensionService.ApplyLooks, player)
end

--------------------------------------------------------------------------
-- Trials
--------------------------------------------------------------------------
-- The next trial and whether it can be started now. Returns trial, reason.
function AscensionService.NextTrial(player)
	local data = DataService.GetData(player)
	if not data then
		return nil, "Your data isn't loaded."
	end
	if data.RankIndex >= #GameConfig.Ranks then
		return nil, "You are already an Elder God."
	end
	local trial = AscensionConfig.Trials[data.RankIndex + 1]
	local cap = Progression.GetLevelCap(data.RankIndex)
	if data.Level < cap then
		return trial, ("Reach level %d first (you are level %d)."):format(cap, data.Level)
	end
	if not trial.Available then
		return trial, trial.Description
	end
	return trial, nil
end

function AscensionService.StartTrial(player)
	local trial, reason = AscensionService.NextTrial(player)
	if reason then
		message(player, reason)
		return false
	end
	if trial.Divine then
		-- The Divine Trial's boss is the Avatar of the player's own god.
		local data = DataService.GetData(player)
		local god = data and GodConfig.Gods[data.SelectedGod]
		trial = table.clone(trial)
		trial.BossDisplayName = "Avatar of " .. (if god then god.DisplayName else "Olympus")
	end
	local ok = ArenaService.StartTrial(player, trial, function(run)
		if not run.Players[player] or not player.Parent then
			return
		end
		local advanced, text = ProgressionService.AdvanceRank(player, trial.Id)
		if advanced then
			AscensionService.OnRankUp(player)
			message(player, text)
		end
	end)
	return ok
end

--------------------------------------------------------------------------
-- Ascension Chamber (placeholder build in Olympus Plaza)
--------------------------------------------------------------------------
function AscensionService.BuildChamber()
	local hub = Workspace:WaitForChild("Hub")
	local marker = hub:FindFirstChild("Ascension Chamber")
	if marker then
		marker:Destroy() -- the old "coming in Phase 6" marker
	end
	if hub:FindFirstChild("AscensionChamber") then
		return
	end
	local chamber = Instance.new("Model")
	chamber.Name = "AscensionChamber"
	local MP = WorldBuilder.MakePart
	local c = CHAMBER_CENTER

	MP(chamber, {
		Name = "Dais",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.8, 22, 22),
		CFrame = CFrame.new(c + Vector3.new(0, 0.4, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(240, 236, 226),
	})
	-- One pillar per rank; its top glows on YOUR screen once you reach that rank.
	for i, rank in GameConfig.Ranks do
		local angle = math.rad(-90 + (i - 1) * 45)
		local pos = c + Vector3.new(math.cos(angle) * 9, 0.8, math.sin(angle) * 9)
		local height = 3 + i * 0.6
		MP(chamber, {
			Name = "Pillar" .. i,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(height, 1.6, 1.6),
			CFrame = CFrame.new(pos + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		})
		local top = MP(chamber, {
			Name = "RankGlow" .. i,
			Size = Vector3.new(1.4, 1.4, 1.4),
			CFrame = CFrame.new(pos + Vector3.new(0, height + 0.9, 0)) * CFrame.Angles(0, math.rad(45), 0),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(150, 150, 160),
		})
		top:SetAttribute("RankIndex", i)
		WorldBuilder.AddLabel(top, rank.Name, rank.Color, 2)
	end
	local altar = MP(chamber, {
		Name = "Altar",
		Size = Vector3.new(4, 3, 4),
		Position = c + Vector3.new(0, 2.3, 0),
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(212, 175, 55),
	})
	WorldBuilder.AddLabel(altar, "Ascension Chamber", Color3.fromRGB(120, 200, 255), 6)
	MP(chamber, {
		Name = "Beam",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(40, 1.2, 1.2),
		CFrame = CFrame.new(c + Vector3.new(0, 23.8, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 236, 170),
		Transparency = 0.6,
		CanCollide = false,
	})
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Ascend"
	prompt.ObjectText = "Ascension Chamber"
	prompt.HoldDuration = 0.2
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = altar
	prompt.Triggered:Connect(function(player)
		notifyRemote:FireClient(player, "OpenAscension")
	end)
	chamber.Parent = hub
end

--------------------------------------------------------------------------
-- Setup
--------------------------------------------------------------------------
function AscensionService.Init(dataService, progressionService, arenaService, notifyRemoteEvent, fxRemoteEvent, ascensionRemote, diagnosticsService)
	DataService = dataService
	DiagnosticsService = diagnosticsService

	-- Safety net: every 2 s, make sure everyone shows their rank looks
	-- (avatar loading can replace body parts after we applied them).
	task.spawn(function()
		local failures = {}
		while true do
			task.wait(2)
			for player in originalScales do
				if player.Parent == nil then
					originalScales[player] = nil
				end
			end
			for _, player in game:GetService("Players"):GetPlayers() do
				local data = DataService.GetData(player)
				local character = player.Character
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				if data and humanoid and humanoid.Health > 0 then
					local missingOutfit = data.RankIndex >= 2 and not character:FindFirstChild(RankOutfits.Name)
					if character:GetAttribute("LooksRank") ~= data.RankIndex or missingOutfit then
						local ok, err = pcall(AscensionService.ApplyLooks, player)
						if not ok then
							failures[player] = (failures[player] or 0) + 1
							if failures[player] <= 3 then
								note(player, "ApplyLooks error: " .. tostring(err))
							end
						end
					end
				end
			end
		end
	end)
	ProgressionService = progressionService
	ArenaService = arenaService
	notifyRemote = notifyRemoteEvent
	fxRemote = fxRemoteEvent

	if ascensionRemote then
		local last = {}
		ascensionRemote.OnServerEvent:Connect(function(player, action)
			local t = os.clock()
			if last[player] and t - last[player] < 1 then
				return
			end
			last[player] = t
			if action == "StartTrial" then
				AscensionService.StartTrial(player)
			end
		end)
	end
end

function AscensionService.SetupPlayer(player)
	-- Looks are applied once the avatar has fully loaded (body parts arrive late).
	if typeof(player) == "Instance" then
		player.CharacterAppearanceLoaded:Connect(function()
			AscensionService.ApplyLooks(player)
		end)
		if player.Character and player:HasAppearanceLoaded() then
			task.spawn(AscensionService.ApplyLooks, player)
		end
	elseif player.Character then
		task.spawn(AscensionService.ApplyLooks, player)
	end
	player:GetAttributeChangedSignal("SelectedGod"):Connect(function()
		refreshOutfit(player)
	end)
end

function AscensionService.ReleasePlayer(player)
	originalScales[player] = nil
	applyToken[player] = nil
end

return AscensionService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">ChallengeService</string>
          <string name="Source"><![CDATA[-- ChallengeService (ModuleScript)
-- Location: ServerScriptService > Services > ChallengeService
--
-- Phase 7E: the Titan Gate (west of the plaza, beside the Arena Gate) and
-- Olympian Challenges: harder boss rematches and the Olympian Gauntlet
-- (settings in Shared/ChallengeConfig). A challenge runs as a solo arena run
-- through ArenaService.StartTrial, with stronger bosses and bigger rewards.
-- Clears and best times are saved in data.Challenges and sent to the client
-- as attribute "ChallengesJson".

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ChallengeConfig = require(Shared:WaitForChild("ChallengeConfig"))
local WorldBuilder = require(script.Parent:WaitForChild("WorldBuilder"))
local GameEvents = require(script.Parent:WaitForChild("GameEvents"))

local ChallengeService = {}

local DataService = nil
local ArenaService = nil
local notifyRemote = nil

local function message(player, text)
	if notifyRemote and player.Parent then
		notifyRemote:FireClient(player, "Message", text)
	end
end

local function records(data)
	if type(data.Challenges) ~= "table" then
		data.Challenges = {}
	end
	return data.Challenges
end

local function push(player, data)
	player:SetAttribute("ChallengesJson", HttpService:JSONEncode(records(data)))
end

-- Builds the run description handed to ArenaService.
local function buildRun(challenge, difficulty, firstClear)
	local waveHealth, waveDamage, waveSpeed = {}, {}, {}
	for i = 1, #challenge.Waves do
		waveHealth[i] = difficulty.AddHealth
		waveDamage[i] = difficulty.AddDamage
		waveSpeed[i] = difficulty.Speed
	end
	local rewards = {}
	for currency, amount in challenge.Rewards do
		rewards[currency] = math.floor(amount * difficulty.Reward)
	end
	if firstClear then
		rewards.Ambrosia = (rewards.Ambrosia or 0) + difficulty.FirstClearAmbrosia
	end
	return {
		Id = challenge.Id,
		ArenaId = "Challenge_" .. challenge.Id,
		Name = challenge.Name,
		DisplayName = ("%s (%s)"):format(challenge.Name, difficulty.Name),
		Color = difficulty.Color,
		Waves = challenge.Waves,
		WaveHealth = waveHealth,
		WaveDamage = waveDamage,
		WaveSpeed = waveSpeed,
		BossHealth = difficulty.BossHealth,
		BossDamage = difficulty.BossDamage,
		BossSpeed = difficulty.Speed,
		Theme = challenge.Theme,
		Radius = challenge.Radius,
		Rewards = rewards,
	}
end

function ChallengeService.Start(player, challengeId, difficultyId)
	local data = DataService.GetData(player)
	local challenge = ChallengeConfig.ById[challengeId]
	local difficulty = ChallengeConfig.Difficulties[difficultyId]
	if not data or not challenge or not difficulty then
		return false
	end
	if ArenaService.IsInRun(player) then
		message(player, "You're already in a fight.")
		return false
	end
	local reason = ChallengeConfig.LockReason(challenge, difficultyId, data.RankIndex)
	if reason then
		message(player, ("%s: %s."):format(challenge.Name, reason))
		return false
	end
	local key = ChallengeConfig.Key(challengeId, difficultyId)
	local firstClear = records(data)[key] == nil
	local run = buildRun(challenge, difficulty, firstClear)
	local ok = ArenaService.StartTrial(player, run, function(finishedRun)
		local current = DataService.GetData(player)
		if not current then
			return
		end
		local seconds = math.floor(os.clock() - finishedRun.StartedAt)
		local record = records(current)[key] or { Clears = 0, Best = 0 }
		record.Clears += 1
		local newBest = record.Best == 0 or seconds < record.Best
		if newBest then
			record.Best = seconds
		end
		records(current)[key] = record
		push(player, current)
		GameEvents.Fire("WinChallenge", player, challengeId)
		if firstClear then
			message(player, ("First %s clear of %s! +%d bonus Ambrosia."):format(difficulty.Name, challenge.Name, difficulty.FirstClearAmbrosia))
		elseif newBest then
			message(player, ("New best time: %d:%02d!"):format(seconds // 60, seconds % 60))
		end
	end)
	return ok
end

function ChallengeService.BuildGate()
	local hub = Workspace:WaitForChild("Hub")
	local marker = hub:FindFirstChild("Titan Gate")
	if marker then
		marker:Destroy() -- the old placeholder pad
	end
	if hub:FindFirstChild("TitanGate") then
		return
	end
	local gate = Instance.new("Model")
	gate.Name = "TitanGate"
	local MP = WorldBuilder.MakePart
	local base = Vector3.new(-44, 1, 35)
	local stone = Color3.fromRGB(70, 60, 85)
	local purple = Color3.fromRGB(150, 70, 200)
	-- Two huge dark pillars, a heavy lintel, and a purple portal.
	for _, z in { -6, 6 } do
		MP(gate, {
			Name = "Pillar", Size = Vector3.new(4, 20, 4), Position = base + Vector3.new(0, 10, z),
			Material = Enum.Material.Slate, Color = stone,
		})
		MP(gate, {
			Name = "PillarCap", Size = Vector3.new(5.5, 1.5, 5.5), Position = base + Vector3.new(0, 20.5, z),
			Material = Enum.Material.Slate, Color = stone,
		})
		MP(gate, {
			Name = "Rune", Size = Vector3.new(0.3, 12, 1), Position = base + Vector3.new(2.1, 10, z),
			Material = Enum.Material.Neon, Color = purple, CanCollide = false,
		})
	end
	MP(gate, { Name = "Lintel", Size = Vector3.new(5, 3, 17), Position = base + Vector3.new(0, 22.5, 0), Material = Enum.Material.Slate, Color = stone })
	local portal = MP(gate, {
		Name = "Portal", Size = Vector3.new(0.4, 19, 8), Position = base + Vector3.new(0, 10.5, 0),
		Material = Enum.Material.Neon, Color = purple, Transparency = 0.3, CanCollide = false,
	})
	WorldBuilder.AddLabel(portal, "Titan Gate", Color3.fromRGB(200, 140, 255), 13)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Open"
	prompt.ObjectText = "Titan Gate (Olympian Challenges)"
	prompt.HoldDuration = 0.2
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = portal
	prompt.Triggered:Connect(function(player)
		notifyRemote:FireClient(player, "OpenTitanGate")
	end)
	gate.Parent = hub
end

function ChallengeService.Init(dataService, arenaService, notifyRemoteEvent, challengeRemote)
	DataService = dataService
	ArenaService = arenaService
	notifyRemote = notifyRemoteEvent
	if challengeRemote then
		local last = {}
		challengeRemote.OnServerEvent:Connect(function(player, action, challengeId, difficultyId)
			local t = os.clock()
			if last[player] and t - last[player] < 0.5 then
				return
			end
			last[player] = t
			if action == "Start" and type(challengeId) == "string" and type(difficultyId) == "string" then
				ChallengeService.Start(player, challengeId, difficultyId)
			end
		end)
	end
end

function ChallengeService.SetupPlayer(player)
	local data = DataService.GetData(player)
	if data then
		push(player, data)
	end
end

return ChallengeService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">CombatService</string>
          <string name="Source"><![CDATA[-- CombatService (ModuleScript)
-- Location: ServerScriptService > Services > CombatService
--
-- The player side of combat, all checked on the server:
--   * Basic attack: the client only says "I swung". The server checks the
--     cooldown, finds enemies in front of the player, and works out damage
--     (BaseAttack incl. blessings, x Training Grounds bonus).
--   * Block: less damage taken, slower movement, can't attack.
--   * Dash: the client moves itself; the server grants a short moment where
--     you can't be hit (with its own cooldown, so it can't be spammed).
--   * Damage to players (from enemies), damage numbers.
--   * Health regeneration (replaces Roblox's default), boosted by the
--     Divine Fountain.
--   * Gives every player a placeholder sword welded into their hand that
--     glows in their god's colour and leaves a light trail when swung.
--     Real weapons come in Phase 7. The swing animations themselves are
--     played on each device by SwordAnimator.
--
-- Other systems call: CombatService.DamagePlayer(player, amount, sourcePosition)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local PhysicsService = game:GetService("PhysicsService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CombatConfig = require(Shared:WaitForChild("CombatConfig"))
local GodConfig = require(Shared:WaitForChild("GodConfig"))
local SwordBuilder = require(Shared:WaitForChild("SwordBuilder"))
local SwordPoses = require(Shared:WaitForChild("SwordPoses"))

local CombatService = {}

local TempleService = nil
local EnemyService = nil
local fxRemote = nil
local modifierProvider = nil -- Phase 4B: function(player) -> { AttackPercent, DamageTaken }
local dashHandler = nil      -- Phase 4B: function(player, direction) for god dash abilities
local counterHandler = nil   -- Phase 7A: function(player, attackerModel) -> true if the hit was parried
local weaponProvider = nil   -- Phase 7C: function(player) -> equipped weapon stats (InventoryService.GetEquipped)

local function modifiers(player)
	return if modifierProvider then modifierProvider(player) else { AttackPercent = 0, DamageTaken = 1 }
end

local CFG = CombatConfig.Player
local state = {} -- [Player] = { NextAttackAt, NextDashAt, InvulnerableUntil, Blocking, SavedWalkSpeed, Shield, LastDamagedAt }
local random = Random.new()

-- Players and enemies pass through each other, so bumping into an enemy can't
-- lift you up ("random jumps") or shove you around mid-swing.
CombatService.PLAYER_GROUP = "OlympusPlayers"
CombatService.ENEMY_GROUP = "OlympusEnemies"

local function setupCollisionGroups()
	for _, name in { CombatService.PLAYER_GROUP, CombatService.ENEMY_GROUP } do
		pcall(function()
			PhysicsService:RegisterCollisionGroup(name)
		end)
	end
	PhysicsService:CollisionGroupSetCollidable(CombatService.PLAYER_GROUP, CombatService.ENEMY_GROUP, false)
end

local function putInGroup(item)
	if item:IsA("BasePart") then
		item.CollisionGroup = CombatService.PLAYER_GROUP
	end
end

local function watchCharacterGroup(character)
	for _, item in character:GetDescendants() do
		putInGroup(item)
	end
	character.DescendantAdded:Connect(putInGroup) -- avatar parts arrive later
end

--------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------
local function getParts(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and root and humanoid.Health > 0 then
		return character, humanoid, root
	end
	return nil
end

local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function setBlocking(player, on)
	local st = state[player]
	if not st or st.Blocking == on then
		return
	end
	local _, humanoid, root = getParts(player)
	st.Blocking = on
	player:SetAttribute("Blocking", on)

	if on then
		if humanoid then
			st.SavedWalkSpeed = humanoid.WalkSpeed
			humanoid.WalkSpeed = humanoid.WalkSpeed * CFG.Block.WalkSpeedMultiplier
		end
		if root then
			-- A see-through shield bubble everyone can see.
			local shield = Instance.new("Part")
			shield.Name = "BlockShield"
			shield.Shape = Enum.PartType.Ball
			shield.Size = Vector3.new(7, 7, 7)
			shield.Material = Enum.Material.ForceField
			shield.Color = Color3.fromRGB(120, 190, 255)
			shield.CanCollide = false
			shield.CanQuery = false
			shield.CanTouch = false
			shield.Massless = true
			shield.CFrame = root.CFrame
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = root
			weld.Part1 = shield
			weld.Parent = shield
			shield.Parent = root.Parent
			st.Shield = shield
		end
	else
		if humanoid and st.SavedWalkSpeed then
			humanoid.WalkSpeed = st.SavedWalkSpeed
		end
		st.SavedWalkSpeed = nil
		if st.Shield then
			st.Shield:Destroy()
			st.Shield = nil
		end
	end
end

--------------------------------------------------------------------------
-- Placeholder sword (welded into the right hand; see SwordBuilder)
--------------------------------------------------------------------------
local function swordColor(player)
	return GodConfig.GetColors(player:GetAttribute("SelectedGod") or "").Primary
end

local function giveSword(player, character)
	if character.Parent and character:FindFirstChildOfClass("Humanoid") then
		local weapon = if weaponProvider then weaponProvider(player).Weapon else nil
		SwordBuilder.Attach(character, swordColor(player), weapon)
	end
end

local function flashTrail(player)
	local trail = SwordBuilder.GetTrail(player.Character)
	if trail then
		trail.Enabled = true
		task.delay(0.3, function()
			trail.Enabled = false
		end)
	end
end

--------------------------------------------------------------------------
-- Requests from the client
--------------------------------------------------------------------------
-- combo = which swing of the combo the client played (1-3), only used so
-- other players see the same animation.
-- Aim dot: in fighting areas the client sends the direction its camera
-- looks; the character is turned that way before the attack is worked out,
-- so every "the way you face" attack goes where the centre dot points.
function CombatService.ApplyAim(player, aim)
	if typeof(aim) ~= "Vector3" or aim ~= aim then
		return -- not sent (outside fighting areas) or invalid
	end
	local direction = Vector3.new(aim.X, 0, aim.Z)
	if direction.Magnitude < 0.1 or direction.Magnitude > 10 then
		return
	end
	local _, humanoid, root = getParts(player)
	if root and humanoid and humanoid.Health > 0 then
		local position = root.Position
		root.CFrame = CFrame.lookAt(position, position + direction.Unit)
	end
end

function CombatService.BasicAttack(player, combo, aim)
	local st = state[player]
	local _, _, root = getParts(player)
	if not st or not root or st.Blocking then
		return 0
	end
	local now = os.clock()
	if now < st.NextAttackAt then
		return 0
	end
	CombatService.ApplyAim(player, aim)
	local attack = CFG.BasicAttack
	-- Phase 7C: the equipped weapon decides reach, swing, speed and damage.
	local weapon = if weaponProvider then weaponProvider(player) else nil
	local range = if weapon then weapon.Range else attack.Range
	local arcDot = if weapon and weapon.ArcDot then weapon.ArcDot else attack.ArcDot
	local maxTargets = if weapon then weapon.MaxTargets else attack.MaxTargets
	local cooldown = if weapon then weapon.Cooldown else attack.Cooldown
	st.NextAttackAt = now + cooldown * 0.9 -- small tolerance for network timing
	flashTrail(player)

	-- Let everyone else's screen play the same swing.
	local index = if type(combo) == "number" then math.clamp(math.floor(combo), 1, 3) else 1
	local moveName = if weapon and weapon.Combo then weapon.Combo[index] else SwordPoses.ComboOrder[index]
	for _, other in Players:GetPlayers() do
		if other ~= player then
			fxRemote:FireClient(other, "Swing", player, moveName)
		end
	end

	local baseAttack = player:GetAttribute("BaseAttack") or 10
	local combatBonus = TempleService.GetEffect(player, "CombatBonusPercent") / 100
	local mods = modifiers(player)
	local buffBonus = mods.AttackPercent / 100
	local power = if weapon then weapon.Power else 1
	local look = flat(root.CFrame.LookVector).Unit

	-- Targets: in front (melee), or along a line (bows), closest first.
	local candidates = {}
	if weapon and weapon.Ranged then
		local finish = root.Position + look * range
		for _, record in EnemyService.GetEnemiesInRange(root.Position, range + 4) do
			local offset = flat(record.Root.Position - root.Position)
			local along = offset:Dot(look)
			local side = (offset - look * along).Magnitude
			if along >= -1 and along <= range + 1.5 and side <= (weapon.Width or 3) / 2 + record.Root.Size.X / 2 + 1 then
				table.insert(candidates, { Record = record, Distance = along })
			end
		end
		local color = weapon.Weapon.Look.Glow or weapon.Weapon.Look.Blade or Color3.new(1, 1, 1)
		fxRemote:FireAllClients("Beam", root.Position + Vector3.new(0, 1.5, 0), color, finish + Vector3.new(0, 1.5, 0), 0.6)
	else
		for _, record in EnemyService.GetEnemiesInRange(root.Position, range + 4) do
			local offset = flat(record.Root.Position - root.Position)
			-- +1.5 studs allows for internet delay (positions on the server lag a little).
			local reach = range + record.Root.Size.X / 2 + 1.5
			if offset.Magnitude <= reach and (offset.Magnitude < 1.5 or look:Dot(offset.Unit) >= arcDot) then
				table.insert(candidates, { Record = record, Distance = offset.Magnitude })
			end
		end
	end
	table.sort(candidates, function(a, b)
		return a.Distance < b.Distance
	end)

	local hits = 0
	local lifeSteal = (mods.LifeSteal or 0) + (if weapon then weapon.LifeSteal else 0)
	for i = 1, math.min(#candidates, maxTargets) do
		local record = candidates[i].Record
		local spread = 1 + random:NextNumber(-attack.RandomSpread, attack.RandomSpread)
		local crit = weapon ~= nil and random:NextNumber() < weapon.CritChance
		local damage = baseAttack * attack.DamageMultiplier * power * (1 + combatBonus) * (1 + buffBonus) * spread * (if crit then 2 else 1)
		if EnemyService.DamageEnemy(record.Model, damage, player, { Crit = crit }) then
			hits += 1
			local _, humanoid = getParts(player)
			if lifeSteal > 0 and humanoid then
				humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + damage * lifeSteal)
			end
			fxRemote:FireAllClients("Hit", record.Root.Position, record.Model, player)
		end
	end
	return hits
end

function CombatService.Dash(player, direction)
	local st = state[player]
	if not st or not getParts(player) then
		return false
	end
	local now = os.clock()
	if now < st.NextDashAt then
		return false
	end
	st.NextDashAt = now + CFG.Dash.Cooldown * 0.9
	st.InvulnerableUntil = now + CFG.Dash.InvulnerableTime
	if dashHandler then
		dashHandler(player, direction) -- god dash ability (Thunder Dash / Battle Charge)
	end
	return true
end

--------------------------------------------------------------------------
-- Damage to players
--------------------------------------------------------------------------
function CombatService.DamagePlayer(player, amount, _sourcePosition, attackerModel)
	local st = state[player]
	local _, humanoid, root = getParts(player)
	if not st or not humanoid then
		return 0
	end
	local now = os.clock()
	if now < st.InvulnerableUntil then
		fxRemote:FireAllClients("Damage", root.Position + Vector3.new(0, 3, 0), 0, "Dodged")
		return 0
	end
	if counterHandler and counterHandler(player, attackerModel) then
		fxRemote:FireAllClients("Damage", root.Position + Vector3.new(0, 3, 0), 0, "Countered")
		return 0
	end
	local style = "Player"
	amount *= modifiers(player).DamageTaken
	if st.Blocking then
		amount *= CFG.Block.DamageTaken
		style = "Blocked"
	end
	amount = math.max(1, math.floor(amount))
	st.LastDamagedAt = now
	humanoid:TakeDamage(amount)
	fxRemote:FireAllClients("Damage", root.Position + Vector3.new(0, 3, 0), amount, style)
	return amount
end

--------------------------------------------------------------------------
-- Setup
--------------------------------------------------------------------------
function CombatService.Init(templeService, enemyService, fxRemoteEvent, remotes)
	TempleService = templeService
	EnemyService = enemyService
	fxRemote = fxRemoteEvent
	Players.RespawnTime = CFG.RespawnTime
	setupCollisionGroups()

	if remotes then
		remotes.Attack.OnServerEvent:Connect(function(player, combo, aim)
			CombatService.BasicAttack(player, combo, aim)
		end)
		remotes.Block.OnServerEvent:Connect(function(player, on)
			if type(on) == "boolean" then
				setBlocking(player, on)
			end
		end)
		remotes.Dash.OnServerEvent:Connect(function(player, direction)
			CombatService.Dash(player, direction)
		end)
	end

	-- Health regeneration, once per second. Also makes sure everyone is
	-- still holding their sword (avatar loading can replace the hand).
	task.spawn(function()
		while true do
			task.wait(1)
			local now = os.clock()
			for player, st in state do
				local character = getParts(player)
				if character then
					giveSword(player, character)
				end
				local _, humanoid = getParts(player)
				if humanoid and humanoid.Health < humanoid.MaxHealth and now - st.LastDamagedAt >= CFG.Regen.DelayAfterDamage then
					local bonus = 1 + TempleService.GetEffect(player, "RegenBonusPercent") / 100
					local heal = humanoid.MaxHealth * CFG.Regen.PercentPerSecond / 100 * bonus
					humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + heal)
				end
			end
		end
	end)
end

-- Phase 4B hooks (set by AbilityService's owner, Main).
function CombatService.SetModifierProvider(provider)
	modifierProvider = provider
end

function CombatService.SetDashHandler(handler)
	dashHandler = handler
end

-- Phase 7B: slows a player's walking (e.g. Medusa's gaze) for a while.
function CombatService.SlowPlayer(player, multiplier, duration)
	local st = state[player]
	local _, humanoid = getParts(player)
	if not st or not humanoid or st.Slowed then
		return
	end
	st.Slowed = true
	humanoid.WalkSpeed *= multiplier
	task.delay(duration, function()
		st.Slowed = false
		if humanoid.Parent then
			humanoid.WalkSpeed /= multiplier
		end
	end)
end

function CombatService.SetCounterHandler(handler)
	counterHandler = handler
end

function CombatService.SetWeaponProvider(provider)
	weaponProvider = provider
end

-- Swaps the weapon in the player's hand right away (after equipping).
function CombatService.RefreshWeapon(player)
	local character = getParts(player)
	if character then
		giveSword(player, character)
	end
end

function CombatService.SetupPlayer(player)
	state[player] = {
		NextAttackAt = 0,
		NextDashAt = 0,
		InvulnerableUntil = 0,
		Blocking = false,
		SavedWalkSpeed = nil,
		Shield = nil,
		LastDamagedAt = 0,
	}
	player:SetAttribute("Blocking", false)
	player:GetAttributeChangedSignal("SelectedGod"):Connect(function()
		local sword = player.Character and player.Character:FindFirstChild(SwordBuilder.Name)
		if sword then
			SwordBuilder.SetColor(sword, swordColor(player))
		end
	end)
	if player.Character then
		watchCharacterGroup(player.Character)
		task.spawn(giveSword, player, player.Character)
	end
	-- Fires once the avatar's own body parts and clothes have been applied.
	if typeof(player) == "Instance" then
		player.CharacterAppearanceLoaded:Connect(function(character)
			giveSword(player, character)
		end)
	end
	player.CharacterAdded:Connect(function(character)
		watchCharacterGroup(character)
		task.spawn(function()
			character:WaitForChild("Humanoid", 10)
			giveSword(player, character)
		end)
		local st = state[player]
		if st then
			st.Blocking = false
			st.SavedWalkSpeed = nil
			st.Shield = nil
			st.InvulnerableUntil = 0
			player:SetAttribute("Blocking", false)
		end
	end)
end

function CombatService.ReleasePlayer(player)
	state[player] = nil
end

-- Test helper: lets the cloud test act as a player.
function CombatService._GetState(player)
	return state[player]
end

return CombatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- DataService (ModuleScript)
-- Location: ServerScriptService > Services > DataService
--
-- Loads and saves each player's progress with DataStoreService.
-- Safety features:
--   * Session locking: only one server can own a player's data at a time,
--     so fast server-hopping cannot duplicate or roll back progress.
--   * Never overwrites saved data with defaults. If loading fails, the
--     player is kicked and NOTHING is written.
--   * Retries on load and save.
--   * Schema versioning + migrations for future updates.
--   * Autosave, save on leave, and save on server shutdown (BindToClose).
--
-- Other scripts must only change data through the table returned by
-- DataService.GetData(player). It returns nil if data is not safely loaded.

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))
local DATA = GameConfig.Data

local DataService = {}

local store = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(DATA.StoreName)
	end)
	if ok then
		store = result
	else
		warn("[DataService] Could not open the DataStore: " .. tostring(result))
		warn("[DataService] In Studio: publish the place, then Game Settings > Security > Enable Studio Access to API Services.")
	end
end

local profiles = {} -- [Player] = { Key = string, Data = table, Writing = bool, Released = bool }
local pendingReleases = 0
local shuttingDown = false

--------------------------------------------------------------------------
-- Default data
--------------------------------------------------------------------------
local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = deepCopy(v)
	end
	return copy
end

-- The full save layout. Later phases fill in the empty sections.
local function makeDefaultData()
	return {
		SchemaVersion = DATA.SchemaVersion,

		Level = 1,
		XP = 0,
		RankIndex = 1, -- 1 = Mortal (see GameConfig.Ranks)

		Currencies = deepCopy(GameConfig.StartingCurrencies),

		SelectedGod = "",     -- Phase 3
		GodLoyalty = {},      -- Phase 3: [GodName] = number
		Blessings = {},       -- Phase 3: [GodName] = { [BlessingId] = level }
		NextWorshipAt = 0,    -- Phase 3: os.time() when worship is ready again
		GodChange = {         -- Phase 3: Shrine of Change quest in progress
			Target = "",      -- god being switched to ("" = none)
			Prayers = 0,
			NextPrayerAt = 0,
		},

		Temple = {            -- Phase 2
			Tier = 1,
			Buildings = {},   -- [BuildingId] = level
			Prestige = 0,     -- Phase 7E: Temple Prestige level (0-10)
		},

		Inventory = {         -- Phase 7
			Items = {},
			EquippedWeapon = "",
		},

		Quests = {            -- Phase 7
			Active = {},
			Completed = {},
			LastDailyReset = 0,
			Daily = { Day = 0, Ids = {}, Progress = {}, Claimed = {} }, -- Phase 7D
		},

		CompletedTrials = {}, -- [TrialId] = true
		Mastery = {},         -- Phase 7E: [GodId] = { Level, XP }
		Challenges = {},      -- Phase 7E: ["<challenge>:<difficulty>"] = { Clears, Best (seconds) }

		Stats = {
			JoinCount = 0,
			EnemiesDefeated = 0,
		},

		Settings = {
			MusicVolume = 0.5,
			SfxVolume = 0.8,
		},
	}
end

-- Adds any missing fields (e.g. after an update) without touching existing values.
local function reconcile(target, template)
	for key, value in template do
		if target[key] == nil then
			target[key] = deepCopy(value)
		elseif type(value) == "table" and type(target[key]) == "table" then
			reconcile(target[key], value)
		end
	end
end

--------------------------------------------------------------------------
-- Schema migrations
-- When you change the data layout: add a step here, then increase
-- GameConfig.Data.SchemaVersion by 1.
--------------------------------------------------------------------------
local Migrations = {
	-- Example for the future:
	-- [1] = function(data) -- turns a version 1 save into version 2
	--     data.Temple.Prestige = 0
	-- end,
}

local function migrate(data)
	local version = tonumber(data.SchemaVersion) or 0
	while version < DATA.SchemaVersion do
		local step = Migrations[version]
		if step then
			step(data)
		end
		version += 1
	end
	data.SchemaVersion = DATA.SchemaVersion
end

--------------------------------------------------------------------------
-- Low-level DataStore calls
-- Stored format: { Data = <player data>, SessionLock = { JobId, Time } | nil }
--------------------------------------------------------------------------
local function keyFor(player)
	return "Player_" .. player.UserId
end

local function lockedByAnotherServer(lock)
	return type(lock) == "table"
		and lock.JobId ~= game.JobId
		and (os.time() - (tonumber(lock.Time) or 0)) < DATA.SessionLockTimeout
end

-- Returns status ("OK", "Locked", "TooNew", "Corrupt", "Error") and data/error.
local function tryLoad(key)
	local status, loaded = "Error", nil

	local ok, err = pcall(function()
		store:UpdateAsync(key, function(stored)
			status, loaded = "Error", nil

			if stored ~= nil and type(stored) ~= "table" then
				status = "Corrupt"
				return nil -- cancel: do not write anything
			end
			stored = stored or {}

			if lockedByAnotherServer(stored.SessionLock) then
				status = "Locked"
				return nil
			end

			if type(stored.Data) == "table" and (tonumber(stored.Data.SchemaVersion) or 0) > DATA.SchemaVersion then
				status = "TooNew" -- saved by a newer version of the game; this server must not touch it
				return nil
			end

			if type(stored.Data) ~= "table" then
				stored.Data = makeDefaultData() -- genuinely new player (no save exists)
			end

			stored.SessionLock = { JobId = game.JobId, Time = os.time() }
			status, loaded = "OK", stored.Data
			return stored
		end)
	end)

	if not ok then
		return "Error", tostring(err)
	end
	return status, loaded
end

local function writeProfile(profile, release)
	for attempt = 1, DATA.MaxSaveAttempts do
		local lockLost = false
		local ok, err = pcall(function()
			store:UpdateAsync(profile.Key, function(stored)
				lockLost = false
				if type(stored) ~= "table" then
					stored = {}
				end
				if type(stored.SessionLock) == "table" and stored.SessionLock.JobId ~= game.JobId then
					lockLost = true -- another server owns this data now; never overwrite it
					return nil
				end
				stored.Data = profile.Data
				if release then
					stored.SessionLock = nil
				else
					stored.SessionLock = { JobId = game.JobId, Time = os.time() }
				end
				return stored
			end)
		end)

		if ok then
			if lockLost then
				warn("[DataService] Did not save " .. profile.Key .. ": another server owns this data.")
				return false
			end
			print("[DataService] Saved " .. profile.Key .. (if release then " (released)" else ""))
			return true
		end

		warn(("[DataService] Save attempt %d for %s failed: %s"):format(attempt, profile.Key, tostring(err)))
		if attempt < DATA.MaxSaveAttempts then
			task.wait(attempt * 2)
		end
	end
	return false
end

-- Only one write per player at a time.
local function save(profile, release)
	while profile.Writing do
		task.wait(0.1)
	end
	profile.Writing = true
	local ok = writeProfile(profile, release)
	profile.Writing = false
	return ok
end

--------------------------------------------------------------------------
-- Public API
--------------------------------------------------------------------------

-- Yields. Returns the player's data table, or nil (player is kicked or left).
function DataService.LoadPlayer(player)
	if not store then
		player:Kick("Saving is unavailable right now, so your progress was not loaded. Please rejoin later.")
		return nil
	end

	local key = keyFor(player)

	for attempt = 1, DATA.MaxLoadAttempts do
		if not player.Parent or shuttingDown then
			return nil
		end

		local status, result = tryLoad(key)

		if status == "OK" then
			migrate(result)
			reconcile(result, makeDefaultData())
			result.Stats.JoinCount += 1

			profiles[player] = { Key = key, Data = result, Writing = false, Released = false }
			print(("[DataService] Loaded %s (Level %d)"):format(key, result.Level))

			if not player.Parent then
				-- They left while we were loading: hand the data straight back.
				DataService.ReleasePlayer(player)
				return nil
			end
			return result

		elseif status == "TooNew" then
			player:Kick("A newer version of Mount Olympus saved your progress. Please rejoin to get an updated server.")
			return nil

		elseif status == "Corrupt" then
			warn("[DataService] Save for " .. key .. " is not in the expected format. Not loading or overwriting it.")
			player:Kick("There is a problem with your save file. It has not been changed. Please contact the developer.")
			return nil
		end

		warn(("[DataService] Load attempt %d/%d for %s: %s %s"):format(
			attempt, DATA.MaxLoadAttempts, key, status, if result then tostring(result) else ""))
		task.wait(DATA.LoadRetryDelay)
	end

	player:Kick("We couldn't load your progress safely, so nothing was changed. Please rejoin in a minute.")
	return nil
end

-- Returns the live data table, or nil if not loaded / already released.
function DataService.GetData(player)
	local profile = profiles[player]
	if profile and not profile.Released then
		return profile.Data
	end
	return nil
end

function DataService.IsLoaded(player)
	return DataService.GetData(player) ~= nil
end

-- Yields. Saves immediately (keeps the session lock).
function DataService.SaveNow(player)
	local profile = profiles[player]
	if not profile or profile.Released then
		return false
	end
	return save(profile, false)
end

-- Yields. Final save + unlock. Call when the player leaves.
function DataService.ReleasePlayer(player)
	local profile = profiles[player]
	if not profile or profile.Released then
		return
	end
	profile.Released = true
	pendingReleases += 1
	save(profile, true)
	pendingReleases -= 1
	if profiles[player] == profile then
		profiles[player] = nil
	end
end

-- Studio testing only: wipe this player's progress back to defaults.
function DataService.ResetData(player)
	local profile = profiles[player]
	if not profile or profile.Released then
		return false
	end
	profile.Data = makeDefaultData()
	return true
end

function DataService.Init()
	-- Autosave loop
	task.spawn(function()
		while true do
			task.wait(DATA.AutosaveInterval)
			for _, profile in profiles do
				if not profile.Released and not profile.Writing then
					task.spawn(save, profile, false)
				end
			end
		end
	end)

	-- Server shutting down: save everyone before Roblox closes the server (max ~30s).
	game:BindToClose(function()
		shuttingDown = true
		for player in profiles do
			task.spawn(DataService.ReleasePlayer, player)
		end
		local started = os.clock()
		while pendingReleases > 0 and os.clock() - started < 25 do
			task.wait(0.2)
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">DiagnosticsService</string>
          <string name="Source"><![CDATA[-- DiagnosticsService (ModuleScript)
-- Location: ServerScriptService > Services > DiagnosticsService
--
-- Receives the small reports devices send (see the Diagnostics LocalScript),
-- adds server numbers (server frame rate, network use, memory, enemy count)
-- and saves the latest 40 per player in the "OlympusDiagnostics" DataStore.
-- They can be read later with a Luau Execution task. Debug use only.

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Stats = game:GetService("Stats")
local Workspace = game:GetService("Workspace")

local DiagnosticsService = {}

local KEEP = 40
local FLUSH_EVERY = 15
local MAX_REPORT_CHARS = 6000

local queue = {} -- [userId] = { entries }
local lastReport = {}
local serverFps = 0

-- Server-side notes about a player (e.g. an error applying their rank looks).
function DiagnosticsService.Note(player, text)
	local list = queue[player.UserId] or {}
	table.insert(list, { Time = os.time(), PlaceVersion = game.PlaceVersion, ServerNote = string.sub(tostring(text), 1, 1000) })
	queue[player.UserId] = list
end

function DiagnosticsService.Init(remote)
	local store = DataStoreService:GetDataStore("OlympusDiagnostics")

	-- Server frame rate (Heartbeats per second).
	local beats, since = 0, os.clock()
	RunService.Heartbeat:Connect(function()
		beats += 1
		local now = os.clock()
		if now - since >= 5 then
			serverFps = math.floor(beats / (now - since) * 10) / 10
			beats, since = 0, now
		end
	end)

	remote.OnServerEvent:Connect(function(player, report)
		local now = os.clock()
		if type(report) ~= "table" or (lastReport[player] and now - lastReport[player] < 5) then
			return
		end
		lastReport[player] = now
		local ok, json = pcall(HttpService.JSONEncode, HttpService, report)
		if not ok then
			return
		end
		local enemies = Workspace:FindFirstChild("Enemies")
		local entry = {
			Time = os.time(),
			PlaceVersion = game.PlaceVersion,
			Server = {
				Fps = serverFps,
				Players = #Players:GetPlayers(),
				MemoryMb = math.floor(Stats:GetTotalMemoryUsageMb()),
				ReceiveKbps = math.floor(Stats.DataReceiveKbps),
				SendKbps = math.floor(Stats.DataSendKbps),
				EnemyModels = if enemies then #enemies:GetChildren() else 0,
			},
			Client = string.sub(json, 1, MAX_REPORT_CHARS),
		}
		local list = queue[player.UserId] or {}
		table.insert(list, entry)
		queue[player.UserId] = list
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastReport[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(FLUSH_EVERY)
			for userId, entries in queue do
				queue[userId] = nil
				pcall(function()
					store:UpdateAsync("Player_" .. userId, function(old)
						local list = if type(old) == "table" then old else {}
						for _, e in entries do
							table.insert(list, e)
						end
						while #list > KEEP do
							table.remove(list, 1)
						end
						return list
					end)
				end)
			end
		end
	end)
end

return DiagnosticsService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">EnemyService</string>
          <string name="Source"><![CDATA[-- EnemyService (ModuleScript)
-- Location: ServerScriptService > Services > EnemyService
--
-- Server-controlled enemies:
--   * Spawns enemies from CombatConfig.Enemies (placeholder characters).
--   * Simple AI: idle -> chase the nearest player -> wind up (weapon glows
--     red, red ring on the ground, weapon raised) -> strike -> cooldown.
--     Gives up and heals if pulled too far from its spawn.
--   * Hits knock enemies back and stagger them briefly. Training dummies
--     wobble (drawn on each player's device, so it costs the server nothing).
--   * Health bar over its head, damage numbers, death effect.
--   * Rewards XP + Gold ONCE per kill to every player who damaged it.
--
--   * Bosses (CombatConfig `Boss = true`): special attacks with big red
--     warnings (Slam: a circle; Charge: a line), an enraged second phase, and
--     no knockback or stagger.
--
-- Used by later systems:
--   EnemyService.Spawn(enemyType, cframe, options) -> model
--       options = { HealthMultiplier, DamageMultiplier, SpeedMultiplier, RewardMultiplier,
--                   AggroRange, LeashRange, Attributes = { name = value },
--                   OnDeath = function(model), OnPhase2 = function(model) }
--   EnemyService.Remove(model) -- removes an enemy silently (no rewards)
--   EnemyService.DamageEnemy(model, amount, player) -> true/false
--   EnemyService.GetEnemiesInRange(position, range) -> { record, ... }

local GameEvents = require(script.Parent:WaitForChild("GameEvents"))
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CombatConfig = require(Shared:WaitForChild("CombatConfig"))

local EnemyService = {}

local DataService = nil
local ProgressionService = nil
local CombatService = nil
local fxRemote = nil

local enemies = {} -- [Model] = record
local templates = {} -- [enemyType] = finished body, built once and cloned (cloning is instant)
local getPlayers = function()
	return Players:GetPlayers()
end
local folder = nil

local THINK_INTERVAL = 0.15
local HEAL_DELAY = 4 -- an enemy only heals after this many seconds without being hit
local REWARD_WINDOW = 60 -- damage older than this (seconds) doesn't earn a share of the reward

-- Roblox's own default R15 walk animation (free for every game). Attack
-- poses are our own (SwordPoses), played on each device.
local WALK_ANIMATION = "rbxassetid://507777826"
local KNOCKBACK_SPEED = 8 -- small, so hits don't push enemies out of sword reach
local STAGGER_TIME = 0.3

--------------------------------------------------------------------------
-- Building an enemy character
--------------------------------------------------------------------------
local function buildFallbackRig(look)
	-- Used only if Roblox can't create a normal character.
	local model = Instance.new("Model")
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1)
	root.Transparency = 1
	root.Parent = model
	local torso = Instance.new("Part")
	torso.Name = "UpperTorso"
	torso.Size = Vector3.new(2 * look.Width, 2, 1)
	torso.Color = look.Shirt
	torso.Parent = model
	local head = Instance.new("Part")
	head.Name = "Head"
	head.Size = Vector3.new(1.2, 1.2, 1.2)
	head.Color = look.Skin
	head.Parent = model
	for _, pair in { { torso, CFrame.new() }, { head, CFrame.new(0, 1.6, 0) } } do
		local weld = Instance.new("Weld")
		weld.Part0 = root
		weld.Part1 = pair[1]
		weld.C0 = pair[2]
		weld.Parent = root
		pair[1].CFrame = root.CFrame * pair[2]
	end
	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15
	humanoid.HipHeight = 2
	humanoid.Parent = model
	model.PrimaryPart = root
	return model
end

local function buildRig(look)
	local ok, model = pcall(function()
		local description = Instance.new("HumanoidDescription")
		description.HeadColor = look.Skin
		description.LeftArmColor = look.Skin
		description.RightArmColor = look.Skin
		description.TorsoColor = look.Shirt
		description.LeftLegColor = look.Pants
		description.RightLegColor = look.Pants
		description.WidthScale = look.Width
		description.DepthScale = look.Width
		description.HeightScale = look.Height or 1
		description.HeadScale = look.Height or 1
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if ok and model then
		return model
	end
	warn("[EnemyService] Using fallback enemy body: " .. tostring(model))
	return buildFallbackRig(look)
end

local function addWeapon(model, color, length)
	local hand = model:FindFirstChild("RightHand") or model:FindFirstChild("UpperTorso")
	if not hand or not color then
		return
	end
	length = length or 3.6
	local blade = Instance.new("Part")
	blade.Name = "Weapon"
	blade.Size = Vector3.new(0.25 * length / 3.6, 0.4 * length / 3.6, length)
	blade.Material = Enum.Material.Metal
	blade.Color = color
	blade.CanCollide = false
	blade.Massless = true
	blade.CFrame = hand.CFrame * CFrame.new(0, -0.2, -length / 2)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = hand
	weld.Part1 = blade
	weld.Parent = blade
	blade.Parent = model
end

-- Wooden training dummy: crossed feet, post, straw body with a target,
-- arms, and a sack head. Everything is anchored; the root sits 3 studs up.
local function buildDummy()
	local model = Instance.new("Model")
	local WOOD = Color3.fromRGB(120, 85, 55)
	local STRAW = Color3.fromRGB(222, 196, 130)
	local ROPE = Color3.fromRGB(140, 100, 60)
	local SACK = Color3.fromRGB(196, 168, 120)
	local origin = CFrame.new(0, 3, 0) -- root position; ground is 3 below
	local function part(name, size, offset, props)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Anchored = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.CFrame = origin * offset
		for key, value in props or {} do
			p[key] = value
		end
		p.Parent = model
		return p
	end
	local function vcyl(name, height, diameter, y, color, material)
		-- vertical cylinder whose centre is `y` studs above the ground
		return part(name, Vector3.new(height, diameter, diameter), CFrame.new(0, y - 3, 0) * CFrame.Angles(0, 0, math.rad(90)), {
			Shape = Enum.PartType.Cylinder, Color = color, Material = material or Enum.Material.Wood,
		})
	end

	local root = part("HumanoidRootPart", Vector3.new(2, 2, 1), CFrame.new(), { Transparency = 1, CanCollide = false })
	part("FootA", Vector3.new(4, 0.4, 0.7), CFrame.new(0, -2.8, 0), { Color = WOOD, Material = Enum.Material.Wood })
	part("FootB", Vector3.new(0.7, 0.4, 4), CFrame.new(0, -2.8, 0), { Color = WOOD, Material = Enum.Material.Wood })
	vcyl("Post", 5.6, 0.6, 3.2, WOOD)
	vcyl("Body", 2.8, 2.1, 3.4, STRAW, Enum.Material.Fabric)
	vcyl("RopeLow", 0.25, 2.2, 2.3, ROPE, Enum.Material.Fabric)
	vcyl("RopeHigh", 0.25, 2.2, 4.5, ROPE, Enum.Material.Fabric)
	-- Target on the front (local -Z faces the player)
	for i, ring in { { 1.5, Color3.fromRGB(200, 40, 35) }, { 1.0, Color3.fromRGB(245, 240, 230) }, { 0.45, Color3.fromRGB(200, 40, 35) } } do
		part("Target" .. i, Vector3.new(0.08, ring[1], ring[1]), CFrame.new(0, 0.4, -1.05 - i * 0.03) * CFrame.Angles(0, math.rad(90), 0), {
			Shape = Enum.PartType.Cylinder, Color = ring[2], Material = Enum.Material.SmoothPlastic,
		})
	end
	part("Arms", Vector3.new(4.6, 0.4, 0.4), CFrame.new(0, 1.3, 0), { Color = WOOD, Material = Enum.Material.Wood })
	for i, x in { -2.4, 2.4 } do
		part("Hand" .. i, Vector3.new(0.8, 0.8, 0.8), CFrame.new(x, 1.3, 0), { Shape = Enum.PartType.Ball, Color = STRAW, Material = Enum.Material.Fabric })
	end
	part("Head", Vector3.new(1.6, 1.6, 1.6), CFrame.new(0, 2.85, 0), { Shape = Enum.PartType.Ball, Color = SACK, Material = Enum.Material.Fabric })
	for i, x in { -0.3, 0.3 } do
		part("Eye" .. i, Vector3.new(0.22, 0.22, 0.1), CFrame.new(x, 3.0, -0.76), { Color = Color3.fromRGB(40, 30, 25) })
	end
	part("Mouth", Vector3.new(0.6, 0.08, 0.1), CFrame.new(0, 2.6, -0.76), { Color = Color3.fromRGB(40, 30, 25) })
	part("Knot", Vector3.new(0.5, 0.35, 0.5), CFrame.new(0, 3.75, 0), { Color = ROPE, Material = Enum.Material.Fabric })

	local humanoid = Instance.new("Humanoid")
	humanoid.RequiresNeck = false
	humanoid.Parent = model
	model.PrimaryPart = root
	return model
end

--------------------------------------------------------------------------
-- Phase 7B bodies: four-legged beasts and extra armour pieces
--------------------------------------------------------------------------
local function weldPart(model, anchorPart, props)
	local p = Instance.new("Part")
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		p[key] = value
	end
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = anchorPart
	weld.Part1 = p
	weld.Parent = p
	p.Parent = model
	return p
end

-- A four-legged animal (war hound, hellhound, Cerberus with Heads = 3).
local function buildBeast(look)
	local s = look.Size or 1
	local hip = 1.8 * s
	local model = Instance.new("Model")
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2 * s, 2 * s, 4 * s)
	root.Transparency = 1
	root.CFrame = CFrame.new()
	root.Parent = model
	local function part(name, size, offset, color, props)
		local p = { Name = name, Size = size, CFrame = root.CFrame * offset, Color = color, Material = Enum.Material.SmoothPlastic }
		for key, value in props or {} do
			p[key] = value
		end
		return weldPart(model, root, p)
	end
	part("Torso", Vector3.new(2.4 * s, 1.8 * s, 4.4 * s), CFrame.new(0, 0.2 * s, 0), look.Body)
	local legLength = hip + 0.3 * s
	for _, xz in { { -0.8, -1.5 }, { 0.8, -1.5 }, { -0.8, 1.5 }, { 0.8, 1.5 } } do
		part("Leg", Vector3.new(legLength, 0.7 * s, 0.7 * s), CFrame.new(xz[1] * s, -0.7 * s - legLength / 2, xz[2] * s) * CFrame.Angles(0, 0, math.rad(90)), look.Accent, { Shape = Enum.PartType.Cylinder })
	end
	part("Tail", Vector3.new(0.35 * s, 0.35 * s, 2 * s), CFrame.new(0, 0.7 * s, 2.8 * s) * CFrame.Angles(math.rad(30), 0, 0), look.Accent)
	local heads = look.Heads or 1
	local xs = if heads == 3 then { 0, -1.9, 1.9 } else { 0 }
	for i, x in xs do
		local name = if i == 1 then "Head" else ("Head" .. i)
		local tilt = if x < 0 then 25 elseif x > 0 then -25 else 0
		local back = if x ~= 0 then 0.5 else 0 -- side heads sit a little further back
		if x ~= 0 then
			part("Neck", Vector3.new(0.9 * s, 0.9 * s, 1.6 * s), CFrame.new(x * 0.6 * s, 0.7 * s, -2.0 * s) * CFrame.Angles(0, math.rad(tilt), 0), look.Body)
		end
		local headFrame = CFrame.new(x * s, (1.0 + (if x ~= 0 then 0.25 else 0)) * s, (-2.7 + back) * s) * CFrame.Angles(0, math.rad(tilt), 0)
		local head = part(name, Vector3.new(1.4 * s, 1.3 * s, 1.6 * s), headFrame, look.Body)
		part("Snout", Vector3.new(0.85 * s, 0.6 * s, 1.0 * s), headFrame * CFrame.new(0, -0.25 * s, -1.2 * s), look.Accent)
		for _, ex in { -0.35, 0.35 } do
			part("Ear", Vector3.new(0.3 * s, 0.6 * s, 0.25 * s), headFrame * CFrame.new(ex * s, 0.85 * s, 0.2 * s), look.Accent)
			part("Eye", Vector3.new(0.22 * s, 0.22 * s, 0.1 * s), headFrame * CFrame.new(ex * s, 0.2 * s, -0.82 * s), look.Eye, { Material = Enum.Material.Neon })
		end
		if look.Fire then
			local fire = Instance.new("Fire")
			fire.Size = 3 * s
			fire.Heat = 6
			fire.Color = Color3.fromRGB(255, 110, 30)
			fire.SecondaryColor = Color3.fromRGB(255, 220, 80)
			fire.Parent = head
		end
	end
	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15
	humanoid.HipHeight = hip
	humanoid.RequiresNeck = false
	humanoid.Parent = model
	model.PrimaryPart = root
	return model
end

-- Extra armour and features welded onto a humanoid enemy.
local function addExtras(model, look)
	local head = model:FindFirstChild("Head")
	local color = look.ExtraColor or Color3.fromRGB(176, 112, 56)
	for _, extra in look.Extras or {} do
		if extra == "Helmet" and head then
			local s = head.Size
			weldPart(model, head, { Name = "Helmet", Size = Vector3.new(s.X * 1.15, s.Y * 0.75, s.Z * 1.15), CFrame = head.CFrame * CFrame.new(0, s.Y * 0.2, 0), Color = color, Material = Enum.Material.Metal })
			weldPart(model, head, { Name = "Crest", Size = Vector3.new(0.18, s.Y * 0.55, s.Z * 1.2), CFrame = head.CFrame * CFrame.new(0, s.Y * 0.75, 0), Color = Color3.fromRGB(170, 30, 30), Material = Enum.Material.Fabric })
		elseif extra == "Shield" then
			local arm = model:FindFirstChild("LeftLowerArm")
			if arm then
				weldPart(model, arm, { Name = "Shield", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.25, 2.6, 2.6), CFrame = arm.CFrame * CFrame.new(-arm.Size.X / 2 - 0.15, 0, 0), Color = color, Material = Enum.Material.Metal })
			end
		elseif extra == "Horns" and head then
			local s = head.Size
			for _, side in { -1, 1 } do
				weldPart(model, head, { Name = "Horn", Size = Vector3.new(s.X * 0.55, 0.28, 0.28), CFrame = head.CFrame * CFrame.new(side * s.X * 0.65, s.Y * 0.35, 0) * CFrame.Angles(0, 0, math.rad(side * -35)), Color = color })
				weldPart(model, head, { Name = "HornTip", Size = Vector3.new(0.22, s.Y * 0.45, 0.22), CFrame = head.CFrame * CFrame.new(side * s.X * 0.95, s.Y * 0.62, 0) * CFrame.Angles(0, 0, math.rad(side * -10)), Color = color })
			end
			weldPart(model, head, { Name = "Muzzle", Size = Vector3.new(s.X * 0.55, s.Y * 0.4, s.Z * 0.35), CFrame = head.CFrame * CFrame.new(0, -s.Y * 0.2, -s.Z * 0.6), Color = look.Skin })
		elseif extra == "Snakes" and head then
			local s = head.Size
			for i = 0, 9 do
				local angle = (i / 10) * math.pi * 2
				weldPart(model, head, { Name = "Snake", Shape = Enum.PartType.Cylinder, Size = Vector3.new(s.Y * 0.7, 0.22, 0.22),
					CFrame = head.CFrame * CFrame.new(math.cos(angle) * s.X * 0.45, s.Y * 0.45, math.sin(angle) * s.Z * 0.45) * CFrame.Angles(0, -angle, math.rad(55)),
					Color = color })
			end
		elseif extra == "Eye" and head then
			local s = head.Size
			weldPart(model, head, { Name = "BigEye", Shape = Enum.PartType.Ball, Size = Vector3.new(s.X * 0.55, s.X * 0.55, s.X * 0.55), CFrame = head.CFrame * CFrame.new(0, s.Y * 0.1, -s.Z * 0.4), Color = Color3.new(1, 1, 1) })
			weldPart(model, head, { Name = "Pupil", Shape = Enum.PartType.Ball, Size = Vector3.new(s.X * 0.22, s.X * 0.22, s.X * 0.22), CFrame = head.CFrame * CFrame.new(0, s.Y * 0.1, -s.Z * 0.62), Color = Color3.fromRGB(180, 30, 20), Material = Enum.Material.Neon })
		elseif extra == "Crown" and head then
			local s = head.Size
			for i = 0, 7 do
				local angle = (i / 8) * math.pi * 2
				weldPart(model, head, { Name = "CrownSpike", Size = Vector3.new(0.25, s.Y * 0.45, 0.25),
					CFrame = head.CFrame * CFrame.new(math.cos(angle) * s.X * 0.42, s.Y * 0.62, math.sin(angle) * s.Z * 0.42), Color = color, Material = Enum.Material.Metal })
			end
		end
	end
end

-- A finished enemy body for this type (the first one is built, the rest are copies).
local function makeBody(enemyType, cfg)
	if cfg.Builder == "Dummy" then
		return buildDummy()
	end
	if templates[enemyType] == nil then
		templates[enemyType] = false -- "being built": other spawns wait for it
		local template
		if cfg.Builder == "Beast" then
			template = buildBeast(cfg.Appearance)
		else
			template = buildRig(cfg.Appearance)
			addWeapon(template, cfg.Appearance.Weapon, cfg.Appearance.WeaponLength)
			addExtras(template, cfg.Appearance)
		end
		local scale = cfg.Appearance.Scale
		if scale and scale ~= 1 then
			local humanoid = template:FindFirstChildOfClass("Humanoid")
			local hipBefore = humanoid and humanoid.HipHeight
			template:ScaleTo(scale) -- giants
			if humanoid and math.abs(humanoid.HipHeight - hipBefore) < 0.01 then
				humanoid.HipHeight = hipBefore * scale -- in case ScaleTo left it alone
			end
		end
		templates[enemyType] = template
	end
	while templates[enemyType] == false do
		task.wait()
	end
	return templates[enemyType]:Clone()
end

local function addHealthBar(record)
	local head = record.Model:FindFirstChild("Head")
	if not head then
		return
	end
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "EnemyBar"
	billboard.Size = UDim2.fromOffset(120, 34)
	billboard.StudsOffset = Vector3.new(0, 2.6, 0)
	billboard.MaxDistance = 90
	billboard.AlwaysOnTop = true

	local name = Instance.new("TextLabel")
	name.Size = UDim2.new(1, 0, 0, 16)
	name.BackgroundTransparency = 1
	name.Text = record.Config.DisplayName
	name.Font = Enum.Font.GothamBold
	name.TextScaled = true
	name.TextColor3 = Color3.new(1, 1, 1)
	name.TextStrokeTransparency = 0.3
	name.Parent = billboard

	local back = Instance.new("Frame")
	back.Position = UDim2.fromOffset(0, 20)
	back.Size = UDim2.new(1, 0, 0, 10)
	back.BackgroundColor3 = Color3.fromRGB(40, 30, 30)
	back.BorderSizePixel = 0
	back.Parent = billboard

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(210, 60, 50)
	fill.BorderSizePixel = 0
	fill.Parent = back

	billboard.Parent = head
	record.Humanoid.HealthChanged:Connect(function(health)
		fill.Size = UDim2.fromScale(math.clamp(health / record.Humanoid.MaxHealth, 0, 1), 1)
	end)
end

local function loadAnimation(humanoid, id)
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local ok, track = pcall(function()
		local animation = Instance.new("Animation")
		animation.AnimationId = id
		return animator:LoadAnimation(animation)
	end)
	return if ok then track else nil
end

--------------------------------------------------------------------------
-- AI helpers
--------------------------------------------------------------------------
local function flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

local function face(record, position)
	local root = record.Root
	local look = flat(position - root.Position)
	if look.Magnitude > 0.1 and not root.Anchored then
		root.CFrame = CFrame.lookAt(root.Position, root.Position + look)
	end
end

local function aliveCharacterRoot(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and root and humanoid.Health > 0 then
		return root
	end
	return nil
end

local function findTarget(record)
	-- Whoever hit it recently is chased first (even from a little further away).
	local attacker = record.LastAttacker
	if attacker and attacker.Parent and os.clock() - record.LastDamagedAt < HEAL_DELAY then
		local root = aliveCharacterRoot(attacker)
		if root and (root.Position - record.Home).Magnitude <= record.LeashRange then
			return attacker, (root.Position - record.Root.Position).Magnitude
		end
	end
	local best, bestDistance = nil, math.huge
	for _, player in getPlayers() do
		local root = aliveCharacterRoot(player)
		if root then
			local distance = (root.Position - record.Root.Position).Magnitude
			local range = if record.Target == player then record.AggroRange * 1.5 else record.AggroRange
			local fromHome = (root.Position - record.Home).Magnitude
			if distance <= range and fromHome <= record.LeashRange and distance < bestDistance then
				best, bestDistance = player, distance
			end
		end
	end
	return best, bestDistance
end

local function clearTelegraph(record)
	if record.Telegraph then
		for _, item in record.Telegraph do
			item:Destroy()
		end
		record.Telegraph = nil
	end
	local weapon = record.Model:FindFirstChild("Weapon")
	if weapon and record.WeaponLook then
		weapon.Material = record.WeaponLook.Material
		weapon.Color = record.WeaponLook.Color
	end
end

local function startAttack(record, target)
	local cfg = record.Config
	record.State = "Windup"
	record.Humanoid:MoveTo(record.Root.Position)
	local targetRoot = aliveCharacterRoot(target)
	if targetRoot then
		face(record, targetRoot.Position)
	end

	-- Telegraph: the weapon glows red, a red ring shows the danger zone, and
	-- every player's screen shows the enemy raising its weapon.
	local weapon = record.Model:FindFirstChild("Weapon")
	if weapon then
		record.WeaponLook = record.WeaponLook or { Material = weapon.Material, Color = weapon.Color }
		weapon.Material = Enum.Material.Neon
		weapon.Color = Color3.fromRGB(255, 50, 40)
	end
	fxRemote:FireAllClients("EnemyAttack", record.Root.Position, record.Model, cfg.Windup)

	local groundY = record.Root.Position.Y - record.Root.Size.Y / 2 - record.Humanoid.HipHeight + 0.1
	local ring = Instance.new("Part")
	ring.Name = "AttackWarning"
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.Shape = Enum.PartType.Cylinder
	ring.Material = Enum.Material.Neon
	ring.Color = Color3.fromRGB(255, 50, 40)
	ring.Transparency = 0.6
	local diameter = (cfg.AttackRange + 1.5) * 2
	ring.Size = Vector3.new(0.2, diameter, diameter)
	ring.CFrame = CFrame.new(record.Root.Position.X, groundY, record.Root.Position.Z) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = folder
	record.Telegraph = { ring }

	task.delay(cfg.Windup, function()
		clearTelegraph(record)
		if record.Dead or not record.Model.Parent then
			return
		end
		local root = record.Root
		for _, player in getPlayers() do
			local playerRoot = aliveCharacterRoot(player)
			if playerRoot then
				local offset = flat(playerRoot.Position - root.Position)
				local inRange = offset.Magnitude <= cfg.AttackRange + 1.5
				local inFront = offset.Magnitude < 1 or root.CFrame.LookVector:Dot(offset.Unit) > 0.1
				if inRange and inFront then
					CombatService.DamagePlayer(player, cfg.Damage * record.DamageMultiplier, root.Position, record.Model)
				end
			end
		end
		record.NextAttackAt = os.clock() + cfg.AttackCooldown * record.CooldownMultiplier
		record.State = "Chase"
	end)
end

--------------------------------------------------------------------------
-- Boss special attacks
--------------------------------------------------------------------------
local WARNING_RED = Color3.fromRGB(255, 50, 40)

local function warningPart(props)
	local part = Instance.new("Part")
	part.Name = "AttackWarning"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Material = Enum.Material.Neon
	part.Color = WARNING_RED
	part.Transparency = 0.55
	for key, value in props do
		part[key] = value
	end
	part.Parent = folder
	return part
end

local function groundUnder(record)
	return record.Root.Position.Y - record.Root.Size.Y / 2 - record.Humanoid.HipHeight + 0.1
end

local function glowWeapon(record)
	local weapon = record.Model:FindFirstChild("Weapon")
	if weapon then
		record.WeaponLook = record.WeaponLook or { Material = weapon.Material, Color = weapon.Color }
		weapon.Material = Enum.Material.Neon
		weapon.Color = WARNING_RED
	end
end

-- Phase 7B: a red fan in front (gaze, fire breath) and meteor showers.
local function startConeOrMeteors(record, attack)
	local root = record.Root
	local ground = groundUnder(record)
	local damage = attack.Damage * record.DamageMultiplier

	if attack.Kind == "Cone" then
		local origin = Vector3.new(root.Position.X, ground, root.Position.Z)
		local look = flat(root.CFrame.LookVector).Unit
		local base = CFrame.lookAt(origin, origin + look)
		local warnings = {}
		for i = -3, 3 do
			local angle = math.rad(attack.Arc * i / 3)
			local dir = base * CFrame.Angles(0, angle, 0)
			table.insert(warnings, warningPart({
				Size = Vector3.new(1.2 + attack.Range * 0.06, 0.2, attack.Range),
				CFrame = dir * CFrame.new(0, 0, -attack.Range / 2),
			}))
		end
		record.Telegraph = warnings
		task.delay(attack.Windup, function()
			clearTelegraph(record)
			if record.Dead or not record.Model.Parent then
				return
			end
			local minDot = math.cos(math.rad(attack.Arc + 5))
			for _, player in getPlayers() do
				local playerRoot = aliveCharacterRoot(player)
				if playerRoot then
					local offset = flat(playerRoot.Position - origin)
					if offset.Magnitude <= attack.Range + 1 and (offset.Magnitude < 2 or look:Dot(offset.Unit) >= minDot) then
						CombatService.DamagePlayer(player, damage, origin, record.Model)
						if attack.Slow then
							CombatService.SlowPlayer(player, attack.Slow, attack.SlowTime or 2)
						end
					end
				end
			end
			fxRemote:FireAllClients("Wave", root.Position, WARNING_RED, root.CFrame.LookVector, attack.Range)
			record.State = "Chase"
		end)
	else -- Meteors
		local spots = {}
		local players = {}
		for _, player in getPlayers() do
			local playerRoot = aliveCharacterRoot(player)
			if playerRoot and (playerRoot.Position - root.Position).Magnitude <= attack.Range then
				table.insert(players, playerRoot.Position)
			end
		end
		for i = 1, attack.Count do
			local around = players[((i - 1) % math.max(#players, 1)) + 1] or root.Position
			local offset = if i <= #players then Vector3.zero else Vector3.new(math.random(-12, 12), 0, math.random(-12, 12))
			table.insert(spots, Vector3.new(around.X + offset.X, ground, around.Z + offset.Z))
		end
		local warnings = {}
		for _, spot in spots do
			local d = attack.Radius * 2
			table.insert(warnings, warningPart({
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.2, d, d),
				CFrame = CFrame.new(spot) * CFrame.Angles(0, 0, math.rad(90)),
			}))
		end
		record.Telegraph = warnings
		task.delay(attack.Windup, function()
			clearTelegraph(record)
			if record.Dead or not record.Model.Parent then
				return
			end
			for _, player in getPlayers() do
				local playerRoot = aliveCharacterRoot(player)
				if playerRoot then
					for _, spot in spots do
						if flat(playerRoot.Position - spot).Magnitude <= attack.Radius then
							CombatService.DamagePlayer(player, damage, spot, record.Model)
							break
						end
					end
				end
			end
			for _, spot in spots do
				fxRemote:FireAllClients("Lightning", spot + Vector3.new(0, 3, 0), Color3.fromRGB(255, 140, 40), attack.Radius, true)
			end
			record.State = "Chase"
		end)
	end
end

local function startSpecial(record, target, attack)
	record.State = "Windup"
	record.AttackReadyAt[attack.Name] = os.clock() + attack.Windup + attack.Cooldown * record.CooldownMultiplier
	record.Humanoid:MoveTo(record.Root.Position)
	local targetRoot = aliveCharacterRoot(target)
	if targetRoot then
		face(record, targetRoot.Position)
	end
	glowWeapon(record)
	fxRemote:FireAllClients("EnemyAttack", record.Root.Position, record.Model, attack.Windup)
	local root = record.Root
	local ground = groundUnder(record)
	local origin = Vector3.new(root.Position.X, ground, root.Position.Z)
	local look = flat(root.CFrame.LookVector).Unit
	local damage = attack.Damage * record.DamageMultiplier

	if attack.Kind == "Cone" or attack.Kind == "Meteors" then
		startConeOrMeteors(record, attack)
		return
	end

	if attack.Kind == "Slam" then
		-- A big red circle around the boss; everyone inside when it lands is hit.
		local d = attack.Radius * 2
		local ring = warningPart({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.2, d, d),
			CFrame = CFrame.new(origin) * CFrame.Angles(0, 0, math.rad(90)),
		})
		record.Telegraph = { ring }
		task.delay(attack.Windup, function()
			clearTelegraph(record)
			if record.Dead or not record.Model.Parent then
				return
			end
			for _, player in getPlayers() do
				local playerRoot = aliveCharacterRoot(player)
				if playerRoot and flat(playerRoot.Position - origin).Magnitude <= attack.Radius then
					CombatService.DamagePlayer(player, damage, origin, record.Model)
				end
			end
			fxRemote:FireAllClients("Shockwave", root.Position, WARNING_RED, attack.Radius)
			record.State = "Chase"
		end)
	elseif attack.Kind == "Charge" then
		-- A red lane in front; the boss rushes down it, hitting everyone inside.
		local lane = warningPart({
			Size = Vector3.new(attack.Width, 0.2, attack.Length),
			CFrame = CFrame.lookAt(origin + look * (attack.Length / 2), origin + look * attack.Length),
		})
		record.Telegraph = { lane }
		task.delay(attack.Windup, function()
			clearTelegraph(record)
			if record.Dead or not record.Model.Parent then
				return
			end
			local finish = origin + look * attack.Length
			for _, player in getPlayers() do
				local playerRoot = aliveCharacterRoot(player)
				if playerRoot then
					local offset = flat(playerRoot.Position - origin)
					local along = offset:Dot(look)
					local side = (offset - look * along).Magnitude
					if along >= -1 and along <= attack.Length + 1 and side <= attack.Width / 2 + 1 then
						CombatService.DamagePlayer(player, damage, origin, record.Model)
					end
				end
			end
			-- The rush itself
			local attachment = Instance.new("Attachment")
			attachment.Parent = root
			local push = Instance.new("LinearVelocity")
			push.Attachment0 = attachment
			push.RelativeTo = Enum.ActuatorRelativeTo.World
			push.VectorVelocity = look * (attack.Length / 0.4)
			push.MaxForce = 200000
			push.Parent = root
			Debris:AddItem(push, 0.4)
			Debris:AddItem(attachment, 0.4)
			fxRemote:FireAllClients("DashTrail", root.Position, WARNING_RED, finish + Vector3.new(0, root.Position.Y - origin.Y, 0))
			task.delay(0.45, function()
				record.State = "Chase"
			end)
		end)
	end
end

-- A special attack that is ready and fits the distance, or nil.
local function pickSpecial(record, distance, now)
	local attacks = record.Config.Attacks
	if not attacks then
		return nil
	end
	for _, attack in attacks do
		if now >= (record.AttackReadyAt[attack.Name] or 0) and distance <= attack.Range and distance >= (attack.MinRange or 0) then
			return attack
		end
	end
	return nil
end

local function think(record, now)
	if record.Dead then
		return
	end
	local cfg = record.Config
	local humanoid = record.Humanoid

	if cfg.Passive then
		if now - record.LastDamagedAt > cfg.RegenDelay and humanoid.Health < humanoid.MaxHealth then
			humanoid.Health = humanoid.MaxHealth
		end
		return
	end
	if record.State == "Windup" or now < record.StaggerUntil then
		return
	end

	local target, distance = findTarget(record)
	record.Target = target
	local fromHome = (record.Root.Position - record.Home).Magnitude

	if not target or fromHome > record.LeashRange then
		-- Go home, and heal up once nobody has hit it for a while.
		if fromHome > 3 then
			humanoid:MoveTo(record.Home)
		elseif humanoid.Health < humanoid.MaxHealth and now - record.LastDamagedAt > HEAL_DELAY then
			humanoid.Health = humanoid.MaxHealth
		end
		return
	end

	local targetRoot = aliveCharacterRoot(target)
	local special = pickSpecial(record, distance, now)
	if special then
		startSpecial(record, target, special)
	elseif distance > cfg.AttackRange then
		humanoid:MoveTo(targetRoot.Position)
	elseif now >= record.NextAttackAt then
		startAttack(record, target)
	else
		-- Waiting to attack again: keep facing the target. A tiny step turns it
		-- smoothly; up close (where a step would walk into you) it only turns
		-- when it's facing well away.
		local toward = flat(targetRoot.Position - record.Root.Position)
		if toward.Magnitude > 3.5 then
			humanoid:MoveTo(record.Root.Position + toward.Unit * 0.5)
		elseif toward.Magnitude > 0.5 then
			humanoid:MoveTo(record.Root.Position)
			if record.Root.CFrame.LookVector:Dot(toward.Unit) < 0.8 then
				face(record, targetRoot.Position)
			end
		end
	end
end

--------------------------------------------------------------------------
-- Death and rewards
--------------------------------------------------------------------------
local function die(record)
	if record.Dead then
		return
	end
	record.Dead = true
	enemies[record.Model] = nil
	clearTelegraph(record)

	local cfg = record.Config
	local position = record.Root.Position
	local now = os.clock()
	local xp = math.floor(cfg.XP * record.RewardMultiplier)
	local gold = math.floor(cfg.Gold * record.RewardMultiplier)

	-- Every player who helped gets the reward once.
	for player, info in record.Contributors do
		if player.Parent and info.Damage > 0 and now - info.Last <= REWARD_WINDOW then
			local data = DataService.GetData(player)
			if data then
				data.Stats.EnemiesDefeated += 1
				GameEvents.Fire("KillEnemy", player, record.Type)
				if cfg.Boss then
					GameEvents.Fire("KillBoss", player, record.Type)
				end
				if xp > 0 then
					ProgressionService.AddXP(player, xp, "Combat")
				end
				if gold > 0 then
					ProgressionService.AddCurrency(player, "Gold", gold, "Combat")
				end
				if xp > 0 or gold > 0 then
					fxRemote:FireClient(player, "Reward", position, ("+%d XP  +%d Gold"):format(xp, gold))
				end
			end
		end
	end

	-- Roblox's classic death: the joints break and the body falls apart.
	-- Make every piece land on the ground and tumble, then fade away.
	fxRemote:FireAllClients("Death", position)
	for _, item in record.Model:GetDescendants() do
		if item:IsA("BasePart") then
			item.CanCollide = true
			item.Massless = false
		elseif item:IsA("BillboardGui") then
			item.Enabled = false
		end
	end
	task.delay(2, function()
		for _, item in record.Model:GetDescendants() do
			if item:IsA("BasePart") then
				TweenService:Create(item, TweenInfo.new(1), { Transparency = 1 }):Play()
			end
		end
	end)
	Debris:AddItem(record.Model, 3.2)

	if record.OnDeath then
		task.spawn(record.OnDeath, record.Model)
	end
end

--------------------------------------------------------------------------
-- Public API
--------------------------------------------------------------------------
function EnemyService.Init(dataService, progressionService, combatService, fxRemoteEvent)
	DataService = dataService
	ProgressionService = progressionService
	CombatService = combatService
	fxRemote = fxRemoteEvent

	folder = Workspace:FindFirstChild("Enemies")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Enemies"
		folder.Parent = Workspace
	end

	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if elapsed < THINK_INTERVAL then
			return
		end
		elapsed = 0
		local now = os.clock()
		for _, record in enemies do
			think(record, now)
		end
	end)
end

function EnemyService.Spawn(enemyType, cframe, options)
	local cfg = CombatConfig.Enemies[enemyType]
	if not cfg then
		warn("[EnemyService] Unknown enemy type: " .. tostring(enemyType))
		return nil
	end
	options = options or {}

	local model = makeBody(enemyType, cfg)
	model.Name = enemyType
	for _, item in model:GetDescendants() do
		if item:IsA("BasePart") then
			item.CollisionGroup = CombatService.ENEMY_GROUP
		end
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	local healthMultiplier = options.HealthMultiplier or 1
	if cfg.Boss then
		healthMultiplier *= CombatConfig.BossHealthScale or 1 -- Phase 7E nerf, one place to tune
	end
	humanoid.MaxHealth = math.floor(cfg.MaxHealth * healthMultiplier)
	humanoid.Health = humanoid.MaxHealth
	humanoid.WalkSpeed = cfg.WalkSpeed * (options.SpeedMultiplier or 1)
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.BreakJointsOnDeath = true

	-- Stand on the ground whatever the size: root centre = half the root + hip height.
	model:PivotTo(cframe + Vector3.new(0, root.Size.Y / 2 + humanoid.HipHeight, 0))
	if cfg.Passive then
		root.Anchored = true
	end
	if cfg.Builder == "Dummy" then
		model:SetAttribute("Dummy", true) -- clients wobble it when hit
	end
	model:SetAttribute("IsEnemy", true)
	if cfg.Boss then
		model:SetAttribute("IsBoss", true)
		model:SetAttribute("DisplayName", cfg.DisplayName)
	end
	for key, value in options.Attributes or {} do
		model:SetAttribute(key, value)
	end
	model.Parent = folder
	if not root.Anchored then
		pcall(function()
			root:SetNetworkOwner(nil) -- the server moves enemies; players can't
		end)
	end

	local record = {
		Model = model,
		Humanoid = humanoid,
		Root = root,
		Type = enemyType,
		Config = cfg,
		Home = cframe.Position,
		State = "Idle",
		Target = nil,
		NextAttackAt = 0,
		LastDamagedAt = 0,
		LastAttacker = nil,
		Contributors = {}, -- [Player] = { Damage, Last }
		Dead = false,
		DamageMultiplier = (options.DamageMultiplier or 1) * (if cfg.Boss then CombatConfig.BossDamageScale or 1 else 1),
		RewardMultiplier = options.RewardMultiplier or 1,
		OnDeath = options.OnDeath,
		OnPhase2 = options.OnPhase2,
		StaggerUntil = 0,
		AggroRange = options.AggroRange or cfg.AggroRange or 0,
		LeashRange = options.LeashRange or cfg.LeashRange or 0,
		AttackReadyAt = {},
		CooldownMultiplier = 1,
		Phase2 = false,
	}
	-- Special attacks start on a short delay so a boss doesn't open with one.
	for _, attack in cfg.Attacks or {} do
		record.AttackReadyAt[attack.Name] = os.clock() + 3
	end
	addHealthBar(record)

	local walkTrack = if cfg.Passive then nil else loadAnimation(humanoid, WALK_ANIMATION)
	if walkTrack then
		humanoid.Running:Connect(function(speed)
			if speed > 0.5 and not walkTrack.IsPlaying then
				walkTrack:Play()
			elseif speed <= 0.5 and walkTrack.IsPlaying then
				walkTrack:Stop()
			end
		end)
	end

	humanoid.Died:Connect(function()
		die(record)
	end)
	enemies[model] = record
	return model
end

-- Damages an enemy on behalf of a player. Returns true if it was hit.
-- options.Knockback = push speed (studs/s) instead of the default.
function EnemyService.DamageEnemy(model, amount, player, options)
	local record = enemies[model]
	if not record or record.Dead or record.Humanoid.Health <= 0 then
		return false
	end
	amount = math.max(1, math.floor(amount))
	local now = os.clock()
	record.LastDamagedAt = now
	if player then
		record.LastAttacker = player
		if not record.Config.Immortal then
			GameEvents.Fire("HitEnemy", player, record.Type) -- Phase 7E: fills Divine Energy
		end
		local info = record.Contributors[player] or { Damage = 0, Last = 0 }
		info.Damage += amount
		info.Last = now
		record.Contributors[player] = info
	end
	local head = model:FindFirstChild("Head") or record.Root
	fxRemote:FireAllClients("Damage", head.Position + Vector3.new(0, 1.5, 0), amount, if options and options.Crit then "Crit" else "Enemy")

	if record.Config.Immortal then
		-- Training dummies never die: a "knockout" pops them straight back up.
		if record.Humanoid.Health - amount <= 0 then
			record.Humanoid.Health = record.Humanoid.MaxHealth
			fxRemote:FireAllClients("Damage", head.Position + Vector3.new(0, 3, 0), 0, "KnockedOut")
			fxRemote:FireAllClients("Death", record.Root.Position)
		else
			record.Humanoid.Health -= amount
		end
		return true
	end

	record.Humanoid:TakeDamage(amount)
	if record.Humanoid.Health <= 0 then
		die(record)
		return true
	end

	-- Boss second phase.
	local phase2 = record.Config.Phase2
	if phase2 and not record.Phase2 and record.Humanoid.Health <= record.Humanoid.MaxHealth * phase2.At then
		record.Phase2 = true
		record.CooldownMultiplier = phase2.CooldownMultiplier or 1
		record.Humanoid.WalkSpeed *= phase2.SpeedMultiplier or 1
		model:SetAttribute("Enraged", true)
		if record.OnPhase2 then
			task.spawn(record.OnPhase2, model)
		end
	end
	if record.Config.Boss then
		return true -- bosses aren't knocked back or staggered
	end

	-- Knock it back a little and interrupt its walking (not a wind-up already started).
	local attackerRoot = player and aliveCharacterRoot(player)
	if attackerRoot and not record.Root.Anchored then
		local away = flat(record.Root.Position - attackerRoot.Position)
		if away.Magnitude > 0.1 then
			-- A short push that the enemy's own walking can't cancel.
			local attachment = Instance.new("Attachment")
			attachment.Parent = record.Root
			local push = Instance.new("LinearVelocity")
			push.Attachment0 = attachment
			push.RelativeTo = Enum.ActuatorRelativeTo.World
			push.VectorVelocity = away.Unit * (options and options.Knockback or KNOCKBACK_SPEED)
			push.MaxForce = 40000
			push.Parent = record.Root
			Debris:AddItem(push, 0.12)
			Debris:AddItem(attachment, 0.12)
		end
		record.Humanoid:MoveTo(record.Root.Position)
		record.StaggerUntil = now + STAGGER_TIME
	end
	return true
end

-- Pushes an enemy (e.g. into a whirlpool) for a moment. Bosses resist.
function EnemyService.Push(model, velocity, duration)
	local record = enemies[model]
	if not record or record.Dead or record.Root.Anchored or record.Config.Boss then
		return
	end
	local attachment = Instance.new("Attachment")
	attachment.Parent = record.Root
	local push = Instance.new("LinearVelocity")
	push.Attachment0 = attachment
	push.RelativeTo = Enum.ActuatorRelativeTo.World
	push.VectorVelocity = velocity
	push.MaxForce = 40000
	push.Parent = record.Root
	Debris:AddItem(push, duration)
	Debris:AddItem(attachment, duration)
end

-- Slows an enemy's walking (multiplier 0.5 = half speed) for a while.
function EnemyService.Slow(model, multiplier, duration)
	local record = enemies[model]
	if not record or record.Dead or record.Slowed then
		return
	end
	record.Slowed = true
	local humanoid = record.Humanoid
	humanoid.WalkSpeed *= multiplier
	task.delay(duration, function()
		record.Slowed = false
		if humanoid.Parent then
			humanoid.WalkSpeed /= multiplier
		end
	end)
end

-- Removes an enemy without rewards (e.g. when an arena run ends).
function EnemyService.Remove(model)
	local record = enemies[model]
	if record then
		record.Dead = true
		enemies[model] = nil
		clearTelegraph(record)
	end
	if model then
		model:Destroy()
	end
end

-- Living enemies whose root is within `range` of `position`.
function EnemyService.GetEnemiesInRange(position, range)
	local found = {}
	for _, record in enemies do
		if not record.Dead and (record.Root.Position - position).Magnitude <= range then
			table.insert(found, record)
		end
	end
	return found
end

function EnemyService.GetEnemyCount()
	local count = 0
	for _ in enemies do
		count += 1
	end
	return count
end

-- Test helper: lets the cloud test supply pretend players.
function EnemyService._SetPlayerProvider(provider)
	getPlayers = provider
end

-- Spawns the Practice Field enemies; each one respawns after it dies.
function EnemyService.SpawnPracticeField()
	local field = CombatConfig.PracticeField
	for _, entry in field.Spawns do
		local cfg = CombatConfig.Enemies[entry.Enemy]
		local position = field.Center + entry.Offset
		local cframe = CFrame.lookAt(position, position + Vector3.new(0, 0, 1)) -- face the entrance
		local function spawnOne()
			EnemyService.Spawn(entry.Enemy, cframe, {
				OnDeath = function()
					task.wait(cfg.RespawnTime)
					spawnOne()
				end,
			})
		end
		task.spawn(spawnOne) -- all at once, not one after another
	end
end

return EnemyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">EnvironmentService</string>
          <string name="Source"><![CDATA[-- EnvironmentService (ModuleScript)
-- Location: ServerScriptService > Services > EnvironmentService
--
-- Phase 8: the look of Mount Olympus.
--   * Lighting: golden late-afternoon sun, atmosphere haze, bloom, sun rays,
--     colour grading and drifting sky clouds.
--   * Terrain: the summit of Mount Olympus right under the plaza, practice
--     field and temple district (a rocky plateau with grass, cliffs falling
--     away, snow on the upper slopes), plus distant peaks rising out of the
--     clouds.
--   * A sea of clouds far below that stretches to the horizon.
-- Everything is generated when the server starts (nothing to upload).
-- Settings are at the top of this file.

local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local EnvironmentService = {}

local SUMMIT_CENTER = Vector3.new(0, 0, 90)  -- under the plaza + temple district
local SUMMIT_RADIUS = 390                    -- flat top covers everything built
local SUMMIT_TOP = -4.5                      -- under the floors (terrain voxels round up ~2.5 studs)
local MOUNTAIN_DEPTH = 300                   -- the cliffs go down into the clouds
local CLOUD_Y = -270                         -- height of the cloud sea
local CLOUD_EXTENT = 7000                    -- how far the cloud sea reaches

-- Distant peaks (X, Z, height above the clouds, base radius). Kept away from
-- the arenas (which float at Z = 1500).
local PEAKS = {
	{ -1300, 600, 380, 420 },
	{ 1250, 300, 300, 360 },
	{ -700, -1200, 260, 330 },
	{ 1100, -1000, 420, 460 },
	{ -1800, -300, 220, 300 },
	{ 2000, 1300, 340, 380 },
	{ -1400, 2100, 300, 360 },
}

--------------------------------------------------------------------------
-- Lighting and sky
--------------------------------------------------------------------------
local function setupLighting()
	Lighting.ClockTime = 16.6               -- golden late afternoon
	Lighting.GeographicLatitude = 38          -- Greece
	Lighting.Brightness = 3
	Lighting.Ambient = Color3.fromRGB(70, 60, 75)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 135, 150)
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.GlobalShadows = true
	Lighting.ExposureCompensation = 0.15

	for _, item in Lighting:GetChildren() do
		if item:IsA("Sky") or item:IsA("Atmosphere") or item:IsA("PostEffect") then
			item:Destroy()
		end
	end

	local sky = Instance.new("Sky")
	sky.Name = "OlympusSky"
	sky.SunAngularSize = 14
	sky.MoonAngularSize = 9
	sky.StarCount = 4000
	sky.CelestialBodiesShown = true
	sky.Parent = Lighting

	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Name = "OlympusAir"
	atmosphere.Density = 0.32
	atmosphere.Offset = 0.12
	atmosphere.Color = Color3.fromRGB(255, 226, 200)   -- warm haze
	atmosphere.Decay = Color3.fromRGB(150, 120, 190)   -- violet distance
	atmosphere.Glare = 0.6
	atmosphere.Haze = 1.6
	atmosphere.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Name = "DivineBloom"
	bloom.Intensity = 0.9
	bloom.Size = 30
	bloom.Threshold = 1.6
	bloom.Parent = Lighting

	local rays = Instance.new("SunRaysEffect")
	rays.Name = "DivineRays"
	rays.Intensity = 0.12
	rays.Spread = 0.8
	rays.Parent = Lighting

	local grade = Instance.new("ColorCorrectionEffect")
	grade.Name = "DivineGrade"
	grade.Brightness = 0.02
	grade.Contrast = 0.12
	grade.Saturation = 0.12
	grade.TintColor = Color3.fromRGB(255, 246, 236)
	grade.Parent = Lighting

	-- Drifting clouds in the sky above
	local terrain = Workspace.Terrain
	local clouds = terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
	clouds.Cover = 0.55
	clouds.Density = 0.5
	clouds.Color = Color3.fromRGB(255, 240, 235)
	clouds.Parent = terrain
end

--------------------------------------------------------------------------
-- Terrain
--------------------------------------------------------------------------
local rng = Random.new(1821) -- fixed seed: the mountain looks the same every server

local function ball(terrain, position, radius, material)
	terrain:FillBall(position, radius, material)
end

-- A craggy cone made of overlapping rock balls (only the outer shell is
-- filled, so it stays light): from `topY` down to `bottomY`.
local function craggyCone(terrain, center, topY, bottomY, topRadius, bottomRadius, materials)
	local height = topY - bottomY
	local layers = math.max(3, math.floor(height / 26))
	for layer = 0, layers do
		local t = layer / layers -- 0 at the top, 1 at the bottom
		local y = topY - t * height
		local radius = topRadius + (bottomRadius - topRadius) * (t ^ 0.8)
		local blob = 18 + 14 * t + rng:NextNumber(0, 6)
		local count = math.max(6, math.floor(2 * math.pi * radius / (blob * 1.6)))
		local twist = rng:NextNumber(0, math.pi * 2)
		for i = 1, count do
			local angle = twist + i / count * math.pi * 2
			local wobble = rng:NextNumber(-0.06, 0.08) * radius
			local r = radius + wobble
			local position = Vector3.new(center.X + math.cos(angle) * r, y + rng:NextNumber(-6, 6), center.Z + math.sin(angle) * r)
			local material = materials(t, rng)
			ball(terrain, position, blob * rng:NextNumber(0.85, 1.2), material)
		end
	end
end

local function summitMaterial(t, random)
	if t < 0.12 then
		return if random:NextNumber() < 0.55 then Enum.Material.Grass else Enum.Material.Rock
	elseif t < 0.45 then
		local roll = random:NextNumber()
		if roll < 0.35 then
			return Enum.Material.Snow
		elseif roll < 0.5 then
			return Enum.Material.Glacier
		end
		return Enum.Material.Rock
	elseif t < 0.75 then
		return if random:NextNumber() < 0.6 then Enum.Material.Slate else Enum.Material.Rock
	end
	return Enum.Material.Basalt
end

local function peakMaterial(t, random)
	if t < 0.3 then
		return if random:NextNumber() < 0.7 then Enum.Material.Snow else Enum.Material.Glacier
	elseif t < 0.6 then
		return if random:NextNumber() < 0.3 then Enum.Material.Snow else Enum.Material.Rock
	end
	return Enum.Material.Slate
end

local function buildTerrain()
	local terrain = Workspace.Terrain
	terrain:Clear()
	terrain.WaterWaveSize = 0
	terrain.Decoration = true -- grass blades on Grass
	terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(120, 160, 80))
	terrain:SetMaterialColor(Enum.Material.Rock, Color3.fromRGB(150, 140, 130))
	terrain:SetMaterialColor(Enum.Material.Slate, Color3.fromRGB(120, 115, 120))
	terrain:SetMaterialColor(Enum.Material.Snow, Color3.fromRGB(245, 248, 255))

	-- The summit plateau: a flat slab with a grassy top, under everything.
	local c = SUMMIT_CENTER
	local slabThickness = 24
	terrain:FillCylinder(CFrame.new(c.X, SUMMIT_TOP - slabThickness / 2, c.Z), slabThickness, SUMMIT_RADIUS, Enum.Material.Rock)
	terrain:FillCylinder(CFrame.new(c.X, SUMMIT_TOP - 2, c.Z), 4, SUMMIT_RADIUS - 6, Enum.Material.Grass)
	-- Worn paths of stone in the grass
	for _ = 1, 40 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(60, SUMMIT_RADIUS - 30)
		terrain:FillCylinder(CFrame.new(c.X + math.cos(angle) * r, SUMMIT_TOP - 2, c.Z + math.sin(angle) * r), 4.2, rng:NextNumber(8, 22), Enum.Material.Rock)
	end
	task.wait()

	-- Boulders and a rocky rim around the edge of the plateau
	for i = 1, 70 do
		local angle = i / 70 * math.pi * 2 + rng:NextNumber(-0.03, 0.03)
		local r = SUMMIT_RADIUS + rng:NextNumber(-2, 10)
		local size = rng:NextNumber(8, 18)
		ball(terrain, Vector3.new(c.X + math.cos(angle) * r, SUMMIT_TOP + size * 0.25, c.Z + math.sin(angle) * r), size, if rng:NextNumber() < 0.3 then Enum.Material.Snow else Enum.Material.Rock)
	end
	task.wait()

	-- The mountain falling away below the plateau, down into the clouds
	craggyCone(terrain, c, SUMMIT_TOP - 10, SUMMIT_TOP - MOUNTAIN_DEPTH, SUMMIT_RADIUS + 8, SUMMIT_RADIUS + 360, summitMaterial)
	task.wait()

	-- Distant peaks
	for _, peak in PEAKS do
		local center = Vector3.new(peak[1], 0, peak[2])
		local top = CLOUD_Y + peak[3]
		craggyCone(terrain, center, top, CLOUD_Y - 25, 18, peak[4], peakMaterial)
		ball(terrain, Vector3.new(center.X, top + 6, center.Z), 26, Enum.Material.Snow) -- the snowy tip
		task.wait()
	end
end

--------------------------------------------------------------------------
-- Sea of clouds
--------------------------------------------------------------------------
local function buildCloudSea()
	local old = Workspace:FindFirstChild("CloudSea")
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "CloudSea"

	local function cloudPart(size, position, transparency, color)
		local part = Instance.new("Part")
		part.Name = "Cloud"
		part.Shape = Enum.PartType.Ball
		part.Size = size
		part.Position = position
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Material = Enum.Material.SmoothPlastic
		part.Color = color
		part.Transparency = transparency
		part.Parent = folder
		return part
	end

	-- A flat floor of cloud so there are never holes (parts max 2048 studs).
	local tile = 2048
	local tiles = math.ceil(CLOUD_EXTENT * 2 / tile)
	for ix = 0, tiles - 1 do
		for iz = 0, tiles - 1 do
			local part = Instance.new("Part")
			part.Name = "CloudFloor"
			part.Size = Vector3.new(tile, 2, tile)
			part.Position = Vector3.new(-CLOUD_EXTENT + tile / 2 + ix * tile, CLOUD_Y - 22, 900 - CLOUD_EXTENT + tile / 2 + iz * tile)
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.CastShadow = false
			part.Material = Enum.Material.SmoothPlastic
			part.Color = Color3.fromRGB(246, 236, 240)
			part.Parent = folder
		end
	end

	-- Puffy cloud mounds: big near the mountain, spread to the horizon.
	local cloudRng = Random.new(77)
	local colors = { Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 244, 238), Color3.fromRGB(246, 236, 248), Color3.fromRGB(255, 236, 220) }
	for _ = 1, 420 do
		local distance = 300 + cloudRng:NextNumber() ^ 1.4 * (CLOUD_EXTENT - 400)
		local angle = cloudRng:NextNumber(0, math.pi * 2)
		local width = cloudRng:NextNumber(160, 420) * (1 + distance / 4000)
		local position = Vector3.new(math.cos(angle) * distance, CLOUD_Y + cloudRng:NextNumber(-18, 22), 90 + math.sin(angle) * distance)
		cloudPart(Vector3.new(width, width * cloudRng:NextNumber(0.18, 0.3), width), position, cloudRng:NextNumber(0, 0.15), colors[cloudRng:NextInteger(1, #colors)])
	end
	-- Wisps hugging the mountain's sides
	for i = 1, 60 do
		local angle = i / 60 * math.pi * 2
		local distance = SUMMIT_RADIUS + cloudRng:NextNumber(120, 380)
		local width = cloudRng:NextNumber(90, 200)
		cloudPart(Vector3.new(width, width * 0.25, width * 0.7), Vector3.new(math.cos(angle) * distance, CLOUD_Y + cloudRng:NextNumber(20, 120), 90 + math.sin(angle) * distance), cloudRng:NextNumber(0.35, 0.6), colors[1])
	end
	folder.Parent = Workspace
end

function EnvironmentService.Build()
	setupLighting()
	buildCloudSea()
	task.spawn(buildTerrain) -- takes a few seconds; players can already play
end

return EnvironmentService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">GameEvents</string>
          <string name="Source"><![CDATA[-- GameEvents (ModuleScript)
-- Location: ServerScriptService > Services > GameEvents
--
-- A tiny message board for "something happened" (Phase 7D). Systems report
-- events here, and anything that cares (quests) listens, so systems don't
-- need to know about each other.
--   GameEvents.Fire(eventName, player, target, amount)
--   GameEvents.Connect(function(eventName, player, target, amount) ... end)
-- Events: KillEnemy, KillBoss (target = enemy type), WinArena (arena id),
-- UpgradeBuilding (building id), Worship (god id), UpgradeBlessing
-- (blessing id), UseAbility (god id), CraftWeapon, UpgradeWeapon (weapon id),
-- EarnGold (amount), WinChallenge (challenge id).

local GameEvents = {}

local listeners = {}

function GameEvents.Connect(listener)
	table.insert(listeners, listener)
end

function GameEvents.Fire(eventName, player, target, amount)
	for _, listener in listeners do
		task.spawn(listener, eventName, player, target, amount or 1)
	end
end

return GameEvents
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">GodService</string>
          <string name="Source"><![CDATA[-- GodService (ModuleScript)
-- Location: ServerScriptService > Services > GodService
--
-- Everything about gods, on the server:
--   * First god choice (the intro screen), Zeus and Ares playable for now.
--   * Blessings: unlocked and upgraded with Divine Favor, gated by Main Altar
--     level, loyalty with the god, and ascension rank (rules in GodConfig).
--   * Passive blessing bonuses (attack / health / speed) for the ACTIVE god only.
--   * Worship at your god's statue: Divine Favor + loyalty (cooldown saved).
--   * Changing god: start at the Shrine of Change, then pray there.
--     Levels, currencies, temple, and every god's blessings/loyalty are kept.
--   * Builds the Hall of the Gods in Olympus Plaza.
--   * Tells TempleService which colours to paint the temple.

local GameEvents = require(script.Parent:WaitForChild("GameEvents"))
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GodConfig = require(Shared:WaitForChild("GodConfig"))
local MasteryConfig = require(Shared:WaitForChild("MasteryConfig"))
local WorldBuilder = require(ServerScriptService:WaitForChild("Services"):WaitForChild("WorldBuilder"))

local GodService = {}

local DataService = nil
local ProgressionService = nil
local TempleService = nil
local notifyRemote = nil

local MAX_LEVEL = GodConfig.MaxBlessingLevel
local HALL_CENTER = Vector3.new(-42, 1, -35) -- on the plaza floor (top at Y = 1)
local lastAction = {} -- [Player] = os.clock() of last menu request

--------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------
local function notify(player, kind, value)
	if notifyRemote and player.Parent then
		notifyRemote:FireClient(player, kind, value)
	end
end

local function message(player, text)
	notify(player, "Message", text)
end

local function blessingLevel(data, godId, blessingId)
	local tree = data.Blessings[godId]
	return if type(tree) == "table" then tonumber(tree[blessingId]) or 0 else 0
end

local function loyalty(data, godId)
	return tonumber(data.GodLoyalty[godId]) or 0
end

-- Tier 1 level 1 is free whenever you start worshipping a god.
local function grantFirstBlessing(data, godId)
	local god = GodConfig.Gods[godId]
	data.Blessings[godId] = data.Blessings[godId] or {}
	for _, blessing in god.Blessings do
		if blessing.Tier == 1 and blessingLevel(data, godId, blessing.Id) < 1 then
			data.Blessings[godId][blessing.Id] = 1
		end
	end
end

local function sanitize(data)
	if type(data.SelectedGod) ~= "string" or (data.SelectedGod ~= "" and not GodConfig.IsPlayable(data.SelectedGod)) then
		data.SelectedGod = ""
	end
	for godId, tree in data.Blessings do
		if type(tree) == "table" then
			for id, level in tree do
				tree[id] = math.clamp(math.floor(tonumber(level) or 0), 0, MAX_LEVEL)
			end
		else
			data.Blessings[godId] = nil
		end
	end
	for godId, value in data.GodLoyalty do
		data.GodLoyalty[godId] = math.max(0, math.floor(tonumber(value) or 0))
	end
	local change = data.GodChange
	if change.Target ~= "" and (not GodConfig.IsPlayable(change.Target) or change.Target == data.SelectedGod) then
		change.Target, change.Prayers = "", 0
	end
end

-- Publishes god values so the menus can show them.
local function pushAttributes(player, data)
	local godId = data.SelectedGod
	player:SetAttribute("SelectedGod", godId)
	player:SetAttribute("Loyalty", if godId ~= "" then loyalty(data, godId) else 0)
	for blessingId, entry in GodConfig.BlessingsById do
		player:SetAttribute("Blessing_" .. blessingId, blessingLevel(data, entry.God, blessingId))
	end
	player:SetAttribute("GodChangeTarget", data.GodChange.Target)
	player:SetAttribute("GodChangePrayers", data.GodChange.Prayers)
	player:SetAttribute("NextPrayerAt", data.GodChange.NextPrayerAt)
	player:SetAttribute("NextWorshipAt", data.NextWorshipAt)

	local bonuses = GodService.GetBonuses(player)
	player:SetAttribute("BonusAttackPercent", bonuses.AttackPercent)
	player:SetAttribute("BonusHealthPercent", bonuses.HealthPercent)
	player:SetAttribute("BonusSpeedPercent", bonuses.SpeedPercent)
end

-- After anything that changes bonuses or colours.
local function refreshAll(player, data, rebuildTemple)
	pushAttributes(player, data)
	ProgressionService.RefreshAll(player) -- re-applies health, speed and attack
	if rebuildTemple then
		TempleService.Rebuild(player) -- new god colours
	end
end

--------------------------------------------------------------------------
-- Hall of the Gods (placeholder build in Olympus Plaza)
--------------------------------------------------------------------------
local function addPrompt(part, actionText, objectText, onTriggered)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.HoldDuration = 0.3
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = part
	prompt.Triggered:Connect(onTriggered)
	return prompt
end

function GodService.BuildHall()
	local hub = Workspace:WaitForChild("Hub")
	if hub:FindFirstChild("HallOfTheGods") then
		return
	end
	local hall = Instance.new("Model")
	hall.Name = "HallOfTheGods"
	local c = HALL_CENTER
	local MP = WorldBuilder.MakePart

	MP(hall, { Name = "Floor", Size = Vector3.new(18, 0.6, 26), Position = c + Vector3.new(0, 0.3, 0), Color = Color3.fromRGB(245, 240, 228) })
	local titlePart = MP(hall, { Name = "Title", Size = Vector3.new(1, 1, 1), Position = c + Vector3.new(0, 1, 0), Transparency = 1, CanCollide = false })
	WorldBuilder.AddLabel(titlePart, "Hall of the Gods", Color3.fromRGB(255, 220, 120), 16)

	-- One statue per god along the back (west) side, facing the plaza.
	for i, godId in GodConfig.Order do
		local god = GodConfig.Gods[godId]
		local z = c.Z - 11 + (i - 1) * 4.4
		local x = c.X - 6
		MP(hall, { Name = godId .. "Pedestal", Size = Vector3.new(3, 2, 3), Position = Vector3.new(x, c.Y + 1.6, z) })
		local figure = MP(hall, {
			Name = godId .. "Statue",
			Size = Vector3.new(1.8, 6, 1.8),
			Position = Vector3.new(x, c.Y + 5.6, z),
			Material = if god.Available then Enum.Material.Neon else Enum.Material.Marble,
			Color = if god.Available then god.Colors.Primary else Color3.fromRGB(190, 185, 178),
		})
		WorldBuilder.AddLabel(figure, god.DisplayName .. "\n" .. (if god.Available then god.Title else "Coming in Phase 7"), god.Colors.Primary, 5)
		if god.Available then
			local light = Instance.new("PointLight")
			light.Color = god.Colors.Primary
			light.Range = 10
			light.Parent = figure
			addPrompt(figure, "Worship", god.DisplayName, function(player)
				GodService.Worship(player, godId)
			end)
		end
	end

	-- Altar that opens the god menu
	local altar = MP(hall, { Name = "GodAltar", Size = Vector3.new(4, 3, 3), Position = c + Vector3.new(3, 2.1, -4), Color = Color3.fromRGB(212, 175, 55), Material = Enum.Material.Metal })
	WorldBuilder.AddLabel(altar, "Your God & Blessings", Color3.new(1, 1, 1), 4)
	addPrompt(altar, "Open", "Gods & Blessings", function(player)
		notify(player, "OpenGodMenu", "Blessings")
	end)

	-- Shrine of Change
	local shrine = MP(hall, {
		Name = "ShrineOfChange",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(7, 2.4, 2.4),
		CFrame = CFrame.new(c + Vector3.new(3, 4.1, 6)) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(160, 100, 230),
	})
	WorldBuilder.AddLabel(shrine, "Shrine of Change", Color3.fromRGB(200, 160, 255), 5)
	addPrompt(shrine, "Pray", "Shrine of Change", function(player)
		GodService.Pray(player)
	end)

	hall.Parent = hub
end

--------------------------------------------------------------------------
-- Public API
--------------------------------------------------------------------------
function GodService.Init(dataService, progressionService, templeService, notifyRemoteEvent, godRemote)
	DataService = dataService
	ProgressionService = progressionService
	TempleService = templeService
	notifyRemote = notifyRemoteEvent

	ProgressionService.SetBonusProvider(GodService.GetBonuses)
	TempleService.SetColorProvider(GodService.GetColors)

	-- Requests from the god menus: ("Choose", godId), ("UpgradeBlessing", blessingId),
	-- ("StartChange", godId), ("CancelChange"). Never trust the client.
	if godRemote then
		godRemote.OnServerEvent:Connect(function(player, action, arg)
			local now = os.clock()
			if lastAction[player] and now - lastAction[player] < 0.3 then
				return
			end
			lastAction[player] = now
			if action == "Choose" and type(arg) == "string" then
				GodService.ChooseFirstGod(player, arg)
			elseif action == "UpgradeBlessing" and type(arg) == "string" then
				GodService.UpgradeBlessing(player, arg)
			elseif action == "StartChange" and type(arg) == "string" then
				GodService.StartGodChange(player, arg)
			elseif action == "CancelChange" then
				GodService.CancelGodChange(player)
			end
		end)
	end
end

-- Call after data has loaded (before TempleService.SetupPlayer).
function GodService.SetupPlayer(player)
	local data = DataService.GetData(player)
	if not data then
		return
	end
	sanitize(data)
	pushAttributes(player, data)
end

-- Re-publish everything (used after the !reset debug command).
function GodService.Refresh(player)
	local data = DataService.GetData(player)
	if data then
		sanitize(data)
		refreshAll(player, data, false)
	end
end

function GodService.ReleasePlayer(player)
	lastAction[player] = nil
end

-- Sum of passive bonuses from the ACTIVE god's blessings.
function GodService.GetBonuses(player)
	local bonuses = { AttackPercent = 0, HealthPercent = 0, SpeedPercent = 0 }
	local data = DataService.GetData(player)
	local god = data and GodConfig.Gods[data.SelectedGod]
	if not god then
		return bonuses
	end
	for _, blessing in god.Blessings do
		local level = blessingLevel(data, god.Id, blessing.Id)
		local stat = blessing.Passive and blessing.Passive.Stat
		if level > 0 and bonuses[stat] then
			bonuses[stat] += level * blessing.Passive.PerLevel
		end
	end
	-- Phase 7E: Divine Mastery adds a small bonus for this god.
	local mastery = type(data.Mastery) == "table" and data.Mastery[god.Id]
	local masteryLevel = if type(mastery) == "table" then math.clamp(tonumber(mastery.Level) or 1, 1, MasteryConfig.MaxLevel) else 1
	bonuses.AttackPercent += masteryLevel * MasteryConfig.AttackPercentPerLevel
	bonuses.HealthPercent += masteryLevel * MasteryConfig.HealthPercentPerLevel
	return bonuses
end

function GodService.GetColors(player)
	local data = DataService.GetData(player)
	return GodConfig.GetColors(data and data.SelectedGod or "")
end

function GodService.ChooseFirstGod(player, godId)
	local data = DataService.GetData(player)
	if not data or data.SelectedGod ~= "" then
		return false -- already chosen: changing goes through the Shrine of Change
	end
	if not GodConfig.IsPlayable(godId) then
		message(player, "That god is not available yet.")
		return false
	end
	data.SelectedGod = godId
	grantFirstBlessing(data, godId)
	refreshAll(player, data, true)
	local god = GodConfig.Gods[godId]
	message(player, ("You now worship %s, %s!"):format(god.DisplayName, god.Title))
	return true
end

function GodService.UpgradeBlessing(player, blessingId)
	local data = DataService.GetData(player)
	local entry = GodConfig.BlessingsById[blessingId]
	if not data or not entry then
		return false
	end
	if entry.God ~= data.SelectedGod then
		message(player, "You can only upgrade blessings of the god you worship.")
		return false
	end

	local level = blessingLevel(data, entry.God, blessingId)
	local altarLevel = tonumber(data.Temple.Buildings.MainAltar) or 0
	local info = GodConfig.GetBlessingUpgradeInfo(blessingId, level, altarLevel, loyalty(data, entry.God), data.RankIndex)
	if info.Maxed then
		message(player, entry.Blessing.Name .. " is already at max level.")
		return false
	end
	if info.Blocked then
		message(player, info.Blocked .. " to upgrade " .. entry.Blessing.Name .. ".")
		return false
	end
	if info.Cost > 0 and not ProgressionService.SpendCurrency(player, "DivineFavor", info.Cost) then
		message(player, ("You need %d more Divine Favor."):format(info.Cost - (data.Currencies.DivineFavor or 0)))
		return false
	end

	data.Blessings[entry.God] = data.Blessings[entry.God] or {}
	data.Blessings[entry.God][blessingId] = info.NextLevel
	refreshAll(player, data, false)
	message(player, ("%s reached level %d!"):format(entry.Blessing.Name, info.NextLevel))
	GameEvents.Fire("UpgradeBlessing", player, blessingId)
	return true
end

function GodService.Worship(player, godId)
	local data = DataService.GetData(player)
	if not data then
		return false
	end
	if data.SelectedGod == "" then
		notify(player, "OpenGodMenu", "Choose")
		return false
	end
	if godId ~= data.SelectedGod then
		message(player, ("You worship %s. Visit the Shrine of Change to switch gods."):format(GodConfig.Gods[data.SelectedGod].DisplayName))
		return false
	end
	local now = os.time()
	if now < data.NextWorshipAt then
		message(player, ("You can worship again in %d seconds."):format(data.NextWorshipAt - now))
		return false
	end

	local multiplier = 1 + TempleService.GetEffect(player, "WorshipBonusPercent") / 100
	local favor = math.floor(GodConfig.Worship.Favor * multiplier)
	local gainedLoyalty = math.floor(GodConfig.Worship.Loyalty * multiplier)
	data.NextWorshipAt = now + GodConfig.Worship.Cooldown
	data.GodLoyalty[godId] = loyalty(data, godId) + gainedLoyalty
	ProgressionService.AddCurrency(player, "DivineFavor", favor, "Worship")
	pushAttributes(player, data)
	message(player, ("%s is pleased: +%d Favor, +%d Loyalty"):format(GodConfig.Gods[godId].DisplayName, favor, gainedLoyalty))
	GameEvents.Fire("Worship", player, godId)
	return true
end

function GodService.StartGodChange(player, godId)
	local data = DataService.GetData(player)
	if not data or data.SelectedGod == "" then
		return false
	end
	if not GodConfig.IsPlayable(godId) or godId == data.SelectedGod then
		message(player, "You can't switch to that god.")
		return false
	end
	data.GodChange.Target = godId
	data.GodChange.Prayers = 0
	pushAttributes(player, data)
	message(player, ("Pray %d times at the Shrine of Change to follow %s."):format(GodConfig.GodChange.PrayersNeeded, GodConfig.Gods[godId].DisplayName))
	return true
end

function GodService.CancelGodChange(player)
	local data = DataService.GetData(player)
	if not data or data.GodChange.Target == "" then
		return false
	end
	data.GodChange.Target = ""
	data.GodChange.Prayers = 0
	pushAttributes(player, data)
	message(player, "God change cancelled.")
	return true
end

function GodService.Pray(player)
	local data = DataService.GetData(player)
	if not data then
		return false
	end
	local change = data.GodChange
	if data.SelectedGod == "" then
		notify(player, "OpenGodMenu", "Choose")
		return false
	end
	if change.Target == "" then
		notify(player, "OpenGodMenu", "Change") -- shows the "choose a new god" options
		return false
	end
	local now = os.time()
	if now < change.NextPrayerAt then
		message(player, ("You can pray again in %d seconds."):format(change.NextPrayerAt - now))
		return false
	end

	change.Prayers += 1
	change.NextPrayerAt = now + GodConfig.GodChange.PrayerCooldown
	local target = GodConfig.Gods[change.Target]

	if change.Prayers < GodConfig.GodChange.PrayersNeeded then
		pushAttributes(player, data)
		message(player, ("Prayer to %s: %d / %d"):format(target.DisplayName, change.Prayers, GodConfig.GodChange.PrayersNeeded))
		return true
	end

	-- Quest complete: switch god. Everything else is kept.
	data.SelectedGod = change.Target
	change.Target, change.Prayers = "", 0
	grantFirstBlessing(data, data.SelectedGod)
	refreshAll(player, data, true)
	message(player, ("You now worship %s, %s!"):format(target.DisplayName, target.Title))
	return true
end

-- Studio / owner test command: every blessing of the current god to max level.
function GodService.DebugMaxBlessings(player)
	local data = DataService.GetData(player)
	local god = data and GodConfig.Gods[data.SelectedGod]
	if not god then
		return false
	end
	data.Blessings[god.Id] = data.Blessings[god.Id] or {}
	for _, blessing in god.Blessings do
		data.Blessings[god.Id][blessing.Id] = MAX_LEVEL
	end
	refreshAll(player, data, false)
	return true
end

-- Studio / owner test command: add loyalty to the current god.
function GodService.AddLoyalty(player, amount)
	local data = DataService.GetData(player)
	amount = math.floor(tonumber(amount) or 0)
	if not data or data.SelectedGod == "" or amount <= 0 then
		return false
	end
	data.GodLoyalty[data.SelectedGod] = loyalty(data, data.SelectedGod) + amount
	pushAttributes(player, data)
	return true
end

return GodService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">InventoryService</string>
          <string name="Source"><![CDATA[-- InventoryService (ModuleScript)
-- Location: ServerScriptService > Services > InventoryService
--
-- Phase 7C: weapons, all decided on the server.
--   * Saved in data.Inventory.Items = { { Uid, Id, Level }, ... } and
--     data.Inventory.EquippedWeapon = Uid. Uids are made here (never by the
--     client) and each weapon Id can only be owned once, so items can't be
--     duplicated. A duplicate drop is salvaged into Gold instead.
--   * Everyone owns the Bronze Sword.
--   * Equip anywhere; craft and upgrade at the Divine Forge (distance checked).
--   * Boss drops are rolled when an arena or trial with that boss is won.
-- The client sees: attribute "WeaponsJson" (owned weapons) and
-- "EquippedWeaponId", "EquippedWeaponLevel", "WeaponType", "WeaponCooldown",
-- "WeaponRange" (for the attack buttons and the forge screen).

local GameEvents = require(script.Parent:WaitForChild("GameEvents"))
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local WeaponConfig = require(Shared:WaitForChild("WeaponConfig"))
local WorldBuilder = require(ServerScriptService:WaitForChild("Services"):WaitForChild("WorldBuilder"))

local InventoryService = {}

local DataService = nil
local ProgressionService = nil
local notifyRemote = nil
local weaponChanged = nil -- callback(player) so CombatService can swap the model in hand

local FORGE_POSITION = Vector3.new(42, 1, -36)

local function message(player, text)
	if notifyRemote and player.Parent then
		notifyRemote:FireClient(player, "Message", text)
	end
end

local function findItem(data, key, value)
	for _, item in data.Inventory.Items do
		if item[key] == value then
			return item
		end
	end
	return nil
end

local function newItem(weaponId)
	return { Uid = HttpService:GenerateGUID(false), Id = weaponId, Level = 0 }
end

-- Keeps saved inventories valid: known weapons only, one of each, levels in range.
local function sanitize(data)
	local inventory = data.Inventory
	if type(inventory.Items) ~= "table" then
		inventory.Items = {}
	end
	local seen = {}
	local clean = {}
	for _, item in inventory.Items do
		local weapon = type(item) == "table" and WeaponConfig.Weapons[item.Id]
		if weapon and not seen[item.Id] and type(item.Uid) == "string" then
			seen[item.Id] = true
			local maxLevel = WeaponConfig.Rarities[weapon.Rarity].MaxLevel
			item.Level = math.clamp(math.floor(tonumber(item.Level) or 0), 0, maxLevel)
			table.insert(clean, item)
		end
	end
	inventory.Items = clean
	if not seen[WeaponConfig.StarterWeapon] then
		table.insert(inventory.Items, 1, newItem(WeaponConfig.StarterWeapon))
	end
	if not findItem(data, "Uid", inventory.EquippedWeapon) then
		inventory.EquippedWeapon = findItem(data, "Id", WeaponConfig.StarterWeapon).Uid
	end
end

local function push(player, data)
	local list = {}
	for _, item in data.Inventory.Items do
		table.insert(list, { Uid = item.Uid, Id = item.Id, Level = item.Level })
	end
	player:SetAttribute("WeaponsJson", HttpService:JSONEncode(list))
	local equipped = findItem(data, "Uid", data.Inventory.EquippedWeapon)
	local weapon = WeaponConfig.Weapons[equipped.Id]
	local kind = WeaponConfig.Types[weapon.Type]
	player:SetAttribute("EquippedWeaponId", equipped.Id)
	player:SetAttribute("EquippedWeaponUid", equipped.Uid)
	player:SetAttribute("EquippedWeaponLevel", equipped.Level)
	player:SetAttribute("WeaponType", weapon.Type)
	player:SetAttribute("WeaponCooldown", kind.Cooldown * weapon.Speed)
	player:SetAttribute("WeaponRange", kind.Range)
end

local function nearForge(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return root ~= nil and (root.Position - FORGE_POSITION).Magnitude <= WeaponConfig.ForgeRange
end

--------------------------------------------------------------------------
-- Public API
--------------------------------------------------------------------------

-- Everything combat needs about the equipped weapon.
function InventoryService.GetEquipped(player)
	local data = DataService.GetData(player)
	local item = data and findItem(data, "Uid", data.Inventory.EquippedWeapon)
	local weapon = item and WeaponConfig.Weapons[item.Id] or WeaponConfig.Weapons[WeaponConfig.StarterWeapon]
	local level = item and item.Level or 0
	local kind = WeaponConfig.Types[weapon.Type]
	local special = weapon.Special or {}
	return {
		Weapon = weapon,
		Level = level,
		Power = WeaponConfig.Power(weapon.Id, level),
		Type = weapon.Type,
		Range = kind.Range,
		ArcDot = kind.ArcDot,
		Width = kind.Width,
		Ranged = kind.Ranged == true,
		Cooldown = kind.Cooldown * weapon.Speed,
		MaxTargets = kind.MaxTargets + (special.ExtraTargets or 0) + (special.Pierce or 0),
		CritChance = special.CritChance or 0,
		LifeSteal = special.LifeSteal or 0,
		Combo = kind.Combo,
	}
end

-- Adds a weapon (or salvages a duplicate into Gold). Returns "New" or "Salvaged".
function InventoryService.GiveWeapon(player, weaponId)
	local data = DataService.GetData(player)
	local weapon = WeaponConfig.Weapons[weaponId]
	if not data or not weapon then
		return nil
	end
	if findItem(data, "Id", weaponId) then
		local gold = WeaponConfig.Rarities[weapon.Rarity].Salvage
		ProgressionService.AddCurrency(player, "Gold", gold, "Salvage")
		message(player, ("You already own the %s: salvaged for %d Gold."):format(weapon.Name, gold))
		return "Salvaged"
	end
	table.insert(data.Inventory.Items, newItem(weaponId))
	push(player, data)
	message(player, ("New weapon: %s (%s)!"):format(weapon.Name, WeaponConfig.Rarities[weapon.Rarity].Name))
	return "New"
end

function InventoryService.Equip(player, uid)
	local data = DataService.GetData(player)
	local item = data and type(uid) == "string" and findItem(data, "Uid", uid)
	if not item then
		return false
	end
	data.Inventory.EquippedWeapon = uid
	push(player, data)
	if weaponChanged then
		weaponChanged(player)
	end
	message(player, "Equipped " .. WeaponConfig.Weapons[item.Id].Name .. ".")
	return true
end

function InventoryService.Craft(player, weaponId)
	local data = DataService.GetData(player)
	local weapon = WeaponConfig.Weapons[weaponId]
	if not data or not weapon or not weapon.Cost then
		return false
	end
	if not nearForge(player) then
		message(player, "Crafting happens at the Divine Forge.")
		return false
	end
	if findItem(data, "Id", weaponId) then
		message(player, "You already own the " .. weapon.Name .. ".")
		return false
	end
	local gold, ambrosia = weapon.Cost.Gold or 0, weapon.Cost.Ambrosia or 0
	if (data.Currencies.Gold or 0) < gold or (data.Currencies.Ambrosia or 0) < ambrosia then
		message(player, ("You need %d Gold%s."):format(gold, if ambrosia > 0 then (" and %d Ambrosia"):format(ambrosia) else ""))
		return false
	end
	-- Both checked above with no yield in between, then both spent.
	if gold > 0 then
		ProgressionService.SpendCurrency(player, "Gold", gold)
	end
	if ambrosia > 0 then
		ProgressionService.SpendCurrency(player, "Ambrosia", ambrosia)
	end
	local crafted = InventoryService.GiveWeapon(player, weaponId) == "New"
	if crafted then
		GameEvents.Fire("CraftWeapon", player, weaponId)
	end
	return crafted
end

function InventoryService.Upgrade(player, uid)
	local data = DataService.GetData(player)
	local item = data and type(uid) == "string" and findItem(data, "Uid", uid)
	if not item then
		return false
	end
	if not nearForge(player) then
		message(player, "Upgrades happen at the Divine Forge.")
		return false
	end
	local weapon = WeaponConfig.Weapons[item.Id]
	local training = tonumber(data.Temple.Buildings.TrainingGrounds) or 0
	local gold, ambrosia = WeaponConfig.UpgradeCost(item.Id, item.Level, training)
	if not gold then
		message(player, weapon.Name .. " is fully upgraded.")
		return false
	end
	if (data.Currencies.Gold or 0) < gold or (data.Currencies.Ambrosia or 0) < ambrosia then
		message(player, ("Upgrading needs %d Gold%s."):format(gold, if ambrosia > 0 then (" and %d Ambrosia"):format(ambrosia) else ""))
		return false
	end
	ProgressionService.SpendCurrency(player, "Gold", gold)
	if ambrosia > 0 then
		ProgressionService.SpendCurrency(player, "Ambrosia", ambrosia)
	end
	item.Level += 1
	push(player, data)
	message(player, ("%s upgraded to +%d!"):format(weapon.Name, item.Level))
	GameEvents.Fire("UpgradeWeapon", player, item.Id)
	return true
end

-- Rolls the weapon drops for bosses beaten in a won arena/trial. Returns the names won.
function InventoryService.RollBossDrops(player, bossTypes)
	local won = {}
	for bossType in bossTypes do
		for id, weapon in WeaponConfig.Weapons do
			if weapon.Drop and weapon.Drop.Boss == bossType and math.random() < weapon.Drop.Chance then
				local result = InventoryService.GiveWeapon(player, id)
				if result then
					table.insert(won, weapon.Name .. (if result == "Salvaged" then " (salvaged)" else ""))
				end
			end
		end
	end
	return won
end

--------------------------------------------------------------------------
-- The Divine Forge (placeholder build in Olympus Plaza)
--------------------------------------------------------------------------
function InventoryService.BuildForge()
	local hub = Workspace:WaitForChild("Hub")
	local marker = hub:FindFirstChild("Divine Forge")
	if marker then
		marker:Destroy() -- the old "coming in Phase 7" marker
	end
	if hub:FindFirstChild("DivineForge") then
		return
	end
	local forge = Instance.new("Model")
	forge.Name = "DivineForge"
	local MP = WorldBuilder.MakePart
	local c = FORGE_POSITION
	MP(forge, { Name = "Floor", Size = Vector3.new(16, 0.6, 14), Position = c + Vector3.new(0, 0.3, 0), Material = Enum.Material.Slate, Color = Color3.fromRGB(90, 80, 75) })
	-- Furnace
	MP(forge, { Name = "Furnace", Size = Vector3.new(6, 6, 4), Position = c + Vector3.new(0, 3.6, 4), Material = Enum.Material.Brick, Color = Color3.fromRGB(120, 60, 45) })
	local mouth = MP(forge, { Name = "FurnaceFire", Size = Vector3.new(3, 2, 0.4), Position = c + Vector3.new(0, 2.6, 1.9), Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 120, 30) })
	local fire = Instance.new("Fire")
	fire.Size = 6
	fire.Heat = 12
	fire.Parent = mouth
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 140, 60)
	light.Range = 18
	light.Brightness = 2
	light.Parent = mouth
	MP(forge, { Name = "Chimney", Size = Vector3.new(2, 8, 2), Position = c + Vector3.new(0, 10.6, 5), Material = Enum.Material.Brick, Color = Color3.fromRGB(110, 55, 42) })
	-- Anvil
	MP(forge, { Name = "AnvilBase", Size = Vector3.new(1.6, 1.6, 1.4), Position = c + Vector3.new(0, 1.4, -2) , Material = Enum.Material.Metal, Color = Color3.fromRGB(60, 60, 65) })
	local anvil = MP(forge, { Name = "Anvil", Size = Vector3.new(3.4, 0.9, 1.6), Position = c + Vector3.new(0, 2.6, -2), Material = Enum.Material.Metal, Color = Color3.fromRGB(70, 70, 78) })
	WorldBuilder.AddLabel(anvil, "Divine Forge", Color3.fromRGB(255, 160, 60), 5)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Forge"
	prompt.ObjectText = "Divine Forge"
	prompt.HoldDuration = 0.2
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = anvil
	prompt.Triggered:Connect(function(player)
		notifyRemote:FireClient(player, "OpenWeapons", "Forge")
	end)
	forge.Parent = hub
end

--------------------------------------------------------------------------
-- Setup
--------------------------------------------------------------------------
function InventoryService.Init(dataService, progressionService, notifyRemoteEvent, weaponRemote)
	DataService = dataService
	ProgressionService = progressionService
	notifyRemote = notifyRemoteEvent

	if weaponRemote then
		local last = {}
		weaponRemote.OnServerEvent:Connect(function(player, action, arg)
			local t = os.clock()
			if last[player] and t - last[player] < 0.4 then
				return
			end
			last[player] = t
			if type(arg) ~= "string" then
				return
			end
			if action == "Equip" then
				InventoryService.Equip(player, arg)
			elseif action == "Craft" then
				InventoryService.Craft(player, arg)
			elseif action == "Upgrade" then
				InventoryService.Upgrade(player, arg)
			end
		end)
	end
end

-- CombatService registers this to swap the weapon model when you equip.
function InventoryService.SetWeaponChangedHandler(handler)
	weaponChanged = handler
end

function InventoryService.SetupPlayer(player)
	local data = DataService.GetData(player)
	if not data then
		return
	end
	sanitize(data)
	push(player, data)
end

-- Test helper
function InventoryService._ForgePosition()
	return FORGE_POSITION
end

return InventoryService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">MasteryService</string>
          <string name="Source"><![CDATA[-- MasteryService (ModuleScript)
-- Location: ServerScriptService > Services > MasteryService
--
-- Phase 7E part 3 (settings in Shared/MasteryConfig):
--   * Divine Mastery: mastery XP and level per god (data.Mastery[god] =
--     { Level, XP }), earned for the god you worship from GameEvents (kills,
--     arena/challenge wins, worship, abilities). Small attack/health bonus
--     (GodService.GetBonuses reads it) and cosmetics on your character.
--   * Divine Incarnation (Elder God): Divine Energy from hitting/defeating
--     enemies; when full, "Activate" transforms you for a while: opening
--     blast, heal, buffs (through AbilityService.AddBuff) and a glowing form.
-- Client attributes: MasteryJson, IncarnationUnlocked, DivineEnergy,
-- IncarnationUntil (server time), IncarnationForm.

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MasteryConfig = require(Shared:WaitForChild("MasteryConfig"))
local CombatConfig = require(Shared:WaitForChild("CombatConfig"))
local ArenaConfig = require(Shared:WaitForChild("ArenaConfig"))
local GodConfig = require(Shared:WaitForChild("GodConfig"))

local GameEvents = require(script.Parent:WaitForChild("GameEvents"))

local MasteryService = {}

local DataService = nil
local ProgressionService = nil
local AbilityService = nil
local notifyRemote = nil
local fxRemote = nil

local INC = MasteryConfig.Incarnation
local energy = {} -- [Player] = { Energy, Until }

local function message(player, text)
	if notifyRemote and player.Parent then
		notifyRemote:FireClient(player, "Message", text)
	end
end

local function masteryOf(data, godId)
	if type(data.Mastery) ~= "table" then
		data.Mastery = {}
	end
	local entry = data.Mastery[godId]
	if type(entry) ~= "table" then
		entry = { Level = 1, XP = 0 }
		data.Mastery[godId] = entry
	end
	entry.Level = math.clamp(math.floor(tonumber(entry.Level) or 1), 1, MasteryConfig.MaxLevel)
	entry.XP = math.max(0, tonumber(entry.XP) or 0)
	return entry
end

-- Mastery level of the god this player worships (0 = no god yet).
function MasteryService.GetLevel(player)
	local data = DataService.GetData(player)
	if not data or data.SelectedGod == "" then
		return 0
	end
	return masteryOf(data, data.SelectedGod).Level
end

local function push(player, data)
	local levels = {}
	for godId in GodConfig.Gods do
		local entry = type(data.Mastery) == "table" and data.Mastery[godId]
		levels[godId] = if type(entry) == "table" then entry.Level or 1 else 1
	end
	local current = if data.SelectedGod ~= "" then masteryOf(data, data.SelectedGod) else { Level = 0, XP = 0 }
	player:SetAttribute("MasteryGod", data.SelectedGod)
	player:SetAttribute("MasteryJson", HttpService:JSONEncode({
		God = data.SelectedGod,
		Level = current.Level,
		XP = math.floor(current.XP),
		Need = if current.Level >= 1 and current.Level < MasteryConfig.MaxLevel then MasteryConfig.XPForLevel(current.Level) else 0,
		Levels = levels,
	}))
end

--------------------------------------------------------------------------
-- Cosmetics (all parented to the HumanoidRootPart, which avatar changes
-- never replace; rebuilt whenever god or level changes)
--------------------------------------------------------------------------
local function clearCosmetics(character, prefix)
	for _, item in character:GetDescendants() do
		if item.Name:sub(1, #prefix) == prefix then
			item:Destroy()
		end
	end
end

local function weldedRing(character, root, prefix, offsetY, radius, count, color, thickness)
	for i = 1, count do
		local angle = (i / count) * math.pi * 2
		local part = Instance.new("Part")
		part.Name = prefix .. i
		part.Size = Vector3.new(2 * math.pi * radius / count * 1.05, thickness, thickness)
		part.Material = Enum.Material.Neon
		part.Color = color
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Massless = true
		part.CastShadow = false
		part.CFrame = root.CFrame * CFrame.new(0, offsetY, 0) * CFrame.Angles(0, -angle, 0) * CFrame.new(0, 0, radius)
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = part
		weld.Parent = part
		part.Parent = character
	end
end

local function applyCosmetics(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local data = DataService.GetData(player)
	if not root or not data then
		return
	end
	local godId = data.SelectedGod
	local level = if godId ~= "" then masteryOf(data, godId).Level else 0
	local signature = godId .. "|" .. level
	if root:GetAttribute("MasteryLook") == signature and root:FindFirstChild("Mastery_Marker") then
		return
	end
	clearCosmetics(character, "Mastery_")
	root:SetAttribute("MasteryLook", signature)
	local marker = Instance.new("Folder")
	marker.Name = "Mastery_Marker"
	marker.Parent = root
	if level <= 0 then
		return
	end
	local god = GodConfig.Gods[godId]
	local colors = GodConfig.GetColors(godId)
	local glow = colors.Glow or colors.Accent

	if level >= 5 then
		local sparks = Instance.new("ParticleEmitter")
		sparks.Name = "Mastery_Sparks"
		sparks.Color = ColorSequence.new(glow)
		sparks.LightEmission = 1
		sparks.Rate = if level >= 25 then 10 else 5
		sparks.Lifetime = NumberRange.new(1, 1.8)
		sparks.Speed = NumberRange.new(0.5, 1.5)
		sparks.SpreadAngle = Vector2.new(180, 180)
		sparks.Size = NumberSequence.new(0.22, 0)
		sparks.Parent = root
	end
	local title = MasteryConfig.Title(god and god.DisplayName or godId, level)
	if title then
		local gui = Instance.new("BillboardGui")
		gui.Name = "Mastery_Title"
		gui.Size = UDim2.fromOffset(220, 26)
		gui.StudsOffset = Vector3.new(0, 4.2, 0)
		gui.MaxDistance = 90
		gui.LightInfluence = 0
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = Enum.Font.GothamBold
		label.TextScaled = true
		label.TextColor3 = colors.Accent
		label.TextStrokeTransparency = 0.3
		label.Text = title
		label.Parent = gui
		gui.Parent = root
	end
	if level >= 15 then
		local a0 = Instance.new("Attachment")
		a0.Name = "Mastery_TrailA"
		a0.Position = Vector3.new(0, -2.6, 0)
		a0.Parent = root
		local a1 = Instance.new("Attachment")
		a1.Name = "Mastery_TrailB"
		a1.Position = Vector3.new(0, -1.9, 0)
		a1.Parent = root
		local trail = Instance.new("Trail")
		trail.Name = "Mastery_Trail"
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Color = ColorSequence.new(glow)
		trail.LightEmission = 1
		trail.Lifetime = 0.6
		trail.Transparency = NumberSequence.new(0.3, 1)
		trail.Parent = root
	end
	if level >= 30 then
		local light = Instance.new("PointLight")
		light.Name = "Mastery_Glow"
		light.Color = glow
		light.Range = 10
		light.Brightness = 1.2
		light.Parent = root
	end
	if level >= 50 then
		weldedRing(character, root, "Mastery_Crown", 3.3, 0.9, 10, colors.Accent, 0.25)
	end
end

--------------------------------------------------------------------------
-- Mastery XP
--------------------------------------------------------------------------
function MasteryService.AddXP(player, amount)
	local data = DataService.GetData(player)
	amount = tonumber(amount)
	if not data or data.SelectedGod == "" or not amount or amount <= 0 or amount ~= amount then
		return
	end
	local godId = data.SelectedGod
	local entry = masteryOf(data, godId)
	if entry.Level >= MasteryConfig.MaxLevel then
		return
	end
	entry.XP += amount
	local startLevel = entry.Level
	while entry.Level < MasteryConfig.MaxLevel and entry.XP >= MasteryConfig.XPForLevel(entry.Level) do
		entry.XP -= MasteryConfig.XPForLevel(entry.Level)
		entry.Level += 1
	end
	local gained = entry.Level > startLevel
	if gained then
		-- One message however many levels were gained at once.
		local god = GodConfig.Gods[godId]
		message(player, ("%s Mastery level %d! (+%.1f%% attack and health)"):format(god and god.DisplayName or godId, entry.Level, entry.Level * MasteryConfig.AttackPercentPerLevel))
		for _, unlock in MasteryConfig.Unlocks do
			if unlock.Level > startLevel and unlock.Level <= entry.Level then
				message(player, "Unlocked: " .. unlock.Name .. "!")
			end
		end
	end
	if entry.Level >= MasteryConfig.MaxLevel then
		entry.XP = 0
	end
	push(player, data)
	if gained then
		ProgressionService.RefreshStats(player) -- the attack/health bonus
		applyCosmetics(player)
	end
end

local function onEvent(eventType, player, target, amount)
	if not player or not player.Parent then
		return
	end
	local src = MasteryConfig.Sources
	if eventType == "KillEnemy" then
		local cfg = CombatConfig.Enemies[target]
		if cfg and (cfg.XP or 0) > 0 then
			MasteryService.AddXP(player, cfg.XP * src.KillXPShare)
		end
		MasteryService.AddEnergy(player, if cfg and cfg.Boss then INC.EnergyPerBossKill else INC.EnergyPerKill)
	elseif eventType == "HitEnemy" then
		MasteryService.AddEnergy(player, INC.EnergyPerHit)
	elseif eventType == "WinArena" then
		local arena = ArenaConfig.ById[target]
		if arena and arena.Rewards and arena.Rewards.XP then
			MasteryService.AddXP(player, arena.Rewards.XP * src.ArenaXPShare)
		end
	elseif eventType == "WinChallenge" then
		MasteryService.AddXP(player, src.ChallengeWin)
	elseif eventType == "Worship" then
		MasteryService.AddXP(player, src.Worship)
	elseif eventType == "UseAbility" then
		MasteryService.AddXP(player, src.UseAbility * (amount or 1))
	end
end

--------------------------------------------------------------------------
-- Divine Incarnation
--------------------------------------------------------------------------
local function unlocked(player)
	local data = DataService.GetData(player)
	return data ~= nil and (data.RankIndex or 1) >= INC.RequiredRank
end

local function pushEnergy(player)
	local st = energy[player]
	if st then
		player:SetAttribute("IncarnationUnlocked", unlocked(player))
		player:SetAttribute("DivineEnergy", math.floor(st.Energy))
	end
end

function MasteryService.AddEnergy(player, amount)
	local st = energy[player]
	if not st or not unlocked(player) or os.clock() < st.Until then
		return -- no charging while transformed
	end
	local before = st.Energy
	st.Energy = math.min(INC.EnergyMax, st.Energy + amount)
	if math.floor(st.Energy) ~= math.floor(before) then
		pushEnergy(player)
		if st.Energy >= INC.EnergyMax and before < INC.EnergyMax then
			message(player, "Divine Energy full! Incarnate to take your god's form.")
		end
	end
end

local function addFormLook(player, form, colors, duration)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	clearCosmetics(character, "Incarnation_")
	local glow = colors.Glow or colors.Accent
	local aura = Instance.new("ParticleEmitter")
	aura.Name = "Incarnation_Aura"
	aura.Color = ColorSequence.new(glow, colors.Accent)
	aura.LightEmission = 1
	aura.Rate = 40
	aura.Lifetime = NumberRange.new(0.6, 1.1)
	aura.Speed = NumberRange.new(2, 5)
	aura.SpreadAngle = Vector2.new(180, 180)
	aura.Size = NumberSequence.new(0.9, 0)
	aura.Transparency = NumberSequence.new(0.2, 1)
	aura.Parent = root
	local light = Instance.new("PointLight")
	light.Name = "Incarnation_Light"
	light.Color = glow
	light.Range = 22
	light.Brightness = 3
	light.Parent = root
	local fire = Instance.new("Fire")
	fire.Name = "Incarnation_Fire"
	fire.Color = colors.Fire or glow
	fire.SecondaryColor = colors.Accent
	fire.Size = 7
	fire.Heat = 12
	fire.Parent = root
	weldedRing(character, root, "Incarnation_Halo", 3.9, 1.6, 16, colors.Accent, 0.3)
	weldedRing(character, root, "Incarnation_Wing", 0.6, 2.4, 6, glow, 0.2)
	player:SetAttribute("IncarnationForm", form.Name)
	task.delay(duration, function()
		if character.Parent then
			clearCosmetics(character, "Incarnation_")
		end
	end)
end

-- Transforms the player if their Divine Energy is full. Returns true if it did.
function MasteryService.Activate(player)
	local st = energy[player]
	local data = DataService.GetData(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not st or not data or not root or not humanoid or humanoid.Health <= 0 then
		return false
	end
	if not unlocked(player) then
		message(player, "Divine Incarnation unlocks at Elder God.")
		return false
	end
	if os.clock() < st.Until then
		return false
	end
	if st.Energy < INC.EnergyMax then
		message(player, ("Divine Energy %d/%d: keep fighting!"):format(math.floor(st.Energy), INC.EnergyMax))
		return false
	end
	local level = MasteryService.GetLevel(player)
	local duration = INC.BaseDuration + INC.DurationPerMastery * level
	local form = MasteryConfig.Forms[data.SelectedGod] or MasteryConfig.DefaultForm
	local colors = GodConfig.GetColors(data.SelectedGod)
	st.Energy = 0
	st.Until = os.clock() + duration
	player:SetAttribute("IncarnationUntil", Workspace:GetServerTimeNow() + duration)
	pushEnergy(player)

	AbilityService.AddBuff(player, "Incarnation", form, duration)
	AbilityService.Heal(player, humanoid.MaxHealth * INC.HealPercent / 100)
	local blast = AbilityService.BaseDamage(player) * INC.BlastDamage
	AbilityService.DamageArea(player, root.Position, INC.BlastRadius, blast, 25)
	if fxRemote then
		fxRemote:FireAllClients("Shockwave", root.Position, colors.Accent, INC.BlastRadius)
		fxRemote:FireAllClients("Lightning", root.Position, colors.Glow or colors.Accent, 6, true) -- beam from the sky
	end
	addFormLook(player, form, colors, duration)
	message(player, ("You become the %s!"):format(form.Name))
	GameEvents.Fire("Incarnate", player, data.SelectedGod)
	return true
end

--------------------------------------------------------------------------
-- Setup
--------------------------------------------------------------------------
function MasteryService.Init(dataService, progressionService, abilityService, gameEvents, notifyRemoteEvent, fxRemoteEvent, incarnationRemote)
	DataService = dataService
	ProgressionService = progressionService
	AbilityService = abilityService
	notifyRemote = notifyRemoteEvent
	fxRemote = fxRemoteEvent
	gameEvents.Connect(onEvent)
	if incarnationRemote then
		local last = {}
		incarnationRemote.OnServerEvent:Connect(function(player, action)
			local t = os.clock()
			if last[player] and t - last[player] < 0.5 then
				return
			end
			last[player] = t
			if action == "Activate" then
				MasteryService.Activate(player)
			end
		end)
	end
	-- Keep cosmetics right (god change, rank looks rebuilding the avatar...).
	task.spawn(function()
		while true do
			task.wait(3)
			for _, player in Players:GetPlayers() do
				if energy[player] then
					local data = DataService.GetData(player)
					if data and player:GetAttribute("MasteryGod") ~= data.SelectedGod then
						push(player, data) -- the player changed god
					end
					applyCosmetics(player)
					pushEnergy(player)
				end
			end
		end
	end)
end

function MasteryService.SetupPlayer(player)
	energy[player] = { Energy = 0, Until = 0 }
	player:SetAttribute("IncarnationUntil", 0)
	local data = DataService.GetData(player)
	if data then
		push(player, data)
	end
	pushEnergy(player)
	player.CharacterAdded:Connect(function()
		task.wait(1)
		applyCosmetics(player)
	end)
	task.defer(applyCosmetics, player)
end

function MasteryService.ReleasePlayer(player)
	energy[player] = nil
end

-- Re-sends mastery (e.g. after a god change).
function MasteryService.Refresh(player)
	local data = DataService.GetData(player)
	if data then
		push(player, data)
		applyCosmetics(player)
	end
end

return MasteryService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">PlotService</string>
          <string name="Source"><![CDATA[-- PlotService (ModuleScript)
-- Location: ServerScriptService > Services > PlotService
--
-- Gives each player one free temple plot, frees it when they leave, and
-- handles Temple/Plaza teleports. Ownership is stored on the plot as the
-- attribute "OwnerUserId" (0 = free). TempleService builds the temple on it
-- and uses OwnerUserId to stop anyone changing another player's temple.

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))

local PlotService = {}

local plotsFolder = nil
local plotByPlayer = {} -- [Player] = plot Model

local function setSign(plot, text)
	local sign = plot:FindFirstChild("Sign")
	local label = sign and sign:FindFirstChild("Label")
	local textLabel = label and label:FindFirstChild("Text")
	if textLabel then
		textLabel.Text = text
	end
end

function PlotService.Init()
	plotsFolder = Workspace:WaitForChild("TemplePlots")
	for _, plot in plotsFolder:GetChildren() do
		plot:SetAttribute("OwnerUserId", 0)
	end
end

function PlotService.GetPlot(player)
	return plotByPlayer[player]
end

-- Returns the plot, or nil if every plot is taken.
function PlotService.AssignPlot(player)
	if plotByPlayer[player] then
		return plotByPlayer[player]
	end
	for i = 1, GameConfig.Plots.Count do
		local plot = plotsFolder:FindFirstChild("Plot" .. i)
		if plot and (plot:GetAttribute("OwnerUserId") or 0) == 0 then
			plot:SetAttribute("OwnerUserId", player.UserId)
			plot:SetAttribute("OwnerName", player.DisplayName)
			plotByPlayer[player] = plot
			player:SetAttribute("PlotName", plot.Name)
			setSign(plot, player.DisplayName .. "'s Temple")
			-- The temple itself is built from saved data by TempleService.SetupPlayer.
			return plot
		end
	end
	warn("[PlotService] No free plot for " .. player.Name .. ". Is Max Players higher than GameConfig.Plots.Count?")
	return nil
end

-- Visual reset only. The player's saved upgrades are untouched.
function PlotService.ReleasePlot(player)
	local plot = plotByPlayer[player]
	if not plot then
		return
	end
	plotByPlayer[player] = nil
	local buildings = plot:FindFirstChild("Buildings")
	if buildings then
		buildings:ClearAllChildren()
	end
	local pads = plot:FindFirstChild("Pads")
	if pads then
		pads:ClearAllChildren()
	end
	plot:SetAttribute("OwnerUserId", 0)
	plot:SetAttribute("OwnerName", nil)
	setSign(plot, "Unclaimed Temple")
end

-- destination: "Temple", "Plaza" or "Practice". Validated by the caller.
function PlotService.TeleportPlayer(player, destination)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 or not character.PrimaryPart then
		return false
	end

	local target
	if destination == "Temple" then
		local plot = plotByPlayer[player]
		local base = plot and plot:FindFirstChild("Base")
		if not base then
			return false
		end
		local pos = Vector3.new(base.Position.X, base.Position.Y + base.Size.Y / 2 + 3, base.Position.Z - base.Size.Z / 2 + 8)
		target = CFrame.lookAt(pos, pos + Vector3.new(0, 0, 1))
	elseif destination == "Plaza" then
		local hub = Workspace:FindFirstChild("Hub")
		local spawn = hub and hub:FindFirstChild("PlazaSpawn")
		if not spawn then
			return false
		end
		local pos = spawn.Position + Vector3.new(0, 4, 0)
		target = CFrame.lookAt(pos, pos + Vector3.new(0, 0, 1))
	elseif destination == "Practice" then
		local hub = Workspace:FindFirstChild("Hub")
		local spawn = hub and hub:FindFirstChild("PracticeSpawn")
		if not spawn then
			return false
		end
		local pos = spawn.Position + Vector3.new(0, 4, 0)
		target = CFrame.lookAt(pos, pos + Vector3.new(0, 0, -1)) -- face the enemies
	else
		return false
	end

	humanoid.Sit = false
	character:PivotTo(target)
	return true
end

return PlotService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">ProgressionService</string>
          <string name="Source"><![CDATA[-- ProgressionService (ModuleScript)
-- Location: ServerScriptService > Services > ProgressionService
--
-- The ONLY place that changes XP, levels, ranks and currencies.
-- Server-only: clients can never call these functions directly.
-- Later systems (combat, arenas, temple, quests) will call:
--   ProgressionService.AddXP(player, amount, source)
--   ProgressionService.AddCurrency(player, "Gold", amount, source)
--   ProgressionService.SpendCurrency(player, "Gold", amount) -> true/false
--   ProgressionService.AdvanceRank(player, trialId) -> true/false, message
--
-- Values are shown to the client through Player Attributes (Level, XP,
-- Gold, ...). Attributes set by the server replicate to the client, and a
-- client changing its own copy does NOT affect the server.

local GameEvents = require(script.Parent:WaitForChild("GameEvents"))
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local Progression = require(Shared:WaitForChild("Progression"))

local ProgressionService = {}

local DataService = nil
local notifyRemote = nil
local bonusProvider = nil -- function(player) -> { AttackPercent, HealthPercent, SpeedPercent }

local BASE_WALK_SPEED = 16

local VALID_CURRENCY = {}
for _, name in GameConfig.Currencies do
	VALID_CURRENCY[name] = true
end

--------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------

-- Accepts only positive whole finite numbers.
local function sanitizeAmount(amount)
	if type(amount) ~= "number" or amount ~= amount or amount == math.huge or amount == -math.huge then
		return nil
	end
	amount = math.floor(amount)
	if amount <= 0 then
		return nil
	end
	return amount
end

local function notify(player, kind, value)
	if notifyRemote and player.Parent then
		notifyRemote:FireClient(player, kind, value)
	end
end

-- Converts stored XP into level-ups, respecting the rank cap.
local function processLevels(data)
	local cap = Progression.GetLevelCap(data.RankIndex)
	while data.Level < cap do
		local need = Progression.XPToNextLevel(data.Level)
		if need <= 0 or data.XP < need then
			break
		end
		data.XP -= need
		data.Level += 1
	end
	if data.Level >= cap then
		local need = Progression.XPToNextLevel(data.Level)
		-- At the cap the bar stays full; extra XP is not banked.
		data.XP = if need > 0 then math.min(data.XP, need) else 0
	end
end

local function getBonuses(player)
	local bonuses = if bonusProvider then bonusProvider(player) else nil
	return bonuses or {}
end

local function applyCharacterStats(player, character, healFully)
	if not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 10)
	local data = DataService.GetData(player)
	if not humanoid or not data then
		return
	end
	local bonuses = getBonuses(player)
	local maxHealth = math.floor(Progression.GetMaxHealth(data.Level) * (1 + (bonuses.HealthPercent or 0) / 100))
	humanoid.MaxHealth = maxHealth
	humanoid.WalkSpeed = BASE_WALK_SPEED * (1 + (bonuses.SpeedPercent or 0) / 100)
	if healFully then
		humanoid.Health = maxHealth
	end
end

--------------------------------------------------------------------------
-- Public API
--------------------------------------------------------------------------
function ProgressionService.Init(dataService, notifyRemoteEvent)
	DataService = dataService
	notifyRemote = notifyRemoteEvent
end

-- Phase 3: GodService supplies blessing bonuses (attack / health / speed %).
function ProgressionService.SetBonusProvider(provider)
	bonusProvider = provider
end

-- Pushes saved values to attributes + leaderboard so the client can display them.
function ProgressionService.Refresh(player)
	local data = DataService.GetData(player)
	if not data then
		return
	end
	local rank = Progression.GetRank(data.RankIndex)
	local cap = Progression.GetLevelCap(data.RankIndex)

	player:SetAttribute("Level", data.Level)
	player:SetAttribute("XP", data.XP)
	player:SetAttribute("XPToNext", Progression.XPToNextLevel(data.Level))
	player:SetAttribute("RankIndex", data.RankIndex)
	player:SetAttribute("RankName", rank.Name)
	player:SetAttribute("LevelCap", cap)
	player:SetAttribute("TrialReady", data.Level >= cap and data.RankIndex < #GameConfig.Ranks)
	local attackBonus = getBonuses(player).AttackPercent or 0
	player:SetAttribute("BaseAttack", math.floor(Progression.GetBaseAttack(data.Level) * (1 + attackBonus / 100)))
	for _, name in GameConfig.Currencies do
		player:SetAttribute(name, data.Currencies[name] or 0)
	end

	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		leaderstats.Level.Value = data.Level
		leaderstats.Rank.Value = rank.Name
		leaderstats.Gold.Value = data.Currencies.Gold or 0
	end
end

-- Call once after data has loaded.
function ProgressionService.SetupPlayer(player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"

	local level = Instance.new("IntValue")
	level.Name = "Level"
	level.Parent = leaderstats

	local rank = Instance.new("StringValue")
	rank.Name = "Rank"
	rank.Parent = leaderstats

	local gold = Instance.new("IntValue")
	gold.Name = "Gold"
	gold.Parent = leaderstats

	leaderstats.Parent = player

	ProgressionService.Refresh(player)

	player.CharacterAdded:Connect(function(character)
		applyCharacterStats(player, character, true)
	end)
	if player.Character then
		task.spawn(applyCharacterStats, player, player.Character, true)
	end
end

-- Re-applies max health and speed WITHOUT healing (e.g. when a speed buff starts or ends).
function ProgressionService.RefreshStats(player)
	ProgressionService.Refresh(player)
	task.spawn(applyCharacterStats, player, player.Character, false)
end

-- Refresh everything, including the character's health (used after a data reset).
function ProgressionService.RefreshAll(player)
	ProgressionService.Refresh(player)
	task.spawn(applyCharacterStats, player, player.Character, true)
end

function ProgressionService.AddXP(player, amount, source)
	local data = DataService.GetData(player)
	amount = sanitizeAmount(amount)
	if not data or not amount then
		return false
	end

	local oldLevel = data.Level
	data.XP += amount
	processLevels(data)
	ProgressionService.Refresh(player)

	if data.Level > oldLevel then
		task.spawn(applyCharacterStats, player, player.Character, true)
		notify(player, "LevelUp", data.Level)

		local cap = Progression.GetLevelCap(data.RankIndex)
		if data.Level >= cap and data.RankIndex < #GameConfig.Ranks then
			local nextRank = Progression.GetRank(data.RankIndex + 1)
			notify(player, "Message", ("Level cap reached! Complete your trial to become a %s."):format(nextRank.Name))
		end
	end
	return true
end

function ProgressionService.AddCurrency(player, currency, amount, source)
	local data = DataService.GetData(player)
	amount = sanitizeAmount(amount)
	if not data or not amount or not VALID_CURRENCY[currency] then
		return false
	end
	data.Currencies[currency] = (data.Currencies[currency] or 0) + amount
	ProgressionService.Refresh(player)
	if currency == "Gold" and source ~= "Debug" and source ~= "Quest" then
		GameEvents.Fire("EarnGold", player, nil, amount)
	end
	return true
end

function ProgressionService.CanAfford(player, currency, amount)
	local data = DataService.GetData(player)
	amount = sanitizeAmount(amount)
	if not data or not amount or not VALID_CURRENCY[currency] then
		return false
	end
	return (data.Currencies[currency] or 0) >= amount
end

-- Check and subtract happen with no yield in between, so two purchases
-- arriving at once cannot both spend the same Gold.
function ProgressionService.SpendCurrency(player, currency, amount)
	if not ProgressionService.CanAfford(player, currency, amount) then
		return false
	end
	local data = DataService.GetData(player)
	data.Currencies[currency] -= math.floor(amount)
	ProgressionService.Refresh(player)
	return true
end

-- Phase 6 will call this when a trial is won. Requires the level cap to be reached.
function ProgressionService.AdvanceRank(player, trialId)
	local data = DataService.GetData(player)
	if not data then
		return false, "Data not loaded."
	end
	if data.RankIndex >= #GameConfig.Ranks then
		return false, "You are already an Elder God."
	end
	local cap = Progression.GetLevelCap(data.RankIndex)
	if data.Level < cap then
		return false, ("Reach level %d before attempting this trial."):format(cap)
	end

	data.RankIndex += 1
	local newRank = Progression.GetRank(data.RankIndex)
	if newRank.Trial ~= "" then
		data.CompletedTrials[newRank.Trial] = true
	end

	local oldLevel = data.Level
	processLevels(data) -- a full XP bar turns into the next level now the cap is lifted
	ProgressionService.Refresh(player)
	notify(player, "RankUp", newRank.Name)
	if data.Level > oldLevel then
		task.spawn(applyCharacterStats, player, player.Character, true)
	end
	return true, "You are now a " .. newRank.Name .. "!"
end

return ProgressionService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">QuestService</string>
          <string name="Source"><![CDATA[-- QuestService (ModuleScript)
-- Location: ServerScriptService > Services > QuestService
--
-- Phase 7D: quests, all tracked on the server.
--   * Chains (QuestConfig.Chains): the first unfinished quest of each chain
--     whose requirements are met is active; claiming it unlocks the next.
--   * Daily quests: 3 per day from QuestConfig.Daily, reset at midnight UTC.
--   * Progress comes from GameEvents (kills, wins, upgrades...) or, for
--     state objectives (god chosen, rank, temple tier, buildings, blessings,
--     weapons owned), from the save, so things done before still count.
--   * Rewards are paid once, when the player presses Claim.
-- Saved in data.Quests: Active = { [questId] = progress }, Completed =
-- { [questId] = true }, Daily = { Day, Ids, Progress, Claimed }.
-- The client gets attribute "QuestsJson" (the active quests).

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local QuestConfig = require(Shared:WaitForChild("QuestConfig"))

local QuestService = {}

local DataService = nil
local ProgressionService = nil
local notifyRemote = nil
local announced = {} -- [Player] = { [questId] = true } "ready to claim" messages already sent

local function message(player, text)
	if notifyRemote and player.Parent then
		notifyRemote:FireClient(player, "Message", text)
	end
end

local function today()
	return math.floor(os.time() / 86400)
end

-- Picks today's daily quests (the same for a player all day).
local function refreshDaily(player, data)
	local quests = data.Quests
	if type(quests.Daily) ~= "table" then
		quests.Daily = {}
	end
	local daily = quests.Daily
	local day = today()
	if daily.Day == day and type(daily.Ids) == "table" then
		return false
	end
	local pool = {}
	for _, quest in QuestConfig.Daily do
		table.insert(pool, quest.Id)
	end
	local rng = Random.new(day * 7919 + math.abs(player.UserId) % 100000)
	local ids = {}
	for _ = 1, math.min(QuestConfig.DailyCount, #pool) do
		table.insert(ids, table.remove(pool, rng:NextInteger(1, #pool)))
	end
	quests.Daily = { Day = day, Ids = ids, Progress = {}, Claimed = {} }
	if announced[player] then
		for _, quest in QuestConfig.Daily do
			announced[player][quest.Id] = nil -- a new day: dailies can be announced again
		end
	end
	return true
end

local function requirementsMet(data, chain)
	return chain.God == nil or chain.God == data.SelectedGod
end

-- The quests currently active for this player (chain heads + today's dailies).
local function activeQuests(data)
	local list = {}
	for _, chain in QuestConfig.Chains do
		if requirementsMet(data, chain) then
			for _, quest in chain.Quests do
				if not data.Quests.Completed[quest.Id] then
					table.insert(list, quest)
					break
				end
			end
		end
	end
	local daily = data.Quests.Daily
	if type(daily) == "table" and type(daily.Ids) == "table" then
		for _, id in daily.Ids do
			local quest = QuestConfig.ById[id]
			if quest and not daily.Claimed[id] then
				table.insert(list, quest)
			end
		end
	end
	return list
end

local function isActive(data, questId)
	for _, quest in activeQuests(data) do
		if quest.Id == questId then
			return quest
		end
	end
	return nil
end

-- Current progress (capped at the objective count).
local function progressOf(data, quest)
	local objective = quest.Objective
	local value
	if objective.Type == "ChooseGod" then
		value = if data.SelectedGod ~= "" then 1 else 0
	elseif objective.Type == "ReachLevel" then
		value = data.Level
	elseif objective.Type == "ReachRank" then
		value = data.RankIndex
	elseif objective.Type == "TempleTier" then
		value = data.Temple.Tier
	elseif objective.Type == "MasteryLevel" then
		local entry = type(data.Mastery) == "table" and data.Mastery[data.SelectedGod]
		value = if type(entry) == "table" then tonumber(entry.Level) or 1 else 1
	elseif objective.Type == "TemplePrestige" then
		value = tonumber(data.Temple.Prestige) or 0
	elseif objective.Type == "BuildingLevel" then
		value = tonumber(data.Temple.Buildings[objective.Target]) or 0
	elseif objective.Type == "TotalBuildingLevels" then
		value = 0
		for _, level in data.Temple.Buildings do
			value += tonumber(level) or 0
		end
	elseif objective.Type == "BlessingLevels" then
		value = 0
		for _, blessings in data.Blessings do
			for _, level in blessings do
				value += tonumber(level) or 0
			end
		end
	elseif objective.Type == "OwnWeapons" then
		value = #data.Inventory.Items
	elseif quest.IsDaily then
		value = data.Quests.Daily.Progress[quest.Id] or 0
	else
		value = data.Quests.Active[quest.Id] or 0
	end
	return math.min(value, objective.Count)
end

local function rewardsFor(data, quest)
	if not quest.IsDaily then
		return quest.Rewards
	end
	local scale = 1 + data.Level / 20
	local scaled = {}
	for currency, amount in quest.Rewards do
		scaled[currency] = if currency == "Ambrosia" then amount else math.floor(amount * scale)
	end
	return scaled
end

local function push(player, data)
	local list = {}
	for _, quest in activeQuests(data) do
		local progress = progressOf(data, quest)
		local ready = progress >= quest.Objective.Count
		table.insert(list, {
			Id = quest.Id,
			Name = quest.Name,
			Description = quest.Description,
			Category = quest.Category,
			Progress = progress,
			Count = quest.Objective.Count,
			Rewards = rewardsFor(data, quest),
			Ready = ready,
			Daily = quest.IsDaily == true,
		})
		announced[player] = announced[player] or {}
		if ready and not announced[player][quest.Id] then
			announced[player][quest.Id] = true
			message(player, ("Quest complete: %s! Claim it in your Quests."):format(quest.Name))
		end
	end
	player:SetAttribute("QuestsJson", HttpService:JSONEncode(list))
end

--------------------------------------------------------------------------
-- Public API
--------------------------------------------------------------------------

-- Counts an event towards every matching active quest.
function QuestService.Record(player, eventType, target, amount)
	local data = DataService.GetData(player)
	if not data then
		return
	end
	refreshDaily(player, data)
	local changed = false
	for _, quest in activeQuests(data) do
		local objective = quest.Objective
		if objective.Type == eventType and (objective.Target == nil or objective.Target == "Any" or objective.Target == target) then
			local store = if quest.IsDaily then data.Quests.Daily.Progress else data.Quests.Active
			local before = store[quest.Id] or 0
			if before < objective.Count then
				store[quest.Id] = math.min(objective.Count, before + (amount or 1))
				changed = true
			end
		end
	end
	if changed or eventType == "UpgradeBuilding" or eventType == "TemplePrestige" or eventType == "UpgradeBlessing" or eventType == "CraftWeapon" then
		push(player, data) -- state quests (building levels, weapons owned...) may have moved too
	end
end

-- Pays a finished quest once. Returns true if paid.
function QuestService.Claim(player, questId)
	local data = DataService.GetData(player)
	if not data or type(questId) ~= "string" then
		return false
	end
	refreshDaily(player, data)
	local quest = isActive(data, questId)
	if not quest or progressOf(data, quest) < quest.Objective.Count then
		return false
	end
	-- Mark first (no yield before this), so a double click can't pay twice.
	if quest.IsDaily then
		data.Quests.Daily.Claimed[questId] = true
	else
		data.Quests.Completed[questId] = true
		data.Quests.Active[questId] = nil
	end
	local paid = {}
	for currency, amount in rewardsFor(data, quest) do
		if currency == "XP" then
			ProgressionService.AddXP(player, amount, "Quest")
		else
			ProgressionService.AddCurrency(player, currency, amount, "Quest")
		end
		table.insert(paid, ("+%d %s"):format(amount, if currency == "DivineFavor" then "Favor" else currency))
	end
	push(player, data)
	message(player, ("%s: %s"):format(quest.Name, table.concat(paid, "  ")))
	return true
end

-- Re-publishes quests (e.g. after state changes like a rank-up).
function QuestService.Refresh(player)
	local data = DataService.GetData(player)
	if data then
		refreshDaily(player, data)
		push(player, data)
	end
end

function QuestService.Init(dataService, progressionService, gameEvents, notifyRemoteEvent, questRemote)
	DataService = dataService
	ProgressionService = progressionService
	notifyRemote = notifyRemoteEvent

	gameEvents.Connect(function(eventType, player, target, amount)
		QuestService.Record(player, eventType, target, amount)
	end)

	if questRemote then
		local last = {}
		questRemote.OnServerEvent:Connect(function(player, action, questId)
			local t = os.clock()
			if last[player] and t - last[player] < 0.3 then
				return
			end
			last[player] = t
			if action == "Claim" then
				QuestService.Claim(player, questId)
			end
		end)
	end

	-- Every 10 s: new day's dailies, and state quests (rank, tier, god) update.
	task.spawn(function()
		while true do
			task.wait(10)
			for _, player in Players:GetPlayers() do
				QuestService.Refresh(player)
			end
		end
	end)
end

function QuestService.SetupPlayer(player)
	announced[player] = {}
	QuestService.Refresh(player)
end

function QuestService.ReleasePlayer(player)
	announced[player] = nil
end

return QuestService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="48">
        <Properties>
          <string name="Name">TempleModels</string>
          <string name="Source"><![CDATA[-- TempleModels (ModuleScript)
-- Location: ServerScriptService > Services > TempleModels
--
-- Builds the PLACEHOLDER 3D models for the Temple Tycoon out of simple parts:
--   TempleModels.Temple(tier, origin, colors, prestige)     -> the main temple (tiers 1-7; prestige 0-10 decorations)
--   TempleModels.Building(buildingId, level, origin, colors) -> one of the 5 buildings (levels 1-6)
-- `colors` = the god's { Accent, Glow, Fire } from GodConfig (optional).
--   TempleModels.AnimateIn(model)                    -> "rise from the ground" construction effect
-- `origin` is a CFrame at ground level in the centre of the building's slot.
-- Models are returned un-parented; the caller parents them.
-- Replace these with proper models during Phase 8 polish.

local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local ServerScriptService = game:GetService("ServerScriptService")

local WorldBuilder = require(ServerScriptService:WaitForChild("Services"):WaitForChild("WorldBuilder"))

local TempleModels = {}

local MARBLE = Color3.fromRGB(236, 232, 224)
local WORN_MARBLE = Color3.fromRGB(210, 205, 196)
local STONE = Color3.fromRGB(128, 122, 114)
local GOLD = Color3.fromRGB(212, 175, 55)
local WATER = Color3.fromRGB(80, 190, 230)
local SAND = Color3.fromRGB(214, 190, 140)
local WOOD = Color3.fromRGB(120, 85, 55)
local IRON = Color3.fromRGB(120, 120, 125)
local DIVINE_BLUE = Color3.fromRGB(110, 170, 255)

-- Phase 3: trims, glows and flames follow the player's god (GodConfig colours).
local DEFAULT_COLORS = { Accent = GOLD, Glow = DIVINE_BLUE }
local pal = DEFAULT_COLORS -- set at the start of each Temple()/Building() call

--------------------------------------------------------------------------
-- Part helpers (all positions are relative to `origin`)
--------------------------------------------------------------------------
local function block(model, origin, name, size, offset, props)
	local p = { Name = name, Size = size, CFrame = origin * CFrame.new(offset) }
	for key, value in props or {} do
		p[key] = value
	end
	return WorldBuilder.MakePart(model, p)
end

-- Vertical cylinder standing on `baseY`.
local function column(model, origin, name, x, baseY, z, height, diameter, props)
	local p = {
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, diameter, diameter),
		CFrame = origin * CFrame.new(x, baseY + height / 2, z) * CFrame.Angles(0, 0, math.rad(90)),
	}
	for key, value in props or {} do
		p[key] = value
	end
	return WorldBuilder.MakePart(model, p)
end

-- Flat disc (a short vertical cylinder) centred at height y.
local function disc(model, origin, name, x, y, z, thickness, diameter, props)
	return column(model, origin, name, x, y - thickness / 2, z, thickness, diameter, props)
end

local function ball(model, origin, name, diameter, offset, props)
	local p = { Name = name, Shape = Enum.PartType.Ball, Size = Vector3.new(diameter, diameter, diameter), CFrame = origin * CFrame.new(offset) }
	for key, value in props or {} do
		p[key] = value
	end
	return WorldBuilder.MakePart(model, p)
end

local function addLight(part, color, range, brightness)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range or 12
	light.Brightness = brightness or 1.5
	light.Parent = part
	return light
end

local function addFire(part, size)
	local fire = Instance.new("Fire")
	fire.Size = size or 5
	fire.Heat = 8
	if pal.Fire then
		fire.Color = pal.Fire
		fire.SecondaryColor = pal.Accent
	end
	fire.Parent = part
	return fire
end

-- Evenly spaced positions from a to b (inclusive), at least 2.
local function spread(a, b, spacing)
	local count = math.max(2, math.floor(math.abs(b - a) / spacing) + 1)
	local list = {}
	for i = 0, count - 1 do
		table.insert(list, a + (b - a) * i / (count - 1))
	end
	return list
end

--------------------------------------------------------------------------
-- Main temple
--------------------------------------------------------------------------
local function buildRuinedShrine(model, origin)
	block(model, origin, "Foundation", Vector3.new(22, 1, 22), Vector3.new(0, 0.5, 0), { Material = Enum.Material.Slate, Color = STONE })
	local floorY = 1

	block(model, origin, "Altar", Vector3.new(6, 3, 3), Vector3.new(0, floorY + 1.5, 0), { Material = Enum.Material.Slate, Color = Color3.fromRGB(165, 160, 152) })
	WorldBuilder.MakePart(model, {
		Name = "BrokenAltarTop",
		Size = Vector3.new(4, 0.8, 3.2),
		CFrame = origin * CFrame.new(1.5, floorY + 3.3, 0) * CFrame.Angles(0, 0, math.rad(-14)),
		Material = Enum.Material.Slate,
		Color = Color3.fromRGB(150, 145, 138),
	})

	-- Column stumps: { x, z, height }
	for i, s in { { -8, -8, 7 }, { 8, -8, 3.5 }, { -8, 8, 2 }, { 8, 8, 9 } } do
		column(model, origin, "ColumnStump" .. i, s[1], floorY, s[2], s[3], 2.6, { Color = WORN_MARBLE })
	end

	WorldBuilder.MakePart(model, {
		Name = "FallenColumn",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(9, 2.4, 2.4),
		CFrame = origin * CFrame.new(-2, floorY + 1.2, -6) * CFrame.Angles(0, math.rad(25), 0),
		Color = WORN_MARBLE,
	})

	-- Rubble: { x, z, size }
	for i, r in { { 4, -3, 1.2 }, { -4, 3, 0.9 }, { 6, 5, 1.5 }, { -6, -2, 0.8 } } do
		WorldBuilder.MakePart(model, {
			Name = "Rubble" .. i,
			Size = Vector3.new(r[3], r[3] * 0.7, r[3]),
			CFrame = origin * CFrame.new(r[1], floorY + r[3] * 0.35, r[2]) * CFrame.Angles(0, math.rad(i * 37), 0),
			Material = Enum.Material.Slate,
			Color = STONE,
		})
	end
end

-- Look of each tier from 2 upwards. W = width (X), D = depth (Z).
local TEMPLE_STYLES = {
	[2] = { W = 20, D = 20, ColH = 9, Spacing = 6.5 },
	[3] = { W = 22, D = 26, ColH = 12, Spacing = 5.5, Cella = true, Roof = true },
	[4] = { W = 24, D = 28, ColH = 14, Spacing = 5, Cella = true, Roof = true, GoldTrim = true, Braziers = true },
	[5] = { W = 26, D = 28, ColH = 15, Spacing = 4.6, Cella = true, Roof = true, GoldTrim = true, Braziers = true, Dome = true, Statues = true },
	[6] = { W = 26, D = 28, ColH = 15, Spacing = 4.6, Cella = true, Roof = true, GoldTrim = true, Braziers = true, Dome = true, Statues = true, Floating = true },
	[7] = { W = 32, D = 34, ColH = 19, Spacing = 4.4, Cella = true, Roof = true, GoldTrim = true, Braziers = true, Dome = true, Statues = true, Floating = true, GoldColumns = true, Citadel = true },
}

-- Phase 7E: ring of small blocks (a halo) centred at `center`, flat.
local function ring(model, origin, name, center, radius, count, props)
	for i = 1, count do
		local angle = (i / count) * math.pi * 2
		local arc = 2 * math.pi * radius / count
		local p = {
			Name = name .. i,
			Size = Vector3.new(arc * 1.05, 0.5, 0.9),
			CFrame = origin * CFrame.new(center) * CFrame.Angles(0, -angle, 0) * CFrame.new(0, 0, radius) ,
			CanCollide = false,
		}
		for key, value in props or {} do
			p[key] = value
		end
		WorldBuilder.MakePart(model, p)
	end
end

-- Divine Citadel extras (tier 7): corner towers, a central spire and crown.
local function buildCitadel(model, origin, s, topY)
	local W, D = s.W, s.D
	local towerH = s.ColH + 14
	local gold = { Material = Enum.Material.Metal, Color = pal.Accent }
	for i, c in { { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } } do
		local x, z = c[1] * (W / 2 - 1), c[2] * (D / 2 - 1)
		column(model, origin, "Tower" .. i, x, 0, z, towerH, 5, { Color = MARBLE, Material = Enum.Material.Marble })
		disc(model, origin, "TowerRim" .. i, x, towerH, z, 1, 6.4, gold)
		column(model, origin, "TowerRoof" .. i, x, towerH + 0.5, z, 4, 3.2, gold)
		local orb = ball(model, origin, "TowerOrb" .. i, 2.2, Vector3.new(x, towerH + 6, z), { Material = Enum.Material.Neon, Color = pal.Glow })
		addLight(orb, pal.Glow, 20, 2)
	end
	-- Walls between the towers at the back and sides (front stays open)
	block(model, origin, "WallBack", Vector3.new(W - 4, 8, 1.6), Vector3.new(0, 4, D / 2 - 1))
	block(model, origin, "WallLeft", Vector3.new(1.6, 8, D - 4), Vector3.new(-W / 2 + 1, 4, 0))
	block(model, origin, "WallRight", Vector3.new(1.6, 8, D - 4), Vector3.new(W / 2 - 1, 4, 0))
	-- Central spire rising out of the dome with a glowing crown
	local spireBase = topY + W * 0.2
	column(model, origin, "Spire", 0, spireBase, 4, 16, 2, gold)
	ring(model, origin, "Crown", Vector3.new(0, spireBase + 16.5, 4), 2.6, 10, { Material = Enum.Material.Neon, Color = pal.Accent })
	local crown = ball(model, origin, "CrownGem", 2.6, Vector3.new(0, spireBase + 18, 4), { Material = Enum.Material.Neon, Color = pal.Glow })
	addLight(crown, pal.Glow, 40, 3)
	-- Grand stairway at the front
	block(model, origin, "Stair1", Vector3.new(12, 0.6, 3), Vector3.new(0, 0.3, -D / 2 - 3.5))
	block(model, origin, "Stair2", Vector3.new(10, 0.6, 2), Vector3.new(0, 0.9, -D / 2 - 2.5))
	return spireBase + 18
end

-- Temple Prestige decorations (Phase 7E). See TempleConfig.Prestige.Looks.
local function buildPrestige(model, origin, s, topY, crownY, prestige)
	local W, D = s.W, s.D
	local gold = { Material = Enum.Material.Metal, Color = pal.Accent }
	local glow = { Material = Enum.Material.Neon, Color = pal.Glow, CanCollide = false }
	if prestige >= 1 then -- banners
		for i, x in { -W / 2 + 4, -W / 6, W / 6, W / 2 - 4 } do
			block(model, origin, "Banner" .. i, Vector3.new(2.4, 7, 0.2), Vector3.new(x, s.ColH - 2, -D / 2 - 0.4), { Color = pal.Accent, Material = Enum.Material.Fabric, CanCollide = false })
		end
	end
	if prestige >= 2 then -- ring of glowing pillars
		for i = 1, 8 do
			local angle = i / 8 * math.pi * 2
			local x, z = math.cos(angle) * (W / 2 + 6), math.sin(angle) * (D / 2 + 6) + 0
			if z > -D / 2 - 2 then -- keep the entrance clear
				column(model, origin, "PrestigePillar" .. i, x, 0, z, 6, 1, glow)
			end
		end
	end
	if prestige >= 3 then
		ring(model, origin, "Halo", Vector3.new(0, topY + W * 0.35, 4), W * 0.3, 20, glow)
	end
	if prestige >= 4 then -- stars on the front
		for i = 1, math.min(prestige, 10) do
			local x = (i - (math.min(prestige, 10) + 1) / 2) * 2.2
			ball(model, origin, "Star" .. i, 1.2, Vector3.new(x, s.ColH + 4.2, -D / 2 - 0.6), glow)
		end
	end
	if prestige >= 5 then -- beam of light into the sky
		column(model, origin, "SkyBeam", 0, crownY, 4, 120, 3, { Material = Enum.Material.Neon, Color = pal.Glow, Transparency = 0.6, CanCollide = false, CastShadow = false })
	end
	if prestige >= 6 then
		local skyY = topY + 12
		for i, pos in { Vector3.new(-22, skyY + 4, 16), Vector3.new(22, skyY + 6, 16) } do
			block(model, origin, "PrestigeIsland" .. i, Vector3.new(7, 1.2, 7), pos)
			block(model, origin, "PrestigeIslandGold" .. i, Vector3.new(7.4, 0.4, 7.4), pos - Vector3.new(0, 0.8, 0), gold)
			local orb = ball(model, origin, "PrestigeOrb" .. i, 1.6, pos + Vector3.new(0, 3, 0), glow)
			addLight(orb, pal.Glow, 14, 2)
		end
	end
	if prestige >= 7 then -- flames on the towers
		for _, item in model:GetChildren() do
			if item.Name:match("^TowerRoof") then
				addFire(item, 6)
			end
		end
	end
	if prestige >= 8 then
		ring(model, origin, "GreatHalo", Vector3.new(0, topY + W * 0.55, 4), W * 0.5, 28, { Material = Enum.Material.Neon, Color = pal.Accent, CanCollide = false })
	end
	if prestige >= 9 then -- golden statues at the gates
		for i, x in { -9, 9 } do
			block(model, origin, "GatePedestal" .. i, Vector3.new(3, 2, 3), Vector3.new(x, 1, -D / 2 - 7))
			block(model, origin, "GateStatueBody" .. i, Vector3.new(2, 5, 1.4), Vector3.new(x, 4.5, -D / 2 - 7), gold)
			ball(model, origin, "GateStatueHead" .. i, 1.6, Vector3.new(x, 7.8, -D / 2 - 7), gold)
		end
	end
	if prestige >= 10 then -- radiant: marble glows faintly in the god's colour
		for _, item in model:GetChildren() do
			if item:IsA("BasePart") and item.Material == Enum.Material.Marble then
				item.Color = item.Color:Lerp(pal.Glow, 0.25)
			end
		end
		local radiance = model:FindFirstChild("CrownGem")
		if radiance then
			addLight(radiance, pal.Accent, 60, 4)
		end
	end
end

local function buildTempleStyle(model, origin, s, prestige)
	local W, D = s.W, s.D

	-- Two-step platform
	block(model, origin, "Step", Vector3.new(W + 4, 0.8, D + 4), Vector3.new(0, 0.4, 0))
	block(model, origin, "Platform", Vector3.new(W, 1.2, D), Vector3.new(0, 1.4, 0))
	local floorY = 2

	-- Perimeter columns
	local columnColor = if s.GoldColumns then pal.Accent else MARBLE
	local columnMaterial = if s.GoldColumns then Enum.Material.Metal else Enum.Material.Marble
	local x0, x1 = -W / 2 + 1.6, W / 2 - 1.6
	local z0, z1 = -D / 2 + 1.6, D / 2 - 1.6
	local n = 0
	local function addColumn(x, z)
		n += 1
		column(model, origin, "Column" .. n, x, floorY, z, s.ColH, 2.2, { Color = columnColor, Material = columnMaterial })
	end
	for _, x in spread(x0, x1, s.Spacing) do
		addColumn(x, z0)
		addColumn(x, z1)
	end
	local sideZ = spread(z0, z1, s.Spacing)
	for i = 2, #sideZ - 1 do
		addColumn(x0, sideZ[i])
		addColumn(x1, sideZ[i])
	end

	-- Inner chamber (cella)
	if s.Cella then
		block(model, origin, "Cella", Vector3.new(W - 8, s.ColH, D - 10), Vector3.new(0, floorY + s.ColH / 2, 2), { Color = Color3.fromRGB(225, 218, 205) })
	end

	-- Altar in front of the chamber
	local altar = block(model, origin, "Altar", Vector3.new(5, 2.5, 2.5), Vector3.new(0, floorY + 1.25, -D / 2 + 5))
	if s.GoldTrim then
		block(model, origin, "AltarGold", Vector3.new(5.4, 0.4, 2.9), Vector3.new(0, floorY + 2.7, -D / 2 + 5), { Material = Enum.Material.Metal, Color = pal.Accent })
	end
	if s.Braziers then
		addFire(altar, 3)
	end

	local topY = floorY + s.ColH
	if s.Roof then
		block(model, origin, "Entablature", Vector3.new(W, 1.6, D), Vector3.new(0, topY + 0.8, 0))
		if s.GoldTrim then
			block(model, origin, "GoldTrim", Vector3.new(W + 0.4, 0.5, D + 0.4), Vector3.new(0, topY + 0.25, 0), { Material = Enum.Material.Metal, Color = pal.Accent })
		end
		-- Stepped roof
		block(model, origin, "Roof1", Vector3.new(W - 2, 1.2, D), Vector3.new(0, topY + 2.2, 0))
		block(model, origin, "Roof2", Vector3.new(W * 0.6, 1.2, D), Vector3.new(0, topY + 3.4, 0))
		block(model, origin, "Roof3", Vector3.new(W * 0.25, 1.2, D), Vector3.new(0, topY + 4.6, 0))
		topY += 5.2
	else
		-- Tier 2: restored columns with a simple marble ring on top
		block(model, origin, "LintelFront", Vector3.new(W, 1, 2.4), Vector3.new(0, topY + 0.5, z0))
		block(model, origin, "LintelBack", Vector3.new(W, 1, 2.4), Vector3.new(0, topY + 0.5, z1))
		block(model, origin, "LintelLeft", Vector3.new(2.4, 1, D), Vector3.new(x0, topY + 0.5, 0))
		block(model, origin, "LintelRight", Vector3.new(2.4, 1, D), Vector3.new(x1, topY + 0.5, 0))
	end

	if s.Braziers then
		for i, x in { -W / 2 + 2, W / 2 - 2 } do
			local bowl = disc(model, origin, "Brazier" .. i, x, 1.6, -D / 2 - 1.5, 0.8, 2.4, { Material = Enum.Material.Metal, Color = pal.Accent })
			column(model, origin, "BrazierStand" .. i, x, 0, -D / 2 - 1.5, 1.2, 0.6, { Material = Enum.Material.Metal, Color = IRON })
			addFire(bowl, 4)
		end
	end

	if s.Dome then
		local dome = ball(model, origin, "Dome", W * 0.45, Vector3.new(0, topY, 4), { Material = Enum.Material.Metal, Color = pal.Accent })
		addLight(dome, pal.Accent, 18, 1)
	end

	if s.Statues then
		for i, x in { -6, 6 } do
			block(model, origin, "StatuePedestal" .. i, Vector3.new(2.4, 2, 2.4), Vector3.new(x, 1, -D / 2 - 4))
			local figure = block(model, origin, "Statue" .. i, Vector3.new(1.4, 5, 1.4), Vector3.new(x, 4.5, -D / 2 - 4), { Material = Enum.Material.Neon, Color = pal.Glow })
			addLight(figure, pal.Glow, 12, 1.5)
		end
	end

	if s.Citadel then
		local crownY = buildCitadel(model, origin, s, topY)
		buildPrestige(model, origin, s, topY, crownY, prestige or 0)
	end

	if s.Floating then
		local skyY = topY + 8
		for i, pos in { Vector3.new(-16, skyY, -4), Vector3.new(16, skyY + 2, -4), Vector3.new(0, skyY + 5, 20) } do
			block(model, origin, "SkyIsland" .. i, Vector3.new(8, 1.2, 8), pos)
			block(model, origin, "SkyIslandGold" .. i, Vector3.new(8.4, 0.4, 8.4), pos - Vector3.new(0, 0.8, 0), { Material = Enum.Material.Metal, Color = pal.Accent })
			column(model, origin, "SkyColumn" .. i, pos.X, pos.Y + 0.6, pos.Z, 5, 1.4, { Color = MARBLE })
			local orb = ball(model, origin, "SkyOrb" .. i, 1.6, pos + Vector3.new(0, 7, 0), { Material = Enum.Material.Neon, Color = pal.Accent })
			addLight(orb, pal.Accent, 16, 2)
		end
	end
end

function TempleModels.Temple(tier, origin, colors, prestige)
	pal = colors or DEFAULT_COLORS
	local model = Instance.new("Model")
	model.Name = "Temple"
	if tier <= 1 then
		buildRuinedShrine(model, origin)
	else
		buildTempleStyle(model, origin, TEMPLE_STYLES[math.min(tier, 7)], prestige)
	end
	return model
end

--------------------------------------------------------------------------
-- Buildings (each fits inside a 14 x 14 stud slot)
--------------------------------------------------------------------------
local BUILDERS = {}

BUILDERS.GoldTreasury = function(model, o, level)
	block(model, o, "Floor", Vector3.new(12, 0.6, 12), Vector3.new(0, 0.3, 0))
	local floorY = 0.6
	local w, h = 5 + level, 3 + level
	block(model, o, "Vault", Vector3.new(w, h, w), Vector3.new(0, floorY + h / 2, 0))
	block(model, o, "VaultDoor", Vector3.new(2, 2.5, 0.3), Vector3.new(0, floorY + 1.25, -w / 2 - 0.15), { Material = Enum.Material.Metal, Color = GOLD })
	block(model, o, "VaultTop", Vector3.new(w + 0.6, 0.5, w + 0.6), Vector3.new(0, floorY + h + 0.25, 0), { Material = Enum.Material.Metal, Color = GOLD })

	local piles = { { -4.8, -4.8 }, { 4.8, -4.8 }, { -4.8, 4.8 }, { 4.8, 4.8 }, { 2.8, -5 } }
	for i = 1, level do
		ball(model, o, "GoldPile" .. i, 1.6, Vector3.new(piles[i][1], floorY + 0.4, piles[i][2]), { Material = Enum.Material.Metal, Color = GOLD })
	end
	if level >= 3 then
		for i, c in { { -5.4, -5.4 }, { 5.4, -5.4 }, { -5.4, 5.4 }, { 5.4, 5.4 } } do
			column(model, o, "Column" .. i, c[1], floorY, c[2], 4 + level, 1.2)
		end
	end
	if level >= 5 then
		local dome = ball(model, o, "GoldDome", 4, Vector3.new(0, floorY + h + 1.5, 0), { Material = Enum.Material.Metal, Color = GOLD })
		addLight(dome, GOLD, 14, 1.5)
	end
end

BUILDERS.MainAltar = function(model, o, level)
	-- One stone step per level
	for i = 1, level do
		local size = 12 - (i - 1) * 1.6
		block(model, o, "Step" .. i, Vector3.new(size, 0.6, size), Vector3.new(0, (i - 0.5) * 0.6, 0))
	end
	local top = level * 0.6
	local altar = block(model, o, "Altar", Vector3.new(4, 2.5, 2), Vector3.new(0, top + 1.25, 0))
	if level >= 2 then
		addFire(altar, 4)
	end
	if level >= 3 then
		block(model, o, "AltarGold", Vector3.new(4.4, 0.4, 2.4), Vector3.new(0, top + 2.7, 0), { Material = Enum.Material.Metal, Color = pal.Accent })
	end
	if level >= 4 then
		local orb = ball(model, o, "FavorOrb", 1.6, Vector3.new(0, top + 6, 0), { Material = Enum.Material.Neon, Color = pal.Glow })
		addLight(orb, pal.Glow, 14, 2)
	end
	if level >= 5 then
		for i, x in { -4, 4 } do
			column(model, o, "GoldColumn" .. i, x, top, 0, 8, 1.4, { Material = Enum.Material.Metal, Color = pal.Accent })
		end
	end
end

BUILDERS.DivineFountain = function(model, o, level)
	local d = 7 + level
	disc(model, o, "BaseDisc", 0, 0.15, 0, 0.3, d + 1.2, if level >= 5
		then { Material = Enum.Material.Metal, Color = pal.Accent }
		else nil)
	disc(model, o, "Basin", 0, 0.9, 0, 1.2, d)
	local water = disc(model, o, "Water", 0, 1.35, 0, 0.3, d - 1, {
		Material = Enum.Material.Glass,
		Color = WATER,
		Transparency = 0.3,
		CanCollide = false,
	})
	local pillarHeight = 1 + level * 1.2
	column(model, o, "Pillar", 0, 1.5, 0, pillarHeight, 1.2)
	local topY = 1.5 + pillarHeight
	if level >= 2 then
		local bowl = disc(model, o, "TopBowl", 0, topY, 0, 0.5, 3)
		if level >= 3 then
			local spray = Instance.new("ParticleEmitter")
			spray.Color = ColorSequence.new(WATER)
			spray.LightEmission = 0.4
			spray.Rate = 30
			spray.Lifetime = NumberRange.new(0.8, 1.2)
			spray.Speed = NumberRange.new(5, 7)
			spray.SpreadAngle = Vector2.new(25, 25)
			spray.Acceleration = Vector3.new(0, -20, 0)
			spray.Size = NumberSequence.new(0.3)
			spray.EmissionDirection = Enum.NormalId.Right -- the cylinder's local +X points up
			spray.Parent = bowl
		end
	end
	if level >= 4 then
		addLight(water, WATER, 14, 1.5)
	end
end

BUILDERS.TrainingGrounds = function(model, o, level)
	block(model, o, "SandFloor", Vector3.new(14, 0.4, 14), Vector3.new(0, 0.2, 0), { Material = Enum.Material.Sand, Color = SAND })
	local floorY = 0.4
	local dummies = { { -4, -3 }, { 0, -3 }, { 4, -3 }, { -2, 2 }, { 2, 2 } }
	for i = 1, level do
		local x, z = dummies[i][1], dummies[i][2]
		column(model, o, "DummyPost" .. i, x, floorY, z, 4, 0.8, { Material = Enum.Material.Wood, Color = WOOD })
		block(model, o, "DummyArms" .. i, Vector3.new(2.6, 0.4, 0.4), Vector3.new(x, floorY + 3, z), { Material = Enum.Material.Wood, Color = WOOD })
		ball(model, o, "DummyHead" .. i, 1.4, Vector3.new(x, floorY + 4.5, z), { Material = Enum.Material.Fabric, Color = SAND })
	end
	if level >= 3 then
		block(model, o, "RackBar", Vector3.new(6, 0.4, 0.4), Vector3.new(0, floorY + 2.5, 5.5), { Material = Enum.Material.Wood, Color = WOOD })
		for i, x in { -2.8, 2.8 } do
			column(model, o, "RackPost" .. i, x, floorY, 5.5, 3, 0.4, { Material = Enum.Material.Wood, Color = WOOD })
		end
		for i, x in { -1.5, 0, 1.5 } do
			block(model, o, "Spear" .. i, Vector3.new(0.2, 4.5, 0.2), Vector3.new(x, floorY + 2.25, 5.8), { Material = Enum.Material.Metal, Color = IRON })
		end
	end
	if level >= 4 then
		local posts = { { -6.6, -6.6 }, { 0, -6.6 }, { 6.6, -6.6 }, { -6.6, 0 }, { 6.6, 0 }, { -6.6, 6.6 }, { 0, 6.6 }, { 6.6, 6.6 } }
		for i, p in posts do
			column(model, o, "FencePost" .. i, p[1], floorY, p[2], 2.5, 0.6, { Material = Enum.Material.Wood, Color = WOOD })
		end
	end
	if level >= 5 then
		column(model, o, "BannerPole", -5, floorY, 5, 9, 0.5, { Material = Enum.Material.Metal, Color = GOLD })
		block(model, o, "Banner", Vector3.new(0.2, 3, 2.4), Vector3.new(-5, floorY + 7, 6.3), { Material = Enum.Material.Fabric, Color = pal.Glow })
	end
end

BUILDERS.StatueHall = function(model, o, level)
	block(model, o, "Floor", Vector3.new(14, 0.6, 12), Vector3.new(0, 0.3, 0))
	local floorY = 0.6
	local golden = level >= 5
	for i = 1, level do
		local x = -6 + (i - 1) * 3
		block(model, o, "Pedestal" .. i, Vector3.new(2, 1.5, 2), Vector3.new(x, floorY + 0.75, 2))
		local h = 3.5 + 0.3 * i
		local figure = block(model, o, "Statue" .. i, Vector3.new(1.2, h, 1.2), Vector3.new(x, floorY + 1.5 + h / 2, 2), if golden
			then { Material = Enum.Material.Metal, Color = pal.Accent }
			else nil)
		ball(model, o, "StatueHead" .. i, 1.2, Vector3.new(x, floorY + 1.5 + h + 0.5, 2), if golden
			then { Material = Enum.Material.Metal, Color = pal.Accent }
			else nil)
		if golden then
			addLight(figure, pal.Accent, 8, 1)
		end
	end
	if level >= 3 then
		block(model, o, "BackWall", Vector3.new(14, 7, 1), Vector3.new(0, floorY + 3.5, 5.5))
		block(model, o, "WallGold", Vector3.new(14.2, 0.4, 1.2), Vector3.new(0, floorY + 7.2, 5.5), { Material = Enum.Material.Metal, Color = pal.Accent })
	end
	if level >= 4 then
		for i, x in { -6.5, 6.5 } do
			column(model, o, "FrontColumn" .. i, x, floorY, -5.3, 7.4, 1.2)
		end
		block(model, o, "Roof", Vector3.new(14.6, 0.8, 12.6), Vector3.new(0, floorY + 7.8, 0))
	end
end

function TempleModels.Building(buildingId, level, origin, colors)
	pal = colors or DEFAULT_COLORS
	local builder = BUILDERS[buildingId]
	if not builder or level <= 0 then
		return nil
	end
	local model = Instance.new("Model")
	model.Name = buildingId
	builder(model, origin, math.clamp(level, 1, 5))
	if level >= 6 then
		-- Phase 7E "Divine" level: a floating halo and glow above the building.
		local _, size = model:GetBoundingBox()
		local height = size.Y + 2.5
		ring(model, origin, "DivineHalo", Vector3.new(0, height, 0), 4, 14, { Material = Enum.Material.Neon, Color = pal.Accent })
		local gem = ball(model, origin, "DivineGem", 1.4, Vector3.new(0, height + 1.5, 0), { Material = Enum.Material.Neon, Color = pal.Glow, CanCollide = false })
		addLight(gem, pal.Glow, 16, 2)
	end
	return model
end

--------------------------------------------------------------------------
-- Construction animation: every part rises out of the ground and fades in.
-- Call BEFORE parenting the model (same frame), so players never see the
-- finished building flash before the animation starts.
--------------------------------------------------------------------------
function TempleModels.AnimateIn(model, duration)
	duration = duration or 1.2
	local _, size = model:GetBoundingBox()
	local drop = size.Y + 2
	local info = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	for _, item in model:GetDescendants() do
		if item:IsA("BasePart") then
			local targetCFrame, targetTransparency = item.CFrame, item.Transparency
			item.CFrame = targetCFrame - Vector3.new(0, drop, 0)
			item.Transparency = 1
			TweenService:Create(item, info, { CFrame = targetCFrame, Transparency = targetTransparency }):Play()
		elseif (item:IsA("Fire") or item:IsA("ParticleEmitter") or item:IsA("PointLight")) and item.Enabled then
			item.Enabled = false
			task.delay(duration, function()
				if item.Parent then
					item.Enabled = true
				end
			end)
		end
	end

	-- Golden sparkle burst at the building's base
	local center = model:GetBoundingBox()
	local sparkle = Instance.new("Part")
	sparkle.Name = "ConstructionSparkle"
	sparkle.Anchored = true
	sparkle.CanCollide = false
	sparkle.CanQuery = false
	sparkle.Transparency = 1
	sparkle.Size = Vector3.new(math.max(size.X, 4), 1, math.max(size.Z, 4))
	sparkle.CFrame = CFrame.new(center.Position.X, center.Position.Y - size.Y / 2 + 0.5, center.Position.Z)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(GOLD)
	emitter.LightEmission = 1
	emitter.Rate = 60
	emitter.Lifetime = NumberRange.new(0.6, 1.2)
	emitter.Speed = NumberRange.new(4, 8)
	emitter.Size = NumberSequence.new(0.4, 0)
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Parent = sparkle
	task.delay(duration, function()
		emitter.Enabled = false
	end)
	sparkle.Parent = model
	Debris:AddItem(sparkle, duration + 1.5)
end

return TempleModels
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">TempleService</string>
          <string name="Source"><![CDATA[-- TempleService (ModuleScript)
-- Location: ServerScriptService > Services > TempleService
--
-- The Temple Tycoon, all on the server:
--   * Builds each player's temple and buildings from their SAVED data
--     (data.Temple) when they join, on whichever plot they get.
--   * Glowing purchase pads (with a hold-to-buy prompt) on the owner's plot.
--     Only the plot's owner can buy; checked against the plot's OwnerUserId.
--   * Validates every purchase (level, temple tier, character level, Gold).
--   * Plays the construction animation and saves the new level.
--   * Pays passive income (Gold Treasury -> Gold, Main Altar -> Divine Favor)
--     only while the player is in the game.
--
-- Other systems can read temple bonuses with:
--   TempleService.GetEffect(player, "CombatBonusPercent")  -> number

local GameEvents = require(script.Parent:WaitForChild("GameEvents"))
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local TempleConfig = require(Shared:WaitForChild("TempleConfig"))
local Progression = require(Shared:WaitForChild("Progression"))

local Services = ServerScriptService:WaitForChild("Services")
local TempleModels = require(Services:WaitForChild("TempleModels"))
local WorldBuilder = require(Services:WaitForChild("WorldBuilder"))

local TempleService = {}

local DataService = nil
local ProgressionService = nil
local PlotService = nil
local notifyRemote = nil
local colorProvider = nil -- function(player) -> god colours { Accent, Glow, Fire }

local MAX_LEVEL = TempleConfig.MaxBuildingLevel
local PAD_READY = Color3.fromRGB(120, 230, 120)
local PAD_TOO_EXPENSIVE = Color3.fromRGB(230, 120, 80)
local PAD_LOCKED = Color3.fromRGB(150, 150, 160)
local PAD_MAXED = Color3.fromRGB(212, 175, 55)

-- [Player] = { Plot, Pads = { [id] = { Part, Label, Prompt } }, Income = { Gold, DivineFavor }, LastRequest, Connections }
local state = {}

--------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------
local function notify(player, text)
	if notifyRemote and player.Parent then
		notifyRemote:FireClient(player, "Message", text)
	end
end

local function getLevel(data, buildingId)
	return tonumber(data.Temple.Buildings[buildingId]) or 0
end

-- Makes sure saved temple data is valid (whole numbers, 0-6) and the tier matches the Core.
local function sanitizeTemple(data)
	local buildings = data.Temple.Buildings
	for id in TempleConfig.Buildings do
		local level = math.clamp(math.floor(tonumber(buildings[id]) or 0), 0, MAX_LEVEL)
		buildings[id] = if level > 0 then level else nil
	end
	data.Temple.Tier = TempleConfig.TierFromCoreLevel(buildings.TempleCore)
	data.Temple.Prestige = math.clamp(math.floor(tonumber(data.Temple.Prestige) or 0), 0, TempleConfig.Prestige.MaxLevel)
end

local function slotCFrame(plot, offset)
	local base = plot:FindFirstChild("Base")
	local top = base.Position.Y + base.Size.Y / 2
	return CFrame.new(base.Position.X + offset.X, top, base.Position.Z + offset.Z)
end

-- Publishes temple values so the upgrade menu can show them.
local function pushAttributes(player, data)
	player:SetAttribute("TempleTier", data.Temple.Tier)
	player:SetAttribute("TempleTierName", TempleConfig.GetTierName(data.Temple.Tier))
	for id in TempleConfig.Buildings do
		player:SetAttribute("Temple_" .. id, getLevel(data, id))
	end
	local multiplier = TempleConfig.PrestigeMultiplier(data.Temple.Prestige)
	player:SetAttribute("TemplePrestige", data.Temple.Prestige or 0)
	player:SetAttribute("GoldPerMinute", math.floor(TempleConfig.GetEffectValue("GoldTreasury", getLevel(data, "GoldTreasury")) * multiplier))
	player:SetAttribute("FavorPerMinute", math.floor(TempleConfig.GetEffectValue("MainAltar", getLevel(data, "MainAltar")) * multiplier))
end

--------------------------------------------------------------------------
-- Building the models on the plot
--------------------------------------------------------------------------
local function placeTemple(player, data, animate)
	local st = state[player]
	local buildings = st.Plot:FindFirstChild("Buildings")
	local old = buildings:FindFirstChild("Temple")
	if old then
		old:Destroy()
	end
	local colors = if colorProvider then colorProvider(player) else nil
	local model = TempleModels.Temple(data.Temple.Tier, slotCFrame(st.Plot, TempleConfig.Buildings.TempleCore.Slot), colors, data.Temple.Prestige)
	if animate then
		TempleModels.AnimateIn(model, 1.8)
	end
	model.Parent = buildings
end

local function placeBuilding(player, data, buildingId, animate)
	local st = state[player]
	local buildings = st.Plot:FindFirstChild("Buildings")
	local old = buildings:FindFirstChild(buildingId)
	if old then
		old:Destroy()
	end
	local colors = if colorProvider then colorProvider(player) else nil
	local model = TempleModels.Building(buildingId, getLevel(data, buildingId), slotCFrame(st.Plot, TempleConfig.Buildings[buildingId].Slot), colors)
	if not model then
		return
	end
	if animate then
		TempleModels.AnimateIn(model)
	end
	model.Parent = buildings
end

local function placeEverything(player, data)
	local buildings = state[player].Plot:FindFirstChild("Buildings")
	buildings:ClearAllChildren()
	placeTemple(player, data, false)
	for id, info in TempleConfig.Buildings do
		if not info.IsCore then
			placeBuilding(player, data, id, false)
		end
	end
end

--------------------------------------------------------------------------
-- Purchase pads
--------------------------------------------------------------------------
local function refreshPads(player)
	local st = state[player]
	local data = DataService.GetData(player)
	if not st or not data then
		return
	end
	local gold = data.Currencies.Gold or 0

	for id, pad in st.Pads do
		local info = TempleConfig.Buildings[id]
		local level = getLevel(data, id)
		local upgrade = TempleConfig.GetUpgradeInfo(id, level, data.Temple.Tier, data.Level, data.RankIndex)
		local name = info.DisplayName

		if upgrade.Maxed then
			pad.Label.Text = name .. "\nMAX LEVEL"
			pad.Part.Color = PAD_MAXED
			pad.Prompt.Enabled = false
		elseif upgrade.Blocked then
			pad.Label.Text = ("%s  Lv %d\nLocked: %s"):format(name, level, upgrade.Blocked)
			pad.Part.Color = PAD_LOCKED
			pad.Prompt.Enabled = true
			pad.Prompt.ActionText = "Locked"
			pad.Prompt.ObjectText = name
		else
			local costText = Progression.FormatNumber(upgrade.Cost) .. " Gold"
			if level == 0 then
				pad.Label.Text = ("Build %s\n%s"):format(name, costText)
			else
				pad.Label.Text = ("%s  Lv %d -> %d\n%s"):format(name, level, upgrade.NextLevel, costText)
			end
			pad.Part.Color = if gold >= upgrade.Cost then PAD_READY else PAD_TOO_EXPENSIVE
			pad.Prompt.Enabled = true
			pad.Prompt.ActionText = if level == 0 then "Build" else "Upgrade"
			pad.Prompt.ObjectText = name .. " (" .. costText .. ")"
		end
	end
end

local function createPads(player)
	local st = state[player]
	local plot = st.Plot
	local padsFolder = plot:FindFirstChild("Pads")
	if not padsFolder then
		padsFolder = Instance.new("Folder")
		padsFolder.Name = "Pads"
		padsFolder.Parent = plot
	end
	padsFolder:ClearAllChildren()

	for id, info in TempleConfig.Buildings do
		local part = WorldBuilder.MakePart(padsFolder, {
			Name = "Pad_" .. id,
			Size = Vector3.new(6, 0.4, 6),
			CFrame = slotCFrame(plot, info.Pad) * CFrame.new(0, 0.2, 0),
			Material = Enum.Material.Neon,
			Color = PAD_LOCKED,
			Transparency = 0.15,
		})
		local label = WorldBuilder.AddLabel(part, info.DisplayName, Color3.new(1, 1, 1), 4)

		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Build"
		prompt.ObjectText = info.DisplayName
		prompt.HoldDuration = 0.4 -- a short hold stops accidental purchases
		prompt.MaxActivationDistance = 10
		prompt.RequiresLineOfSight = false
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
		prompt.Parent = part

		prompt.Triggered:Connect(function(who)
			-- Ownership check: only this plot's owner may change it.
			if plot:GetAttribute("OwnerUserId") ~= who.UserId then
				notify(who, "This is not your temple.")
				return
			end
			TempleService.RequestUpgrade(who, id)
		end)

		st.Pads[id] = { Part = part, Label = label, Prompt = prompt }
	end
end

--------------------------------------------------------------------------
-- Public API
--------------------------------------------------------------------------
function TempleService.Init(dataService, progressionService, plotService, notifyRemoteEvent, upgradeRemote)
	DataService = dataService
	ProgressionService = progressionService
	PlotService = plotService
	notifyRemote = notifyRemoteEvent

	-- Upgrade requests from the menu. Never trust the client: check everything.
	if upgradeRemote then
		upgradeRemote.OnServerEvent:Connect(function(player, buildingId)
			if buildingId == "Prestige" then
				TempleService.RequestPrestige(player)
				return
			end
			if type(buildingId) ~= "string" or not TempleConfig.Buildings[buildingId] then
				return
			end
			TempleService.RequestUpgrade(player, buildingId)
		end)
	end

	-- Passive income loop
	task.spawn(function()
		local interval = TempleConfig.IncomeInterval
		while true do
			task.wait(interval)
			TempleService.PayIncome(interval)
		end
	end)
end

-- Phase 3: GodService supplies the selected god's colours.
function TempleService.SetColorProvider(provider)
	colorProvider = provider
end

-- Call after the player's data has loaded and they have a plot.
function TempleService.SetupPlayer(player, plot)
	local data = DataService.GetData(player)
	if not data or not plot then
		return
	end
	sanitizeTemple(data)

	state[player] = {
		Plot = plot,
		Pads = {},
		Income = { Gold = 0, DivineFavor = 0 },
		LastRequest = 0,
		Connections = {},
	}

	placeEverything(player, data)
	createPads(player)
	pushAttributes(player, data)
	refreshPads(player)

	-- Keep pad colours/labels in sync when Gold or level changes from anywhere.
	local st = state[player]
	for _, attribute in { "Gold", "Level", "RankIndex" } do
		table.insert(st.Connections, player:GetAttributeChangedSignal(attribute):Connect(function()
			refreshPads(player)
		end))
	end
end

-- Call when the player leaves (before PlotService.ReleasePlot).
function TempleService.ReleasePlayer(player)
	local st = state[player]
	if not st then
		return
	end
	state[player] = nil
	for _, connection in st.Connections do
		connection:Disconnect()
	end
	local pads = st.Plot:FindFirstChild("Pads")
	if pads then
		pads:ClearAllChildren()
	end
end

-- Rebuilds the plot from saved data (used after the !reset debug command).
function TempleService.Rebuild(player)
	local data = DataService.GetData(player)
	if not data or not state[player] then
		return
	end
	sanitizeTemple(data)
	placeEverything(player, data)
	pushAttributes(player, data)
	refreshPads(player)
end

-- Validates and performs one upgrade. Returns true if it happened.
function TempleService.RequestUpgrade(player, buildingId)
	local st = state[player]
	local data = DataService.GetData(player)
	local info = TempleConfig.Buildings[buildingId]
	if not st or not data or not info then
		return false
	end
	if PlotService.GetPlot(player) ~= st.Plot or st.Plot:GetAttribute("OwnerUserId") ~= player.UserId then
		return false
	end

	local now = os.clock()
	if now - st.LastRequest < TempleConfig.UpgradeCooldown then
		return false
	end
	st.LastRequest = now

	local level = getLevel(data, buildingId)
	local upgrade = TempleConfig.GetUpgradeInfo(buildingId, level, data.Temple.Tier, data.Level, data.RankIndex)
	if upgrade.Maxed then
		notify(player, info.DisplayName .. " is already at max level.")
		return false
	end
	if upgrade.Blocked then
		notify(player, upgrade.Blocked .. " to upgrade the " .. info.DisplayName .. ".")
		return false
	end

	-- SpendCurrency checks and subtracts without yielding, so double-clicks can't double-spend.
	if not ProgressionService.SpendCurrency(player, "Gold", upgrade.Cost) then
		local missing = upgrade.Cost - (data.Currencies.Gold or 0)
		notify(player, ("You need %s more Gold."):format(Progression.FormatNumber(missing)))
		return false
	end

	data.Temple.Buildings[buildingId] = upgrade.NextLevel

	if info.IsCore then
		data.Temple.Tier = TempleConfig.TierFromCoreLevel(upgrade.NextLevel)
		placeTemple(player, data, true)
		notify(player, ("Your temple is now a %s!"):format(TempleConfig.GetTierName(data.Temple.Tier)))
	else
		placeBuilding(player, data, buildingId, true)
		notify(player, ("%s reached level %d!"):format(info.DisplayName, upgrade.NextLevel))
	end

	pushAttributes(player, data)
	refreshPads(player)
	GameEvents.Fire("UpgradeBuilding", player, buildingId)
	return true
end

-- Phase 7E: buys the next Temple Prestige level. Returns true if it happened.
function TempleService.RequestPrestige(player)
	local st = state[player]
	local data = DataService.GetData(player)
	if not st or not data then
		return false
	end
	local now = os.clock()
	if now - st.LastRequest < TempleConfig.UpgradeCooldown then
		return false
	end
	st.LastRequest = now
	local info = TempleConfig.GetPrestigeInfo(data.Temple.Prestige, data.Temple.Tier, data.Temple.Buildings)
	if info.Maxed then
		notify(player, "Your temple is at maximum Prestige!")
		return false
	end
	if info.Blocked then
		notify(player, info.Blocked .. " to raise Temple Prestige.")
		return false
	end
	local gold, ambrosia = data.Currencies.Gold or 0, data.Currencies.Ambrosia or 0
	if gold < info.Gold or ambrosia < info.Ambrosia then
		notify(player, ("Prestige %d needs %s Gold and %d Ambrosia."):format(info.NextLevel, Progression.FormatNumber(info.Gold), info.Ambrosia))
		return false
	end
	-- Both checked above with no yield in between, then both spent.
	ProgressionService.SpendCurrency(player, "Gold", info.Gold)
	ProgressionService.SpendCurrency(player, "Ambrosia", info.Ambrosia)
	data.Temple.Prestige = info.NextLevel
	placeTemple(player, data, true)
	pushAttributes(player, data)
	refreshPads(player)
	local look = TempleConfig.Prestige.Looks[info.NextLevel]
	notify(player, ("Temple Prestige %d! +%d%% temple income%s"):format(info.NextLevel, TempleConfig.Prestige.IncomeBonusPercent, if look then (". New: " .. look) else ""))
	GameEvents.Fire("TemplePrestige", player, nil, 1)
	return true
end

-- Total of one effect across all buildings, e.g. "CombatBonusPercent".
function TempleService.GetEffect(player, effect)
	local data = DataService.GetData(player)
	if not data then
		return 0
	end
	local total = 0
	for id, info in TempleConfig.Buildings do
		if info.Effect == effect then
			total += TempleConfig.GetEffectValue(id, getLevel(data, id))
		end
	end
	return total
end

-- Pays `seconds` worth of income to everyone in the game. Fractions carry over.
function TempleService.PayIncome(seconds)
	for player, st in state do
		local data = DataService.GetData(player)
		if data and player.Parent then
			local multiplier = TempleConfig.PrestigeMultiplier(data.Temple.Prestige)
			local rates = {
				Gold = TempleService.GetEffect(player, "GoldPerMinute") * multiplier,
				DivineFavor = TempleService.GetEffect(player, "FavorPerMinute") * multiplier,
			}
			for currency, perMinute in rates do
				if perMinute > 0 then
					st.Income[currency] += perMinute * seconds / 60
					local whole = math.floor(st.Income[currency])
					if whole > 0 then
						st.Income[currency] -= whole
						ProgressionService.AddCurrency(player, currency, whole, "Temple")
					end
				end
			end
		end
	end
end

return TempleService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <string name="Source"><![CDATA[-- WorldBuilder (ModuleScript)
-- Location: ServerScriptService > Services > WorldBuilder
--
-- Builds PLACEHOLDER world geometry when the game starts:
--   Workspace > Hub          (Olympus Plaza, spawn, columns, area markers)
--   Workspace > TemplePlots  (Plot1..Plot8)
-- If you later build your own Hub or TemplePlots by hand with the same
-- names, this script leaves them alone.

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))
local CombatConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("CombatConfig"))

local WorldBuilder = {}

local MARBLE = Color3.fromRGB(236, 232, 224)
local GOLD = Color3.fromRGB(212, 175, 55)

-- Creates an anchored part. `props` is a table of property = value.
function WorldBuilder.MakePart(parent, props)
	local part = Instance.new("Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.Marble
	part.Color = MARBLE
	if props.Shape then
		part.Shape = props.Shape
	end
	for key, value in props do
		if key ~= "Shape" then
			part[key] = value
		end
	end
	part.Parent = parent
	return part
end

-- Floating text above a part. Returns the TextLabel (named "Text").
function WorldBuilder.AddLabel(part, text, color, heightOffset)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Label"
	billboard.Size = UDim2.fromOffset(240, 56)
	billboard.StudsOffset = Vector3.new(0, heightOffset or 4, 0)
	billboard.MaxDistance = 220
	billboard.LightInfluence = 0

	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.2
	label.Parent = billboard

	billboard.Parent = part
	return label
end

local function buildHub()
	local hub = Instance.new("Folder")
	hub.Name = "Hub"

	-- Plaza floor (top surface at Y = 1)
	WorldBuilder.MakePart(hub, {
		Name = "PlazaFloor",
		Size = Vector3.new(140, 1, 140),
		Position = Vector3.new(0, 0.5, 0),
	})

	-- Spawn
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "PlazaSpawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0 -- no force field
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.Position = Vector3.new(0, 1.5, -35)
	spawn.Material = Enum.Material.Marble
	spawn.Color = GOLD
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = hub

	-- Central statue placeholder
	WorldBuilder.MakePart(hub, {
		Name = "StatuePedestal",
		Size = Vector3.new(10, 6, 10),
		Position = Vector3.new(0, 4, 0),
	})
	local statue = WorldBuilder.MakePart(hub, {
		Name = "StatuePlaceholder",
		Size = Vector3.new(4, 12, 4),
		Position = Vector3.new(0, 13, 0),
		Material = Enum.Material.Metal,
		Color = GOLD,
	})
	WorldBuilder.AddLabel(statue, "Olympus Plaza", GOLD, 9)

	-- Ring of columns (gaps at +Z for the Temple District and -Z for the Practice Field)
	for i = 0, 11 do
		local angle = math.rad(i * 30)
		local x, z = math.cos(angle) * 62, math.sin(angle) * 62
		if not (math.abs(z) > 55 and math.abs(x) < 20) then
			WorldBuilder.MakePart(hub, {
				Name = "Column",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(24, 4, 4),
				CFrame = CFrame.new(x, 13, z) * CFrame.Angles(0, 0, math.rad(90)),
			})
		end
	end

	-- Future area markers
	local areas = {
		-- Hall of the Gods is built by GodService (Phase 3).
		{ "Arena Gate", "Phase 5", Vector3.new(-40, 1.2, 0), Color3.fromRGB(220, 80, 60) },
		{ "Titan Gate", "Phase 5", Vector3.new(-40, 1.2, 35), Color3.fromRGB(150, 70, 200) },
		{ "Divine Forge", "Phase 7", Vector3.new(40, 1.2, -35), Color3.fromRGB(255, 140, 40) },
		{ "Ascension Chamber", "Phase 6", Vector3.new(40, 1.2, 0), Color3.fromRGB(120, 200, 255) },
		{ "Olympus Market", "Phase 7", Vector3.new(40, 1.2, 35), Color3.fromRGB(120, 220, 120) },
	}
	for _, area in areas do
		local pad = WorldBuilder.MakePart(hub, {
			Name = area[1],
			Size = Vector3.new(14, 0.4, 14),
			Position = area[3],
			Material = Enum.Material.Neon,
			Color = area[4],
			Transparency = 0.35,
			CanCollide = false,
		})
		WorldBuilder.AddLabel(pad, area[1] .. "\n(coming in " .. area[2] .. ")", area[4], 5)
	end

	-- Path to the Temple District
	local path = WorldBuilder.MakePart(hub, {
		Name = "DistrictPath",
		Size = Vector3.new(16, 1, 100),
		Position = Vector3.new(0, 0.5, 120),
		Color = Color3.fromRGB(215, 205, 185),
	})
	WorldBuilder.AddLabel(path, "Temple District", GOLD, 6)

	-- Phase 4: Practice Field behind the spawn, for fighting before arenas exist.
	local field = CombatConfig.PracticeField
	local plazaEdge = -70
	local fieldNear = field.Center.Z + field.Size.Z / 2
	local practicePath = WorldBuilder.MakePart(hub, {
		Name = "PracticePath",
		Size = Vector3.new(16, 1, plazaEdge - fieldNear),
		Position = Vector3.new(0, 0.5, (plazaEdge + fieldNear) / 2),
		Color = Color3.fromRGB(215, 205, 185),
	})
	WorldBuilder.AddLabel(practicePath, "Practice Field", Color3.fromRGB(255, 140, 110), 6)
	local practiceFloor = WorldBuilder.MakePart(hub, {
		Name = "PracticeField",
		Size = field.Size,
		Position = field.Center - Vector3.new(0, 0.5, 0),
		Material = Enum.Material.Sandstone,
		Color = Color3.fromRGB(196, 170, 125),
	})
	WorldBuilder.AddLabel(practiceFloor, "Practice Field\n(arenas arrive in Phase 5)", Color3.fromRGB(255, 140, 110), 12)
	WorldBuilder.MakePart(hub, {
		Name = "PracticeSpawn",
		Size = Vector3.new(6, 0.2, 6),
		Position = Vector3.new(field.Center.X, field.Center.Y + 0.1, fieldNear - 6),
		Color = Color3.fromRGB(255, 140, 110),
		Material = Enum.Material.Neon,
		Transparency = 0.5,
		CanCollide = false,
	})

	hub.Parent = Workspace
end

local function buildPlots()
	local cfg = GameConfig.Plots
	local folder = Instance.new("Folder")
	folder.Name = "TemplePlots"

	for i = 1, cfg.Count do
		local row = math.floor((i - 1) / cfg.Columns)
		local col = (i - 1) % cfg.Columns

		local plot = Instance.new("Model")
		plot.Name = "Plot" .. i

		local base = WorldBuilder.MakePart(plot, {
			Name = "Base",
			Size = cfg.Size,
			Position = cfg.Origin + Vector3.new(col * cfg.Spacing, 0, row * cfg.Spacing),
			Material = Enum.Material.Sandstone,
			Color = Color3.fromRGB(205, 192, 160),
		})
		plot.PrimaryPart = base

		local sign = WorldBuilder.MakePart(plot, {
			Name = "Sign",
			Size = Vector3.new(1, 1, 1),
			Position = base.Position + Vector3.new(0, 1, -cfg.Size.Z / 2 + 3),
			Transparency = 1,
			CanCollide = false,
		})
		WorldBuilder.AddLabel(sign, "Unclaimed Temple", Color3.new(1, 1, 1), 8)

		local buildings = Instance.new("Folder")
		buildings.Name = "Buildings"
		buildings.Parent = plot

		plot:SetAttribute("PlotIndex", i)
		plot:SetAttribute("OwnerUserId", 0)
		plot.Parent = folder
	end

	folder.Parent = Workspace
end

function WorldBuilder.Build()
	if not Workspace:FindFirstChild("Hub") then
		buildHub()
	end
	if not Workspace:FindFirstChild("TemplePlots") then
		buildPlots()
	end
end

return WorldBuilder
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="51">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="52">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <token name="AvatarJointUpgrade_SerializedRollout">1</token>
    </Properties>
    <Item class="StarterCharacterScripts" referent="53">
      <Properties>
        <string name="Name">StarterCharacterScripts</string>
      </Properties>
      <Item class="Script" referent="54">
        <Properties>
          <string name="Name">Health</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Health (Script)
-- Location: StarterPlayer > StarterCharacterScripts > Health
--
-- Intentionally empty. A Script named "Health" here replaces Roblox's
-- built-in health regeneration, so CombatService can control regeneration
-- (delay after taking damage, and the Divine Fountain bonus).
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="StarterPlayerScripts" referent="55">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="56">
        <Properties>
          <string name="Name">AbilityController</string>
          <string name="Source"><![CDATA[-- AbilityController (LocalScript)
-- Location: StarterPlayer > StarterPlayerScripts > AbilityController
--
-- Phase 4B, the device side of god abilities:
--   * Ability buttons with cooldown countdowns. Touch screens: round buttons
--     around the Attack button. Keyboard/controller: a bar above the health bar.
--     Keys: Q, E, R, T (Form); controller L1, R1, Y, D-pad up.
--   * Only abilities whose blessing you have unlocked (for your current god) show.
--   * Plays your own ability animation immediately and asks the server to use it;
--     the server decides whether it happens and what it hits.
--   * Draws ability effects for everyone: lightning bolts, chain lightning,
--     shockwaves, the cleave arc, dash trails and auras.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local AbilityConfig = require(Shared:WaitForChild("AbilityConfig"))
local GodConfig = require(Shared:WaitForChild("GodConfig"))
local SwordAnimator = require(Shared:WaitForChild("SwordAnimator"))

local AimHelper = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("AimHelper"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local abilityRemote = Remotes:WaitForChild("UseAbility")
local fxRemote = Remotes:WaitForChild("CombatFX")

local SLOTS = AbilityConfig.SlotOrder

--------------------------------------------------------------------------
-- Which ability is in each slot right now
--------------------------------------------------------------------------
local function abilityForSlot(slot)
	local god = GodConfig.Gods[player:GetAttribute("SelectedGod") or ""]
	if not god then
		return nil
	end
	for _, blessing in god.Blessings do
		if blessing.Ability == slot then
			local level = player:GetAttribute("Blessing_" .. blessing.Id) or 0
			if level >= 1 then
				return blessing, AbilityConfig.Abilities[blessing.Id], level
			end
			return nil
		end
	end
	return nil
end

local function cooldownLeft(slot)
	return math.max(0, (player:GetAttribute("Cooldown_" .. slot) or 0) - Workspace:GetServerTimeNow())
end

local function alive()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0
end

local localReadyAt = {} -- stops double-presses before the server's answer arrives

local function useSlot(slot)
	if player:GetAttribute("DataLoaded") ~= true or not alive() or player:GetAttribute("Blocking") == true then
		return
	end
	local blessing, cfg = abilityForSlot(slot)
	if not blessing or not cfg then
		return
	end
	local now = os.clock()
	if cooldownLeft(slot) > 0.15 or now < (localReadyAt[slot] or 0) then
		return
	end
	localReadyAt[slot] = now + 0.5
	local character = player.Character
	local aim = AimHelper.FaceAim(character and character:FindFirstChild("HumanoidRootPart")) -- face the centre dot
	if cfg.Move then
		SwordAnimator.Play(player.Character, cfg.Move)
	end
	abilityRemote:FireServer(slot, aim)
end

--------------------------------------------------------------------------
-- Buttons
--------------------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "AbilityButtons"
gui.ResetOnSpawn = false
gui.Enabled = false
gui.Parent = playerGui

local buttons = {}

local function makeButton(slot)
	local b = Instance.new("TextButton")
	b.Name = slot
	b.AnchorPoint = Vector2.new(0.5, 0.5)
	b.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
	b.BackgroundTransparency = 0.2
	b.Text = ""
	b.AutoButtonColor = false
	b.Visible = false
	b.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = b
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = b

	-- Dark cover that shrinks as the cooldown runs out.
	local cover = Instance.new("Frame")
	cover.Name = "Cooldown"
	cover.AnchorPoint = Vector2.new(0.5, 1)
	cover.Position = UDim2.fromScale(0.5, 1)
	cover.Size = UDim2.fromScale(1, 0)
	cover.BackgroundColor3 = Color3.new(0, 0, 0)
	cover.BackgroundTransparency = 0.45
	cover.ZIndex = 2
	cover.Parent = b
	local coverCorner = Instance.new("UICorner")
	coverCorner.CornerRadius = UDim.new(1, 0)
	coverCorner.Parent = cover

	local name = Instance.new("TextLabel")
	name.Name = "AbilityName"
	name.AnchorPoint = Vector2.new(0.5, 0.5)
	name.Position = UDim2.fromScale(0.5, 0.5)
	name.Size = UDim2.fromScale(0.86, 0.5)
	name.BackgroundTransparency = 1
	name.Font = Enum.Font.GothamBold
	name.TextScaled = true
	name.TextColor3 = Color3.new(1, 1, 1)
	name.TextStrokeTransparency = 0.4
	name.ZIndex = 3
	name.Parent = b

	local key = Instance.new("TextLabel")
	key.Name = "Key"
	key.AnchorPoint = Vector2.new(0.5, 0)
	key.Position = UDim2.fromScale(0.5, 0.04)
	key.Size = UDim2.fromScale(0.5, 0.22)
	key.BackgroundTransparency = 1
	key.Font = Enum.Font.GothamBlack
	key.TextScaled = true
	key.TextColor3 = Color3.fromRGB(255, 230, 150)
	key.TextStrokeTransparency = 0.4
	key.Text = AbilityConfig.KeyLabels[slot]
	key.ZIndex = 3
	key.Parent = b

	local timer = Instance.new("TextLabel")
	timer.Name = "Timer"
	timer.AnchorPoint = Vector2.new(0.5, 1)
	timer.Position = UDim2.fromScale(0.5, 0.96)
	timer.Size = UDim2.fromScale(0.6, 0.26)
	timer.BackgroundTransparency = 1
	timer.Font = Enum.Font.GothamBlack
	timer.TextScaled = true
	timer.TextColor3 = Color3.new(1, 1, 1)
	timer.TextStrokeTransparency = 0.2
	timer.Text = ""
	timer.ZIndex = 4
	timer.Parent = b

	b.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			useSlot(slot)
		end
	end)
	buttons[slot] = { Button = b, Stroke = stroke, Cover = cover, Name = name, Key = key, Timer = timer }
end
for _, slot in SLOTS do
	makeButton(slot)
end

-- Short names that fit on a round button.
local function shortName(blessingName)
	local words = string.split(blessingName, " ")
	if #words >= 3 then
		return words[1] .. "\n" .. words[2]
	end
	return table.concat(words, "\n")
end

local function layout()
	local camera = Workspace.CurrentCamera
	local viewport = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	local touch = UserInputService.TouchEnabled
	for _, b in buttons do
		b.Key.Visible = not touch
	end
	if touch then
		-- Same jump-button geometry as the Attack/Block/Dash buttons.
		local big = math.min(viewport.X, viewport.Y) > 500
		local jumpSize = if big then 120 else 70
		local jumpLeft = if big then 170 else 95
		local jumpTop = if big then 210 else 90
		local jumpCenterY = jumpTop - jumpSize / 2
		local gap = if big then 16 else 10
		local attackSize = math.floor(jumpSize * 1.05)
		local size = math.floor(jumpSize * 0.75)
		local attackX = jumpLeft + gap + attackSize / 2 -- distance from the right edge
		local qX = attackX + attackSize / 2 + gap + size / 2
		local rX = qX + size + gap
		local lowY = jumpCenterY
		local highY = jumpCenterY + size + gap
		local spots = { Q = { qX, lowY }, E = { qX, highY }, R = { rX, lowY }, Form = { rX, highY } }
		for slot, b in buttons do
			b.Button.Size = UDim2.fromOffset(size, size)
			b.Button.Position = UDim2.new(1, -spots[slot][1], 1, -spots[slot][2])
		end
	else
		-- A bar above the health bar (bottom centre).
		local size = 68
		local gap = 12
		local total = #SLOTS * size + (#SLOTS - 1) * gap
		for i, slot in SLOTS do
			local b = buttons[slot].Button
			b.Size = UDim2.fromOffset(size, size)
			b.Position = UDim2.new(0.5, -total / 2 + (i - 1) * (size + gap) + size / 2, 1, -(24 + 24 + 14 + size / 2))
		end
	end
end
layout()
if Workspace.CurrentCamera then
	Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(layout)
end

local function refresh()
	local god = GodConfig.Gods[player:GetAttribute("SelectedGod") or ""]
	local color = if god then god.Colors.Primary else Color3.fromRGB(212, 175, 55)
	for slot, b in buttons do
		local blessing = abilityForSlot(slot)
		b.Button.Visible = blessing ~= nil
		if blessing then
			b.Name.Text = shortName(blessing.Name)
			b.Stroke.Color = color
		end
	end
	gui.Enabled = player:GetAttribute("DataLoaded") == true
end

local watched = { "SelectedGod", "DataLoaded" }
for blessingId in GodConfig.BlessingsById do
	table.insert(watched, "Blessing_" .. blessingId)
end
for _, attribute in watched do
	player:GetAttributeChangedSignal(attribute):Connect(refresh)
end
refresh()

-- Cooldown countdowns
task.spawn(function()
	while true do
		task.wait(0.1)
		for slot, b in buttons do
			if b.Button.Visible then
				local _, cfg = abilityForSlot(slot)
				local left = cooldownLeft(slot)
				local total = if cfg then cfg.Cooldown else 1
				b.Cover.Size = UDim2.fromScale(1, math.clamp(left / total, 0, 1))
				b.Timer.Text = if left > 0.05 then tostring(math.ceil(left)) else ""
			end
		end
	end
end)

-- Keyboard and controller keys (touch uses the buttons above).
for _, slot in SLOTS do
	ContextActionService:BindAction("OlympusAbility" .. slot, function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			useSlot(slot)
		end
		return Enum.ContextActionResult.Pass
	end, false, table.unpack(AbilityConfig.Keys[slot]))
end

--------------------------------------------------------------------------
-- Effects (drawn on this device)
--------------------------------------------------------------------------
local fxFolder = Workspace:FindFirstChild("ClientEffects") or Instance.new("Folder")
fxFolder.Name = "ClientEffects"
fxFolder.Parent = Workspace

local function effectPart(props)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	for key, value in props do
		part[key] = value
	end
	part.Parent = fxFolder
	return part
end

local function fadeOut(part, time)
	TweenService:Create(part, TweenInfo.new(time), { Transparency = 1 }):Play()
	Debris:AddItem(part, time + 0.05)
end

-- A jagged lightning bolt from a to b.
local function bolt(a, b, color, thickness, life)
	local segments = math.max(3, math.floor((b - a).Magnitude / 4))
	local points = { a }
	for i = 1, segments - 1 do
		local t = i / segments
		local jitter = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 3
		table.insert(points, a:Lerp(b, t) + jitter)
	end
	table.insert(points, b)
	for i = 1, #points - 1 do
		local p0, p1 = points[i], points[i + 1]
		local length = (p1 - p0).Magnitude
		local seg = effectPart({
			Size = Vector3.new(thickness, thickness, length),
			CFrame = CFrame.lookAt((p0 + p1) / 2, p1),
			Color = color,
		})
		fadeOut(seg, life)
	end
end

local function lightFlash(position, color, range)
	local holder = effectPart({ Size = Vector3.new(0.2, 0.2, 0.2), Transparency = 1, Position = position })
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = 4
	light.Parent = holder
	TweenService:Create(light, TweenInfo.new(0.35), { Brightness = 0 }):Play()
	Debris:AddItem(holder, 0.4)
end

local function groundY(position)
	return position.Y - 2.9 -- character roots sit about 3 studs above the ground
end

local function shockwave(position, color, radius)
	local ring = effectPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 2, 2),
		CFrame = CFrame.new(position.X, groundY(position), position.Z) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Transparency = 0.25,
	})
	TweenService:Create(ring, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.3, radius * 2, radius * 2),
		Transparency = 1,
	}):Play()
	Debris:AddItem(ring, 0.45)
end

local function sparks(position, color, count)
	local holder = effectPart({ Size = Vector3.new(0.2, 0.2, 0.2), Transparency = 1, Position = position })
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 1
	emitter.Lifetime = NumberRange.new(0.3, 0.6)
	emitter.Speed = NumberRange.new(8, 18)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new(0.45, 0)
	emitter.Rate = 0
	emitter.Parent = holder
	emitter:Emit(count)
	Debris:AddItem(holder, 1)
end

local auras = {}

local function aura(character, color, duration)
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	if auras[character] then
		auras[character]:Destroy()
	end
	local attachment = Instance.new("Attachment")
	attachment.Name = "AbilityAura"
	attachment.Parent = root
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 1
	emitter.Lifetime = NumberRange.new(0.5, 0.9)
	emitter.Rate = 30
	emitter.Speed = NumberRange.new(2, 4)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Acceleration = Vector3.new(0, 6, 0)
	emitter.Size = NumberSequence.new(0.5, 0)
	emitter.Parent = attachment
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 12
	light.Brightness = 2
	light.Parent = attachment
	auras[character] = attachment
	task.delay(duration, function()
		if auras[character] == attachment then
			auras[character] = nil
		end
		attachment:Destroy()
	end)
end

fxRemote.OnClientEvent:Connect(function(kind, position, color, extra, extra2)
	if typeof(color) ~= "Color3" then
		return
	end
	if kind == "Lightning" then
		local radius = if typeof(extra) == "number" then extra else 4
		if extra2 == true then
			-- A straight beam from the sky (sunbeams).
			local top = position + Vector3.new(0, 45, 0)
			local beam = effectPart({ Size = Vector3.new(1.6, 1.6, 45), CFrame = CFrame.lookAt((top + position) / 2, position), Color = color, Transparency = 0.2 })
			TweenService:Create(beam, TweenInfo.new(0.4), { Transparency = 1, Size = Vector3.new(0.3, 0.3, 45) }):Play()
			Debris:AddItem(beam, 0.45)
		else
			bolt(position + Vector3.new(math.random(-4, 4), 45, math.random(-4, 4)), position, color, 0.6, 0.3)
		end
		lightFlash(position, color, 24)
		sparks(position, color, 20)
		shockwave(position, color, radius)
	elseif kind == "Chain" and type(extra) == "table" then
		for i = 1, #extra - 1 do
			if typeof(extra[i]) == "Vector3" and typeof(extra[i + 1]) == "Vector3" then
				bolt(extra[i], extra[i + 1], color, 0.4, 0.35)
				sparks(extra[i + 1], color, 10)
			end
		end
		lightFlash(position, color, 16)
	elseif kind == "Shockwave" then
		shockwave(position, color, if typeof(extra) == "number" then extra else 10)
		sparks(position, color, 16)
	elseif kind == "Cleave" and typeof(extra) == "Vector3" then
		local look = Vector3.new(extra.X, 0, extra.Z).Unit
		local range = if typeof(extra2) == "number" then extra2 else 10
		local base = CFrame.lookAt(position, position + look)
		for i = -5, 5 do
			local angle = math.rad(i * 18)
			local spot = (base * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -range * 0.75)).Position
			local piece = effectPart({
				Size = Vector3.new(range * 0.32, 0.25, 0.6),
				CFrame = CFrame.lookAt(spot, position) * CFrame.Angles(0, math.rad(90), 0),
				Color = color,
				Transparency = 0.15,
			})
			task.delay((i + 5) * 0.012, function()
				fadeOut(piece, 0.3)
			end)
		end
		sparks(position + look * range * 0.6, color, 18)
	elseif kind == "DashTrail" and typeof(extra) == "Vector3" then
		bolt(position, extra, color, 0.5, 0.4)
		bolt(position + Vector3.new(0, 1, 0), extra + Vector3.new(0, 1, 0), color, 0.3, 0.3)
		sparks(extra, color, 14)
	elseif kind == "Beam" and typeof(extra) == "Vector3" then
		-- A straight blast (water, spear, sunlight arrow).
		local width = if typeof(extra2) == "number" then extra2 else 2
		local length = (extra - position).Magnitude
		local beam = effectPart({ Size = Vector3.new(width * 0.6, width * 0.6, length), CFrame = CFrame.lookAt((position + extra) / 2, extra), Color = color, Transparency = 0.15 })
		TweenService:Create(beam, TweenInfo.new(0.35), { Transparency = 1, Size = Vector3.new(0.2, 0.2, length) }):Play()
		Debris:AddItem(beam, 0.4)
		sparks(extra, color, 12)
	elseif kind == "Vortex" then
		-- A spinning ring for the whirlpool's duration.
		local radius = if typeof(extra) == "number" then extra else 10
		local life = if typeof(extra2) == "number" then extra2 else 2.5
		local ring = effectPart({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.4, radius * 2, radius * 2),
			CFrame = CFrame.new(position.X, groundY(position) + 0.2, position.Z) * CFrame.Angles(0, 0, math.rad(90)),
			Color = color,
			Transparency = 0.45,
		})
		local inner = effectPart({
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.5, radius, radius),
			CFrame = ring.CFrame,
			Color = Color3.new(1, 1, 1),
			Transparency = 0.6,
		})
		local spin = Instance.new("NumberValue")
		spin.Changed:Connect(function(angle)
			inner.CFrame = CFrame.new(position.X, groundY(position) + 0.25, position.Z) * CFrame.Angles(math.rad(angle), 0, math.rad(90))
		end)
		TweenService:Create(spin, TweenInfo.new(life), { Value = 720 }):Play()
		TweenService:Create(inner, TweenInfo.new(life, Enum.EasingStyle.Linear), { Size = Vector3.new(0.5, 1, 1) }):Play()
		task.delay(life - 0.3, function()
			fadeOut(ring, 0.3)
			fadeOut(inner, 0.3)
		end)
		Debris:AddItem(spin, life + 0.1)
	elseif kind == "Wave" and typeof(extra) == "Vector3" then
		-- A wall of water rushing forward.
		local look = Vector3.new(extra.X, 0, extra.Z).Unit
		local range = if typeof(extra2) == "number" then extra2 else 20
		local base = CFrame.lookAt(position, position + look)
		local wall = effectPart({ Size = Vector3.new(6, 5, 1.5), CFrame = base * CFrame.new(0, 0, -2), Color = color, Transparency = 0.25 })
		TweenService:Create(wall, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			CFrame = base * CFrame.new(0, 0, -range),
			Size = Vector3.new(range * 1.1, 7, 1.5),
			Transparency = 0.9,
		}):Play()
		Debris:AddItem(wall, 0.55)
		sparks(position + look * range * 0.6, color, 25)
	elseif kind == "Dome" then
		-- A see-through shield dome.
		local radius = if typeof(extra) == "number" then extra else 12
		local life = if typeof(extra2) == "number" then extra2 else 5
		local dome = effectPart({
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(2, 2, 2),
			Position = position,
			Material = Enum.Material.ForceField,
			Color = color,
			Transparency = 0,
		})
		TweenService:Create(dome, TweenInfo.new(0.3), { Size = Vector3.new(radius * 2, radius * 2, radius * 2) }):Play()
		task.delay(life - 0.4, function()
			fadeOut(dome, 0.4)
		end)
	elseif kind == "HealBurst" then
		local radius = if typeof(extra) == "number" then extra else 15
		shockwave(position, Color3.fromRGB(120, 255, 140), radius)
		sparks(position + Vector3.new(0, 2, 0), color, 30)
		lightFlash(position, color, 20)
	elseif kind == "Aura" and typeof(extra) == "Instance" and extra:IsA("Player") then
		aura(extra.Character, color, if typeof(extra2) == "number" then extra2 else 10)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="57">
        <Properties>
          <string name="Name">AimDot</string>
          <string name="Source"><![CDATA[-- AimDot (LocalScript)
-- Location: StarterPlayer > StarterPlayerScripts > AimDot
--
-- A small white dot fixed in the centre of the screen. In a fighting area your
-- attacks (swings, arrows, abilities) go where it points: the character turns
-- to face it as you attack (see Shared/AimHelper).
-- Only shown when a weapon is in your hand AND you are in a fighting area
-- (an arena / trial / challenge run, or on the Practice Field).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local AimHelper = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("AimHelper"))

local DOT_SIZE = 10

local gui = Instance.new("ScreenGui")
gui.Name = "AimDot"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true -- true centre of the screen
gui.DisplayOrder = 5
gui.Parent = player:WaitForChild("PlayerGui")

local dot = Instance.new("Frame")
dot.AnchorPoint = Vector2.new(0.5, 0.5)
dot.Position = UDim2.fromScale(0.5, 0.5)
dot.Size = UDim2.fromOffset(DOT_SIZE, DOT_SIZE)
dot.BackgroundColor3 = Color3.new(1, 1, 1)
dot.BorderSizePixel = 0
dot.Visible = false
dot.Parent = gui
local round = Instance.new("UICorner")
round.CornerRadius = UDim.new(0.5, 0)
round.Parent = dot
local outline = Instance.new("UIStroke") -- thin dark edge so it shows on white marble too
outline.Color = Color3.new(0, 0, 0)
outline.Transparency = 0.5
outline.Thickness = 1
outline.Parent = dot

RunService.RenderStepped:Connect(function()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	dot.Visible = root ~= nil and humanoid ~= nil and humanoid.Health > 0
		and character:FindFirstChild("DivineSword") ~= nil and AimHelper.InFightingArea(root)
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="58">
        <Properties>
          <string name="Name">ArenaUI</string>
          <string name="Source"><![CDATA[-- ArenaUI (LocalScript)
-- Location: StarterPlayer > StarterPlayerScripts > ArenaUI
--
-- Phase 5 interface:
--   * Arena Gate menu: arenas with level ranges / lock reasons, Fight Solo,
--     Join Party, and the party list with Start / Leave.
--   * During a run: wave and enemies-left tracker, countdowns, boss health bar,
--     and a Leave button.
--   * Results screen (victory or defeat) with rewards.
-- Display only: the server runs the arena and decides everything.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ArenaConfig = require(Shared:WaitForChild("ArenaConfig"))
local Progression = require(Shared:WaitForChild("Progression"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local actionRemote = Remotes:WaitForChild("ArenaAction")
local eventRemote = Remotes:WaitForChild("ArenaEvent")
local notifyRemote = Remotes:WaitForChild("Notify")

local THEME = {
	Marble = Color3.fromRGB(246, 242, 232),
	MarbleDark = Color3.fromRGB(228, 220, 204),
	Gold = Color3.fromRGB(212, 175, 55),
	Bronze = Color3.fromRGB(140, 92, 45),
	Text = Color3.fromRGB(58, 44, 28),
	SubText = Color3.fromRGB(110, 95, 75),
	White = Color3.new(1, 1, 1),
	Ready = Color3.fromRGB(70, 150, 70),
	Party = Color3.fromRGB(70, 110, 180),
	Locked = Color3.fromRGB(130, 130, 140),
	Danger = Color3.fromRGB(190, 50, 40),
}
local TITLE_FONT = Enum.Font.Garamond
local BODY_FONT = Enum.Font.GothamBold
local SMALL_FONT = Enum.Font.Gotham

--------------------------------------------------------------------------
-- Small UI helpers
--------------------------------------------------------------------------
local function create(className, props, children)
	local inst = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			inst[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end
local function corner(r)
	return create("UICorner", { CornerRadius = UDim.new(0, r) })
end
local function stroke(color, thickness)
	return create("UIStroke", { Color = color, Thickness = thickness, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end
local function padding(px)
	return create("UIPadding", { PaddingTop = UDim.new(0, px), PaddingBottom = UDim.new(0, px), PaddingLeft = UDim.new(0, px), PaddingRight = UDim.new(0, px) })
end
local function text(props)
	props.BackgroundTransparency = 1
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	props.TextColor3 = props.TextColor3 or THEME.Text
	props.Font = props.Font or SMALL_FONT
	return create("TextLabel", props)
end
local function button(props)
	props.AutoButtonColor = true
	props.Font = props.Font or BODY_FONT
	props.TextColor3 = props.TextColor3 or THEME.White
	props.TextSize = props.TextSize or 15
	return create("TextButton", props, { corner(8) })
end

local gui = create("ScreenGui", { Name = "ArenaUI", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 7, Parent = playerGui })
local uiScale = create("UIScale", { Parent = gui })
local function updateScale()
	local camera = Workspace.CurrentCamera
	local viewport = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	uiScale.Scale = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720), 0.7, 1.2)
end
updateScale()
if Workspace.CurrentCamera then
	Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
end

local function serverNow()
	return Workspace:GetServerTimeNow()
end

--------------------------------------------------------------------------
-- 1. Arena Gate menu
--------------------------------------------------------------------------
local menu = create("Frame", {
	Name = "Menu",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(640, 500),
	BackgroundColor3 = THEME.Marble,
	Visible = false,
	Parent = gui,
}, { corner(12), stroke(Color3.fromRGB(230, 90, 50), 3), padding(14) })
text({ Size = UDim2.new(1, -50, 0, 36), Font = TITLE_FONT, TextSize = 34, Text = "Arena Gate", Parent = menu })
local closeMenu = button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromOffset(40, 40), BackgroundColor3 = THEME.Bronze, Text = "X", TextSize = 20, Parent = menu })
text({ Position = UDim2.fromOffset(0, 38), Size = UDim2.new(1, 0, 0, 18), TextSize = 14, TextColor3 = THEME.SubText, Text = "5 waves, a boss in the last one. Fight alone or with up to 4 players.", Parent = menu })

local partyBar = create("Frame", {
	Name = "Party",
	AnchorPoint = Vector2.new(0, 1),
	Position = UDim2.fromScale(0, 1),
	Size = UDim2.new(1, 0, 0, 56),
	BackgroundColor3 = Color3.fromRGB(215, 225, 240),
	Visible = false,
	Parent = menu,
}, { corner(8), padding(8) })
local partyLabel = text({ Size = UDim2.new(1, -240, 1, 0), Font = BODY_FONT, TextSize = 14, TextWrapped = true, Text = "", Parent = partyBar })
local startParty = button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -112, 0.5, 0), Size = UDim2.fromOffset(110, 40), BackgroundColor3 = THEME.Ready, Text = "Start", Parent = partyBar })
local leaveParty = button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(104, 40), BackgroundColor3 = THEME.Bronze, Text = "Leave party", Parent = partyBar })

local list = create("ScrollingFrame", {
	Position = UDim2.fromOffset(0, 64),
	Size = UDim2.new(1, 0, 1, -64),
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	ScrollBarThickness = 6,
	ScrollBarImageColor3 = THEME.Bronze,
	CanvasSize = UDim2.new(),
	AutomaticCanvasSize = Enum.AutomaticSize.Y,
	Parent = menu,
}, { create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }), create("UIPadding", { PaddingRight = UDim.new(0, 10) }) })

local rows = {}
for order, arena in ArenaConfig.Arenas do
	local row = create("Frame", { Size = UDim2.new(1, 0, 0, 72), BackgroundColor3 = THEME.MarbleDark, LayoutOrder = order, Parent = list }, { corner(8), padding(8) })
	text({ Size = UDim2.new(1, -240, 0, 22), Font = BODY_FONT, TextSize = 17, TextColor3 = arena.Color or THEME.Text, Text = arena.DisplayName, Parent = row })
	text({ Position = UDim2.fromOffset(0, 22), Size = UDim2.new(1, -240, 0, 18), TextSize = 13, TextColor3 = THEME.SubText, Text = ("Levels %d-%d · %s"):format(arena.MinLevel, arena.MaxLevel, arena.Description), TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
	local status = text({ Position = UDim2.fromOffset(0, 42), Size = UDim2.new(1, -240, 0, 16), Font = BODY_FONT, TextSize = 13, TextColor3 = THEME.Danger, Text = "", Parent = row })
	local solo = button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -116, 0.5, 0), Size = UDim2.fromOffset(110, 44), BackgroundColor3 = THEME.Ready, Text = "Fight Solo", Parent = row })
	local party = button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(110, 44), BackgroundColor3 = THEME.Party, Text = "Join Party", Parent = row })
	solo.Activated:Connect(function()
		if not ArenaConfig.LockReason(arena, player:GetAttribute("Level") or 1, player:GetAttribute("RankIndex") or 1) then
			actionRemote:FireServer("StartSolo", arena.Id)
			menu.Visible = false
		end
	end)
	party.Activated:Connect(function()
		if not ArenaConfig.LockReason(arena, player:GetAttribute("Level") or 1, player:GetAttribute("RankIndex") or 1) then
			actionRemote:FireServer("JoinQueue", arena.Id)
		end
	end)
	rows[arena.Id] = { Arena = arena, Status = status, Solo = solo, Party = party }
end

local function refreshMenu()
	local level = player:GetAttribute("Level") or 1
	for _, r in rows do
		local reason = ArenaConfig.LockReason(r.Arena, level, player:GetAttribute("RankIndex") or 1)
		r.Status.Text = if reason then "Locked: " .. reason else ""
		r.Solo.Visible = reason == nil
		r.Party.Visible = reason == nil
	end
end
player:GetAttributeChangedSignal("Level"):Connect(refreshMenu)
refreshMenu()

closeMenu.Activated:Connect(function()
	menu.Visible = false
end)
startParty.Activated:Connect(function()
	actionRemote:FireServer("StartParty")
	menu.Visible = false
end)
leaveParty.Activated:Connect(function()
	actionRemote:FireServer("LeaveQueue")
end)

--------------------------------------------------------------------------
-- 2. In-run tracker and boss bar (top centre)
--------------------------------------------------------------------------
local tracker = create("Frame", {
	Name = "Tracker",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 8),
	Size = UDim2.fromOffset(420, 64),
	BackgroundColor3 = THEME.Marble,
	BackgroundTransparency = 0.05,
	Visible = false,
	Parent = gui,
}, { corner(10), stroke(THEME.Gold, 2), padding(8) })
local trackerTitle = text({ Size = UDim2.new(1, -90, 0, 22), Font = TITLE_FONT, TextSize = 22, Text = "", Parent = tracker })
local trackerStatus = text({ Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, -90, 0, 22), Font = BODY_FONT, TextSize = 16, Text = "", Parent = tracker })
local leaveButton = button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromOffset(80, 40), BackgroundColor3 = THEME.Danger, Text = "Leave", Parent = tracker })
leaveButton.Activated:Connect(function()
	actionRemote:FireServer("Leave")
end)

local bossFrame = create("Frame", {
	Name = "Boss",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 80),
	Size = UDim2.fromOffset(520, 46),
	BackgroundTransparency = 1,
	Visible = false,
	Parent = gui,
})
local bossName = text({ Size = UDim2.new(1, 0, 0, 20), Font = TITLE_FONT, TextSize = 22, TextColor3 = THEME.White, TextStrokeTransparency = 0.3, TextXAlignment = Enum.TextXAlignment.Center, Text = "", Parent = bossFrame })
local bossBack = create("Frame", { Position = UDim2.fromOffset(0, 22), Size = UDim2.new(1, 0, 0, 20), BackgroundColor3 = Color3.fromRGB(40, 25, 25), Parent = bossFrame }, { corner(6), stroke(THEME.Gold, 2) })
local bossFill = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(200, 60, 45), Parent = bossBack }, { corner(6) })
local bossHp = text({ Size = UDim2.fromScale(1, 1), Font = BODY_FONT, TextSize = 13, TextColor3 = THEME.White, TextStrokeTransparency = 0.4, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 2, Text = "", Parent = bossBack })

local function findBoss(runId)
	local enemies = Workspace:FindFirstChild("Enemies")
	if not enemies then
		return nil
	end
	for _, model in enemies:GetChildren() do
		if model:GetAttribute("IsBoss") and model:GetAttribute("RunId") == runId then
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			if humanoid and humanoid.Health > 0 then
				return model, humanoid
			end
		end
	end
	return nil
end

local function updateTracker()
	local runId = player:GetAttribute("ArenaRunId")
	tracker.Visible = runId ~= nil
	if not runId then
		bossFrame.Visible = false
		return
	end
	local state = player:GetAttribute("ArenaState") or ""
	local wave = player:GetAttribute("ArenaWave") or 0
	local waves = player:GetAttribute("ArenaWaves") or 5
	local left = player:GetAttribute("ArenaEnemiesLeft") or 0
	local timer = math.max(0, math.ceil((player:GetAttribute("ArenaTimerEnd") or 0) - serverNow()))
	trackerTitle.Text = player:GetAttribute("ArenaName") or "Arena"
	if state == "Countdown" then
		trackerStatus.Text = ("Get ready... %d"):format(timer)
	elseif state == "Fighting" then
		trackerStatus.Text = ("Wave %d / %d   ·   Enemies left: %d"):format(wave, waves, left)
	elseif state == "Intermission" then
		trackerStatus.Text = ("Wave %d cleared! Next wave in %d"):format(wave, timer)
	elseif state == "Victory" then
		trackerStatus.Text = ("Victory! Returning in %d"):format(timer)
	elseif state == "Failed" then
		trackerStatus.Text = ("Defeated. Returning in %d"):format(timer)
	end

	local boss, humanoid = findBoss(runId)
	bossFrame.Visible = boss ~= nil
	if boss then
		local enraged = boss:GetAttribute("Enraged") == true
		bossName.Text = (boss:GetAttribute("DisplayName") or boss.Name) .. (if enraged then "  (ENRAGED)" else "")
		bossFill.BackgroundColor3 = if enraged then Color3.fromRGB(235, 40, 30) else Color3.fromRGB(200, 60, 45)
		bossFill.Size = UDim2.fromScale(math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1), 1)
		bossHp.Text = ("%s / %s"):format(Progression.FormatNumber(math.ceil(humanoid.Health)), Progression.FormatNumber(humanoid.MaxHealth))
	end
end

task.spawn(function()
	while true do
		task.wait(0.1)
		updateTracker()
	end
end)

--------------------------------------------------------------------------
-- 3. Results screen
--------------------------------------------------------------------------
local results = create("Frame", {
	Name = "Results",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(440, 340),
	BackgroundColor3 = THEME.Marble,
	Visible = false,
	ZIndex = 5,
	Parent = gui,
}, { corner(14), padding(16) })
local resultsStroke = stroke(THEME.Gold, 4)
resultsStroke.Parent = results
local resultsTitle = text({ Size = UDim2.new(1, 0, 0, 50), Font = TITLE_FONT, TextSize = 46, TextXAlignment = Enum.TextXAlignment.Center, Text = "", Parent = results })
local resultsInfo = text({ Position = UDim2.fromOffset(0, 54), Size = UDim2.new(1, 0, 0, 40), TextSize = 15, TextColor3 = THEME.SubText, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center, Text = "", Parent = results })
local resultsRewards = text({ Position = UDim2.fromOffset(0, 100), Size = UDim2.new(1, 0, 0, 130), Font = BODY_FONT, TextSize = 19, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top, Text = "", Parent = results })
local homeButton = button({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 1), Size = UDim2.fromOffset(220, 48), BackgroundColor3 = THEME.Gold, TextColor3 = THEME.Text, TextSize = 18, Text = "Return to Olympus", ZIndex = 6, Parent = results })
homeButton.Activated:Connect(function()
	results.Visible = false
	actionRemote:FireServer("Leave")
end)

local REWARD_NAMES = { XP = "XP", Gold = "Gold", DivineFavor = "Divine Favor", Ambrosia = "Ambrosia" }
local REWARD_ORDER = { "XP", "Gold", "DivineFavor", "Ambrosia" }

--------------------------------------------------------------------------
-- Server events
--------------------------------------------------------------------------
eventRemote.OnClientEvent:Connect(function(kind, a, b)
	if kind == "Queue" then
		local arena = a and ArenaConfig.ById[a]
		partyBar.Visible = arena ~= nil
		if arena then
			partyLabel.Text = ("Party for %s (%d/%d): %s"):format(arena.DisplayName, #b, ArenaConfig.Party.MaxPlayers, table.concat(b, ", "))
		end
	elseif kind == "Result" and type(a) == "table" then
		local victory = a.Victory == true
		resultsTitle.Text = if victory then "VICTORY!" else "DEFEATED"
		resultsTitle.TextColor3 = if victory then THEME.Gold else THEME.Danger
		resultsStroke.Color = if victory then THEME.Gold else THEME.Danger
		local seconds = tonumber(a.Seconds) or 0
		resultsInfo.Text = ("%s · waves cleared %d/%d · time %d:%02d"):format(tostring(a.Arena), a.WavesCleared or 0, a.Waves or 5, seconds // 60, seconds % 60)
		local lines = {}
		for _, key in REWARD_ORDER do
			local value = type(a.Rewards) == "table" and a.Rewards[key]
			if value and value > 0 then
				table.insert(lines, ("+%s %s"):format(Progression.FormatNumber(value), REWARD_NAMES[key]))
			end
		end
		if type(a.Weapons) == "table" then
			for _, name in a.Weapons do
				table.insert(lines, "Weapon: " .. tostring(name))
			end
		end
		resultsRewards.Text = if #lines > 0 then table.concat(lines, "\n") else "No rewards this time.\nClear more waves for a bigger share!"
		results.Visible = true
		task.delay(ArenaConfig.ReturnDelay + 1, function()
			results.Visible = false
		end)
	end
end)

notifyRemote.OnClientEvent:Connect(function(kind)
	if kind == "OpenArenaMenu" then
		refreshMenu()
		menu.Visible = true
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="59">
        <Properties>
          <string name="Name">AscensionUI</string>
          <string name="Source"><![CDATA[-- AscensionUI (LocalScript)
-- Location: StarterPlayer > StarterPlayerScripts > AscensionUI
--
-- Phase 6 interface:
--   * Ascension screen (from the altar in the Ascension Chamber): all 8 ranks
--     with what each one gives, your next trial, its requirements, and the
--     "Begin Trial" button.
--   * Lights up the chamber's rank pillars you have reached (on your screen).
--   * The rank-up effect: a pillar of light and a burst, seen by everyone.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local Progression = require(Shared:WaitForChild("Progression"))
local AscensionConfig = require(Shared:WaitForChild("AscensionConfig"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local ascensionRemote = Remotes:WaitForChild("AscensionAction")
local notifyRemote = Remotes:WaitForChild("Notify")
local fxRemote = Remotes:WaitForChild("CombatFX")

local THEME = {
	Marble = Color3.fromRGB(246, 242, 232),
	MarbleDark = Color3.fromRGB(228, 220, 204),
	Gold = Color3.fromRGB(212, 175, 55),
	Bronze = Color3.fromRGB(140, 92, 45),
	Text = Color3.fromRGB(58, 44, 28),
	SubText = Color3.fromRGB(110, 95, 75),
	White = Color3.new(1, 1, 1),
	Ready = Color3.fromRGB(70, 150, 70),
	Locked = Color3.fromRGB(130, 130, 140),
	Sky = Color3.fromRGB(120, 200, 255),
}

local function create(className, props, children)
	local inst = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			inst[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end
local function corner(r)
	return create("UICorner", { CornerRadius = UDim.new(0, r) })
end
local function stroke(color, t)
	return create("UIStroke", { Color = color, Thickness = t, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end
local function padding(px)
	return create("UIPadding", { PaddingTop = UDim.new(0, px), PaddingBottom = UDim.new(0, px), PaddingLeft = UDim.new(0, px), PaddingRight = UDim.new(0, px) })
end
local function text(props)
	props.BackgroundTransparency = 1
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	props.TextColor3 = props.TextColor3 or THEME.Text
	props.Font = props.Font or Enum.Font.Gotham
	return create("TextLabel", props)
end

local gui = create("ScreenGui", { Name = "AscensionUI", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 8, Parent = playerGui })
local uiScale = create("UIScale", { Parent = gui })
local function updateScale()
	local camera = Workspace.CurrentCamera
	local viewport = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	uiScale.Scale = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720), 0.7, 1.2)
end
updateScale()
if Workspace.CurrentCamera then
	Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
end

--------------------------------------------------------------------------
-- Panel
--------------------------------------------------------------------------
local panel = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(660, 520),
	BackgroundColor3 = THEME.Marble,
	Visible = false,
	Parent = gui,
}, { corner(12), stroke(THEME.Sky, 3), padding(14) })
text({ Size = UDim2.new(1, -50, 0, 36), Font = Enum.Font.Garamond, TextSize = 34, Text = "Ascension", Parent = panel })
local closeButton = create("TextButton", {
	AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromOffset(40, 40),
	BackgroundColor3 = THEME.Bronze, Text = "X", Font = Enum.Font.GothamBold, TextSize = 20, TextColor3 = THEME.White, Parent = panel,
}, { corner(8) })

-- Next trial box
local trialBox = create("Frame", {
	Position = UDim2.fromOffset(0, 44),
	Size = UDim2.new(1, 0, 0, 104),
	BackgroundColor3 = Color3.fromRGB(222, 236, 248),
	Parent = panel,
}, { corner(10), padding(10) })
local trialTitle = text({ Size = UDim2.new(1, -170, 0, 24), Font = Enum.Font.GothamBold, TextSize = 18, Text = "", Parent = trialBox })
local trialDesc = text({ Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, -170, 0, 36), TextSize = 14, TextColor3 = THEME.SubText, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Text = "", Parent = trialBox })
local trialReq = text({ Position = UDim2.fromOffset(0, 64), Size = UDim2.new(1, -170, 0, 20), Font = Enum.Font.GothamBold, TextSize = 14, Text = "", Parent = trialBox })
local trialButton = create("TextButton", {
	AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromOffset(150, 56),
	BackgroundColor3 = THEME.Ready, Text = "Begin Trial", Font = Enum.Font.GothamBold, TextSize = 18, TextColor3 = THEME.White, Parent = trialBox,
}, { corner(8) })

-- Rank list
local list = create("ScrollingFrame", {
	Position = UDim2.fromOffset(0, 158),
	Size = UDim2.new(1, 0, 1, -158),
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	ScrollBarThickness = 6,
	ScrollBarImageColor3 = THEME.Bronze,
	CanvasSize = UDim2.new(),
	AutomaticCanvasSize = Enum.AutomaticSize.Y,
	Parent = panel,
}, { create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }), create("UIPadding", { PaddingRight = UDim.new(0, 10) }) })

local rows = {}
for i, rank in GameConfig.Ranks do
	local row = create("Frame", { Size = UDim2.new(1, 0, 0, 52), BackgroundColor3 = THEME.MarbleDark, LayoutOrder = i, Parent = list }, { corner(8), padding(6) })
	create("Frame", { Size = UDim2.fromOffset(10, 40), BackgroundColor3 = rank.Color, Parent = row }, { corner(4) })
	text({ Position = UDim2.fromOffset(18, 0), Size = UDim2.new(1, -150, 0, 20), Font = Enum.Font.GothamBold, TextSize = 16, TextColor3 = rank.Color, Text = ("%s   (levels %d-%d)"):format(rank.Name, rank.MinLevel, rank.MaxLevel), Parent = row })
	text({ Position = UDim2.fromOffset(18, 21), Size = UDim2.new(1, -150, 0, 18), TextSize = 13, TextColor3 = THEME.SubText, TextTruncate = Enum.TextTruncate.AtEnd, Text = AscensionConfig.Perks[i] or "", Parent = row })
	local status = text({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromOffset(130, 24), Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Right, Text = "", Parent = row })
	rows[i] = status
end

local function refresh()
	local rankIndex = player:GetAttribute("RankIndex") or 1
	local level = player:GetAttribute("Level") or 1
	for i, status in rows do
		if i < rankIndex then
			status.Text = "Achieved"
			status.TextColor3 = THEME.Ready
		elseif i == rankIndex then
			status.Text = "Your rank"
			status.TextColor3 = THEME.Sky
		elseif i == rankIndex + 1 then
			status.Text = "Next"
			status.TextColor3 = THEME.Bronze
		else
			status.Text = "Locked"
			status.TextColor3 = THEME.Locked
		end
	end

	if rankIndex >= #GameConfig.Ranks then
		trialTitle.Text = "You are an Elder God!"
		trialDesc.Text = "You have completed every ascension."
		trialReq.Text = ""
		trialButton.Visible = false
		return
	end
	local nextRank = GameConfig.Ranks[rankIndex + 1]
	local trial = AscensionConfig.Trials[rankIndex + 1]
	local cap = Progression.GetLevelCap(rankIndex)
	trialTitle.Text = ("Become a %s: %s"):format(nextRank.Name, trial.Name)
	trialTitle.TextColor3 = nextRank.Color
	trialDesc.Text = trial.Description or ""
	local ready = level >= cap and trial.Available
	if level < cap then
		trialReq.Text = ("Reach level %d (you are level %d)"):format(cap, level)
		trialReq.TextColor3 = Color3.fromRGB(175, 55, 35)
	elseif not trial.Available then
		trialReq.Text = "This trial arrives in Phase 7"
		trialReq.TextColor3 = Color3.fromRGB(175, 55, 35)
	else
		trialReq.Text = "You are ready!"
		trialReq.TextColor3 = THEME.Ready
	end
	trialButton.Visible = true
	trialButton.BackgroundColor3 = if ready then THEME.Ready else THEME.Locked
	trialButton.AutoButtonColor = ready
end

for _, attribute in { "RankIndex", "Level" } do
	player:GetAttributeChangedSignal(attribute):Connect(refresh)
end
refresh()

trialButton.Activated:Connect(function()
	ascensionRemote:FireServer("StartTrial") -- the server checks everything again
	panel.Visible = false
end)
closeButton.Activated:Connect(function()
	panel.Visible = false
end)

notifyRemote.OnClientEvent:Connect(function(kind)
	if kind == "OpenAscension" then
		refresh()
		panel.Visible = true
	end
end)

--------------------------------------------------------------------------
-- Chamber pillars: the ranks you have reached glow in their colour
--------------------------------------------------------------------------
local function colourPillars()
	local hub = Workspace:FindFirstChild("Hub")
	local chamber = hub and hub:FindFirstChild("AscensionChamber")
	if not chamber then
		return
	end
	local rankIndex = player:GetAttribute("RankIndex") or 1
	for _, part in chamber:GetChildren() do
		local index = part:GetAttribute("RankIndex")
		if index then
			part.Color = if index <= rankIndex then GameConfig.Ranks[index].Color else Color3.fromRGB(150, 150, 160)
			part.Transparency = if index <= rankIndex then 0 else 0.4
		end
	end
end
player:GetAttributeChangedSignal("RankIndex"):Connect(colourPillars)
task.spawn(function()
	local hub = Workspace:WaitForChild("Hub", 30)
	if hub then
		hub:WaitForChild("AscensionChamber", 30)
		colourPillars()
	end
end)

--------------------------------------------------------------------------
-- Rank-up effect
--------------------------------------------------------------------------
local fxFolder = Workspace:FindFirstChild("ClientEffects") or Instance.new("Folder")
fxFolder.Name = "ClientEffects"
fxFolder.Parent = Workspace

local function effectPart(props)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	for key, value in props do
		part[key] = value
	end
	part.Parent = fxFolder
	return part
end

fxRemote.OnClientEvent:Connect(function(kind, position, color)
	if kind ~= "Ascend" or typeof(position) ~= "Vector3" or typeof(color) ~= "Color3" then
		return
	end
	local ground = position - Vector3.new(0, 3, 0)
	local pillar = effectPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(80, 2, 2),
		CFrame = CFrame.new(ground + Vector3.new(0, 40, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(255, 240, 190),
		Transparency = 0.2,
	})
	TweenService:Create(pillar, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(80, 9, 9) }):Play()
	task.delay(0.5, function()
		TweenService:Create(pillar, TweenInfo.new(1.4), { Transparency = 1, Size = Vector3.new(80, 12, 12) }):Play()
	end)
	Debris:AddItem(pillar, 2)

	local ring = effectPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 2, 2),
		CFrame = CFrame.new(ground + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Transparency = 0.2,
	})
	TweenService:Create(ring, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.3, 40, 40), Transparency = 1 }):Play()
	Debris:AddItem(ring, 0.9)

	local holder = effectPart({ Size = Vector3.new(0.2, 0.2, 0.2), Transparency = 1, Position = position })
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color, Color3.fromRGB(255, 240, 190))
	emitter.LightEmission = 1
	emitter.Lifetime = NumberRange.new(0.8, 1.5)
	emitter.Speed = NumberRange.new(10, 25)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Acceleration = Vector3.new(0, 8, 0)
	emitter.Size = NumberSequence.new(0.6, 0)
	emitter.Rate = 0
	emitter.Parent = holder
	emitter:Emit(60)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 240, 190)
	light.Range = 40
	light.Brightness = 5
	light.Parent = holder
	TweenService:Create(light, TweenInfo.new(1.5), { Brightness = 0 }):Play()
	Debris:AddItem(holder, 2)
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="60">
        <Properties>
          <string name="Name">AudioController</string>
          <string name="Source"><![CDATA[-- AudioController (LocalScript)
-- Location: StarterPlayer > StarterPlayerScripts > AudioController
--
-- Phase 8: music, ambience and sound effects.
--   * Music zones (SoundConfig.Music): Olympus (ethereal) everywhere, Battle
--     during an arena/trial/challenge run, Boss while a boss of your run is
--     alive. Tracks are shuffled and crossfaded.
--   * Soft mountain wind under the Olympus music.
--   * Sound effects for every combat effect the server sends (hits, crits,
--     blocks, deaths, god abilities...), level ups, arena waves, bosses
--     appearing, rewards and button clicks.
--   * Two small buttons (bottom left): Music and Effects on/off, saved.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local SoundConfig = require(Shared:WaitForChild("SoundConfig"))
local Sfx = require(Shared:WaitForChild("Sfx"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local fxRemote = Remotes:WaitForChild("CombatFX")
local notifyRemote = Remotes:WaitForChild("Notify")
local arenaEvent = Remotes:WaitForChild("ArenaEvent")
local settingsRemote = Remotes:WaitForChild("SettingsAction")

Sfx.Preload()

local function musicSetting()
	local value = player:GetAttribute("MusicVolume")
	return if type(value) == "number" then value else 0.5
end

--------------------------------------------------------------------------
-- Music
--------------------------------------------------------------------------
local musicGroup = Instance.new("SoundGroup")
musicGroup.Name = "OlympusMusic"
musicGroup.Parent = SoundService

local random = Random.new()
local zone = nil
local current = nil -- the Sound playing now
local playlistIndex = {}
local FADE = 2.5

local function fadeOut(sound)
	if not sound then
		return
	end
	local tween = TweenService:Create(sound, TweenInfo.new(FADE), { Volume = 0 })
	tween:Play()
	tween.Completed:Connect(function()
		sound:Destroy()
	end)
end

local function nextTrack(zoneName)
	local cfg = SoundConfig.Music[zoneName]
	local order = playlistIndex[zoneName]
	if not order or order.Position > #order.List then
		local list = table.clone(cfg.Tracks)
		for i = #list, 2, -1 do
			local j = random:NextInteger(1, i)
			list[i], list[j] = list[j], list[i]
		end
		order = { List = list, Position = 1 }
		playlistIndex[zoneName] = order
	end
	local id = order.List[order.Position]
	order.Position += 1
	return id, cfg.Volume
end

local playTrack
playTrack = function(zoneName)
	local id, volume = nextTrack(zoneName)
	local sound = Instance.new("Sound")
	sound.Name = "Music_" .. zoneName
	sound.SoundId = id
	sound.Volume = 0
	sound.SoundGroup = musicGroup
	sound:SetAttribute("BaseVolume", volume)
	sound.Parent = SoundService
	sound:Play()
	TweenService:Create(sound, TweenInfo.new(FADE), { Volume = volume * musicSetting() }):Play()
	fadeOut(current)
	current = sound
	sound.Ended:Connect(function()
		if current == sound and zone == zoneName then
			playTrack(zoneName) -- next song in the same zone
		end
	end)
end

local function setZone(newZone)
	if newZone == zone then
		return
	end
	zone = newZone
	playTrack(newZone)
end

local function applyMusicVolume()
	if current then
		current.Volume = (current:GetAttribute("BaseVolume") or 0.35) * musicSetting()
	end
end
player:GetAttributeChangedSignal("MusicVolume"):Connect(applyMusicVolume)

-- Wind ambience
local wind = Instance.new("Sound")
wind.Name = "MountainWind"
wind.SoundId = SoundConfig.Ambience.Id
wind.Looped = true
wind.Volume = 0
wind.Parent = SoundService
wind:Play()

local function myRunId()
	local id = player:GetAttribute("ArenaRunId")
	return if id ~= nil and id ~= "" and id ~= 0 then id else nil
end

local function bossAlive(runId)
	local enemies = Workspace:FindFirstChild("Enemies")
	if not enemies then
		return false
	end
	for _, model in enemies:GetChildren() do
		if model:GetAttribute("IsBoss") and model:GetAttribute("RunId") == runId then
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			if humanoid and humanoid.Health > 0 then
				return true
			end
		end
	end
	return false
end

task.spawn(function()
	while true do
		local runId = myRunId()
		local state = player:GetAttribute("ArenaState")
		local fighting = runId and state ~= "Victory" and state ~= "Failed"
		if fighting then
			setZone(if bossAlive(runId) then "Boss" else "Battle")
		else
			setZone("Olympus")
		end
		local windTarget = if zone == "Olympus" then SoundConfig.Ambience.Volume * musicSetting() * 2 else 0
		wind.Volume += (windTarget - wind.Volume) * 0.3
		task.wait(1)
	end
end)

--------------------------------------------------------------------------
-- Sound effects from combat events
--------------------------------------------------------------------------
local DAMAGE_SOUNDS = {
	Enemy = "Hit", Crit = "Crit", Player = "Hurt", Blocked = "Block", Countered = "Block", Dodged = "Whoosh",
}
local ABILITY_SOUNDS = {
	Lightning = "Thunder", Chain = "Thunder", Shockwave = "Slam", Cleave = "HeavySwing", DashTrail = "Dash",
	Aura = "Magic", Beam = "Fire", Vortex = "Water", Wave = "Water", Dome = "Magic", HealBurst = "Heal",
}

fxRemote.OnClientEvent:Connect(function(kind, position, a, b)
	if kind == "Swing" and typeof(position) == "Instance" then
		local character = position.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root then
			Sfx.Play("Swing", root.Position, 0.7)
		end
		return
	end
	if typeof(position) ~= "Vector3" then
		return
	end
	if kind == "Damage" then
		local style = b
		if a == 0 and style ~= "Dodged" and style ~= "Countered" then
			return
		end
		local name = DAMAGE_SOUNDS[style or "Enemy"]
		if name then
			Sfx.Play(name, position)
		end
	elseif kind == "Death" then
		Sfx.Play("Death", position)
	elseif kind == "EnemyAttack" then
		local windup = if typeof(b) == "number" then b else 0.5
		task.delay(math.max(0, windup - 0.05), function()
			Sfx.Play("HeavySwing", position, 0.6)
		end)
	elseif kind == "Reward" then
		Sfx.Play("Coins", nil, 0.6)
	elseif ABILITY_SOUNDS[kind] then
		Sfx.Play(ABILITY_SOUNDS[kind], position)
	end
end)

notifyRemote.OnClientEvent:Connect(function(kind)
	if kind == "LevelUp" then
		Sfx.Play("Chimes")
	elseif kind == "RankUp" then
		Sfx.Play("Gong")
		task.delay(0.4, Sfx.Play, "Chimes")
	end
end)

arenaEvent.OnClientEvent:Connect(function(kind, data)
	if kind == "Result" and type(data) == "table" then
		if data.Victory then
			Sfx.Play("Chimes")
			Sfx.Play("Coins", nil, 0.8)
		else
			Sfx.Play("Gong", nil, 0.6)
		end
	end
end)

player:GetAttributeChangedSignal("ArenaWave"):Connect(function()
	if myRunId() and (player:GetAttribute("ArenaWave") or 0) > 0 then
		Sfx.Play("Gong", nil, 0.7)
	end
end)

-- A boss of your run appears: a roar.
task.spawn(function()
	local enemies = Workspace:WaitForChild("Enemies", 60)
	if not enemies then
		return
	end
	enemies.ChildAdded:Connect(function(model)
		task.wait(0.2)
		if model:GetAttribute("IsBoss") and model:GetAttribute("RunId") == myRunId() then
			local root = model:FindFirstChild("HumanoidRootPart")
			Sfx.Play("Roar", root and root.Position)
		end
	end)
end)

--------------------------------------------------------------------------
-- Button clicks (menus only; not the combat and ability buttons)
--------------------------------------------------------------------------
local SILENT_GUIS = { CombatHUD = true, CombatTouchButtons = true, AbilityButtons = true, IncarnationUI = true }
local function hookButton(button)
	if not button:IsA("GuiButton") or button:GetAttribute("SfxHooked") then
		return
	end
	local screen = button:FindFirstAncestorWhichIsA("ScreenGui")
	if screen and SILENT_GUIS[screen.Name] then
		return
	end
	button:SetAttribute("SfxHooked", true)
	button.Activated:Connect(function()
		Sfx.Play("Click")
	end)
end
for _, item in playerGui:GetDescendants() do
	hookButton(item)
end
playerGui.DescendantAdded:Connect(hookButton)

--------------------------------------------------------------------------
-- Music / Effects toggles (bottom left, above the version label)
--------------------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "AudioToggles"
gui.ResetOnSpawn = false
gui.DisplayOrder = 6
gui.Parent = playerGui

local function toggle(label, attribute, x)
	local b = Instance.new("TextButton")
	b.Name = attribute
	b.AnchorPoint = Vector2.new(0, 1)
	b.Position = UDim2.new(0, x, 1, -26)
	b.Size = UDim2.fromOffset(86, 26)
	b.Font = Enum.Font.GothamBold
	b.TextSize = 13
	b.TextColor3 = Color3.new(1, 1, 1)
	b.BackgroundColor3 = Color3.fromRGB(40, 34, 52)
	b.BackgroundTransparency = 0.25
	b.AutoButtonColor = true
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = b
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(212, 175, 55)
	stroke.Thickness = 1
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = b
	local function refresh()
		local value = player:GetAttribute(attribute)
		local on = (if type(value) == "number" then value else 0.5) > 0
		b.Text = label .. (if on then ": On" else ": Off")
		stroke.Color = if on then Color3.fromRGB(212, 175, 55) else Color3.fromRGB(120, 120, 130)
	end
	b.Activated:Connect(function()
		local value = player:GetAttribute(attribute)
		local on = (if type(value) == "number" then value else 0.5) > 0
		settingsRemote:FireServer(attribute, if on then 0 else (if attribute == "MusicVolume" then 0.5 else 0.8))
	end)
	player:GetAttributeChangedSignal(attribute):Connect(refresh)
	refresh()
	b.Parent = gui
end
toggle("Music", "MusicVolume", 8)
toggle("Effects", "SfxVolume", 100)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="61">
        <Properties>
          <string name="Name">CombatController</string>
          <string name="Source"><![CDATA[-- CombatController (LocalScript)
-- Location: StarterPlayer > StarterPlayerScripts > CombatController
--
-- The client side of combat. It only handles input, animation and effects;
-- the server decides hits, damage, cooldowns and rewards.
--   Attack: left mouse button / R2 / on-screen "Attack" button (hold to keep swinging)
--   Block:  hold F / L2 / hold on-screen "Block" button
--   Dash:   Left Shift / B / on-screen "Dash" button
-- On touch screens the buttons are laid out around Roblox's jump button.
-- Also draws the health bar, swing effects, damage numbers and reward text.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CombatConfig = require(Shared:WaitForChild("CombatConfig"))
local GodConfig = require(Shared:WaitForChild("GodConfig"))
local SwordBuilder = require(Shared:WaitForChild("SwordBuilder"))
local SwordPoses = require(Shared:WaitForChild("SwordPoses"))
local SwordAnimator = require(Shared:WaitForChild("SwordAnimator"))
local WeaponConfig = require(Shared:WaitForChild("WeaponConfig"))

-- Phase 7C: the equipped weapon's type (sword, spear, trident, axe, bow).
local function weaponType()
	return WeaponConfig.Types[player:GetAttribute("WeaponType") or "Sword"] or WeaponConfig.Types.Sword
end

local AimHelper = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("AimHelper"))
local Sfx = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Sfx"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local attackRemote = Remotes:WaitForChild("CombatAttack")
local blockRemote = Remotes:WaitForChild("CombatBlock")
local dashRemote = Remotes:WaitForChild("CombatDash")
local fxRemote = Remotes:WaitForChild("CombatFX")

local CFG = CombatConfig.Player
local COMBO_RESET = 1.2 -- seconds; the combo starts over after a pause

-- Our own health bar replaces Roblox's default one; there are no tools, so
-- the backpack bar isn't needed.
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

--------------------------------------------------------------------------
-- Character helpers
--------------------------------------------------------------------------
local comboIndex = 0
local lastAttackAt = 0

local function getParts()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and root and humanoid.Health > 0 then
		return character, humanoid, root
	end
	return nil
end

local function godColor()
	return GodConfig.GetColors(player:GetAttribute("SelectedGod") or "").Primary
end

--------------------------------------------------------------------------
-- Effects folder (client only)
--------------------------------------------------------------------------
local fxFolder = Instance.new("Folder")
fxFolder.Name = "ClientEffects"
fxFolder.Parent = Workspace

local function anchoredPart(props)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	for key, value in props do
		part[key] = value
	end
	part.Parent = fxFolder
	return part
end

-- Show the sword's light trail straight away on your own screen
-- (the server turns it on for everyone else).
local function flashTrail()
	local trail = SwordBuilder.GetTrail(player.Character)
	if trail then
		trail.Enabled = true
		task.delay(0.3, function()
			trail.Enabled = false
		end)
	end
end

local function burst(position, color, count, speed)
	local holder = anchoredPart({ Size = Vector3.new(0.2, 0.2, 0.2), Transparency = 1, Position = position })
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 0.8
	emitter.Lifetime = NumberRange.new(0.25, 0.5)
	emitter.Speed = NumberRange.new(speed * 0.5, speed)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new(0.35, 0)
	emitter.Rate = 0
	emitter.Parent = holder
	emitter:Emit(count)
	Debris:AddItem(holder, 1)
end

local DAMAGE_COLORS = {
	Enemy = Color3.fromRGB(255, 235, 120),
	Player = Color3.fromRGB(255, 80, 70),
	Blocked = Color3.fromRGB(120, 190, 255),
	Dodged = Color3.fromRGB(200, 255, 200),
	KnockedOut = Color3.fromRGB(255, 255, 255),
	Heal = Color3.fromRGB(110, 255, 130),
	Countered = Color3.fromRGB(255, 240, 200),
	Crit = Color3.fromRGB(255, 150, 40),
}

local function floatingText(position, textValue, color, size, rise)
	local holder = anchoredPart({ Size = Vector3.new(0.2, 0.2, 0.2), Transparency = 1, Position = position })
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(160, 40)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 120
	billboard.Parent = holder
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextSize = size
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.2
	label.Text = textValue
	label.Parent = billboard
	local info = TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(billboard, info, { StudsOffset = Vector3.new(0, rise, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(holder, 1)
end

--------------------------------------------------------------------------
-- Hit reactions (drawn on this device only)
--------------------------------------------------------------------------
local flashing = setmetatable({}, { __mode = "k" })
local wobbleBase = setmetatable({}, { __mode = "k" }) -- [dummy Model] = upright pivot
local wobbleToken = setmetatable({}, { __mode = "k" })

-- Enemy turns glowing white for a moment. (Changing colour and material is
-- cheap; Roblox's Highlight effect is expensive on phones and tablets.)
local function flash(model)
	if flashing[model] then
		return
	end
	flashing[model] = true
	local saved = {}
	for _, item in model:GetDescendants() do
		if item:IsA("BasePart") and item.Transparency < 1 and item.Name ~= "Weapon" then
			saved[item] = { item.Color, item.Material }
			item.Color = Color3.new(1, 1, 1)
			item.Material = Enum.Material.Neon
		end
	end
	task.delay(0.15, function()
		for item, look in saved do
			if item.Parent then
				item.Color = look[1]
				item.Material = look[2]
			end
		end
		flashing[model] = nil
	end)
end

-- Training dummy rocks back and springs upright.
local function wobble(model, strength)
	if not model.Parent then
		return
	end
	wobbleBase[model] = wobbleBase[model] or model:GetPivot()
	local ground = wobbleBase[model] * CFrame.new(0, -3, 0)
	local token = (wobbleToken[model] or 0) + 1
	wobbleToken[model] = token
	local tilt = Instance.new("NumberValue")
	tilt.Changed:Connect(function(angle)
		if wobbleToken[model] == token and model.Parent then
			model:PivotTo(ground * CFrame.Angles(math.rad(angle), 0, 0) * CFrame.new(0, 3, 0))
		end
	end)
	tilt.Value = strength
	local tween = TweenService:Create(tilt, TweenInfo.new(0.7, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), { Value = 0 })
	tween.Completed:Connect(function()
		tilt:Destroy()
	end)
	tween:Play()
end

local function react(model, big)
	if typeof(model) ~= "Instance" or not model:IsA("Model") then
		return
	end
	if model:GetAttribute("Dummy") then
		wobble(model, if big then 40 else 14)
	end
	flash(model)
end

-- Instant feedback for your own swing: react to enemies the server will
-- almost certainly count as hit, without waiting for the round trip.
local function predictHits(root)
	local enemies = Workspace:FindFirstChild("Enemies")
	if not enemies then
		return
	end
	local attack = weaponType()
	if attack.Ranged then
		return -- arrows: the server draws the shot and the hits
	end
	local look = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z).Unit
	for _, model in enemies:GetChildren() do
		local enemyRoot = model:FindFirstChild("HumanoidRootPart")
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if enemyRoot and humanoid and humanoid.Health > 0 then
			local offset = enemyRoot.Position - root.Position
			offset = Vector3.new(offset.X, 0, offset.Z)
			local reach = attack.Range + enemyRoot.Size.X / 2
			if offset.Magnitude <= reach and (offset.Magnitude < 1.5 or look:Dot(offset.Unit) >= attack.ArcDot) then
				react(model, false)
				burst(enemyRoot.Position, godColor(), 12, 14)
			end
		end
	end
end

fxRemote.OnClientEvent:Connect(function(kind, position, value, style)
	if kind == "Swing" then
		-- Another player swung: play the same move on their character.
		local other = position
		if typeof(other) == "Instance" and other:IsA("Player") and other ~= player and other.Character then
			SwordAnimator.Play(other.Character, value)
		end
		return
	end
	if typeof(position) ~= "Vector3" then
		return
	end
	if kind == "EnemyAttack" then
		if typeof(value) == "Instance" and typeof(style) == "number" then
			SwordAnimator.PlayKeys(value, SwordPoses.EnemyAttack(style))
		end
		return
	end
	if kind == "Damage" then
		if style == "KnockedOut" then
			-- the dummy under the text gets a big wobble
			local enemies = Workspace:FindFirstChild("Enemies")
			for _, model in if enemies then enemies:GetChildren() else {} do
				local r = model:FindFirstChild("HumanoidRootPart")
				if model:GetAttribute("Dummy") and r and (r.Position - position).Magnitude < 8 then
					react(model, true)
				end
			end
		end
		local jitter = Vector3.new(math.random() - 0.5, 0, math.random() - 0.5) * 2
		local label = if style == "Dodged"
			then "Dodged!"
			elseif style == "KnockedOut" then "Knocked out!"
			elseif style == "Heal" then "+" .. tostring(value)
			elseif style == "Countered" then "Countered!"
			elseif style == "Crit" then ("CRIT %d"):format(value)
			elseif style == "Blocked" then ("%d (blocked)"):format(value)
			else tostring(value)
		floatingText(position + jitter, label, DAMAGE_COLORS[style] or DAMAGE_COLORS.Enemy, if style == "Enemy" then 26 else 22, 3)
	elseif kind == "Hit" then
		-- value = the enemy model, style = the player who hit it.
		if style ~= player then
			burst(position, godColor(), 12, 14)
			react(value, false)
		end
	elseif kind == "Death" then
		burst(position, Color3.fromRGB(230, 230, 230), 30, 10)
	elseif kind == "Reward" then
		floatingText(position + Vector3.new(0, 4, 0), tostring(value), Color3.fromRGB(212, 175, 55), 24, 4)
	end
end)

--------------------------------------------------------------------------
-- Actions
--------------------------------------------------------------------------
local nextAttackAt, nextDashAt = 0, 0
local blocking = false

local function canAct()
	return player:GetAttribute("DataLoaded") == true and getParts() ~= nil
end

local function attack()
	if not canAct() or blocking then
		return
	end
	local now = os.clock()
	if now < nextAttackAt then
		return
	end
	nextAttackAt = now + (player:GetAttribute("WeaponCooldown") or CFG.BasicAttack.Cooldown)
	local _, _, root = getParts()
	local aim = AimHelper.FaceAim(root) -- in fighting areas: face the centre dot

	-- Combo: slash, slash, lunge. Starts over after a short pause.
	if now - lastAttackAt > COMBO_RESET then
		comboIndex = 0
	end
	lastAttackAt = now
	comboIndex = comboIndex % 3 + 1
	SwordAnimator.Play(player.Character, weaponType().Combo[comboIndex] or SwordPoses.ComboOrder[comboIndex])
	predictHits(root)
	flashTrail()
	attackRemote:FireServer(comboIndex, aim)
	Sfx.Play(if weaponType().Ranged then "Arrow" else (if comboIndex == 3 then "HeavySwing" else "Swing"))
end

local function setBlock(on)
	if on == blocking then
		return
	end
	if on and not canAct() then
		return
	end
	blocking = on
	blockRemote:FireServer(on)
end

local function dash()
	if not canAct() or blocking then
		return
	end
	local now = os.clock()
	if now < nextDashAt then
		return
	end
	nextDashAt = now + CFG.Dash.Cooldown
	local _, humanoid, root = getParts()
	local direction = humanoid.MoveDirection
	if direction.Magnitude < 0.1 then
		direction = root.CFrame.LookVector
	end
	direction = Vector3.new(direction.X, 0, direction.Z).Unit

	-- Your own character is simulated on your device, so the push happens here.
	local attachment = Instance.new("Attachment")
	attachment.Parent = root
	local velocity = Instance.new("LinearVelocity")
	velocity.Attachment0 = attachment
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	velocity.PrimaryTangentAxis = Vector3.xAxis
	velocity.SecondaryTangentAxis = Vector3.zAxis
	velocity.PlaneVelocity = Vector2.new(direction.X, direction.Z) * CFG.Dash.Speed
	velocity.MaxForce = 100000
	velocity.Parent = root
	Debris:AddItem(velocity, CFG.Dash.Duration)
	Debris:AddItem(attachment, CFG.Dash.Duration)

	burst(root.Position, godColor(), 16, 8)
	dashRemote:FireServer(direction) -- the server uses it for god dash abilities
	Sfx.Play("Dash")
end

--------------------------------------------------------------------------
-- Input bindings (keyboard, controller and touch buttons)
--------------------------------------------------------------------------
local function onAttack(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		attack()
	end
	return Enum.ContextActionResult.Sink
end

local function onBlock(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		setBlock(true)
	elseif inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
		setBlock(false)
	end
	return Enum.ContextActionResult.Sink
end

local function onDash(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		dash()
	end
	return Enum.ContextActionResult.Sink
end

-- Keyboard and controller (no Roblox touch buttons: we draw our own below).
ContextActionService:BindAction("OlympusAttack", onAttack, false, Enum.KeyCode.ButtonR2)
ContextActionService:BindAction("OlympusBlock", onBlock, false, Enum.KeyCode.F, Enum.KeyCode.ButtonL2)
ContextActionService:BindAction("OlympusDash", onDash, false, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonB)

-- Left mouse button attacks, unless the click was on a menu or button.
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not gameProcessed and input.UserInputType == Enum.UserInputType.MouseButton1 then
		attack()
	end
end)

-- Releasing block if the character dies or respawns.
player.CharacterRemoving:Connect(function()
	blocking = false
end)

--------------------------------------------------------------------------
-- Health bar (bottom centre)
--------------------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "CombatHUD"
gui.ResetOnSpawn = false
gui.Enabled = false
gui.Parent = playerGui

local uiScale = Instance.new("UIScale")
uiScale.Parent = gui
local function updateScale()
	local camera = Workspace.CurrentCamera
	local viewport = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	uiScale.Scale = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720), 0.7, 1.2)
end
updateScale()
if Workspace.CurrentCamera then
	Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
end

local barBack = Instance.new("Frame")
barBack.Name = "HealthBar"
barBack.AnchorPoint = Vector2.new(0.5, 1)
barBack.Position = UDim2.new(0.5, 0, 1, -24)
barBack.Size = UDim2.fromOffset(340, 24)
barBack.BackgroundColor3 = Color3.fromRGB(50, 30, 30)
barBack.Parent = gui
local backCorner = Instance.new("UICorner")
backCorner.CornerRadius = UDim.new(0, 8)
backCorner.Parent = barBack
local backStroke = Instance.new("UIStroke")
backStroke.Color = Color3.fromRGB(212, 175, 55)
backStroke.Thickness = 2
backStroke.Parent = barBack

local barFill = Instance.new("Frame")
barFill.Name = "Fill"
barFill.Size = UDim2.fromScale(1, 1)
barFill.BackgroundColor3 = Color3.fromRGB(200, 55, 50)
barFill.Parent = barBack
local fillCorner = Instance.new("UICorner")
fillCorner.CornerRadius = UDim.new(0, 8)
fillCorner.Parent = barFill

local barText = Instance.new("TextLabel")
barText.Size = UDim2.fromScale(1, 1)
barText.BackgroundTransparency = 1
barText.Font = Enum.Font.GothamBold
barText.TextSize = 15
barText.TextColor3 = Color3.new(1, 1, 1)
barText.TextStrokeTransparency = 0.4
barText.ZIndex = 2
barText.Parent = barBack

local healthConnections = {}
local function trackHumanoid(humanoid)
	for _, c in healthConnections do
		c:Disconnect()
	end
	healthConnections = {}
	local function update()
		local ratio = if humanoid.MaxHealth > 0 then math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1) else 0
		TweenService:Create(barFill, TweenInfo.new(0.15), { Size = UDim2.fromScale(ratio, 1) }):Play()
		barText.Text = ("HP %d / %d"):format(math.ceil(humanoid.Health), humanoid.MaxHealth)
	end
	table.insert(healthConnections, humanoid.HealthChanged:Connect(update))
	table.insert(healthConnections, humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(update))
	update()
end

local function onCharacter(character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if humanoid then
		trackHumanoid(humanoid)
	end
end
player.CharacterAdded:Connect(onCharacter)
if player.Character then
	task.spawn(onCharacter, player.Character)
end

--------------------------------------------------------------------------
-- Touch buttons (phones and tablets), placed around the jump button
--------------------------------------------------------------------------
local touchGui = Instance.new("ScreenGui")
touchGui.Name = "CombatTouchButtons"
touchGui.ResetOnSpawn = false
touchGui.Enabled = false
touchGui.Parent = playerGui

local function touchButton(name, label, color)
	local b = Instance.new("TextButton")
	b.Name = name
	b.AnchorPoint = Vector2.new(0.5, 0.5)
	b.BackgroundColor3 = color
	b.BackgroundTransparency = 0.25
	b.Text = label
	b.Font = Enum.Font.GothamBold
	b.TextScaled = true
	b.TextColor3 = Color3.new(1, 1, 1)
	b.AutoButtonColor = false
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(1, 0) -- round
	c.Parent = b
	local st = Instance.new("UIStroke")
	st.Color = Color3.fromRGB(212, 175, 55)
	st.Thickness = 2
	st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	st.Parent = b
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.18, 0)
	pad.PaddingRight = UDim.new(0.18, 0)
	pad.PaddingTop = UDim.new(0.3, 0)
	pad.PaddingBottom = UDim.new(0.3, 0)
	pad.Parent = b
	b.Parent = touchGui
	return b
end

local attackButton = touchButton("Attack", "Attack", Color3.fromRGB(170, 60, 45))
local blockButton = touchButton("Block", "Block", Color3.fromRGB(60, 110, 180))
local dashButton = touchButton("Dash", "Dash", Color3.fromRGB(90, 140, 70))

-- Roblox's jump button: 120 px on big screens (bottom-right corner 170 px in,
-- 210 px up), 70 px on small screens (95 px in, 90 px up). Our buttons go
-- to its left and above it so they never overlap.
local function layoutTouchButtons()
	local camera = Workspace.CurrentCamera
	local viewport = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	local big = math.min(viewport.X, viewport.Y) > 500
	local jumpSize = if big then 120 else 70
	local jumpLeft = if big then 170 else 95 -- distance from the right edge to the jump button's left side
	local jumpTop = if big then 210 else 90 -- distance from the bottom edge to the jump button's top
	local jumpCenterX = jumpLeft - jumpSize / 2
	local jumpCenterY = jumpTop - jumpSize / 2
	local gap = if big then 16 else 10

	local attackSize = math.floor(jumpSize * 1.05)
	local smallSize = math.floor(jumpSize * 0.75)

	attackButton.Size = UDim2.fromOffset(attackSize, attackSize)
	attackButton.Position = UDim2.new(1, -(jumpLeft + gap + attackSize / 2), 1, -jumpCenterY)

	dashButton.Size = UDim2.fromOffset(smallSize, smallSize)
	dashButton.Position = UDim2.new(1, -jumpCenterX, 1, -(jumpTop + gap + smallSize / 2))

	blockButton.Size = UDim2.fromOffset(smallSize, smallSize)
	blockButton.Position = UDim2.new(1, -(jumpLeft + gap + attackSize / 2), 1, -(jumpCenterY + attackSize / 2 + gap + smallSize / 2))
end
layoutTouchButtons()
if Workspace.CurrentCamera then
	Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(layoutTouchButtons)
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1
end

-- Attack: tap, or hold to keep swinging.
local attackInput = nil
attackButton.InputBegan:Connect(function(input)
	if isPress(input) and not attackInput then
		attackInput = input
		task.spawn(function()
			while attackInput == input do
				attack()
				task.wait(0.1)
			end
		end)
	end
end)

-- Block: held for as long as your finger stays down.
local blockInput = nil
blockButton.InputBegan:Connect(function(input)
	if isPress(input) and not blockInput then
		blockInput = input
		setBlock(true)
		blockButton.BackgroundTransparency = 0
	end
end)

dashButton.InputBegan:Connect(function(input)
	if isPress(input) then
		dash()
	end
end)

-- A finger lifted anywhere ends the hold, even if it slid off the button.
UserInputService.InputEnded:Connect(function(input)
	if input == attackInput then
		attackInput = nil
	end
	if input == blockInput then
		blockInput = nil
		setBlock(false)
		blockButton.BackgroundTransparency = 0.25
	end
end)

-- Dim the Dash button while it recharges.
task.spawn(function()
	while true do
		task.wait(0.1)
		dashButton.BackgroundTransparency = if os.clock() < nextDashAt then 0.7 else 0.25
	end
end)

local function updateEnabled()
	local loaded = player:GetAttribute("DataLoaded") == true
	gui.Enabled = loaded
	touchGui.Enabled = loaded and UserInputService.TouchEnabled
end
player:GetAttributeChangedSignal("DataLoaded"):Connect(updateEnabled)
updateEnabled()
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="62">
        <Properties>
          <string name="Name">Diagnostics</string>
          <string name="Source"><![CDATA[-- Diagnostics (LocalScript)
-- Location: StarterPlayer > StarterPlayerScripts > Diagnostics
--
-- Sends a small report to the server so problems on real devices can be
-- investigated: frame rate, ping, script errors, and what the sword
-- animation system is doing. Turn off with GameConfig.Debug.Diagnostics.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ScriptContext = game:GetService("ScriptContext")
local Stats = game:GetService("Stats")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("GameConfig"))
if not GameConfig.Debug.Diagnostics then
	return
end
local SwordAnimator = require(Shared:WaitForChild("SwordAnimator"))
local reportRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("ClientReport")

local player = Players.LocalPlayer
local errors = {}
local errorCount = 0

ScriptContext.Error:Connect(function(message, trace, source)
	errorCount += 1
	if #errors < 15 then
		table.insert(errors, {
			Message = string.sub(tostring(message), 1, 300),
			Trace = string.sub(tostring(trace), 1, 300),
			Script = if source then source:GetFullName() else "?",
		})
	end
end)

local frames = 0
local slowFrames = 0
RunService.RenderStepped:Connect(function(dt)
	frames += 1
	if dt > 1 / 30 then
		slowFrames += 1
	end
end)

local function round(n)
	return math.floor(n * 10 + 0.5) / 10
end

local function snapshot(elapsed)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local camera = Workspace.CurrentCamera
	local enemies = Workspace:FindFirstChild("Enemies")
	local ok, anim = pcall(SwordAnimator.GetDebugInfo)
	return {
		Build = GameConfig.BuildLabel,
		Fps = round(frames / elapsed),
		SlowFramePercent = round(100 * slowFrames / math.max(frames, 1)),
		PingMs = math.floor(player:GetNetworkPing() * 1000),
		MemoryMb = math.floor(Stats:GetTotalMemoryUsageMb()),
		Touch = UserInputService.TouchEnabled,
		Screen = if camera then ("%dx%d"):format(camera.ViewportSize.X, camera.ViewportSize.Y) else "?",
		Position = if root then ("%d,%d,%d"):format(root.Position.X, root.Position.Y, root.Position.Z) else "none",
		HasSword = character ~= nil and character:FindFirstChild("DivineSword") ~= nil,
		HasRankOutfit = character ~= nil and character:FindFirstChild("RankOutfit") ~= nil,
		LooksRank = character and character:GetAttribute("LooksRank"),
		RankIndex = player:GetAttribute("RankIndex"),
		EnemyModels = if enemies then #enemies:GetChildren() else 0,
		Parts = #Workspace:GetDescendants(),
		Animator = if ok then anim else { Error = tostring(anim) },
		ErrorCount = errorCount,
		Errors = errors,
	}
end

task.spawn(function()
	while player:GetAttribute("DataLoaded") ~= true do
		task.wait(1)
	end
	local started = os.clock()
	local last = os.clock()
	while true do
		-- Every 10 s for the first 5 minutes, then once a minute.
		task.wait(if os.clock() - started < 300 then 10 else 60)
		local now = os.clock()
		local report = snapshot(now - last)
		last = now
		frames, slowFrames = 0, 0
		errors = {}
		reportRemote:FireServer(report)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="63">
        <Properties>
          <string name="Name">GodUI</string>
          <string name="Source"><![CDATA[-- GodUI (LocalScript)
-- Location: StarterPlayer > StarterPlayerScripts > GodUI
--
-- Phase 3 interface:
--   * "Choose your god" intro screen (shown until you pick a god).
--   * God badge under the currency panel (the equipped god indicator).
--   * Gods & Blessings menu: loyalty, worship timer, bonuses, blessing tree,
--     and changing god.
-- Display only: reads Player Attributes and sends requests. The server decides.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GodConfig = require(Shared:WaitForChild("GodConfig"))
local Progression = require(Shared:WaitForChild("Progression"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local godRemote = Remotes:WaitForChild("GodAction")
local notifyRemote = Remotes:WaitForChild("Notify")

local THEME = {
	Marble = Color3.fromRGB(246, 242, 232),
	MarbleDark = Color3.fromRGB(228, 220, 204),
	Gold = Color3.fromRGB(212, 175, 55),
	Bronze = Color3.fromRGB(140, 92, 45),
	Text = Color3.fromRGB(58, 44, 28),
	SubText = Color3.fromRGB(110, 95, 75),
	White = Color3.new(1, 1, 1),
	Night = Color3.fromRGB(18, 22, 38),
	Ready = Color3.fromRGB(70, 150, 70),
	TooExpensive = Color3.fromRGB(175, 80, 55),
	Locked = Color3.fromRGB(130, 130, 140),
	Warning = Color3.fromRGB(175, 55, 35),
	Change = Color3.fromRGB(130, 80, 190),
}
local TITLE_FONT = Enum.Font.Garamond
local BODY_FONT = Enum.Font.GothamBold
local SMALL_FONT = Enum.Font.Gotham

--------------------------------------------------------------------------
-- Small UI helpers
--------------------------------------------------------------------------
local function create(className, props, children)
	local inst = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			inst[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

local function corner(radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius) })
end

local function stroke(color, thickness)
	return create("UIStroke", { Color = color, Thickness = thickness, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

local function padding(px)
	return create("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
	})
end

local function text(props)
	props.BackgroundTransparency = 1
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	props.TextColor3 = props.TextColor3 or THEME.Text
	props.Font = props.Font or SMALL_FONT
	return create("TextLabel", props)
end

local function button(props, radius)
	props.AutoButtonColor = true
	props.Font = props.Font or BODY_FONT
	props.TextColor3 = props.TextColor3 or THEME.White
	return create("TextButton", props, { corner(radius or 8) })
end

local function serverNow()
	return Workspace:GetServerTimeNow()
end

local function godName(godId)
	local god = GodConfig.Gods[godId]
	return if god then god.DisplayName else ""
end

--------------------------------------------------------------------------
-- Screen + scaling
--------------------------------------------------------------------------
local gui = create("ScreenGui", {
	Name = "GodUI",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	DisplayOrder = 6,
	Enabled = false,
	Parent = playerGui,
})
local uiScale = create("UIScale", { Parent = gui })
local chooserScale = nil -- created with the chooser below; extra shrink for small phones

local CHOOSER_SIZE = Vector2.new(940, 560)

local function updateScale()
	local camera = Workspace.CurrentCamera
	local viewport = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	uiScale.Scale = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720), 0.7, 1.2)
	if chooserScale then
		local fit = math.min(viewport.X * 0.96 / CHOOSER_SIZE.X, viewport.Y * 0.94 / CHOOSER_SIZE.Y) / uiScale.Scale
		chooserScale.Scale = math.min(1, fit)
	end
end

--------------------------------------------------------------------------
-- 1. God badge (top-right, under the currency panel)
--------------------------------------------------------------------------
local badge = button({
	Name = "GodBadge",
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -12, 0, 120),
	Size = UDim2.fromOffset(200, 44),
	BackgroundColor3 = THEME.Marble,
	Text = "",
	Parent = gui,
}, 10)
stroke(THEME.Gold, 2).Parent = badge
local badgeName = text({
	Name = "God",
	Position = UDim2.fromOffset(10, 2),
	Size = UDim2.new(1, -20, 0, 24),
	Font = TITLE_FONT,
	TextSize = 24,
	Text = "",
	Parent = badge,
})
local badgeSub = text({
	Name = "Sub",
	Position = UDim2.fromOffset(10, 24),
	Size = UDim2.new(1, -20, 0, 16),
	TextSize = 13,
	TextColor3 = THEME.SubText,
	Text = "",
	Parent = badge,
})

--------------------------------------------------------------------------
-- 2. "Choose your god" screen
--------------------------------------------------------------------------
local chooser = create("Frame", {
	Name = "Chooser",
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = THEME.Night,
	BackgroundTransparency = 0.15,
	Visible = false,
	ZIndex = 10,
	Parent = gui,
})
local chooserInner = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(CHOOSER_SIZE.X, CHOOSER_SIZE.Y),
	BackgroundTransparency = 1,
	Parent = chooser,
})
chooserScale = create("UIScale", { Parent = chooserInner })
updateScale()
if Workspace.CurrentCamera then
	Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
end
text({
	Size = UDim2.new(1, 0, 0, 50),
	Font = TITLE_FONT,
	TextSize = 44,
	TextColor3 = THEME.Gold,
	TextXAlignment = Enum.TextXAlignment.Center,
	Text = "Choose Your God",
	Parent = chooserInner,
})
text({
	Position = UDim2.fromOffset(0, 50),
	Size = UDim2.new(1, 0, 0, 24),
	TextSize = 16,
	TextColor3 = THEME.Marble,
	TextXAlignment = Enum.TextXAlignment.Center,
	Text = "Your god grants your first blessing. You can change gods later at the Shrine of Change.",
	Parent = chooserInner,
})
local grid = create("Frame", {
	Position = UDim2.fromOffset(0, 90),
	Size = UDim2.new(1, 0, 1, -90),
	BackgroundTransparency = 1,
	Parent = chooserInner,
}, {
	create("UIGridLayout", {
		CellSize = UDim2.fromOffset(300, 225),
		CellPadding = UDim2.fromOffset(20, 18),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
	}),
})

for order, godId in GodConfig.Order do
	local god = GodConfig.Gods[godId]
	local card = create("Frame", {
		Name = godId,
		BackgroundColor3 = THEME.Marble,
		LayoutOrder = order,
		Parent = grid,
	}, { corner(12), stroke(god.Colors.Primary, 3), padding(12) })
	text({ Size = UDim2.new(1, 0, 0, 36), Font = TITLE_FONT, TextSize = 34, TextColor3 = god.Colors.Primary, Text = god.DisplayName, Parent = card })
	text({ Position = UDim2.fromOffset(0, 36), Size = UDim2.new(1, 0, 0, 20), Font = BODY_FONT, TextSize = 16, Text = god.Title, Parent = card })
	text({ Position = UDim2.fromOffset(0, 58), Size = UDim2.new(1, 0, 0, 36), TextSize = 14, TextColor3 = THEME.SubText, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Text = god.Specialty, Parent = card })

	local names = {}
	for _, blessing in god.Blessings do
		table.insert(names, blessing.Name)
	end
	text({
		Position = UDim2.fromOffset(0, 96),
		Size = UDim2.new(1, 0, 0, 50),
		TextSize = 12,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		Text = if #names > 0 then table.concat(names, " · ") else "Arrives in a later update.",
		Parent = card,
	})

	local choose = button({
		Name = "Choose",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundColor3 = if god.Available then god.Colors.Primary else THEME.Locked,
		Text = if god.Available then "Worship " .. god.DisplayName else "Coming soon",
		TextSize = 17,
		Parent = card,
	})
	if not god.Available then
		choose.AutoButtonColor = false
	end
	choose.Activated:Connect(function()
		if god.Available then
			godRemote:FireServer("Choose", godId)
		end
	end)
end

--------------------------------------------------------------------------
-- 3. Gods & Blessings menu
--------------------------------------------------------------------------
local panel = create("Frame", {
	Name = "Panel",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(620, 500),
	BackgroundColor3 = THEME.Marble,
	Visible = false,
	Parent = gui,
}, { corner(12), padding(14) })
local panelStroke = stroke(THEME.Gold, 3)
panelStroke.Parent = panel

local titleLabel = text({ Size = UDim2.new(1, -50, 0, 36), Font = TITLE_FONT, TextSize = 34, Text = "", Parent = panel })
local closeButton = button({
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.fromScale(1, 0),
	Size = UDim2.fromOffset(40, 40),
	BackgroundColor3 = THEME.Bronze,
	Text = "X",
	TextSize = 20,
	Parent = panel,
})
local loyaltyLabel = text({ Position = UDim2.fromOffset(0, 40), Size = UDim2.new(1, -50, 0, 20), Font = BODY_FONT, TextSize = 16, TextColor3 = THEME.Bronze, Text = "", Parent = panel })
local worshipLabel = text({ Position = UDim2.fromOffset(0, 62), Size = UDim2.new(1, 0, 0, 18), TextSize = 14, TextColor3 = THEME.SubText, Text = "", Parent = panel })
local bonusLabel = text({ Position = UDim2.fromOffset(0, 82), Size = UDim2.new(1, 0, 0, 18), TextSize = 14, TextColor3 = THEME.SubText, Text = "", Parent = panel })

local list = create("ScrollingFrame", {
	Name = "List",
	Position = UDim2.fromOffset(0, 108),
	Size = UDim2.new(1, 0, 1, -108),
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	ScrollBarThickness = 6,
	ScrollBarImageColor3 = THEME.Bronze,
	CanvasSize = UDim2.new(),
	AutomaticCanvasSize = Enum.AutomaticSize.Y,
	ScrollingDirection = Enum.ScrollingDirection.Y,
	Parent = panel,
}, {
	create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	create("UIPadding", { PaddingRight = UDim.new(0, 10) }),
})

-- Five blessing rows (re-filled for whichever god you worship)
local blessingRows = {}
for tier = 1, #GodConfig.Tiers do
	local row = create("Frame", {
		Name = "Blessing" .. tier,
		Size = UDim2.new(1, 0, 0, 84),
		BackgroundColor3 = THEME.MarbleDark,
		LayoutOrder = tier,
		Parent = list,
	}, { corner(8), padding(8) })
	local r = {
		Frame = row,
		Name = text({ Size = UDim2.new(1, -150, 0, 22), Font = BODY_FONT, TextSize = 17, Text = "", Parent = row }),
		Description = text({ Position = UDim2.fromOffset(0, 22), Size = UDim2.new(1, -150, 0, 18), TextSize = 13, TextColor3 = THEME.SubText, TextTruncate = Enum.TextTruncate.AtEnd, Text = "", Parent = row }),
		Effect = text({ Position = UDim2.fromOffset(0, 41), Size = UDim2.new(1, -150, 0, 18), TextSize = 14, Text = "", Parent = row }),
		Status = text({ Position = UDim2.fromOffset(0, 59), Size = UDim2.new(1, -150, 0, 16), Font = BODY_FONT, TextSize = 13, TextColor3 = THEME.Warning, Text = "", Parent = row }),
		Button = button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.fromScale(1, 0.5),
			Size = UDim2.fromOffset(136, 56),
			BackgroundColor3 = THEME.Locked,
			Text = "",
			TextSize = 15,
			Parent = row,
		}),
		BlessingId = nil,
	}
	r.Button.Activated:Connect(function()
		if r.BlessingId then
			godRemote:FireServer("UpgradeBlessing", r.BlessingId)
		end
	end)
	blessingRows[tier] = r
end

-- Change-god section (last in the list)
local changeFrame = create("Frame", {
	Name = "ChangeGod",
	Size = UDim2.new(1, 0, 0, 0),
	AutomaticSize = Enum.AutomaticSize.Y,
	BackgroundColor3 = THEME.MarbleDark,
	LayoutOrder = 100,
	Parent = list,
}, {
	corner(8),
	padding(8),
	create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
})
text({ Size = UDim2.new(1, 0, 0, 22), Font = BODY_FONT, TextSize = 17, Text = "Change God", LayoutOrder = 1, Parent = changeFrame })
local changeInfo = text({
	Size = UDim2.new(1, 0, 0, 36),
	TextSize = 13,
	TextColor3 = THEME.SubText,
	TextWrapped = true,
	TextYAlignment = Enum.TextYAlignment.Top,
	LayoutOrder = 2,
	Text = "",
	Parent = changeFrame,
})
local changeButtons = {}
for i, godId in GodConfig.Order do
	if GodConfig.IsPlayable(godId) then
		local b = button({
			Name = "SwitchTo" .. godId,
			Size = UDim2.new(1, 0, 0, 38),
			BackgroundColor3 = GodConfig.Gods[godId].Colors.Primary,
			Text = "Start switching to " .. godName(godId),
			TextSize = 15,
			LayoutOrder = 10 + i,
			Parent = changeFrame,
		})
		b.Activated:Connect(function()
			godRemote:FireServer("StartChange", godId)
		end)
		changeButtons[godId] = b
	end
end
local cancelButton = button({
	Name = "Cancel",
	Size = UDim2.new(1, 0, 0, 38),
	BackgroundColor3 = THEME.Bronze,
	Text = "Cancel god change",
	TextSize = 15,
	LayoutOrder = 50,
	Parent = changeFrame,
})
cancelButton.Activated:Connect(function()
	godRemote:FireServer("CancelChange")
end)

--------------------------------------------------------------------------
-- Refresh from attributes
--------------------------------------------------------------------------
local function statName(stat)
	if stat == "AttackPercent" then
		return "attack"
	elseif stat == "HealthPercent" then
		return "health"
	end
	return "speed"
end

local function refreshTimers()
	local now = serverNow()
	local worshipIn = math.ceil((player:GetAttribute("NextWorshipAt") or 0) - now)
	worshipLabel.Text = if worshipIn > 0
		then ("Worship again in %ds at your god's statue in the Hall of the Gods"):format(worshipIn)
		else "Worship is ready: visit your god's statue in the Hall of the Gods"

	local target = player:GetAttribute("GodChangeTarget") or ""
	if target ~= "" then
		local prayers = player:GetAttribute("GodChangePrayers") or 0
		local prayIn = math.ceil((player:GetAttribute("NextPrayerAt") or 0) - now)
		changeInfo.Text = ("Switching to %s: prayers %d / %d at the Shrine of Change%s. Your levels, currencies, temple and blessings are kept."):format(
			godName(target),
			prayers,
			GodConfig.GodChange.PrayersNeeded,
			if prayIn > 0 then (" (next prayer in %ds)"):format(prayIn) else ""
		)
	else
		changeInfo.Text = ("Start a change below, then pray %d times at the Shrine of Change. Your levels, currencies, temple and blessings are kept."):format(GodConfig.GodChange.PrayersNeeded)
	end
end

local function refresh()
	local godId = player:GetAttribute("SelectedGod") or ""
	local god = GodConfig.Gods[godId]
	local loaded = player:GetAttribute("DataLoaded") == true

	gui.Enabled = loaded
	chooser.Visible = loaded and godId == "" and player:GetAttribute("SelectedGod") ~= nil
	badge.Visible = god ~= nil

	if not god then
		panel.Visible = false
		return
	end

	local loyalty = player:GetAttribute("Loyalty") or 0
	badgeName.Text = god.DisplayName
	badgeName.TextColor3 = god.Colors.Primary
	badgeSub.Text = ("%s · Loyalty %s"):format(god.Title, Progression.FormatNumber(loyalty))

	titleLabel.Text = ("%s, %s"):format(god.DisplayName, god.Title)
	titleLabel.TextColor3 = god.Colors.Primary
	panelStroke.Color = god.Colors.Primary
	loyaltyLabel.Text = ("Loyalty %s   ·   Divine Favor %s"):format(
		Progression.FormatNumber(loyalty),
		Progression.FormatNumber(player:GetAttribute("DivineFavor") or 0)
	)
	bonusLabel.Text = ("Blessing bonuses: +%d%% attack   +%d%% health   +%d%% speed"):format(
		player:GetAttribute("BonusAttackPercent") or 0,
		player:GetAttribute("BonusHealthPercent") or 0,
		player:GetAttribute("BonusSpeedPercent") or 0
	)

	local favor = player:GetAttribute("DivineFavor") or 0
	local altarLevel = player:GetAttribute("Temple_MainAltar") or 0
	local rankIndex = player:GetAttribute("RankIndex") or 1

	for tier, r in blessingRows do
		local blessing = nil
		for _, b in god.Blessings do
			if b.Tier == tier then
				blessing = b
			end
		end
		r.Frame.Visible = blessing ~= nil
		r.BlessingId = blessing and blessing.Id
		if blessing then
			local level = player:GetAttribute("Blessing_" .. blessing.Id) or 0
			local info = GodConfig.GetBlessingUpgradeInfo(blessing.Id, level, altarLevel, loyalty, rankIndex)
			local per = blessing.Passive.PerLevel
			r.Name.Text = ("Tier %d: %s   Lv %d/%d"):format(tier, blessing.Name, level, GodConfig.MaxBlessingLevel)
			r.Description.Text = ("%s (%s ability, Phase 4)"):format(blessing.Description, blessing.Ability)
			if info.Maxed then
				r.Effect.Text = ("Bonus: +%d%% %s"):format(level * per, statName(blessing.Passive.Stat))
				r.Status.Text = ""
				r.Button.Text = "MAX"
				r.Button.BackgroundColor3 = THEME.Gold
			else
				r.Effect.Text = ("Bonus: +%d%% -> +%d%% %s"):format(level * per, (level + 1) * per, statName(blessing.Passive.Stat))
				if info.Blocked then
					r.Status.Text = "Locked: " .. info.Blocked
					r.Button.Text = "Locked"
					r.Button.BackgroundColor3 = THEME.Locked
				else
					local canAfford = favor >= info.Cost
					r.Status.Text = if canAfford then "" else "Not enough Divine Favor yet"
					r.Button.Text = (if level == 0 then "Unlock" else "Upgrade") .. "\n" .. Progression.FormatNumber(info.Cost) .. " Favor"
					r.Button.BackgroundColor3 = if canAfford then THEME.Ready else THEME.TooExpensive
				end
			end
		end
	end

	local target = player:GetAttribute("GodChangeTarget") or ""
	for id, b in changeButtons do
		b.Visible = target == "" and id ~= godId
	end
	cancelButton.Visible = target ~= ""
	refreshTimers()
end

local watched = {
	"DataLoaded", "SelectedGod", "Loyalty", "DivineFavor", "Temple_MainAltar", "RankIndex",
	"BonusAttackPercent", "BonusHealthPercent", "BonusSpeedPercent",
	"GodChangeTarget", "GodChangePrayers", "NextPrayerAt", "NextWorshipAt",
}
for blessingId in GodConfig.BlessingsById do
	table.insert(watched, "Blessing_" .. blessingId)
end
for _, attribute in watched do
	player:GetAttributeChangedSignal(attribute):Connect(refresh)
end
refresh()

-- Tick the countdown timers once a second while the menu is open.
task.spawn(function()
	while true do
		task.wait(1)
		if panel.Visible then
			refreshTimers()
		end
	end
end)

--------------------------------------------------------------------------
-- Open / close
--------------------------------------------------------------------------
local function openMenu(section)
	if (player:GetAttribute("SelectedGod") or "") == "" then
		refresh() -- shows the chooser instead
		return
	end
	refresh()
	panel.Visible = true
	if section == "Change" then
		task.defer(function()
			list.CanvasPosition = Vector2.new(0, list.AbsoluteCanvasSize.Y)
		end)
	else
		list.CanvasPosition = Vector2.zero
	end
end

badge.Activated:Connect(function()
	if panel.Visible then
		panel.Visible = false
	else
		openMenu("Blessings")
	end
end)
closeButton.Activated:Connect(function()
	panel.Visible = false
end)

-- The server opens the menu from the Hall of the Gods and the Shrine of Change.
notifyRemote.OnClientEvent:Connect(function(kind, section)
	if kind == "OpenGodMenu" then
		openMenu(section)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="64">
        <Properties>
          <string name="Name">HUDController</string>
          <string name="Source"><![CDATA[-- HUDController (LocalScript)
-- Location: StarterPlayer > StarterPlayerScripts > HUDController
--
-- Builds the Phase 1 interface in code: loading screen, level / rank / XP
-- panel, currency panel, travel buttons, and pop-up notifications.
-- Display only: it reads values the server publishes as Player Attributes
-- and never changes any game data itself.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local Progression = require(Shared:WaitForChild("Progression"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local notifyRemote = Remotes:WaitForChild("Notify")
local teleportRemote = Remotes:WaitForChild("RequestTeleport")

local THEME = {
	Marble = Color3.fromRGB(246, 242, 232),
	Gold = Color3.fromRGB(212, 175, 55),
	Bronze = Color3.fromRGB(140, 92, 45),
	Text = Color3.fromRGB(58, 44, 28),
	BarBack = Color3.fromRGB(60, 52, 44),
	Night = Color3.fromRGB(18, 22, 38),
	White = Color3.new(1, 1, 1),
	Warning = Color3.fromRGB(175, 55, 35),
}
local TITLE_FONT = Enum.Font.Garamond
local BODY_FONT = Enum.Font.GothamBold

--------------------------------------------------------------------------
-- Small UI helpers
--------------------------------------------------------------------------
local function create(className, props, children)
	local inst = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			inst[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

local function corner(radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius) })
end

local function stroke(color, thickness)
	return create("UIStroke", { Color = color, Thickness = thickness, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

local function padding(px)
	return create("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
	})
end

--------------------------------------------------------------------------
-- Loading screen (hidden once the server says data is loaded)
--------------------------------------------------------------------------
local loadingGui = create("ScreenGui", {
	Name = "LoadingScreen",
	IgnoreGuiInset = true,
	DisplayOrder = 100,
	ResetOnSpawn = false,
	Parent = playerGui,
})
local loadingFrame = create("Frame", {
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = THEME.Night,
	Parent = loadingGui,
})
create("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.42),
	Size = UDim2.fromScale(0.8, 0.12),
	BackgroundTransparency = 1,
	Text = "MOUNT OLYMPUS",
	Font = TITLE_FONT,
	TextScaled = true,
	TextColor3 = THEME.Gold,
	Parent = loadingFrame,
})
create("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.52),
	Size = UDim2.fromScale(0.6, 0.06),
	BackgroundTransparency = 1,
	Text = "Rise of the Gods",
	Font = TITLE_FONT,
	TextScaled = true,
	TextColor3 = THEME.Marble,
	Parent = loadingFrame,
})
create("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.64),
	Size = UDim2.fromScale(0.6, 0.04),
	BackgroundTransparency = 1,
	Text = "Loading your progress...",
	Font = BODY_FONT,
	TextScaled = true,
	TextColor3 = Color3.fromRGB(190, 190, 205),
	Parent = loadingFrame,
})

local function updateLoading()
	if player:GetAttribute("DataLoaded") == true then
		loadingGui.Enabled = false
	end
end
player:GetAttributeChangedSignal("DataLoaded"):Connect(updateLoading)
updateLoading()

--------------------------------------------------------------------------
-- HUD
--------------------------------------------------------------------------
local hud = create("ScreenGui", {
	Name = "HUD",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = playerGui,
})
local uiScale = create("UIScale", { Parent = hud })

-- Shrink/grow the whole HUD to fit phones, tablets and PCs.
local function updateScale()
	local camera = Workspace.CurrentCamera
	local viewport = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	local scale = math.min(viewport.X / 1280, viewport.Y / 720)
	uiScale.Scale = math.clamp(scale, 0.7, 1.2)
end
updateScale()
if Workspace.CurrentCamera then
	Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
end

-- Level / rank / XP panel (top-left)
local statsPanel = create("Frame", {
	Name = "StatsPanel",
	Position = UDim2.fromOffset(12, 12),
	Size = UDim2.fromOffset(290, 92),
	BackgroundColor3 = THEME.Marble,
	BackgroundTransparency = 0.05,
	Parent = hud,
}, { corner(10), stroke(THEME.Gold, 2), padding(10) })

local levelLabel = create("TextLabel", {
	Name = "Level",
	Size = UDim2.fromOffset(80, 26),
	BackgroundTransparency = 1,
	Text = "Lv. 1",
	Font = BODY_FONT,
	TextSize = 22,
	TextColor3 = THEME.Text,
	TextXAlignment = Enum.TextXAlignment.Left,
	Parent = statsPanel,
})

local rankBadge = create("TextLabel", {
	Name = "Rank",
	Position = UDim2.fromOffset(84, 0),
	Size = UDim2.new(1, -84, 0, 26),
	BackgroundColor3 = GameConfig.Ranks[1].Color,
	Text = "Mortal",
	Font = TITLE_FONT,
	TextSize = 22,
	TextColor3 = THEME.White,
	TextStrokeTransparency = 0.6,
	Parent = statsPanel,
}, { corner(6) })

local xpBack = create("Frame", {
	Name = "XPBar",
	Position = UDim2.fromOffset(0, 32),
	Size = UDim2.new(1, 0, 0, 20),
	BackgroundColor3 = THEME.BarBack,
	Parent = statsPanel,
}, { corner(6) })

local xpFill = create("Frame", {
	Name = "Fill",
	Size = UDim2.fromScale(0, 1),
	BackgroundColor3 = THEME.Gold,
	Parent = xpBack,
}, { corner(6) })

local xpText = create("TextLabel", {
	Name = "XPText",
	Size = UDim2.fromScale(1, 1),
	BackgroundTransparency = 1,
	Text = "0 / 100 XP",
	Font = BODY_FONT,
	TextSize = 14,
	TextColor3 = THEME.White,
	TextStrokeTransparency = 0.4,
	ZIndex = 2,
	Parent = xpBack,
})

local trialLabel = create("TextLabel", {
	Name = "TrialReady",
	Position = UDim2.fromOffset(0, 56),
	Size = UDim2.new(1, 0, 0, 16),
	BackgroundTransparency = 1,
	Text = "Level cap reached! Your ascension trial awaits.",
	Font = BODY_FONT,
	TextScaled = true,
	TextColor3 = THEME.Warning,
	TextXAlignment = Enum.TextXAlignment.Left,
	Visible = false,
	Parent = statsPanel,
}, { create("UITextSizeConstraint", { MaxTextSize = 14 }) })

-- Currency panel (top-right)
local currencyPanel = create("Frame", {
	Name = "CurrencyPanel",
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -12, 0, 12),
	Size = UDim2.fromOffset(200, 100),
	BackgroundColor3 = THEME.Marble,
	BackgroundTransparency = 0.05,
	Parent = hud,
}, {
	corner(10),
	stroke(THEME.Gold, 2),
	padding(10),
	create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
})

local currencyLabels = {}
for i, name in GameConfig.Currencies do
	local info = GameConfig.CurrencyInfo[name]
	local row = create("Frame", {
		Name = name,
		Size = UDim2.new(1, 0, 0, 24),
		BackgroundTransparency = 1,
		LayoutOrder = i,
		Parent = currencyPanel,
	})
	create("Frame", {
		Name = "Icon",
		Position = UDim2.new(0, 0, 0.5, -8),
		Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = info.Color,
		Parent = row,
	}, { corner(8), stroke(THEME.Bronze, 1) })
	create("TextLabel", {
		Name = "Name",
		Position = UDim2.fromOffset(24, 0),
		Size = UDim2.new(0.55, -24, 1, 0),
		BackgroundTransparency = 1,
		Text = info.DisplayName,
		Font = BODY_FONT,
		TextSize = 15,
		TextColor3 = THEME.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})
	currencyLabels[name] = create("TextLabel", {
		Name = "Amount",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.45, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "0",
		Font = BODY_FONT,
		TextSize = 18,
		TextColor3 = THEME.Text,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = row,
	})
end

-- Travel buttons (under the stats panel; clear of mobile thumbstick and jump button)
local travelBar = create("Frame", {
	Name = "TravelBar",
	Position = UDim2.fromOffset(12, 112),
	Size = UDim2.fromOffset(290, 42),
	BackgroundTransparency = 1,
	Parent = hud,
}, {
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}),
})

local function makeButton(text, order)
	return create("TextButton", {
		Name = text,
		Size = UDim2.new(1 / 3, -7, 1, 0),
		BackgroundColor3 = THEME.Bronze,
		Text = text,
		Font = BODY_FONT,
		TextSize = 17,
		TextColor3 = THEME.White,
		LayoutOrder = order,
		AutoButtonColor = true,
		Parent = travelBar,
	}, { corner(8), stroke(THEME.Gold, 2) })
end
local templeButton = makeButton("My Temple", 1)
local plazaButton = makeButton("Plaza", 2)
local practiceButton = makeButton("Practice", 3)

-- Build label (bottom-left), to check which update this server is running
create("TextLabel", {
	Name = "BuildLabel",
	AnchorPoint = Vector2.new(0, 1),
	Position = UDim2.new(0, 8, 1, -4),
	Size = UDim2.fromOffset(120, 16),
	BackgroundTransparency = 1,
	Text = "Mount Olympus " .. GameConfig.BuildLabel,
	Font = BODY_FONT,
	TextSize = 12,
	TextColor3 = THEME.White,
	TextTransparency = 0.3,
	TextStrokeTransparency = 0.6,
	TextXAlignment = Enum.TextXAlignment.Left,
	Parent = hud,
})

-- Pop-up notification (upper centre)
local toast = create("Frame", {
	Name = "Toast",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0.2, 0),
	Size = UDim2.fromOffset(380, 54),
	BackgroundColor3 = THEME.Marble,
	Visible = false,
	Parent = hud,
}, { corner(10), padding(8) })
local toastStroke = stroke(THEME.Gold, 3)
toastStroke.Parent = toast
local toastLabel = create("TextLabel", {
	Size = UDim2.fromScale(1, 1),
	BackgroundTransparency = 1,
	Text = "",
	Font = BODY_FONT,
	TextScaled = true,
	TextColor3 = THEME.Text,
	Parent = toast,
}, { create("UITextSizeConstraint", { MaxTextSize = 20 }) })

local toastToken = 0
local function showToast(text, color)
	toastToken += 1
	local myToken = toastToken

	toastLabel.Text = text
	toastStroke.Color = color or THEME.Gold
	toast.BackgroundTransparency = 1
	toastLabel.TextTransparency = 1
	toastStroke.Transparency = 1
	toast.Position = UDim2.new(0.5, 0, 0.2, -20)
	toast.Visible = true

	local inInfo = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	TweenService:Create(toast, inInfo, { Position = UDim2.new(0.5, 0, 0.2, 0), BackgroundTransparency = 0.05 }):Play()
	TweenService:Create(toastLabel, inInfo, { TextTransparency = 0 }):Play()
	TweenService:Create(toastStroke, inInfo, { Transparency = 0 }):Play()

	task.delay(2.8, function()
		if myToken ~= toastToken then
			return
		end
		local outInfo = TweenInfo.new(0.4)
		TweenService:Create(toast, outInfo, { BackgroundTransparency = 1 }):Play()
		TweenService:Create(toastLabel, outInfo, { TextTransparency = 1 }):Play()
		TweenService:Create(toastStroke, outInfo, { Transparency = 1 }):Play()
		task.wait(0.4)
		if myToken == toastToken then
			toast.Visible = false
		end
	end)
end

--------------------------------------------------------------------------
-- Keep the HUD in sync with the server's attributes
--------------------------------------------------------------------------
local function updateStats()
	local level = player:GetAttribute("Level") or 1
	local xp = player:GetAttribute("XP") or 0
	local need = player:GetAttribute("XPToNext") or 0
	local rankIndex = player:GetAttribute("RankIndex") or 1
	local rank = Progression.GetRank(rankIndex)

	levelLabel.Text = "Lv. " .. level
	rankBadge.Text = rank.Name
	rankBadge.BackgroundColor3 = rank.Color

	local ratio = 1
	if need > 0 then
		ratio = math.clamp(xp / need, 0, 1)
		xpText.Text = Progression.FormatNumber(xp) .. " / " .. Progression.FormatNumber(need) .. " XP"
	else
		xpText.Text = "MAX LEVEL"
	end
	TweenService:Create(xpFill, TweenInfo.new(0.25), { Size = UDim2.fromScale(ratio, 1) }):Play()

	trialLabel.Visible = player:GetAttribute("TrialReady") == true
end

local function updateCurrency(name)
	currencyLabels[name].Text = Progression.FormatNumber(player:GetAttribute(name) or 0)
end

for _, attribute in { "Level", "XP", "XPToNext", "RankIndex", "TrialReady" } do
	player:GetAttributeChangedSignal(attribute):Connect(updateStats)
end
for _, name in GameConfig.Currencies do
	player:GetAttributeChangedSignal(name):Connect(function()
		updateCurrency(name)
	end)
	updateCurrency(name)
end
updateStats()

--------------------------------------------------------------------------
-- Server notifications
--------------------------------------------------------------------------
notifyRemote.OnClientEvent:Connect(function(kind, value)
	if kind == "LevelUp" then
		showToast("LEVEL UP! You reached level " .. tostring(value), THEME.Gold)
	elseif kind == "RankUp" then
		showToast("ASCENSION! Your new rank: " .. tostring(value), Color3.fromRGB(120, 200, 255))
	elseif kind == "Message" then
		showToast(tostring(value), THEME.Bronze)
	end
end)

--------------------------------------------------------------------------
-- Travel buttons
--------------------------------------------------------------------------
local lastTravel = 0
local function requestTeleport(destination)
	if os.clock() - lastTravel < GameConfig.Teleport.Cooldown then
		showToast("The gods need a moment...", THEME.Bronze)
		return
	end
	lastTravel = os.clock()
	teleportRemote:FireServer(destination)
end

templeButton.Activated:Connect(function()
	requestTeleport("Temple")
end)
plazaButton.Activated:Connect(function()
	requestTeleport("Plaza")
end)
practiceButton.Activated:Connect(function()
	requestTeleport("Practice")
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="65">
        <Properties>
          <string name="Name">MasteryUI</string>
          <string name="Source"><![CDATA[-- MasteryUI (LocalScript)
-- Location: StarterPlayer > StarterPlayerScripts > MasteryUI
--
-- Phase 7E part 3:
--   * "Mastery" button (left, under Quests) -> Divine Mastery panel: your
--     god's mastery level, XP bar, bonuses, cosmetic unlocks, every god's
--     level, and Divine Incarnation info.
--   * Incarnate button (Elder God): fills with Divine Energy; when full, tap
--     it (or press T) to transform. Sits above the ability buttons.
-- Display only: the server tracks everything.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local MasteryConfig = require(Shared:WaitForChild("MasteryConfig"))
local GodConfig = require(Shared:WaitForChild("GodConfig"))
local Progression = require(Shared:WaitForChild("Progression"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local incarnationRemote = Remotes:WaitForChild("IncarnationAction")

local INC = MasteryConfig.Incarnation

local THEME = {
	Marble = Color3.fromRGB(246, 242, 232),
	MarbleDark = Color3.fromRGB(228, 220, 204),
	Gold = Color3.fromRGB(212, 175, 55),
	Bronze = Color3.fromRGB(140, 92, 45),
	Text = Color3.fromRGB(58, 44, 28),
	SubText = Color3.fromRGB(110, 95, 75),
	White = Color3.new(1, 1, 1),
	Ready = Color3.fromRGB(70, 150, 70),
	Locked = Color3.fromRGB(150, 150, 158),
	Bar = Color3.fromRGB(200, 190, 170),
	Mastery = Color3.fromRGB(120, 80, 170),
	Dark = Color3.fromRGB(35, 30, 45),
}

local function create(className, props, children)
	local inst = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			inst[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end
local function corner(r)
	return create("UICorner", { CornerRadius = UDim.new(0, r) })
end
local function stroke(color, t)
	return create("UIStroke", { Color = color, Thickness = t, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end
local function padding(px)
	return create("UIPadding", { PaddingTop = UDim.new(0, px), PaddingBottom = UDim.new(0, px), PaddingLeft = UDim.new(0, px), PaddingRight = UDim.new(0, px) })
end
local function text(props)
	props.BackgroundTransparency = 1
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	props.TextColor3 = props.TextColor3 or THEME.Text
	props.Font = props.Font or Enum.Font.Gotham
	return create("TextLabel", props)
end
local function button(props)
	props.AutoButtonColor = true
	props.Font = props.Font or Enum.Font.GothamBold
	props.TextColor3 = props.TextColor3 or THEME.White
	props.TextSize = props.TextSize or 14
	return create("TextButton", props, { corner(8) })
end


local gui = create("ScreenGui", { Name = "MasteryUI", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 8, Enabled = false, Parent = playerGui })
local uiScale = create("UIScale", { Parent = gui })
local function updateScale()
	local camera = Workspace.CurrentCamera
	local viewport = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	uiScale.Scale = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720), 0.7, 1.2)
end
updateScale()
if Workspace.CurrentCamera then
	Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
end
local function updateEnabled()
	gui.Enabled = player:GetAttribute("DataLoaded") == true
end
player:GetAttributeChangedSignal("DataLoaded"):Connect(updateEnabled)
updateEnabled()


local function readMastery()
	local raw = player:GetAttribute("MasteryJson")
	local ok, decoded = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	return if ok and type(decoded) == "table" then decoded else { God = "", Level = 0, XP = 0, Need = 0, Levels = {} }
end

local function godColors()
	local god = readMastery().God
	return GodConfig.GetColors(god or "")
end

--------------------------------------------------------------------------
-- 1. Mastery button and panel
--------------------------------------------------------------------------
local openButton = button({
	Position = UDim2.fromOffset(12, 306), Size = UDim2.fromOffset(290, 40),
	BackgroundColor3 = THEME.Mastery, Text = "Divine Mastery", TextSize = 17, Parent = gui,
})
stroke(THEME.Bronze, 2).Parent = openButton

local panel = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(680, 520),
	BackgroundColor3 = THEME.Marble, Visible = false, Parent = gui,
}, { corner(12), stroke(THEME.Mastery, 3), padding(14) })
local title = text({ Size = UDim2.new(1, -50, 0, 36), Font = Enum.Font.Garamond, TextSize = 32, Text = "Divine Mastery", Parent = panel })
local closeButton = button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromOffset(40, 40), BackgroundColor3 = THEME.Bronze, Text = "X", TextSize = 20, Parent = panel })
local xpBack = create("Frame", { Position = UDim2.fromOffset(0, 44), Size = UDim2.new(1, 0, 0, 16), BackgroundColor3 = THEME.Bar, BorderSizePixel = 0, Parent = panel }, { corner(6) })
local xpFill = create("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = THEME.Mastery, BorderSizePixel = 0, Parent = xpBack }, { corner(6) })
local xpText = text({ Position = UDim2.fromOffset(0, 62), Size = UDim2.new(1, 0, 0, 18), TextSize = 13, TextColor3 = THEME.SubText, Text = "", Parent = panel })
local bonusText = text({ Position = UDim2.fromOffset(0, 82), Size = UDim2.new(1, 0, 0, 20), Font = Enum.Font.GothamBold, TextSize = 15, Text = "", Parent = panel })

local list = create("ScrollingFrame", {
	Position = UDim2.fromOffset(0, 108), Size = UDim2.new(1, 0, 1, -108), BackgroundTransparency = 1, BorderSizePixel = 0,
	ScrollBarThickness = 6, ScrollBarImageColor3 = THEME.Bronze, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = panel,
}, { create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }), create("UIPadding", { PaddingRight = UDim.new(0, 10) }) })

local function section(name, order)
	text({ Size = UDim2.new(1, 0, 0, 24), Font = Enum.Font.Garamond, TextSize = 22, TextColor3 = THEME.Bronze, Text = name, LayoutOrder = order, Parent = list })
end

local function renderPanel()
	for _, child in list:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local m = readMastery()
	local god = GodConfig.Gods[m.God]
	local godName = if god then god.DisplayName else "your god"
	if not god then
		title.Text = "Divine Mastery"
		xpFill.Size = UDim2.fromScale(0, 1)
		xpText.Text = "Choose a god in the Hall of the Gods to start earning mastery."
		bonusText.Text = ""
		return
	end
	title.Text = ("%s Mastery   Lv %d/%d"):format(godName, m.Level, MasteryConfig.MaxLevel)
	if m.Level >= MasteryConfig.MaxLevel then
		xpFill.Size = UDim2.fromScale(1, 1)
		xpText.Text = "Mastery complete!"
	else
		xpFill.Size = UDim2.fromScale(math.clamp(m.XP / math.max(1, m.Need), 0, 1), 1)
		xpText.Text = ("%s / %s mastery XP · earn it by defeating enemies, winning arenas and challenges, worshipping and using %s's abilities"):format(
			Progression.FormatNumber(m.XP), Progression.FormatNumber(m.Need), godName)
	end
	xpFill.BackgroundColor3 = godColors().Accent
	bonusText.Text = ("Bonus: +%.1f%% attack, +%.1f%% health (max +%d%% at level %d)"):format(
		m.Level * MasteryConfig.AttackPercentPerLevel, m.Level * MasteryConfig.HealthPercentPerLevel,
		MasteryConfig.MaxLevel * MasteryConfig.AttackPercentPerLevel, MasteryConfig.MaxLevel)

	local order = 0
	order += 1
	section("Unlocks for " .. godName, order)
	for _, unlock in MasteryConfig.Unlocks do
		order += 1
		local done = m.Level >= unlock.Level
		local row = create("Frame", { Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = THEME.MarbleDark, LayoutOrder = order, Parent = list }, { corner(8), padding(6) })
		text({ Size = UDim2.new(1, -110, 0, 18), Font = Enum.Font.GothamBold, TextSize = 15, Text = unlock.Name, Parent = row })
		text({ Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, -110, 0, 16), TextSize = 12, TextColor3 = THEME.SubText, TextTruncate = Enum.TextTruncate.AtEnd, Text = unlock.Description:gsub("<God>", godName), Parent = row })
		text({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromOffset(105, 20), Font = Enum.Font.GothamBold, TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = if done then THEME.Ready else THEME.Locked,
			Text = if done then "Unlocked" else ("Level %d"):format(unlock.Level), Parent = row })
	end

	order += 1
	section("Divine Incarnation", order)
	local form = MasteryConfig.Forms[m.God] or MasteryConfig.DefaultForm
	local unlocked = player:GetAttribute("IncarnationUnlocked") == true
	local seconds = INC.BaseDuration + INC.DurationPerMastery * m.Level
	order += 1
	text({
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextSize = 14, TextWrapped = true, LayoutOrder = order, Parent = list,
		Text = ("%s: %s\nFill Divine Energy by hitting and defeating enemies (bosses give a lot), then press Incarnate%s. You transform for %.0f seconds: an opening blast, +%d%% health back, +%d%% attack, +%d%% speed, %d%% less damage taken. Higher mastery = longer."):format(
			form.Name, if unlocked then "unlocked!" else "unlocks at Elder God",
			if UserInputService.KeyboardEnabled then " (or press T)" else "",
			seconds, INC.HealPercent, form.AttackPercent or 0, form.SpeedPercent or 0, math.floor((1 - (form.DamageTaken or 1)) * 100 + 0.5)),
	})

	order += 1
	section("All gods", order)
	for godId, info in GodConfig.Gods do
		order += 1
		local level = (m.Levels and m.Levels[godId]) or 1
		text({ Size = UDim2.new(1, 0, 0, 20), TextSize = 14, LayoutOrder = order, Parent = list,
			Text = ("%s  ·  mastery level %d%s"):format(info.DisplayName, level, if godId == m.God then "  (current)" else "") })
	end
end

openButton.Activated:Connect(function()
	panel.Visible = not panel.Visible
	if panel.Visible then
		renderPanel()
	end
end)
closeButton.Activated:Connect(function()
	panel.Visible = false
end)
player:GetAttributeChangedSignal("MasteryJson"):Connect(function()
	if panel.Visible then
		renderPanel()
	end
end)

--------------------------------------------------------------------------
-- 2. Incarnate button (above the ability buttons)
--------------------------------------------------------------------------
local incGui = create("ScreenGui", { Name = "IncarnationUI", ResetOnSpawn = false, DisplayOrder = 7, Parent = playerGui })
local incButton = create("TextButton", {
	AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = THEME.Dark, AutoButtonColor = false, Text = "", Visible = false, Parent = incGui,
}, { corner(10), stroke(THEME.Gold, 2) })
local incFill = create("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = THEME.Gold, BackgroundTransparency = 0.35, BorderSizePixel = 0, Parent = incButton }, { corner(10) })
local incLabel = create("TextLabel", {
	Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextScaled = true, TextColor3 = THEME.White,
	TextStrokeTransparency = 0.4, Text = "", ZIndex = 2, Parent = incButton,
}, { create("UIPadding", { PaddingTop = UDim.new(0.18, 0), PaddingBottom = UDim.new(0.18, 0), PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6) }) })

local function layout()
	local camera = Workspace.CurrentCamera
	local viewport = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	if UserInputService.TouchEnabled then
		-- Same geometry as AbilityController's touch buttons, one row above them.
		local big = math.min(viewport.X, viewport.Y) > 500
		local jumpSize = if big then 120 else 70
		local jumpLeft = if big then 170 else 95
		local jumpTop = if big then 210 else 90
		local jumpCenterY = jumpTop - jumpSize / 2
		local gap = if big then 16 else 10
		local attackSize = math.floor(jumpSize * 1.05)
		local size = math.floor(jumpSize * 0.75)
		local qX = jumpLeft + gap + attackSize + gap + size / 2
		local rX = qX + size + gap
		local highY = jumpCenterY + size + gap
		local height = math.floor(size * 0.55)
		incButton.Size = UDim2.fromOffset(size * 2 + gap, height)
		incButton.Position = UDim2.new(1, -(qX + rX) / 2, 1, -(highY + size / 2 + gap + height / 2))
	else
		incButton.Size = UDim2.fromOffset(220, 40)
		incButton.Position = UDim2.new(0.5, 0, 1, -(24 + 24 + 14 + 68 + 12 + 20))
	end
end
layout()
if Workspace.CurrentCamera then
	Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(layout)
end

local function activate()
	if player:GetAttribute("IncarnationUnlocked") == true then
		incarnationRemote:FireServer("Activate")
	end
end
incButton.Activated:Connect(activate)
UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and input.KeyCode == INC.Key then
		activate()
	end
end)

RunService.Heartbeat:Connect(function()
	local unlocked = player:GetAttribute("IncarnationUnlocked") == true and player:GetAttribute("DataLoaded") == true
	incButton.Visible = unlocked
	if not unlocked then
		return
	end
	local left = (player:GetAttribute("IncarnationUntil") or 0) - Workspace:GetServerTimeNow()
	local colors = godColors()
	if left > 0 then
		incFill.Size = UDim2.fromScale(math.clamp(left / (INC.BaseDuration + INC.DurationPerMastery * MasteryConfig.MaxLevel), 0, 1), 1)
		incFill.BackgroundColor3 = colors.Glow or colors.Accent
		incLabel.Text = ("%s  %ds"):format(player:GetAttribute("IncarnationForm") or "Divine Form", math.ceil(left))
		return
	end
	local value = player:GetAttribute("DivineEnergy") or 0
	local full = value >= INC.EnergyMax
	incFill.Size = UDim2.fromScale(math.clamp(value / INC.EnergyMax, 0, 1), 1)
	incFill.BackgroundColor3 = if full then THEME.Gold else colors.Accent
	incFill.BackgroundTransparency = if full then 0.1 + 0.25 * math.abs(math.sin(os.clock() * 4)) else 0.35
	incLabel.Text = if full then "INCARNATE!" else ("Divine Energy %d%%"):format(math.floor(value / INC.EnergyMax * 100))
end)

-- Big title when you transform
local banner = create("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.3), Size = UDim2.fromOffset(700, 70),
	BackgroundTransparency = 1, Font = Enum.Font.Garamond, TextSize = 56, TextColor3 = THEME.Gold, TextStrokeTransparency = 0.2,
	TextTransparency = 1, TextStrokeColor3 = Color3.new(0, 0, 0), Text = "", Parent = incGui,
})
local lastUntil = 0
player:GetAttributeChangedSignal("IncarnationUntil"):Connect(function()
	local untilTime = player:GetAttribute("IncarnationUntil") or 0
	if untilTime > lastUntil and untilTime > Workspace:GetServerTimeNow() then
		local colors = godColors()
		banner.Text = string.upper(player:GetAttribute("IncarnationForm") or "Divine Form")
		banner.TextColor3 = colors.Accent
		banner.TextTransparency = 0
		banner.TextStrokeTransparency = 0.2
		TweenService:Create(banner, TweenInfo.new(2.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	end
	lastUntil = untilTime
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="66">
        <Properties>
          <string name="Name">QuestUI</string>
          <string name="Source"><![CDATA[-- QuestUI (LocalScript)
-- Location: StarterPlayer > StarterPlayerScripts > QuestUI
--
-- Phase 7D: quests on screen.
--   * Tracker (right side, under the god badge): up to 3 quests with
--     progress bars; finished ones first. Tap it to open the quest log.
--   * "Quests" button (left, under Weapons) opens the quest log: every
--     active quest grouped as Daily / Story / other chains, with rewards and
--     a Claim button when done.
-- Display only: the server tracks progress and pays rewards.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local questRemote = Remotes:WaitForChild("QuestAction")

local THEME = {
	Marble = Color3.fromRGB(246, 242, 232),
	MarbleDark = Color3.fromRGB(228, 220, 204),
	Gold = Color3.fromRGB(212, 175, 55),
	Bronze = Color3.fromRGB(140, 92, 45),
	Text = Color3.fromRGB(58, 44, 28),
	SubText = Color3.fromRGB(110, 95, 75),
	White = Color3.new(1, 1, 1),
	Ready = Color3.fromRGB(70, 150, 70),
	Bar = Color3.fromRGB(200, 190, 170),
	Quest = Color3.fromRGB(70, 110, 170),
	Daily = Color3.fromRGB(170, 90, 150),
}

local CATEGORY_ORDER = { "Daily", "Story", "Combat", "Boss", "Temple", "Worship", "Forge", "Challenge", "Mastery", "God" }
local CATEGORY_NAMES = {
	Daily = "Daily Quests (new ones every day)",
	Story = "Story",
	Combat = "Combat",
	Boss = "Boss Hunts",
	Temple = "Temple Building",
	Worship = "Devotion",
	Forge = "The Forge",
	Challenge = "Olympian Challenges",
	Mastery = "Divine Mastery",
	God = "Your God",
}
local CURRENCY_NAMES = { XP = "XP", Gold = "Gold", DivineFavor = "Favor", Ambrosia = "Ambrosia" }

local function create(className, props, children)
	local inst = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			inst[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end
local function corner(r)
	return create("UICorner", { CornerRadius = UDim.new(0, r) })
end
local function stroke(color, t)
	return create("UIStroke", { Color = color, Thickness = t, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end
local function padding(px)
	return create("UIPadding", { PaddingTop = UDim.new(0, px), PaddingBottom = UDim.new(0, px), PaddingLeft = UDim.new(0, px), PaddingRight = UDim.new(0, px) })
end
local function text(props)
	props.BackgroundTransparency = 1
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	props.TextColor3 = props.TextColor3 or THEME.Text
	props.Font = props.Font or Enum.Font.Gotham
	return create("TextLabel", props)
end
local function button(props)
	props.AutoButtonColor = true
	props.Font = props.Font or Enum.Font.GothamBold
	props.TextColor3 = props.TextColor3 or THEME.White
	props.TextSize = props.TextSize or 14
	return create("TextButton", props, { corner(8) })
end

local function rewardText(rewards)
	local parts = {}
	for _, currency in { "XP", "Gold", "DivineFavor", "Ambrosia" } do
		if rewards[currency] then
			table.insert(parts, ("+%d %s"):format(rewards[currency], CURRENCY_NAMES[currency]))
		end
	end
	return table.concat(parts, "  ")
end

local function progressBar(parent, position, size, fraction, color)
	local back = create("Frame", { Position = position, Size = size, BackgroundColor3 = THEME.Bar, BorderSizePixel = 0, Parent = parent }, { corner(4) })
	create("Frame", { Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1), BackgroundColor3 = color, BorderSizePixel = 0, Parent = back }, { corner(4) })
	return back
end

local gui = create("ScreenGui", { Name = "QuestUI", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 8, Enabled = false, Parent = playerGui })
local uiScale = create("UIScale", { Parent = gui })
local function updateScale()
	local camera = Workspace.CurrentCamera
	local viewport = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	uiScale.Scale = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720), 0.7, 1.2)
end
updateScale()
if Workspace.CurrentCamera then
	Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
end
local function updateEnabled()
	gui.Enabled = player:GetAttribute("DataLoaded") == true
end
player:GetAttributeChangedSignal("DataLoaded"):Connect(updateEnabled)
updateEnabled()

--------------------------------------------------------------------------
-- Open button (left, under "Weapons") and tracker (right, under god badge)
--------------------------------------------------------------------------
local openButton = button({
	Position = UDim2.fromOffset(12, 258), Size = UDim2.fromOffset(290, 40),
	BackgroundColor3 = THEME.Quest, Text = "Quests", TextSize = 17, Parent = gui,
})
stroke(THEME.Bronze, 2).Parent = openButton

local tracker = create("TextButton", {
	AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 172), Size = UDim2.fromOffset(230, 0),
	AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = THEME.Marble, BackgroundTransparency = 0.15,
	AutoButtonColor = false, Text = "", Parent = gui,
}, { corner(10), stroke(THEME.Gold, 2), padding(8), create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })

--------------------------------------------------------------------------
-- Quest log panel
--------------------------------------------------------------------------
local panel = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(700, 520),
	BackgroundColor3 = THEME.Marble, Visible = false, Parent = gui,
}, { corner(12), stroke(THEME.Quest, 3), padding(14) })
text({ Size = UDim2.new(1, -50, 0, 36), Font = Enum.Font.Garamond, TextSize = 34, Text = "Quests", Parent = panel })
local closeButton = button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromOffset(40, 40), BackgroundColor3 = THEME.Bronze, Text = "X", TextSize = 20, Parent = panel })
text({ Position = UDim2.fromOffset(0, 40), Size = UDim2.new(1, 0, 0, 20), TextSize = 13, TextColor3 = THEME.SubText, Text = "Finish a quest, then press Claim to collect the reward. Claiming a story quest unlocks the next one.", TextWrapped = true, Parent = panel })

local list = create("ScrollingFrame", {
	Position = UDim2.fromOffset(0, 66), Size = UDim2.new(1, 0, 1, -66), BackgroundTransparency = 1, BorderSizePixel = 0,
	ScrollBarThickness = 6, ScrollBarImageColor3 = THEME.Bronze, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = panel,
}, { create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }), create("UIPadding", { PaddingRight = UDim.new(0, 10) }) })

local quests = {}

local function readQuests()
	local raw = player:GetAttribute("QuestsJson")
	if type(raw) ~= "string" then
		return {}
	end
	local ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
	return if ok and type(decoded) == "table" then decoded else {}
end

local function questRow(quest, order)
	local color = if quest.Daily then THEME.Daily else THEME.Quest
	local row = create("Frame", { Size = UDim2.new(1, 0, 0, 74), BackgroundColor3 = THEME.MarbleDark, LayoutOrder = order, Parent = list }, { corner(8), padding(8) })
	text({ Size = UDim2.new(1, -130, 0, 20), Font = Enum.Font.GothamBold, TextSize = 16, Text = quest.Name, Parent = row })
	text({ Position = UDim2.fromOffset(0, 20), Size = UDim2.new(1, -130, 0, 18), TextSize = 13, TextColor3 = THEME.SubText, TextTruncate = Enum.TextTruncate.AtEnd, Text = quest.Description, Parent = row })
	progressBar(row, UDim2.fromOffset(0, 42), UDim2.new(1, -260, 0, 12), quest.Progress / math.max(1, quest.Count), if quest.Ready then THEME.Ready else color)
	text({ Position = UDim2.new(1, -255, 0, 38), Size = UDim2.fromOffset(120, 20), TextSize = 13, Text = ("%d / %d"):format(quest.Progress, quest.Count), Parent = row })
	text({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -125, 0, 38), Size = UDim2.fromOffset(0, 20), AutomaticSize = Enum.AutomaticSize.X, TextSize = 12, TextColor3 = THEME.Bronze, TextXAlignment = Enum.TextXAlignment.Right, Text = rewardText(quest.Rewards), Parent = row })
	local claim = button({
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromOffset(110, 44),
		BackgroundColor3 = if quest.Ready then THEME.Ready else THEME.Bar,
		Text = if quest.Ready then "Claim" else "In progress", TextSize = if quest.Ready then 16 else 12,
		AutoButtonColor = quest.Ready, Parent = row,
	})
	if quest.Ready then
		claim.Activated:Connect(function()
			claim.Text = "..."
			questRemote:FireServer("Claim", quest.Id)
		end)
	end
end

local function renderLog()
	for _, child in list:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local order = 0
	for _, category in CATEGORY_ORDER do
		local inCategory = {}
		for _, quest in quests do
			local questCategory = if quest.Daily then "Daily" else quest.Category
			if questCategory == category then
				table.insert(inCategory, quest)
			end
		end
		if #inCategory > 0 then
			order += 1
			text({ Size = UDim2.new(1, 0, 0, 24), Font = Enum.Font.Garamond, TextSize = 22, TextColor3 = THEME.Bronze, Text = CATEGORY_NAMES[category] or category, LayoutOrder = order, Parent = list })
			for _, quest in inCategory do
				order += 1
				questRow(quest, order)
			end
		end
	end
	if order == 0 then
		text({ Size = UDim2.new(1, 0, 0, 40), TextSize = 16, Text = "No quests right now. Check back tomorrow for new daily quests!", LayoutOrder = 1, Parent = list })
	end
end

local function renderTracker()
	for _, child in tracker:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	-- Finished first, then story, then the rest in log order.
	local sorted = table.clone(quests)
	local rank = {}
	for i, category in CATEGORY_ORDER do
		rank[category] = i
	end
	table.sort(sorted, function(a, b)
		if a.Ready ~= b.Ready then
			return a.Ready
		end
		local ra = if a.Daily then 0 else rank[a.Category] or 99
		local rb = if b.Daily then 0 else rank[b.Category] or 99
		if a.Category == "Story" then
			ra = -1
		end
		if b.Category == "Story" then
			rb = -1
		end
		return ra < rb
	end)
	local readyCount = 0
	for _, quest in quests do
		if quest.Ready then
			readyCount += 1
		end
	end
	text({ Size = UDim2.new(1, 0, 0, 18), Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = THEME.Bronze,
		Text = if readyCount > 0 then ("Quests  (%d to claim!)"):format(readyCount) else "Quests", LayoutOrder = 0, Parent = tracker })
	for i = 1, math.min(3, #sorted) do
		local quest = sorted[i]
		local item = create("Frame", { Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, LayoutOrder = i, Parent = tracker })
		text({ Size = UDim2.new(1, -50, 0, 16), Font = Enum.Font.GothamMedium, TextSize = 13, TextTruncate = Enum.TextTruncate.AtEnd, Text = quest.Name, Parent = item })
		text({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromOffset(50, 16), TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right,
			TextColor3 = if quest.Ready then THEME.Ready else THEME.SubText, Text = if quest.Ready then "Done!" else ("%d/%d"):format(quest.Progress, quest.Count), Parent = item })
		progressBar(item, UDim2.fromOffset(0, 20), UDim2.new(1, 0, 0, 8), quest.Progress / math.max(1, quest.Count), if quest.Ready then THEME.Ready elseif quest.Daily then THEME.Daily else THEME.Quest)
	end
	tracker.Visible = #sorted > 0
end

local function refresh()
	quests = readQuests()
	renderTracker()
	if panel.Visible then
		renderLog()
	end
	local readyCount = 0
	for _, quest in quests do
		if quest.Ready then
			readyCount += 1
		end
	end
	openButton.Text = if readyCount > 0 then ("Quests  (%d!)"):format(readyCount) else "Quests"
	openButton.BackgroundColor3 = if readyCount > 0 then THEME.Ready else THEME.Quest
end

local function open()
	panel.Visible = true
	renderLog()
end
openButton.Activated:Connect(function()
	if panel.Visible then
		panel.Visible = false
	else
		open()
	end
end)
tracker.Activated:Connect(open)
closeButton.Activated:Connect(function()
	panel.Visible = false
end)

player:GetAttributeChangedSignal("QuestsJson"):Connect(refresh)
refresh()
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="67">
        <Properties>
          <string name="Name">TempleUI</string>
          <string name="Source"><![CDATA[-- TempleUI (LocalScript)
-- Location: StarterPlayer > StarterPlayerScripts > TempleUI
--
-- The "Temple" button and the Temple Upgrades menu.
-- Display only: it reads the values the server publishes as Player
-- Attributes and SENDS upgrade requests. The server decides everything.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local TempleConfig = require(Shared:WaitForChild("TempleConfig"))
local Progression = require(Shared:WaitForChild("Progression"))

local upgradeRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("RequestUpgrade")

local THEME = {
	Marble = Color3.fromRGB(246, 242, 232),
	MarbleDark = Color3.fromRGB(228, 220, 204),
	Gold = Color3.fromRGB(212, 175, 55),
	Bronze = Color3.fromRGB(140, 92, 45),
	Text = Color3.fromRGB(58, 44, 28),
	SubText = Color3.fromRGB(110, 95, 75),
	White = Color3.new(1, 1, 1),
	Ready = Color3.fromRGB(70, 150, 70),
	TooExpensive = Color3.fromRGB(175, 80, 55),
	Locked = Color3.fromRGB(130, 130, 140),
	Warning = Color3.fromRGB(175, 55, 35),
}
local TITLE_FONT = Enum.Font.Garamond
local BODY_FONT = Enum.Font.GothamBold
local SMALL_FONT = Enum.Font.Gotham

--------------------------------------------------------------------------
-- Small UI helpers
--------------------------------------------------------------------------
local function create(className, props, children)
	local inst = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			inst[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

local function corner(radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius) })
end

local function stroke(color, thickness)
	return create("UIStroke", { Color = color, Thickness = thickness, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

local function padding(px)
	return create("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
	})
end

local function text(props)
	props.BackgroundTransparency = 1
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	props.TextColor3 = props.TextColor3 or THEME.Text
	return create("TextLabel", props)
end

--------------------------------------------------------------------------
-- Screen + scaling (same rules as the HUD)
--------------------------------------------------------------------------
local gui = create("ScreenGui", {
	Name = "TempleUI",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	DisplayOrder = 5,
	Enabled = false, -- shown once data has loaded
	Parent = playerGui,
})
local uiScale = create("UIScale", { Parent = gui })

local function updateScale()
	local camera = Workspace.CurrentCamera
	local viewport = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	uiScale.Scale = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720), 0.7, 1.2)
end
updateScale()
if Workspace.CurrentCamera then
	Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
end

local function updateEnabled()
	gui.Enabled = player:GetAttribute("DataLoaded") == true
end
player:GetAttributeChangedSignal("DataLoaded"):Connect(updateEnabled)
updateEnabled()

--------------------------------------------------------------------------
-- Open button (under the HUD's travel buttons)
--------------------------------------------------------------------------
local openButton = create("TextButton", {
	Name = "OpenTemple",
	Position = UDim2.fromOffset(12, 162),
	Size = UDim2.fromOffset(290, 40),
	BackgroundColor3 = THEME.Gold,
	Text = "Temple Upgrades",
	Font = BODY_FONT,
	TextSize = 17,
	TextColor3 = THEME.Text,
	AutoButtonColor = true,
	Parent = gui,
}, { corner(8), stroke(THEME.Bronze, 2) })

--------------------------------------------------------------------------
-- Menu panel
--------------------------------------------------------------------------
local panel = create("Frame", {
	Name = "Panel",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(600, 460),
	BackgroundColor3 = THEME.Marble,
	Visible = false,
	Parent = gui,
}, { corner(12), stroke(THEME.Gold, 3), padding(14) })

text({
	Name = "Title",
	Size = UDim2.new(1, -50, 0, 34),
	Text = "Temple Upgrades",
	Font = TITLE_FONT,
	TextSize = 32,
	Parent = panel,
})

local closeButton = create("TextButton", {
	Name = "Close",
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.fromScale(1, 0),
	Size = UDim2.fromOffset(40, 40),
	BackgroundColor3 = THEME.Bronze,
	Text = "X",
	Font = BODY_FONT,
	TextSize = 20,
	TextColor3 = THEME.White,
	Parent = panel,
}, { corner(8) })

local tierLabel = text({
	Name = "Tier",
	Position = UDim2.fromOffset(0, 38),
	Size = UDim2.new(1, -50, 0, 22),
	Text = "",
	Font = BODY_FONT,
	TextSize = 17,
	TextColor3 = THEME.Bronze,
	Parent = panel,
})

local incomeLabel = text({
	Name = "Income",
	Position = UDim2.fromOffset(0, 62),
	Size = UDim2.new(1, 0, 0, 20),
	Text = "",
	Font = SMALL_FONT,
	TextSize = 15,
	TextColor3 = THEME.SubText,
	Parent = panel,
})

local list = create("ScrollingFrame", {
	Name = "List",
	Position = UDim2.fromOffset(0, 90),
	Size = UDim2.new(1, 0, 1, -90),
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	ScrollBarThickness = 6,
	ScrollBarImageColor3 = THEME.Bronze,
	CanvasSize = UDim2.new(),
	AutomaticCanvasSize = Enum.AutomaticSize.Y,
	ScrollingDirection = Enum.ScrollingDirection.Y,
	Parent = panel,
}, {
	create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	create("UIPadding", { PaddingRight = UDim.new(0, 10) }),
})

-- One row per building
local rows = {}
for order, id in TempleConfig.BuildingOrder do
	local info = TempleConfig.Buildings[id]
	local row = create("Frame", {
		Name = id,
		Size = UDim2.new(1, 0, 0, 84),
		BackgroundColor3 = THEME.MarbleDark,
		LayoutOrder = order,
		Parent = list,
	}, { corner(8), padding(8) })

	local nameLabel = text({
		Name = "Name",
		Size = UDim2.new(1, -150, 0, 22),
		Font = BODY_FONT,
		TextSize = 18,
		Text = info.DisplayName,
		Parent = row,
	})
	text({
		Name = "Description",
		Position = UDim2.fromOffset(0, 22),
		Size = UDim2.new(1, -150, 0, 18),
		Font = SMALL_FONT,
		TextSize = 13,
		TextColor3 = THEME.SubText,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = info.Description,
		Parent = row,
	})
	local effectLabel = text({
		Name = "Effect",
		Position = UDim2.fromOffset(0, 41),
		Size = UDim2.new(1, -150, 0, 18),
		Font = SMALL_FONT,
		TextSize = 14,
		Text = "",
		Parent = row,
	})
	local statusLabel = text({
		Name = "Status",
		Position = UDim2.fromOffset(0, 59),
		Size = UDim2.new(1, -150, 0, 16),
		Font = BODY_FONT,
		TextSize = 13,
		TextColor3 = THEME.Warning,
		Text = "",
		Parent = row,
	})
	local button = create("TextButton", {
		Name = "Upgrade",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.fromOffset(136, 56),
		BackgroundColor3 = THEME.Locked,
		Text = "",
		Font = BODY_FONT,
		TextSize = 16,
		TextColor3 = THEME.White,
		Parent = row,
	}, { corner(8) })

	button.Activated:Connect(function()
		upgradeRemote:FireServer(id) -- the server checks cost, requirements and ownership
	end)

	rows[id] = { Name = nameLabel, Effect = effectLabel, Status = statusLabel, Button = button }
end

-- Phase 7E: Temple Prestige row (after the Divine Citadel)
local prestigeRow = create("Frame", {
	Name = "Prestige",
	Size = UDim2.new(1, 0, 0, 84),
	BackgroundColor3 = Color3.fromRGB(240, 226, 180),
	LayoutOrder = #TempleConfig.BuildingOrder + 1,
	Parent = list,
}, { corner(8), padding(8), stroke(THEME.Gold, 2) })
local prestigeName = text({ Size = UDim2.new(1, -150, 0, 22), Font = BODY_FONT, TextSize = 18, Text = "Temple Prestige", Parent = prestigeRow })
text({
	Position = UDim2.fromOffset(0, 22), Size = UDim2.new(1, -150, 0, 18), Font = SMALL_FONT, TextSize = 13, TextColor3 = THEME.SubText,
	TextTruncate = Enum.TextTruncate.AtEnd, Text = "Keep improving your Divine Citadel. Nothing resets.", Parent = prestigeRow,
})
local prestigeEffect = text({ Position = UDim2.fromOffset(0, 41), Size = UDim2.new(1, -150, 0, 18), Font = SMALL_FONT, TextSize = 14, TextTruncate = Enum.TextTruncate.AtEnd, Text = "", Parent = prestigeRow })
local prestigeStatus = text({ Position = UDim2.fromOffset(0, 59), Size = UDim2.new(1, -150, 0, 16), Font = BODY_FONT, TextSize = 13, TextColor3 = THEME.Warning, TextTruncate = Enum.TextTruncate.AtEnd, Text = "", Parent = prestigeRow })
local prestigeButton = create("TextButton", {
	AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromOffset(136, 56),
	BackgroundColor3 = THEME.Locked, Text = "", Font = BODY_FONT, TextSize = 14, TextColor3 = THEME.White, Parent = prestigeRow,
}, { corner(8) })
prestigeButton.Activated:Connect(function()
	upgradeRemote:FireServer("Prestige") -- the server checks everything
end)

--------------------------------------------------------------------------
-- Refresh from attributes
--------------------------------------------------------------------------
local function formatEffect(id, level)
	local info = TempleConfig.Buildings[id]
	if info.IsCore then
		local tier = TempleConfig.TierFromCoreLevel(level)
		if level >= TempleConfig.MaxBuildingLevel then
			return "Temple: " .. TempleConfig.GetTierName(tier)
		end
		return ("Temple: %s -> %s"):format(TempleConfig.GetTierName(tier), TempleConfig.GetTierName(tier + 1))
	end
	local now = TempleConfig.GetEffectValue(id, level)
	if level >= TempleConfig.MaxBuildingLevel then
		return ("%s: %s"):format(info.EffectLabel, Progression.FormatNumber(now))
	end
	local nextValue = TempleConfig.GetEffectValue(id, level + 1)
	return ("%s: %s -> %s"):format(info.EffectLabel, Progression.FormatNumber(now), Progression.FormatNumber(nextValue))
end

local function refresh()
	local tier = player:GetAttribute("TempleTier") or 1
	local gold = player:GetAttribute("Gold") or 0
	local playerLevel = player:GetAttribute("Level") or 1
	local rankIndex = player:GetAttribute("RankIndex") or 1

	tierLabel.Text = ("Tier %d: %s"):format(tier, TempleConfig.GetTierName(tier))
	incomeLabel.Text = ("Income while you play: +%s Gold/min   +%s Favor/min"):format(
		Progression.FormatNumber(player:GetAttribute("GoldPerMinute") or 0),
		Progression.FormatNumber(player:GetAttribute("FavorPerMinute") or 0)
	)

	for id, row in rows do
		local info = TempleConfig.Buildings[id]
		local level = player:GetAttribute("Temple_" .. id) or 0
		local upgrade = TempleConfig.GetUpgradeInfo(id, level, tier, playerLevel, rankIndex)

		row.Name.Text = ("%s   Lv %d/%d"):format(info.DisplayName, level, TempleConfig.MaxBuildingLevel)
		row.Effect.Text = formatEffect(id, level)

		if upgrade.Maxed then
			row.Status.Text = ""
			row.Button.Text = "MAX"
			row.Button.BackgroundColor3 = THEME.Gold
			row.Button.AutoButtonColor = false
		elseif upgrade.Blocked then
			row.Status.Text = "Locked: " .. upgrade.Blocked
			row.Button.Text = "Locked"
			row.Button.BackgroundColor3 = THEME.Locked
			row.Button.AutoButtonColor = false
		else
			local canAfford = gold >= upgrade.Cost
			row.Status.Text = if canAfford then "" else "Not enough Gold yet"
			row.Button.Text = (if level == 0 then "Build" else "Upgrade") .. "\n" .. Progression.FormatNumber(upgrade.Cost) .. " Gold"
			row.Button.BackgroundColor3 = if canAfford then THEME.Ready else THEME.TooExpensive
			row.Button.AutoButtonColor = true
		end
	end
end

local function refreshPrestige()
	local tier = player:GetAttribute("TempleTier") or 1
	local prestige = player:GetAttribute("TemplePrestige") or 0
	local buildings = {}
	for _, id in TempleConfig.BuildingOrder do
		buildings[id] = player:GetAttribute("Temple_" .. id) or 0
	end
	local info = TempleConfig.GetPrestigeInfo(prestige, tier, buildings)
	local p = TempleConfig.Prestige
	prestigeName.Text = ("Temple Prestige   %d/%d"):format(prestige, p.MaxLevel)
	local bonus = prestige * p.IncomeBonusPercent
	if info.Maxed then
		prestigeEffect.Text = ("Temple income +%d%%  ·  Radiant Citadel"):format(bonus)
		prestigeStatus.Text = ""
		prestigeButton.Text = "MAX"
		prestigeButton.BackgroundColor3 = THEME.Gold
		prestigeButton.AutoButtonColor = false
		return
	end
	prestigeEffect.Text = ("Income +%d%% -> +%d%%  ·  New: %s"):format(bonus, bonus + p.IncomeBonusPercent, p.Looks[info.NextLevel] or "")
	if info.Blocked then
		prestigeStatus.Text = "Locked: " .. info.Blocked
		prestigeButton.Text = "Locked"
		prestigeButton.BackgroundColor3 = THEME.Locked
		prestigeButton.AutoButtonColor = false
	else
		local canAfford = (player:GetAttribute("Gold") or 0) >= info.Gold and (player:GetAttribute("Ambrosia") or 0) >= info.Ambrosia
		prestigeStatus.Text = if canAfford then "" else "Not enough Gold or Ambrosia yet"
		prestigeButton.Text = ("Prestige\n%s Gold + %d Amb."):format(Progression.FormatNumber(info.Gold), info.Ambrosia)
		prestigeButton.BackgroundColor3 = if canAfford then THEME.Ready else THEME.TooExpensive
		prestigeButton.AutoButtonColor = true
	end
end

local watched = { "TempleTier", "Gold", "Level", "GoldPerMinute", "FavorPerMinute", "RankIndex", "TemplePrestige", "Ambrosia" }
for _, id in TempleConfig.BuildingOrder do
	table.insert(watched, "Temple_" .. id)
end
for _, attribute in watched do
	player:GetAttributeChangedSignal(attribute):Connect(refresh)
	player:GetAttributeChangedSignal(attribute):Connect(refreshPrestige)
end
refresh()
refreshPrestige()

--------------------------------------------------------------------------
-- Open / close
--------------------------------------------------------------------------
openButton.Activated:Connect(function()
	panel.Visible = not panel.Visible
	if panel.Visible then
		refresh()
	end
end)
closeButton.Activated:Connect(function()
	panel.Visible = false
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="68">
        <Properties>
          <string name="Name">TitanGateUI</string>
          <string name="Source"><![CDATA[-- TitanGateUI (LocalScript)
-- Location: StarterPlayer > StarterPlayerScripts > TitanGateUI
--
-- Phase 7E: the Titan Gate menu (opened from the gate's prompt). Lists the
-- Olympian Challenges with Heroic and Mythic buttons, what each pays, and
-- your clears / best times. Display only: the server checks ranks and runs
-- the fight.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ChallengeConfig = require(Shared:WaitForChild("ChallengeConfig"))
local Progression = require(Shared:WaitForChild("Progression"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local challengeRemote = Remotes:WaitForChild("ChallengeAction")
local notifyRemote = Remotes:WaitForChild("Notify")

local THEME = {
	Marble = Color3.fromRGB(246, 242, 232),
	MarbleDark = Color3.fromRGB(228, 220, 204),
	Bronze = Color3.fromRGB(140, 92, 45),
	Text = Color3.fromRGB(58, 44, 28),
	SubText = Color3.fromRGB(110, 95, 75),
	White = Color3.new(1, 1, 1),
	Locked = Color3.fromRGB(150, 150, 158),
	Danger = Color3.fromRGB(190, 50, 40),
	Titan = Color3.fromRGB(150, 70, 200),
	Cleared = Color3.fromRGB(70, 150, 70),
}

local function create(className, props, children)
	local inst = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			inst[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end
local function corner(r)
	return create("UICorner", { CornerRadius = UDim.new(0, r) })
end
local function stroke(color, t)
	return create("UIStroke", { Color = color, Thickness = t, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end
local function padding(px)
	return create("UIPadding", { PaddingTop = UDim.new(0, px), PaddingBottom = UDim.new(0, px), PaddingLeft = UDim.new(0, px), PaddingRight = UDim.new(0, px) })
end
local function text(props)
	props.BackgroundTransparency = 1
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	props.TextColor3 = props.TextColor3 or THEME.Text
	props.Font = props.Font or Enum.Font.Gotham
	return create("TextLabel", props)
end
local function button(props)
	props.AutoButtonColor = true
	props.Font = props.Font or Enum.Font.GothamBold
	props.TextColor3 = props.TextColor3 or THEME.White
	props.TextSize = props.TextSize or 14
	return create("TextButton", props, { corner(8) })
end


local gui = create("ScreenGui", { Name = "TitanGateUI", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 10, Parent = playerGui })
local uiScale = create("UIScale", { Parent = gui })
local function updateScale()
	local camera = Workspace.CurrentCamera
	local viewport = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	uiScale.Scale = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720), 0.7, 1.2)
end
updateScale()
if Workspace.CurrentCamera then
	Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
end
local function updateEnabled()
	gui.Enabled = player:GetAttribute("DataLoaded") == true
end
player:GetAttributeChangedSignal("DataLoaded"):Connect(updateEnabled)
updateEnabled()


local panel = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(720, 520),
	BackgroundColor3 = THEME.Marble, Visible = false, Parent = gui,
}, { corner(12), stroke(THEME.Titan, 3), padding(14) })
text({ Size = UDim2.new(1, -50, 0, 36), Font = Enum.Font.Garamond, TextSize = 34, Text = "Titan Gate: Olympian Challenges", Parent = panel })
local closeButton = button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromOffset(40, 40), BackgroundColor3 = THEME.Bronze, Text = "X", TextSize = 20, Parent = panel })
text({ Position = UDim2.fromOffset(0, 38), Size = UDim2.new(1, 0, 0, 34), TextSize = 13, TextColor3 = THEME.SubText, TextWrapped = true,
	Text = "Solo rematches against much stronger bosses. Heroic: once you can enter that boss's arena. Mythic and the Gauntlet: Elder Gods only. First clear of each difficulty gives bonus Ambrosia.", Parent = panel })

local list = create("ScrollingFrame", {
	Position = UDim2.fromOffset(0, 78), Size = UDim2.new(1, 0, 1, -78), BackgroundTransparency = 1, BorderSizePixel = 0,
	ScrollBarThickness = 6, ScrollBarImageColor3 = THEME.Bronze, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = panel,
}, { create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }), create("UIPadding", { PaddingRight = UDim.new(0, 10) }) })

local function readRecords()
	local raw = player:GetAttribute("ChallengesJson")
	local ok, decoded = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	return if ok and type(decoded) == "table" then decoded else {}
end

local function rewardLine(challenge, difficulty)
	local gold = math.floor((challenge.Rewards.Gold or 0) * difficulty.Reward)
	local ambrosia = math.floor((challenge.Rewards.Ambrosia or 0) * difficulty.Reward)
	return ("%s Gold, %d Ambrosia"):format(Progression.FormatNumber(gold), ambrosia)
end

local rows = {}
for order, challenge in ChallengeConfig.Challenges do
	local row = create("Frame", { Size = UDim2.new(1, 0, 0, 92), BackgroundColor3 = THEME.MarbleDark, LayoutOrder = order, Parent = list }, { corner(8), padding(8) })
	text({ Size = UDim2.new(1, -300, 0, 22), Font = Enum.Font.GothamBold, TextSize = 17, TextColor3 = challenge.Color or THEME.Text, Text = challenge.Name, Parent = row })
	text({ Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, -300, 0, 52), TextSize = 13, TextColor3 = THEME.SubText, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Text = challenge.Description, Parent = row })
	local buttons = {}
	for i, difficultyId in ChallengeConfig.DifficultyOrder do
		local difficulty = ChallengeConfig.Difficulties[difficultyId]
		local box = create("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -(2 - i) * 146, 0.5, 0), Size = UDim2.fromOffset(140, 76), BackgroundTransparency = 1, Parent = row })
		local b = button({ Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = difficulty.Color, Text = difficulty.Name, TextSize = 16, Parent = box })
		local info = text({ Position = UDim2.fromOffset(0, 42), Size = UDim2.new(1, 0, 0, 34), TextSize = 11, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top, Text = "", Parent = box })
		b.Activated:Connect(function()
			if not ChallengeConfig.LockReason(challenge, difficultyId, player:GetAttribute("RankIndex") or 1) then
				challengeRemote:FireServer("Start", challenge.Id, difficultyId)
				panel.Visible = false
			end
		end)
		buttons[difficultyId] = { Button = b, Info = info, Difficulty = difficulty }
	end
	rows[challenge.Id] = { Challenge = challenge, Buttons = buttons }
end

local function refresh()
	local recordsById = readRecords()
	local rank = player:GetAttribute("RankIndex") or 1
	for _, r in rows do
		for difficultyId, entry in r.Buttons do
			local reason = ChallengeConfig.LockReason(r.Challenge, difficultyId, rank)
			local record = recordsById[ChallengeConfig.Key(r.Challenge.Id, difficultyId)]
			entry.Button.BackgroundColor3 = if reason then THEME.Locked else entry.Difficulty.Color
			entry.Button.AutoButtonColor = reason == nil
			entry.Button.Text = if reason then entry.Difficulty.Name .. " (locked)" else entry.Difficulty.Name
			if reason then
				entry.Info.Text = reason
				entry.Info.TextColor3 = THEME.Danger
			elseif type(record) == "table" and (record.Clears or 0) > 0 then
				local best = record.Best or 0
				entry.Info.Text = ("Cleared x%d · best %d:%02d\n%s"):format(record.Clears, best // 60, best % 60, rewardLine(r.Challenge, entry.Difficulty))
				entry.Info.TextColor3 = THEME.Cleared
			else
				entry.Info.Text = rewardLine(r.Challenge, entry.Difficulty) .. "\n+" .. entry.Difficulty.FirstClearAmbrosia .. " first clear"
				entry.Info.TextColor3 = THEME.Text
			end
		end
	end
end
player:GetAttributeChangedSignal("ChallengesJson"):Connect(refresh)
player:GetAttributeChangedSignal("RankIndex"):Connect(refresh)
refresh()

closeButton.Activated:Connect(function()
	panel.Visible = false
end)
notifyRemote.OnClientEvent:Connect(function(kind)
	if kind == "OpenTitanGate" then
		refresh()
		panel.Visible = true
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="69">
        <Properties>
          <string name="Name">WeaponUI</string>
          <string name="Source"><![CDATA[-- WeaponUI (LocalScript)
-- Location: StarterPlayer > StarterPlayerScripts > WeaponUI
--
-- Phase 7C: the "Weapons" button and the weapons screen.
--   * My Weapons: everything you own, with stats; Equip (anywhere) and
--     Upgrade (at the Divine Forge).
--   * Forge: every weapon, its stats and where it comes from (craft cost or
--     boss drop); Craft at the Divine Forge.
-- Display only: the server checks costs, ownership and the forge distance.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local WeaponConfig = require(Shared:WaitForChild("WeaponConfig"))
local Progression = require(Shared:WaitForChild("Progression"))
local CombatConfig = require(Shared:WaitForChild("CombatConfig"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local weaponRemote = Remotes:WaitForChild("WeaponAction")
local notifyRemote = Remotes:WaitForChild("Notify")

local THEME = {
	Marble = Color3.fromRGB(246, 242, 232),
	MarbleDark = Color3.fromRGB(228, 220, 204),
	Gold = Color3.fromRGB(212, 175, 55),
	Bronze = Color3.fromRGB(140, 92, 45),
	Text = Color3.fromRGB(58, 44, 28),
	SubText = Color3.fromRGB(110, 95, 75),
	White = Color3.new(1, 1, 1),
	Ready = Color3.fromRGB(70, 150, 70),
	Locked = Color3.fromRGB(130, 130, 140),
	Forge = Color3.fromRGB(210, 110, 40),
}

local function create(className, props, children)
	local inst = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			inst[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end
local function corner(r)
	return create("UICorner", { CornerRadius = UDim.new(0, r) })
end
local function stroke(color, t)
	return create("UIStroke", { Color = color, Thickness = t, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end
local function padding(px)
	return create("UIPadding", { PaddingTop = UDim.new(0, px), PaddingBottom = UDim.new(0, px), PaddingLeft = UDim.new(0, px), PaddingRight = UDim.new(0, px) })
end
local function text(props)
	props.BackgroundTransparency = 1
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	props.TextColor3 = props.TextColor3 or THEME.Text
	props.Font = props.Font or Enum.Font.Gotham
	return create("TextLabel", props)
end
local function button(props)
	props.AutoButtonColor = true
	props.Font = props.Font or Enum.Font.GothamBold
	props.TextColor3 = props.TextColor3 or THEME.White
	props.TextSize = props.TextSize or 14
	return create("TextButton", props, { corner(8) })
end

local gui = create("ScreenGui", { Name = "WeaponUI", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 9, Enabled = false, Parent = playerGui })
local uiScale = create("UIScale", { Parent = gui })
local function updateScale()
	local camera = Workspace.CurrentCamera
	local viewport = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	uiScale.Scale = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720), 0.7, 1.2)
end
updateScale()
if Workspace.CurrentCamera then
	Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
end
local function updateEnabled()
	gui.Enabled = player:GetAttribute("DataLoaded") == true
end
player:GetAttributeChangedSignal("DataLoaded"):Connect(updateEnabled)
updateEnabled()

-- Button under "Temple Upgrades"
local openButton = button({
	Position = UDim2.fromOffset(12, 210), Size = UDim2.fromOffset(290, 40),
	BackgroundColor3 = THEME.Forge, Text = "Weapons", TextSize = 17, Parent = gui,
})
stroke(THEME.Bronze, 2).Parent = openButton

local panel = create("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(700, 520),
	BackgroundColor3 = THEME.Marble, Visible = false, Parent = gui,
}, { corner(12), stroke(THEME.Forge, 3), padding(14) })
text({ Size = UDim2.new(1, -50, 0, 36), Font = Enum.Font.Garamond, TextSize = 34, Text = "Weapons", Parent = panel })
local closeButton = button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromOffset(40, 40), BackgroundColor3 = THEME.Bronze, Text = "X", TextSize = 20, Parent = panel })
local myTab = button({ Position = UDim2.fromOffset(0, 42), Size = UDim2.fromOffset(160, 34), BackgroundColor3 = THEME.Forge, Text = "My Weapons", Parent = panel })
local forgeTab = button({ Position = UDim2.fromOffset(170, 42), Size = UDim2.fromOffset(160, 34), BackgroundColor3 = THEME.Locked, Text = "Forge", Parent = panel })
text({ Position = UDim2.fromOffset(340, 46), Size = UDim2.new(1, -340, 0, 28), TextSize = 13, TextColor3 = THEME.SubText, TextWrapped = true, Text = "Crafting and upgrading happen at the Divine Forge (east of the plaza).", Parent = panel })

local list = create("ScrollingFrame", {
	Position = UDim2.fromOffset(0, 84), Size = UDim2.new(1, 0, 1, -84), BackgroundTransparency = 1, BorderSizePixel = 0,
	ScrollBarThickness = 6, ScrollBarImageColor3 = THEME.Bronze, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = panel,
}, { create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }), create("UIPadding", { PaddingRight = UDim.new(0, 10) }) })

local currentTab = "Mine"

local function owned()
	local ok, items = pcall(function()
		return HttpService:JSONDecode(player:GetAttribute("WeaponsJson") or "[]")
	end)
	return if ok then items else {}
end

local function statsLine(weapon, level)
	local kind = WeaponConfig.Types[weapon.Type]
	local parts = {
		weapon.Type,
		("Power x%.2f"):format(WeaponConfig.Power(weapon.Id, level)),
		("Speed %.2fs"):format(kind.Cooldown * weapon.Speed),
		("Reach %d"):format(kind.Range),
	}
	local special = weapon.Special or {}
	if special.CritChance then
		table.insert(parts, ("Crit %d%%"):format(special.CritChance * 100))
	end
	if special.LifeSteal then
		table.insert(parts, ("Life steal %d%%"):format(special.LifeSteal * 100))
	end
	if special.Pierce then
		table.insert(parts, ("Pierces %d"):format(special.Pierce))
	end
	if special.ExtraTargets then
		table.insert(parts, ("+%d targets"):format(special.ExtraTargets))
	end
	return table.concat(parts, " · ")
end

local function costText(gold, ambrosia)
	local t = Progression.FormatNumber(gold) .. " Gold"
	if ambrosia and ambrosia > 0 then
		t ..= " + " .. ambrosia .. " Ambrosia"
	end
	return t
end

local function row(order, weapon, level, subtitle)
	local rarity = WeaponConfig.Rarities[weapon.Rarity]
	local frame = create("Frame", { Size = UDim2.new(1, 0, 0, 70), BackgroundColor3 = THEME.MarbleDark, LayoutOrder = order, Parent = list }, { corner(8), padding(8), stroke(rarity.Color, 2) })
	text({ Size = UDim2.new(1, -250, 0, 22), Font = Enum.Font.GothamBold, TextSize = 17, TextColor3 = rarity.Color,
		Text = weapon.Name .. (if level and level > 0 then (" +%d"):format(level) else "") .. "   (" .. rarity.Name .. ")", Parent = frame })
	text({ Position = UDim2.fromOffset(0, 22), Size = UDim2.new(1, -250, 0, 18), TextSize = 13, Text = statsLine(weapon, level or 0), Parent = frame })
	text({ Position = UDim2.fromOffset(0, 40), Size = UDim2.new(1, -250, 0, 16), TextSize = 12, TextColor3 = THEME.SubText, Text = subtitle or "", Parent = frame })
	return frame
end

local function refresh()
	for _, child in list:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	myTab.BackgroundColor3 = if currentTab == "Mine" then THEME.Forge else THEME.Locked
	forgeTab.BackgroundColor3 = if currentTab == "Forge" then THEME.Forge else THEME.Locked
	local items = owned()
	local equippedUid = player:GetAttribute("EquippedWeaponUid")
	local gold = player:GetAttribute("Gold") or 0
	local ambrosia = player:GetAttribute("Ambrosia") or 0
	local training = player:GetAttribute("Temple_TrainingGrounds") or 0

	if currentTab == "Mine" then
		table.sort(items, function(a, b)
			local wa, wb = WeaponConfig.Weapons[a.Id], WeaponConfig.Weapons[b.Id]
			return (wa and wa.Rarity or 0) > (wb and wb.Rarity or 0)
		end)
		for i, item in items do
			local weapon = WeaponConfig.Weapons[item.Id]
			if weapon then
				local maxLevel = WeaponConfig.Rarities[weapon.Rarity].MaxLevel
				local upGold, upAmbrosia = WeaponConfig.UpgradeCost(item.Id, item.Level, training)
				local frame = row(i, weapon, item.Level, if upGold then ("Next upgrade: %s (level %d/%d)"):format(costText(upGold, upAmbrosia), item.Level, maxLevel) else "Fully upgraded")
				local isEquipped = item.Uid == equippedUid
				local equip = button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -124, 0.5, 0), Size = UDim2.fromOffset(110, 44),
					BackgroundColor3 = if isEquipped then THEME.Gold else THEME.Ready, Text = if isEquipped then "Equipped" else "Equip", Parent = frame })
				equip.Activated:Connect(function()
					if not isEquipped then
						weaponRemote:FireServer("Equip", item.Uid)
					end
				end)
				local canAfford = upGold ~= nil and gold >= upGold and ambrosia >= (upAmbrosia or 0)
				local upgrade = button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(116, 44),
					BackgroundColor3 = if canAfford then THEME.Forge else THEME.Locked, Text = if upGold then "Upgrade" else "MAX", Parent = frame })
				upgrade.Activated:Connect(function()
					if upGold then
						weaponRemote:FireServer("Upgrade", item.Uid)
					end
				end)
			end
		end
	else
		local ownedIds = {}
		for _, item in items do
			ownedIds[item.Id] = true
		end
		for i, id in WeaponConfig.Order do
			local weapon = WeaponConfig.Weapons[id]
			local source
			if id == WeaponConfig.StarterWeapon then
				source = "Everyone starts with this."
			elseif weapon.Cost then
				source = "Craft: " .. costText(weapon.Cost.Gold or 0, weapon.Cost.Ambrosia)
			elseif weapon.Drop then
				local boss = CombatConfig.Enemies[weapon.Drop.Boss]
				source = ("Dropped by %s (%d%% when you win)"):format(boss and boss.DisplayName or weapon.Drop.Boss, weapon.Drop.Chance * 100)
			end
			local frame = row(i, weapon, 0, source)
			local have = ownedIds[id] == true
			if have then
				button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(116, 44), BackgroundColor3 = THEME.Gold, Text = "Owned", AutoButtonColor = false, Parent = frame })
			elseif weapon.Cost then
				local canAfford = gold >= (weapon.Cost.Gold or 0) and ambrosia >= (weapon.Cost.Ambrosia or 0)
				local craft = button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(116, 44),
					BackgroundColor3 = if canAfford then THEME.Forge else THEME.Locked, Text = "Craft", Parent = frame })
				craft.Activated:Connect(function()
					weaponRemote:FireServer("Craft", id)
				end)
			end
		end
	end
end

for _, attribute in { "WeaponsJson", "EquippedWeaponUid", "Gold", "Ambrosia", "Temple_TrainingGrounds" } do
	player:GetAttributeChangedSignal(attribute):Connect(function()
		if panel.Visible then
			refresh()
		end
	end)
end

local function open(tab)
	currentTab = tab
	refresh()
	panel.Visible = true
end
openButton.Activated:Connect(function()
	if panel.Visible then
		panel.Visible = false
	else
		open("Mine")
	end
end)
closeButton.Activated:Connect(function()
	panel.Visible = false
end)
myTab.Activated:Connect(function()
	open("Mine")
end)
forgeTab.Activated:Connect(function()
	open("Forge")
end)
notifyRemote.OnClientEvent:Connect(function(kind, tab)
	if kind == "OpenWeapons" then
		open(if tab == "Forge" then "Forge" else "Mine")
	end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="70">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="FallenPartsDestroyHeight">-1500</float>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>